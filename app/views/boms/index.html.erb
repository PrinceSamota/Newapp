<h1 class="text-2xl font-bold mb-4">BOM List</h1>

<%= link_to 'New BOM', new_bom_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded shadow" %>

<table class="table-auto w-full mt-6 border">
  <thead>
    <tr class="bg-gray-200">
      <th class="px-4 py-2 border">BOM Number</th>
      <th class="px-4 py-2 border">Item Name</th>
      <th class="px-4 py-2 border">Quantity</th>
      <th class="px-4 py-2 border">Finished Good</th>
      <th class="px-4 py-2 border">Unit</th>
      <th class="px-4 py-2 border">Action</th>
    </tr>
  </thead>
  <tbody>
    <% @boms.each do |bom| %>
      <tr>
        <td class="border px-4 py-2"><%= bom.bom_number %></td>
        <td class="border px-4 py-2"><%= bom.item_master.item_name %></td>
        <td class="border px-4 py-2"><%= bom.quantity %></td>
        <td class="border px-4 py-2"><%= bom.finished_good %></td>
        <td class="border px-4 py-2"><%= bom.unit %></td>
        <td class="border px-4 py-2">
          <%= form_with model: BomRawMaterial.new, url: bom_raw_materials_path, local: true do |f| %>
            <!-- Hidden BOM ID -->
            <%= f.hidden_field :bom_id, value: bom.id %>

            <!-- Input Raw Material SKU -->
            <%= f.text_field :raw_material_sku, placeholder: "SKU", class: "border px-1 py-1 w-24" %>

            <!-- Default quantity = bom.quantity -->
            <%= f.number_field :quantity, value: bom.quantity, min: 1, class: "border px-1 py-1 w-16" %>

            <!-- Submit Button -->
            <%= f.submit "Add", class: "bg-green-600 hover:bg-green-700 text-white px-2 py-1 rounded" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<table class="min-w-full bg-white border border-gray-300 rounded-lg shadow">
  <thead>
    <tr class="bg-gray-100 text-left">
      <th class="px-4 py-2 border">Item Master ID</th>
      <th class="px-4 py-2 border">Finished Good SKU</th>
      <th class="px-4 py-2 border">Unit</th>
      <th class="px-4 py-2 border">Quantity</th>
      <th class="px-4 py-2 border">Created At</th>
    </tr>
  </thead>
  <tbody>
    <% boms.each do |bom| %>
      <tr>
        <td class="border px-4 py-2"><%= bom.item_master_id %></td>
        <td class="border px-4 py-2"><%= bom.finished_good_sku %></td>
        <td class="border px-4 py-2"><%= bom.unit %></td>
        <td class="border px-4 py-2"><%= bom.quantity %></td>
        <td class="border px-4 py-2"><%= bom.created_at.strftime("%d %b %Y %H:%M") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
