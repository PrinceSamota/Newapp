<%= link_to root_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 rounded border border-gray-300" do %>
  <i class="fa-solid fa-arrow-left"></i>
    <span class="font-bold">Back</span>
  <% end %>
  <div class="bg-white p-8 rounded-2xl shadow-lg max-w-full mx-auto mt-6 overflow-auto">
  <%= form_with model: @bom, local: true do |f| %>
    <div class="flex flex-col lg:flex-row lg:items-end gap-6">
      <!-- Item Master -->
      <div class="flex-1 min-w-[200px]">
        <%= f.label :item_master_id, "Select Item Master", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= select_tag "bom[item_master_id]",
              options_for_select(@item_masters.map { |item| [item.item_name, item.id] }),
              include_blank: "Choose Item",
              id: "item_master_select",
              class: "w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm" %>
      </div>

      <!-- SKU ID -->
      <div class="flex-1 min-w-[200px]">
        <%= f.label :sku_id, "Select SKU ID", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <select name="bom[sku_id]" id="sku_id_select"
                class="w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm">
          <option value="">Choose SKU</option>
          <% @item_masters.each do |item| %>
            <option value="<%= item.sku_id %>" data-item-id="<%= item.id %>"><%= item.sku_id %></option>
          <% end %>
        </select>
      </div>

      <!-- Quantity -->
      <div class="flex-1 min-w-[150px]">
        <%= f.label :quantity, "Quantity", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.number_field :quantity, value: 1,
              class: "w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm" %>
      </div>

      <!-- Unit -->
      <div class="flex-1 min-w-[150px]">
        <%= f.label :unit, "Unit", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= f.text_field :unit,
              class: "w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm" %>
      </div>

      <!-- Submit -->
      <div class="mt-1 lg:mt-0">
        <%= f.submit "Create BOM",
              class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-full shadow-md transition text-sm whitespace-nowrap cursor-pointer" %>
      </div>
    </div>

    <!-- JSON Data -->
    <%= tag.script id: "item_masters_json", type: "application/json" do %>
      <%= raw @item_masters.to_json(only: [:id, :sku_id]) %>
    <% end %>
  <% end %>
</div>

<!-- BOMs Table -->
<div class="p-6 pt-12">
  

  <% if @boms.present? %>
    <div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
          <tr>
            <% ["Item Master", "SKU", "Unit", "Quantity", "Actions"].each_with_index do |header, index| %>
              <th class="px-6 py-3 text-left whitespace-nowrap border-r border-gray-300 <%= 'last:border-r-0' if index == 4 %>"><%= header %></th>
            <% end %>
          </tr>
        </thead>

        <tbody class="bg-white">
          <% @boms.each_with_index do |bom, index| %>
            <!-- Parent BOM Row -->
            <tr class="border-b-1 border-gray-200 border-t-1">
              <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= bom.item_master.item_name %></td>
              <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= bom.sku_id %></td>
              <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= bom.unit %></td>
              <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= bom.quantity %></td>
              <td class="px-6 py-4 whitespace-nowrap flex gap-2">
                <button onclick="toggleInlineForm(<%= bom.id %>)" class="hover:bg-gray-200 px-3 py-1 rounded text-black font-semibold border border-gray-300 text-sm cursor-pointer">
                  <i class="fa-solid fa-plus"></i> Add Raw
                </button>
                <% if bom.bom_raw_materials.any? %>
                  <button onclick="toggleRawMaterials(<%= bom.id %>)" class="hover:bg-gray-200 px-3 py-1 rounded text-black font-semibold border border-gray-300 text-sm cursor-pointer">
                    <i class="fa-solid fa-eye"></i> Show/Hide
                  </button>
                <% end %>
              </td>
            </tr>

            <!-- Inline Form Row -->
            <tr id="inline_form_<%= bom.id %>" class="hidden p-0 h-0 overflow-hidden ">
              <td colspan="5" class="px-6 py-4">
                <%= form_with url: bom_raw_materials_path, method: :post, data: { turbo: false } do |f| %>
                  <%= hidden_field_tag :bom_id, bom.id %>
                  <div class="flex items-center gap-4">
                    <div class="w-full">
                      <label class="block text-sm font-medium text-gray-700">Item Master</label>
                      <select name="item_master_id" class="w-full border border-gray-300 rounded px-3 py-2">
                        <option value="">Choose an Item</option>
                        <% @item_masters.each do |item| %>
                          <option value="<%= item.id %>"><%= item.item_name %> (<%= item.sku_id %>)</option>
                        <% end %>
                      </select>
                    </div>

                    <div class="w-1/3">
                      <label class="block text-sm font-medium text-gray-700">Quantity</label>
                      <%= f.number_field :quantity, class: "w-full border border-gray-300 rounded px-3 py-2" %>
                    </div>

                    <div class="mt-6">
                      <%= f.submit "Save", class: "hover:bg-gray-200 px-4 py-2 rounded text-black font-bold border border-gray-300 cursor-pointer" %>
                    </div>
                  </div>
                <% end %>
              </td>
            </tr>

            <!-- Raw Materials Row (Conditional) -->
            <% if bom.bom_raw_materials.any? %>
              <tr id="bom_<%= bom.id %>_raw_row" class="hidden">
                <td colspan="5" class="px-6 py-4">
                  <turbo-frame id="bom_<%= bom.id %>_raw_materials">
                    <div class="bg-gray-50 rounded-lg p-4 border border-gray-300 mt-2">
                      <h4 class="font-semibold text-sm mb-2">Raw Materials:</h4>
                      <table class="min-w-full text-sm border border-gray-200 rounded">
                        <thead class="bg-gray-100">
                          <tr>
                            <th class="px-3 py-2 text-left border-r border-gray-300">Item Name</th>
                            <th class="px-3 py-2 text-left">Quantity</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% bom.bom_raw_materials.each do |rm| %>
                            <tr class="bg-white border-b-1 border-gray-200">
                              <td class="px-3 py-2 border-r border-gray-200"><%= rm.item_master.item_name %></td>
                              <td class="px-3 py-2"><%= rm.quantity %></td>
                            </tr>
                          <% end %>
                        </tbody>
                      </table>
                    </div>
                  </turbo-frame>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-gray-600">No BOM records found.</p>
  <% end %>
</div>

<script>
  function toggleRawMaterials(bomId) {
    const row = document.getElementById(`bom_${bomId}_raw_row`);
    if (row) row.classList.toggle("hidden");
  }

  function toggleInlineForm(bomId) {
    const row = document.getElementById(`inline_form_${bomId}`);
    if (row) row.classList.toggle("hidden");
  }

  function setupSyncDropdowns() {
    const jsonElement = document.getElementById("item_masters_json");
    if (!jsonElement) return;

    const itemMasters = JSON.parse(jsonElement.textContent);
    const itemSelect = document.getElementById("item_master_select");
    const skuSelect = document.getElementById("sku_id_select");

    if (!itemSelect || !skuSelect) return;

    function syncByItemId(id) {
      const item = itemMasters.find(i => i.id === parseInt(id));
      if (item) {
        for (const option of skuSelect.options) {
          option.selected = option.value === item.sku_id;
        }
      }
    }

    function syncBySkuId(skuId) {
      const item = itemMasters.find(i => i.sku_id === skuId);
      if (item) {
        for (const option of itemSelect.options) {
          option.selected = option.value === item.id.toString();
        }
      }
    }

    itemSelect.addEventListener("change", function () {
      if (this.value !== "") {
        syncByItemId(this.value);
      }
    });

    skuSelect.addEventListener("change", function () {
      if (this.value !== "") {
        syncBySkuId(this.value);
      }
    });
  }

  document.addEventListener("turbo:load", function () {
    setupSyncDropdowns();
  });
</script>
