<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Declaration</title>
  <style>
    @page { size: A4; margin: 15mm; }
    body { font-family: Arial, sans-serif; font-size: 16px; line-height: 1.6; }
    .header { text-align: center; font-weight: bold; font-size: 18px; margin-bottom: 20px; }
    .content { margin: 20px 0; }
    table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    td, th { border: 1px solid #000; padding: 6px; text-align: left; }
    .signature { margin-top: 50px; text-align: right; }
  </style>
</head>
<body>
<div style="display: flex; justify-content: center; align-items: center; position: relative; width: 100%;">
  <div class="header" style="font-weight: bold; text-align: center; flex: 1; margin-top: 40px;"><span style="font-size: 20px; font-family: 'Merriweather">DECLARATION</span></div>
  
  <% if @logo_data.present? %>
    <img src="data:image/png;base64,<%= @logo_data %>" 
         style="width: 120px; height: 120px; object-fit: contain; position: absolute; right: 0;" />
  <% end %>
</div>


  <div class="content">
    <p>I / We declare that the particulars given herein above are true, correct and complete.</p>
    <p>I / We enclose here with copies of the following documents*:</p>

    <ol>
      <li>1. Duty Exemption Entitlement Certificate/ Advance Authorisation/ Duty Free Import, Authorisation Declaration</li>
      <li>2.Invoice/Invoice cum packing list</li>
      <li>3. Quota/Inspection certificates</li>
      <li>4. Others (Specify)</li>
    </ol>

    <table>
      <tr>
        <td><strong>Name of the Exporter:</strong></td>
        <td>Living Care India</td>
        <td><strong>Name of Customs Broker:</strong></td>
        <td style="width: 150px;"></td>
      </tr>
      <tr>
        <td><strong>Designation:</strong></td>
        <td>Manager</td>
        <td><strong>Designation:</strong></td>
        <td style="width: 150px;"></td>

      </tr>
      <tr>
        <td></td>
        <td></td>
        <td><strong>Identity Card Number</strong></td>
        <td></td>
      </tr>
    </table>

    <p>I/We undertake to abide by the provisions of Foreign Exchange Management Act, 1999, as amended from time to time, including realisation or repatriation of foreign exchange to or from India.</p>
    <p><em>* To be submitted with the exports goods in the warehouse.</em></p>
<div style="display: flex; justify-content: space-between; margin-top: 40px;">

  <!-- Left side: Date & Appendix -->
  <div style="text-align: left;">
    <p style="margin: 0;">Date: <%= @input.invoice_date&.strftime("%-d-%b-%Y") %></p>
    <p style="margin: 0;">(ii) APPENDIX-1 shall be omitted.</p>
    <p style="margin: 0;">[F. No. 450/25/2013- Cus IV (Pt)]</p>
  </div>

  <!-- Right side: Signature -->
  <div style="text-align: center;">
    <% if @signature_data.present? %>
      <img src="data:image/png;base64,<%= @signature_data %>" 
           alt="Signature" 
           style="height: 120px; object-fit: contain; display: block; margin: 0 auto 5px auto;" />
    <% end %>

    <% if @input.shipper_name.signatory.present? %>
      <p style="margin: 2px 0; font-weight: bold; font-size: 14px;"><%= @input.shipper_name.signatory %></p>
    <% end %>
    <p style="margin: 2px 0; font-size: 14px;">Authorised Signatory</p>
  </div>

</div>

</body>
</html>
