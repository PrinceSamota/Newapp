<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>SCOMET Declaration</title>
  <style>
    @page { size: A4; margin: 15mm; }
    body { font-family: Arial, sans-serif; font-size: 16px; line-height: 1.6; }
    .logo { float: right; width: 120px; }
    .date { margin-top: 130px; }
    .center { text-align: center; font-weight: bold; margin: 30px 0; font-size: 18px; text-decoration: underline; }
    .signature { margin-top: 50px; }
  </style>
</head>
<body>
  <div>
    <% if @logo_data.present? %>
    <img src="data:image/png;base64,<%= @logo_data %>" 
         style="width: 120px; height: 120px; object-fit: contain;", class="logo" />
  <% end %>
  
  </div>

  <div class="date">
    Date: <%= Date.today.strftime("%d-%b-%Y") %>
  </div>

  <p>
    TO,<br>
    Assistant Commissioner Of Customs.- EXPORT<br>
    <%= @input.consignee_name.port_of_loading %>
  </p>

  <div class="center">SCOMET DECLARATION</div>

  <p>
    Reference: Our Invoice No: <%= @input.invoice_no %>,   Date <%= @input.invoice_date&.strftime("%d-%b-%Y") %> 
  </p>

  <p style="margin-top: 20px;">
    We are exporting to  <b><%= @input.consignee_name.company_name %></b>
  </p>

  <p style="margin-top: 20px;">
    We hereby declare that the <b><% @input.input_details.each_with_index do |detail, index| %>
      <%= detail.complete_description_of_good&.name %><%= ', ' unless index == @input.input_details.size - 1 %>
    <% end %></b> are not covered in list of SCOMET items OR any other respective list of exports.  
    It will be used for Lighting and Installing in the Railways.
  </p>

  <p style="margin-top: 20px;">
    You are requested to complete shipping procedure and send to the destination at earliest.<br>
    We request you to allow the same for export.
  </p>

  <p>Thanking you</p>
<div class="signature" style="text-align: left; margin-top: 20px; width: 250px;">
  <!-- Top Text -->
  <div>
    <span>Yours faithfully</span><br>
    <span>For Living Care India</span>
  </div>

  <!-- Signature Image -->
<div style="width: 200px; text-align: center; margin-left: auto; margin-right: 50px; margin-top: 20px;">
  <!-- Signature Image -->
  <div style="height: 120px; margin-bottom: 5px; padding: 5px;">
    <% if @signature_data.present? %>
      <img src="data:image/png;base64,<%= @signature_data %>" 
           style="width: 100%; height: 100%; object-fit: contain;" />
    <% end %>
  </div>

  <!-- Signatory Name centered under image -->
  <% if @input.shipper_name.signatory.present? %>
    <p style="margin: 2px 0; font-weight: bold; font-size: 14px;"><%= @input.shipper_name.signatory %></p>
  <% end %>

  <!-- Authorised Signatory Label centered -->
  <p style="margin: 2px 0; font-size: 14px;">Authorised Signatory</p>
</div>

</div>

</body>
</html>
