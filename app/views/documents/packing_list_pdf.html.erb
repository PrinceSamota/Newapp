<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Packing List</title>
  <style>
    @page { size: A4; margin: 10mm; }
    body { font-family: Arial, sans-serif; font-size: 11px; margin: 0; padding: 0; }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    td, th {
      border: 1px solid #000;
      padding: 4px;
      vertical-align: top;
      font-size: 11px;
    }

    .title {
      text-align: center;
      font-weight: bold;
      font-size: 16px;
      border: 1px solid #000;
      height: 35px;
    }

    .logo {
      float: right;
      border: 1px solid #000;
      width: 100px;
      height: 30px;
      text-align: center;
      font-weight: bold;
    }

    .section-title {
      font-weight: bold;
      font-size: 11px;
    }

    .items th, .items td {
      text-align: center;
      font-size: 10px;
      padding: 3px;
    }

    .items th {
      font-weight: bold;
    }

    .signature {
      text-align: center;
      height: 100px;
      vertical-align: bottom;
    }
  </style>
</head>
<body>
  <table>
    <!-- Title -->
    <tr>
      <td colspan="3" class="title">
        PACKING LIST
        <div class="logo">LOGO</div>
      </td>
    </tr>

    <!-- Exporter / Invoice / Date -->
    <tr>
      <td style="width:50%; height:120px;">
        <div class="section-title">Exporter</div>
        <!-- Exporter details dynamically -->
      </td>
      <td style="width:25%; height:120px;">
        <div class="section-title">INVOICE NO:</div>
        <!-- Invoice No -->
      </td>
      <td style="width:25%; height:120px;">
        <div class="section-title">INVOICE DATE:</div>
        <!-- Date -->
      </td>
    </tr>

    <!-- Consignee / Buyer -->
    <tr>
      <td style="height:100px;">
        <div class="section-title">Consignee</div>
        <!-- Consignee details -->
      </td>
      <td colspan="2" style="height:100px;">
        <div class="section-title">Buyer (If other than Consignee)</div>
        <!-- Buyer + Country + Payment -->
      </td>
    </tr>

    <!-- Vessel / Port -->
    <tr>
      <td colspan="3" style="height:60px;">
        <table style="width:100%; border:none;">
          <tr>
            <td style="border:1px solid #000; width:33%;"><div class="section-title">Vessel/ Flight No.</div></td>
            <td style="border:1px solid #000; width:33%;"><div class="section-title">Port of Loading</div></td>
            <td style="border:1px solid #000; width:34%;"><div class="section-title">Place of Discharge / Place of Delivery</div></td>
          </tr>
          <tr>
            <td style="border:1px solid #000; height:25px;"></td>
            <td style="border:1px solid #000;"></td>
            <td style="border:1px solid #000;"></td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- Items Table -->
    <tr>
      <td colspan="3">
        <table class="items">
          <thead>
            <tr>
              <th>Marks & No / Container No</th>
              <th>No of Boxes</th>
              <th>Description of Goods</th>
              <th>Qty per Box</th>
              <th>Total Qty</th>
              <th>N. Wt</th>
              <th>G. Wt</th>
              <th>Total N. Wt</th>
              <th>Total G. Wt</th>
              <th>Size (CM) / CBM</th>
              <th>Order No</th>
            </tr>
          </thead>
          <tbody>
            <!-- Dynamic rows here -->
            <tr>
              <td colspan="11" style="text-align:right; font-weight:bold;">Total</td>
            </tr>
          </tbody>
        </table>
      </td>
    </tr>

    <!-- Totals + Signature -->
    <tr>
      <td style="height:80px;">
        <div class="section-title">Total Gross Weight:</div>
        <div class="section-title">Total Net Wt:</div>
      </td>
      <td colspan="2" class="signature">
        Signature & Date<br><br>
        For LIVING CARE INDIA<br><br>
        Authorised Signatory
      </td>
    </tr>
  </table>
</body>
</html>
