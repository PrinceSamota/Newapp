<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Commercial Invoice</title>
  <style>
  body {
    font-family: Arial, sans-serif;
    font-size: 11px;
    padding: 15px;
    margin: 0;
    color: #000;
  }
  
  .main-container {
    border: 2px solid #000;
    width: 100%;
    box-sizing: border-box;
  }
  
  /* Header */
  .header {
    text-align: center;
    font-size: 22px;
    font-weight: bold;
    font-family: 'Merriweather', serif;
    border-bottom: 1px solid #000;
    position: relative;
    height: 100px;
  }
  .logo-box {
    position: absolute;
    right: 15px;
    top: 8px;
    width: 170px;
    height: 80px;
  }
  
  /* Top 3 boxes */
  .top-row { display: table; width: 100%; border-bottom: 1px solid #000; table-layout: fixed;  font-family: 'Merriweather', serif; font-size: 14px; }
  .top-box { display: table-cell; border-right: 1px solid #000; padding: 10px; height: 60px; vertical-align: top; }
  .top-box:last-child { border-right: none; }
  .top-box:first-child { width: 50%; }
  .top-box:nth-child(2), .top-box:nth-child(3) { width: 25%; }
  
  /* Middle 2 boxes */
  .user-name {  font-family: 'Merriweather', serif; font-size: 14px; font-weight: bold; }
  .user-name_td {  font-family: 'Merriweather', serif;  font-weight: bold; }
  .middle-row { display: table; width: 100%; border-bottom: px solid #000; table-layout: fixed; }
  .middle-box { display: table-cell; border-right: 1px solid #000; padding: 10px; height: 200px; vertical-align: top; }
  .middle-box:last-child { border-right: none; }
  
  /* Country 2 boxes */
  .country-row { display: table; width: 100%; border-bottom: 1px solid #000; table-layout: fixed; }
  .country-box { display: table-cell; border-right: 1px solid #000; padding: 10px; height: 80px; vertical-align: top; }
  .country-box:last-child { border-right: none; }
  
  /* Country single box */
  .country-single-row { display: table; width: 100%; table-layout: fixed; }
  .country-single-box { display: table-cell; border-right: 1px solid #000; border-bottom: 1px solid #000; padding: 10px; height: 80px; vertical-align: top; width: 50%; }
  .country-empty-box { display: table-cell; padding: 10px; border-top: 1px solid #000; height: 80px; vertical-align: top; width: 50%; }
  
  /* Items table */
  .table-section { border-bottom: 1px solid #000; }
  .items-table { width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 10%; }
  .items-table th, .items-table td { border: 1px solid #000; height: 35px; }
  .items-table th, .items-table td { text-align: center; }
  
  /* Bottom row */
  .bottom-row { display: table; width: 100%; border-bottom: 1px solid #000; table-layout: fixed; }
  .payment-box { display: table-cell; padding: 10px; height: 70px; vertical-align: top; }
  .total-box { display: table-cell; border-left: 1px solid #000; padding: 10px; width: 180px; height: 70px; vertical-align: top; }
  
  /* Declaration & Signature */
  .declaration-box { padding: 10px; height: 80px; border-bottom: 1px solid #000; text-align: center; }
  .signature-box {
    margin-top: 30px;
    border-top: 1px solid #ccc;
    padding-top: 15px;
    font-family: 'Arial', sans-serif;
  }

  .signature-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .signature-left {
    width: 60%;
  }

  .signature-line {
    border-bottom: 2px dotted #000;
    height: 70px;
    margin-bottom: 6px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .signature-line img {
    max-height: 65px;
    max-width: 100%;
    object-fit: contain;
  }

  .signature-label {
    text-align: center;
    font-size: 11px;
    font-weight: bold;
    color: #333;
    margin-top: 4px;
  }

  .signature-name {
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: #222;
    margin-top: 2px;
  }

  .signature-right {
    text-align: right;
    font-size: 12px;
    font-weight: 600;
    color: #333;
  }
  
  table {
    width: 100%;
    border-collapse: collapse;
  }

  td, th {
    border: 1px solid #000;
    padding: 4px;
    vertical-align: top;
    font-size: 11px;
  }
  .user-name {  font-family: 'Merriweather', serif; font-size: 14px; font-weight: bold; }

  .user-name_td {  font-family: 'Merriweather', serif;  font-weight: bold; }

  .title {
    text-align: center;
    font-weight: bold;
    font-size: 22px;
    border: 1px solid #000;
    height: 70px;
    font-family: 'Merriweather', serif;
  }

  .logo {
    float: right;
   
    width: 100px;
    text-align: center;
    font-weight: bold;
  }

  .section-title {

  }

  .items th, .items td {
    text-align: center;
    font-size: 10px;
    padding: 3px;
  }

  .items th {
    font-weight: bold;
  }
  .signature {
    text-align: center;
    max-height: 100px;
    vertical-align: bottom;
  }

  </style>
</head>
<body>
<div class="main-container">
  <!-- Header -->
  <div class="header" style="text-align: center; position: relative; display: flex; align-items: center; justify-content: center; height: 130px; ">
    PACKING LIST
    <div class="logo-box">
    <% if @logo_data.present? %>
    <img src="data:image/png;base64,<%= @logo_data %>" 
         style="width: 130px; height: 120px; object-fit: contain;" />
  <% end %>
  
    </div>
  </div>

  <!-- Top Row - 3 boxes -->
  <div class="top-row">
    <div class="top-box"> DATE OF EXPORTATION: </br>
     <%= @input.invoice_date&.strftime("%-d-%b-%Y") %>
    </div>
    <div class="top-box">
      INVOICE NO: </br>
      <%= @input.invoice_no %>
    </div>
    <div class="top-box">
      INVOICE DATE: </br>
      <%= @input.invoice_date&.strftime("%-d-%b-%Y") %>
    </div>
  </div>

  <!-- Middle Row - 2 big boxes -->
  <div class="middle-row">
    <div class="middle-box">
     <span class="user-name">SHIPPER/ EXPORTER</span> </br>
       <%= @input.shipper_name.company_name %></br>
       <%= @input.shipper_name.address1 %></br>
       <%= @input.shipper_name.address2 %></br>
       <%= @input.shipper_name.address3 %></br>
       <%= @input.shipper_name.country %></br>
       <span class="user-name_td">Contact person: <%= @input.shipper_name.name %></span></br>
       <span class="user-name_td">TEL. NO: </span><%= @input.shipper_name.contact_no %></br>
       <span class="user-name_td">Email: </span><%= @input.shipper_name.email %></br>
       <span class="user-name_td">GST: </span><%= @input.shipper_name.gst_no %></br>
       <span class="user-name_td">IEC: </span><%= @input.shipper_name.iec_no %></br>
       <span class="user-name_td">REX No: </span><%= @input.shipper_name.rex_no %></br>
       <span class="user-name_td">LUT Bond No: </span><%= @input.shipper_name.lut_bond_no %></br>
       <span class="user-name_td">AD Code: </span><%= @input.shipper_name.ad_code %></br>
    </div>
    <div class="middle-box">
      <span class="user-name">CONSIGNEE</span> </br>
        <%= @input.consignee_name.company_name %></br>
        <%= @input.consignee_name.address1 %></br>
        <%= @input.consignee_name.address2 %></br>
        <%= @input.consignee_name.address3 %></br>
        <%= @input.consignee_name.country %></br>
        <span class="user-name_td">Contact person: <%= @input.consignee_name.name %> </span></br>
        <span class="user-name_td">Email: </span><%= @input.consignee_name.email %></br>
        <span class="user-name_td">Contact No: </span><%= @input.consignee_name.contact_no %></br>
        <span class="user-name_td">EORI No: </span><%= @input.consignee_name.eori_no %></br>
    </div>
  </div>

  <!-- Additional Country Row - 1 box left side only -->
  <div class="country-single-row">
    <div class="country-single-box"></div>
    <div class="country-empty-box">
      <span class="user-name">BUYER IF OTHER THAN CONSIGNEE:</span> </br>
       <%= @input.importer_name.company_name %></br>
       <%= @input.importer_name.address1 %></br>
       <%= @input.importer_name.address2 %></br>
       <%= @input.importer_name.address3 %></br>
       <%= @input.importer_name.country %></br>
    </div>
  </div>
  <div class="country-single-row">
    <div class="country-single-box">
      <div style="float: left; width: 48%;">
        <strong class="user-name">COUNTRY OF EXPORT:</strong><br>
        <%= @input.consignee_name.country %>
      </div>
      <div style="float: right; width: 48%;">
        <strong class="user-name">PORT OF DISCHARGE:</strong><br>
        <%= @input.consignee_name.port_of_discharge %>
      </div>
      <div style="clear: both;"></div>
    </div>
  <div class="country-empty-box"></div>
</div>
  <!-- Country Row - 4 boxes total -->
  <div class="country-row">
    <div class="country-box">
      <div style="float: left; width: 48%;">
        <strong class="user-name">COUNTRY OF ORIGIN OF GOODS:</strong><br>
        <%= @input.shipper_name.country %>
      </div>
      <div style="float: right; width: 48%;">
        <strong class="user-name">PORT OF LOADING:</strong><br>
        <%= @input.shipper_name.port_of_loading %>
      </div>
      <div style="clear: both;"></div>
    </div>
    <div class="country-box">
      Buyer's Order No: </br>
        <% if @input&.input_items&.any? %>
          <%= @input.input_items.map(&:order_no).compact.join(", ") %>
        <% end %>
    </div>
  </div>
  
  <div class="country-row">
    <div class="country-box">
      <strong class="user-name">COUNTRY OF ULTIMATE DESTINATION:</strong><br>
       <%= @input.consignee_name.country %>
    </div>
    <div class="country-box"></div>
  </div>

  <!-- Table Section -->
  <!-- Items Table -->
    <tr>
      <td colspan="3">
        <table class="items">
          <thead>
            <tr>
              <th>Marks & No / Container No</th>
              <th>No of Boxes</th>
              <th>Description of Goods</th>
              <th>Qty per Box</th>
              <th>Total Qty Pcs</th>
              <th>N. Wt</th>
              <th>G. Wt</th>
              <th>Total N. Wt</th>
              <th>Total G. Wt</th>
              <th>Size (CM)</th>
              <th>CBM</th>
              <th>Order No</th>
            </tr>
          </thead>
          <tbody>
            <!-- Dynamic rows here -->
            <% if @input&.input_items&.any? %>
              <% total_net_weight_sum = @input.input_items.sum { |item| item.no_of_boxes.to_i * item.net_weight.to_f }
              total_gross_weight_sum = @input.input_items.sum { |item| item.no_of_boxes.to_i * item.gross_weight.to_f } %>
              <% start_mark = 1 %>
              <% @input.input_items.each do |item| %>
                 <% boxes = item.no_of_boxes.to_i %>
                 <% end_mark = start_mark + boxes - 1 %>
                <tr class="item-row">
                  <td><%= "#{start_mark}-#{end_mark}" %></td>
                  <td><%= item.no_of_boxes %></td>
                  <td><%= item.description_of_good&.name %></td>
                  <td><%= item.qty_per_box %></td>
                  <td><%= (item.no_of_boxes.to_i * item.qty_per_box.to_i) if item.no_of_boxes && item.qty_per_box %></td>
                  <td><%= item.net_weight %></td>
                  <td><%= item.gross_weight %></td>
                  <td><%= (item.no_of_boxes.to_i * item.net_weight.to_f).round(2) if item.no_of_boxes && item.net_weight %></td>
                  <td><%= (item.no_of_boxes.to_i * item.gross_weight.to_f).round(2) if item.no_of_boxes && item.gross_weight %></td>
                  <td><%= "#{item.length}×#{item.width}×#{item.height}" if item.length && item.width && item.height %></td>
                  <td><%= ((item.length.to_f * item.width.to_f * item.height.to_f / 1000000) * item.no_of_boxes.to_i).round(2) if item.length && item.width && item.height && item.no_of_boxes %></td>
                  <td><%= item.order_no %></td>
                  <% start_mark = end_mark + 1 %>
                </tr>
    
              <% end %>
                 <tr class="item-row">
                  <td>Total</td>
                  <td>  
                    <% total_boxes = @input.input_items.sum { |item| item.no_of_boxes.to_i } %>
                    <%= total_boxes %>
                  </td>
                  <td></td>
                  <td></td>
                  <td> 
                    <% total_qty_pcs = @input.input_items.sum { |item| item.no_of_boxes.to_i * item.qty_per_box.to_i } %>
                    <%= total_qty_pcs %>
                  </td>
                  <td></td>
                  <td></td>
                  <td>
                    <%= total_net_weight_sum.round(2) %>
                  </td>
                  <td>
                     <%= total_gross_weight_sum.round(2) %>
                  </td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
            <% else %>
              <tr class="item-row">
                <td></td><td></td><td></td><td></td><td></td>
                <td></td><td></td><td></td><td></td><td></td><td></td>
                <td></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </td>
    </tr>

    <!-- Bottom Section: Totals & Signature -->
<div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 20px;">

  <!-- LEFT SIDE: Total Weights -->
  <div style="width: 50%; font-size: 12px; line-height: 1.6;">
    <div><strong>Total Gross Weight: KGS.</strong>
      <%= total_gross_weight_sum.round(2) %>
    </div>
    <div><strong>Total Net Weight: KGS.</strong>
      <%= total_net_weight_sum.round(2) %>
    </div>
  </div>

  <!-- RIGHT SIDE: Signature Box -->
  <div style="width: 45%; text-align: right;">
  <div style="text-align: center; font-weight: bold; margin-bottom: 5px;">
  <div style="font-size: 13px; margin-bottom: 3px;">
    <%= @input.invoice_date&.strftime("%-d-%b-%Y") %>
  </div>
  <div style="font-size: 11px; text-transform: uppercase;">
    DATE
  </div>
</div>


    <div style="border-bottom: 2px dotted #000; height: 150px; width: 100%; display: flex; justify-content: center; align-items: center;">
      <% if @signature_data.present? %>
        <img src="data:image/png;base64,<%= @signature_data %>"
             style="max-height: 120px; object-fit: contain;" />
      <% end %>
    </div>

    <% if @input.shipper_name.signatory.present? %>
  <div style="text-align: center; margin-right: 0px; margin-top: 8px;">
    <div style="font-weight: bold; font-size: 14px;">
      <%= @input.shipper_name.signatory %>
    </div>
    <div style="font-size: 14px; font-weight: 600; margin-top: 2px;">
      Authorised Signatory
    </div>
  </div>
<% else %>
  <div style="text-align: center; margin-right: 150px; margin-top: 8px;">
    <div style="font-size: 14px; font-weight: 600;">
      Authorised Signatory
    </div>
  </div>
<% end %>

  </div>
</div>

</div>
</body>
</html>
