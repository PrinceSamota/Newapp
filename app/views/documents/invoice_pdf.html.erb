<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Commercial Invoice</title>
  <style>
  body {
    font-family: Arial, sans-serif;
    font-size: 11px;
    padding: 15px;
    margin: 0;
    color: #000;
  }
  
  .main-container {
    border: 2px solid #000;
    width: 100%;
    box-sizing: border-box;
  }
  
  /* Header */
  .header {
    text-align: center;
    font-size: 22px;
    font-weight: bold;
    font-family: 'Merriweather', serif;
    border-bottom: 1px solid #000;
    position: relative;
    height: 100px;
  }
  .logo-box {
    position: absolute;
    right: 15px;
    top: 8px;
    width: 170px;
    height: 80px;
  }
  
  /* Top 3 boxes */
  .top-row { display: table; width: 100%; border-bottom: 1px solid #000; table-layout: fixed;  font-family: 'Merriweather', serif; font-size: 14px; }
  .top-box { display: table-cell; border-right: 1px solid #000; padding: 10px; height: 60px; vertical-align: top; }
  .top-box:last-child { border-right: none; }
  .top-box:first-child { width: 50%; }
  .top-box:nth-child(2), .top-box:nth-child(3) { width: 25%; }
  
  /* Middle 2 boxes */
  .user-name {  font-family: 'Merriweather', serif; font-size: 14px; font-weight: bold; }
  .user-name_td {  font-family: 'Merriweather', serif;  font-weight: bold; }
  .middle-row { display: table; width: 100%; border-bottom: px solid #000; table-layout: fixed; }
  .middle-box { display: table-cell; border-right: 1px solid #000; padding: 10px; height: 200px; vertical-align: top; }
  .middle-box:last-child { border-right: none; }
  
  /* Country 2 boxes */
  .country-row { display: table; width: 100%; border-bottom: 1px solid #000; table-layout: fixed; }
  .country-box { display: table-cell; border-right: 1px solid #000; padding: 10px; height: 80px; vertical-align: top; }
  .country-box:last-child { border-right: none; }
  
  /* Country single box */
  .country-single-row { display: table; width: 100%; table-layout: fixed; }
  .country-single-box { display: table-cell; border-right: 1px solid #000; border-bottom: 1px solid #000; padding: 10px; height: 80px; vertical-align: top; width: 50%;border-top: 1px solid #000; }
  .country-empty-box { display: table-cell; padding: 10px; border-top: 1px solid #000; height: 80px; vertical-align: top; width: 50%; }
  
  /* Items table */
  .table-section { border-bottom: 1px solid #000; }
  .items-table { width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 2%; }
  .items-table th, .items-table td { border: 1px solid #000; height: 35px; }
  .items-table th, .items-table td { text-align: center; }
  
  /* Bottom row */
  .bottom-row { display: table; width: 100%; border-bottom: 1px solid #000; table-layout: fixed; }
  .payment-box { display: table-cell; padding: 10px; height: 70px; vertical-align: top; }
  .total-box { display: table-cell; border-left: 1px solid #000; padding: 10px; width: 180px; height: 70px; vertical-align: top; }
  
  /* Declaration & Signature */
  .declaration-box { padding: 10px; height: 80px; border-bottom: 1px solid #000; text-align: center; }
  .signature-box {
    margin-top: 0px;
    border-top: 1px solid #ccc;
    padding-top: 15px;
    font-family: 'Arial', sans-serif;
  }

  .signature-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .signature-left {
    width: 60%;
  }

  .signature-line {
    border-bottom: 2px dotted #000;
    height: 140px;
    margin-bottom: 6px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .signature-line img {
    max-height: 120px;
    max-width: 100%;
    object-fit: contain;
  }

  .signature-label {
    text-align: center;
    font-size: 11px;
    font-weight: bold;
    color: #333;
    margin-top: 4px;
  }

  .signature-name {
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: #222;
    margin-top: 2px;
  }

  .signature-right {
    text-align: right;
    font-size: 12px;
    font-weight: 600;
    color: #333;
  }
  
  </style>
</head>
<body>
<div class="main-container">
  <!-- Header -->
  <div class="header" style="text-align: center; position: relative; display: flex; align-items: center; justify-content: center; height: 100px; ">
    COMMERCIAL INVOICE
    <div class="logo-box">
    <% if @logo_data.present? %>
    <img src="data:image/png;base64,<%= @logo_data %>" 
         style="width: 120px; height: 90px; object-fit: contain;" />
  <% end %>
  
    </div>
  </div>

  <!-- Top Row - 3 boxes -->
  <div class="top-row">
    <div class="top-box"> DATE OF EXPORTATION: </br>
     <%= @input.invoice_date&.strftime("%-d-%b-%Y") %>
    </div>
    <div class="top-box">
      INVOICE NO: </br>
      <%= @input.invoice_no %>
    </div>
    <div class="top-box">
      INVOICE DATE: </br>
      <%= @input.invoice_date&.strftime("%-d-%b-%Y") %>
    </div>
  </div>

  <!-- Middle Row - 2 big boxes -->
  <div class="middle-row">
    <div class="middle-box">
     <span class="user-name">SHIPPER/ EXPORTER</span> </br>
       <%= @input.shipper_name.company_name %></br>
       <%= @input.shipper_name.address1 %></br>
       <%= @input.shipper_name.address2 %></br>
       <%= @input.shipper_name.address3 %></br>
       <%= @input.shipper_name.country %></br>
       <span class="user-name_td">Contact person: <%= @input.shipper_name.name %></span></br>
       <span class="user-name_td">TEL. NO: </span><%= @input.shipper_name.contact_no %></br>
       <span class="user-name_td">Email: </span><%= @input.shipper_name.email %></br>
       <span class="user-name_td">GST: </span><%= @input.shipper_name.gst_no %></br>
       <span class="user-name_td">IEC: </span><%= @input.shipper_name.iec_no %></br>
       <span class="user-name_td">REX No: </span><%= @input.shipper_name.rex_no %></br>
       <span class="user-name_td">LUT Bond No: </span><%= @input.shipper_name.lut_bond_no %></br>
       <span class="user-name_td">AD Code: </span><%= @input.shipper_name.ad_code %></br>
    </div>
    <div class="middle-box">
      <span class="user-name">CONSIGNEE</span> </br>
        <%= @input.consignee_name.company_name %></br>
        <%= @input.consignee_name.address1 %></br>
        <%= @input.consignee_name.address2 %></br>
        <%= @input.consignee_name.address3 %></br>
        <%= @input.consignee_name.country %></br>
        <span class="user-name_td">Contact person: <%= @input.consignee_name.name %> </span></br>
        <span class="user-name_td">Email: </span><%= @input.consignee_name.email %></br>
        <span class="user-name_td">Contact No: </span><%= @input.consignee_name.contact_no %></br>
        <span class="user-name_td">EORI No: </span><%= @input.consignee_name.eori_no %></br>
    </div>
  </div>

  <!-- Additional Country Row - 1 box left side only -->
  <div class="country-single-row">
  <div class="country-single-row">
    <div class="country-single-box" style="max-height: 10px;">
      <div style="float: left; width: 48%;">
        <strong class="user-name">COUNTRY OF EXPORT:</strong><br>
        <%= @input.consignee_name.country %>
      </div>
      <div style="float: right; width: 48%;">
        <strong class="user-name">PORT OF DISCHARGE:</strong><br>
        <%= @input.consignee_name.port_of_discharge %>
      </div>
      <div style="clear: both;"></div>
    </div>
  <div class="country-empty-box" style="margin-top: -50px; position: absolute; width: 46.5%;">
     <span class="user-name">BUYER IF OTHER THAN CONSIGNEE:</span> </br>
       <%= @input.importer_name.company_name %></br>
       <%= @input.importer_name.address1 %></br>
       <%= @input.importer_name.address2 %></br>
       <%= @input.importer_name.address3 %></br>
       <%= @input.importer_name.country %></br></div>
       
</div>
  <!-- Country Row - 4 boxes total -->
  <div class="country-row">
    <div class="country-box">
      <div style="float: left; width: 48%;">
        <strong class="user-name">COUNTRY OF ORIGIN OF GOODS:</strong><br>
        <%= @input.shipper_name.country %>
      </div>
      <div style="float: right; width: 48%;">
        <strong class="user-name">PORT OF LOADING:</strong><br>
        <%= @input.shipper_name.port_of_loading %>
      </div>
      <div style="clear: both;"></div>
    </div>
    <div class="country-box" style="border-top: 1px solid #000;">
      Buyer's Order No: </br>
        <% if @input&.input_items&.any? %>
          <%= @input.input_items.map(&:order_no).compact.join(", ") %>
        <% end %>
    </div>
  </div>
  
  <div class="country-row">
    <div class="country-box">
      <strong class="user-name">COUNTRY OF ULTIMATE DESTINATION:</strong><br>
       <%= @input.consignee_name.country %>
    </div>
    <div class="country-box"></div>
  </div>

  <!-- Table Section -->
  <div class="table-section">
    <table class="items-table">
      <thead>
        <tr>
          <th style="width: 10%;">Mark/No</th>
          <th>No. of Packages</th>
          <th style="width: 30%;">Complete Description of Goods</th>
          <th style="width: 10%;">HSN</th>
          <th style="width: 10%;">QTY pcs</th>
          <th style="width: 10%;">Unit Value</th>
          <th>Total Value</th>
          <th>Currency</th>
        </tr>
      </thead>
      <tbody>
     <% @input.input_details.each do |detail| %>
    <tr>
      <td><%= detail.marks_no&.name.presence || "—" %></td>
      <td><%= detail.no_of_packages.presence || "—" %></td>
      <td><%= detail.complete_description_of_good&.name.presence || "—" %></td>
      <td><%= detail.hsn&.name.presence || "—" %></td>
      <td><%= detail.qty_pcs.presence || "—" %></td>
      <td><%= detail.price.presence || "—" %></td>
      <td><%= (detail.price && detail.qty_pcs) ? (detail.price * detail.qty_pcs) : "—" %></td>
      <td><%= @input.currency&.name.presence || "-" %></td>
    </tr>
  <% end %>
        <tr>
          <td colspan="1" style="border:none;"></td> 
          <td><span class="user-name">Total No of Pkgs.</span></td> 

          <td colspan="4" style="border:none;"></td> 

          <td><span class="user-name">Total Value</span></td>
          <td><span class="user-name">Currency</span></td> 
        </tr>
        <tr>
          <td colspan="1" style="border:none;"></td> 
          <td> <%= @input.input_details.sum(&:no_of_packages) %> BOX</td> 

          <td colspan="4" style="border:none;"></td> 

          <td> <%= (@input.input_details.sum { |d| d.price.to_f * d.qty_pcs.to_f }).to_s[/\d+\.\d{0,2}/] %></td>
          <td><%= @input.currency&.name %></td> 
        </tr>
        <tr>
          <td colspan="8" style="border:none; padding: 10px; text-align: left;">
            Payment Terms: <%= @input.shipper_name.payment_terms %><br>
            Shipping Terms: <%= @input.shipper_name.shipping_terms %> <br>
            I DECLARE ALL THE INFORMATION CONTAINED IN THIS INVOICE TO BE TRUE <br>
            AND CORRECT.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Declaration Box -->
  <div class="declaration-box">
  The exporter LIVING CARE INDIA, 240, Building - E5, Bhumi World - Industrial Park, Mumbai - Nashik Highway, Bhiwandi, Maharashtra 421302, India REX No:  INREX0316950076DG003, Date: 24/03/2022 of the products covered by this document declares that, except where otherwise clearly indicated, these products are of INDIA preferential origin according to rules of origin of the Generalised System of Preferences of the European Union and that the origin criterion met is W 8539 EU cumulation.
  </div>

  <!-- Signature Box -->
  
<div class="signature-box">
  <div class="signature-section">
    <!-- LEFT SIDE (Signature + Name + Label) -->
    <div class="signature-left">
      <div class="signature-line">
        <% if @signature_data.present? %>
          <img src="data:image/png;base64,<%= @signature_data %>" alt="Signature" style="height: 120px; object-fit: contain;" />
        <% end %>
      </div>
      <% if @input.shipper_name.signatory.present? %>
        <div class="signature-name"><%= @input.shipper_name.signatory %></div>
      <% end %>
      <div class="signature-label">Authorised Signatory</div>
    </div>

    <!-- RIGHT SIDE (Date) -->
    <div class="signature-right">
      <%= @input.invoice_date&.strftime("%-d-%b-%Y") %><br>
      <strong style="margin-right: 25px;">DATE</strong>
    </div>
  </div>
</div>
</div>
</body>
</html>
