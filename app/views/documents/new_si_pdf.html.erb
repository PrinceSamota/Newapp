<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>Shipper’s Letter of Instruction – FedEx Style</title>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<style>
@page { size:A4; margin:0; }
html,body{
  margin:0;padding:0;height:100%;
  background:#fff;-webkit-print-color-adjust:exact;
  font-family:Arial,Helvetica,sans-serif;
}
body{
  display:flex;justify-content:center;align-items:flex-start;
  padding:10mm 0;
}

/* ---- base container ---- */
.sheet{
  position:relative;
  width:210mm;
  height:297mm;
  border:2px solid #000;
  box-sizing:border-box;
  background:#fff;
  overflow:hidden;
}

/* ---- vertical bars as fixed strips ---- */
.left-bar, .right-bar{
  position:absolute;
  top:0; bottom:0;
  width:18mm;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:700;
  line-height:1.6;
  text-align:center;
  padding:4px;
  box-sizing:border-box;
}

.left-bar{
  left:0;
  background:#e7d4fa;
  color:#000;
  writing-mode:vertical-rl;
  text-orientation:mixed;
  border-right:2px solid #000;
  font-size:9.5px;
  white-space:pre-line;
}

.right-bar{
  right:0;
  background:linear-gradient(180deg,#b35be6,#9d47de);
  color:#fff;
  writing-mode:vertical-lr;
  border-left:2px solid #000;
  font-size:10px;
  text-align:center;
}
.left-bar, .right-bar{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:space-around; /* upar se neeche divide ho jaye */
  padding:4px;
}

.bar-item{
  writing-mode: vertical-rl;
  transform: rotate(-90deg); /* thoda tedha */
  background: #e7d4fa;
  padding: 3px 5px;
  margin: 2px 0;
  border:1px solid #000;
  font-weight:700;
  font-size:9.5px;
  text-align:center;
}
/* ---- main page content ---- */
.main{
  position:absolute;
  top:0; left:18mm; right:18mm; bottom:0;
  padding:6px;
  display:flex;
  flex-direction:column;
  gap:6px;
  box-sizing:border-box;
}

/* top banner */
.top-banner{
  background:#b56be6;
  color:#000;
  padding:4px 6px;
  font-weight:700;
  font-size:11px;
  text-align:center;
  border-bottom:2px solid #000;
}

/* tables */
table{width:100%;border-collapse:collapse;font-size:10px;}
th,td{border:1px solid #000;padding:3px 4px;vertical-align:top;}
th{background:#f3f3f3;font-weight:bold;text-align:left;}
.center{text-align:center;}
.highlight-yellow{background:#fff2a8;}
.section-head{background:#d9c3f9;font-weight:700;text-align:left;padding:3px;}
.footer{border:1px solid #000;padding:4px;margin-top:6px;display:flex;justify-content:space-between;font-size:10px;}
</style>
</head>
<body>
