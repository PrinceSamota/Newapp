<div class="container mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold mb-6">Generate Value Letter</h1>
  
  <%= form_with url: generate_pdf_documents_path, method: :post, format: :pdf, local: true, class: "space-y-6" do |form| %>
    <%= form.hidden_field :document_type, value: @document_type %>
    
    <!-- Order Selection -->
    <div class="bg-white p-6 rounded-lg shadow">
      <h3 class="text-lg font-semibold mb-4">Select Order</h3>
      <%= form.select :order_entry_id, 
          options_from_collection_for_select(@order_entries, :id, :order_no), 
          { prompt: "Select Order" },
          { class: "searchable w-full p-2 border rounded", id: "order_select" } %>
    </div>

    <!-- Value Letter Fields -->
    <div class="bg-white p-6 rounded-lg shadow">
      <h3 class="text-lg font-semibold mb-4">Value Letter Details</h3>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :declared_value, class: "block text-sm font-medium mb-1" %>
          <%= form.number_field :declared_value, step: 0.01, class: "w-full p-2 border rounded" %>
        </div>
        <div>
          <%= form.label :currency, class: "block text-sm font-medium mb-1" %>
          <%= form.select :currency, [['USD', 'USD'], ['EUR', 'EUR'], ['INR', 'INR']], 
              { prompt: "Select Currency" }, { class: "w-full p-2 border rounded" } %>
        </div>
      </div>
    </div>

    <div class="text-center">
      <%= form.submit "Generate Value Letter PDF", class: "bg-purple-600 text-white px-8 py-3 rounded-lg hover:bg-purple-700 transition" %>
    </div>
  <% end %>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  new TomSelect('#order_select', {
    create: false,
    sortField: { field: "text", direction: "asc" },
    placeholder: "Search and select order..."
  });
});
</script>