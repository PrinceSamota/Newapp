<header class="relative z-10 bg-white shadow-lg">
<div class="mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between h-16 items-center w-full">
    <div class="flex-shrink-0 text-xl font-bold ">
    <% if user_signed_in? %>
    <%= link_to "Home", root_path, class: "px-4 py-2  cursor-pointer transition font-bold", form: { class: "inline" } %>
  <% else %>
  <% end %>
    </div>
    <div class="space-x-4">
      <% if user_signed_in? %>
        <span class="text-gray-400">Hi, <%= current_user.email %></span>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "px-4 py-2  cursor-pointer transition font-bold", form: { class: "inline" } %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "px-4 py-2  cursor-pointer transition font-bold" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "px-4 py-2  cursor-pointer transition font-bold" %>
      <% end %>
    </div>
  </div>
</div>
</header>
<h1 class="text-2xl font-bold mb-4 mt-4">Order: <%= @order.name %></h1>

<h2 class="text-xl font-semibold mb-2">Items</h2>

<div class="overflow-x-auto shadow border rounded-lg w-full max-w-full">
  <table class="min-w-full table-auto text-sm text-left text-gray-800">
    <thead class="bg-gray-100 sticky top-0 z-10">
      <tr>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Sheet</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Article No</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Service</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Type</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Suspension</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Voltage</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Length</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Kelvin</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Cover</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Watt</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Anzahl Stripes</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Profile</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Number of<br/> Output</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Output <br/>Voltage</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Outputs</th>
        <th class="px-2 border border-gray-300 py-2 whitespace-nowrap">Wiring <br/>Length</th>
      </tr>
    </thead>

    <tbody class="divide-y divide-gray-200">
      <% @decoded_items.each do |item| %>
        <tr class="hover:bg-gray-50">
          <td class="px-2 border border-gray-300 py-2"><%= item[:sheet_name] %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:article_no] %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:service] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:type] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:suspension] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:voltage] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:length] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:kelvin] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:cover] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:watt] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:stripe_set] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:profile] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:output_count] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:output_voltage] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:outputs_count] || "-" %></td>
          <td class="px-2 border border-gray-300 py-2"><%= item[:wiring_map] || "-" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="mt-6">
  <%= link_to "Upload Another File", root_path, class: "inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded" %>
</div>
