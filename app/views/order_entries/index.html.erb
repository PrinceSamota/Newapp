<div class="pl-6 pr-6">
  <div class="bg-white rounded-lg shadow-md border border-gray-200 mt-6">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-3  p-6">
      <h2 class="text-xl font-semibold w-full md:w-auto text-center md:text-left">
        All Order Entries
      </h2>

      <%= link_to new_order_entry_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300" do %>
        <i class="fa-solid fa-plus"></i>
        <span class="font-semibold">New Order</span>
      <% end %>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
  <table class="text-sm divide-y divide-gray-200 border border-gray-300 rounded min-w-full">
    <thead class="bg-gray-100 text-gray-700 text-xs uppercase">
      <tr>
      <th class="px-4 py-3 sticky left-0 bg-gray-100 z-10 border-r border-gray-300" style="min-width:220px">Order No</th>
      <th class="px-4 py-3 sticky left-[220px] bg-gray-100 z-10 border-r border-gray-300" style="min-width:220px">Article No</th>
      <th class="px-4 py-3 sticky left-[440px] bg-gray-100 z-10 border-r border-gray-300" style="min-width:220px">Client</th>
      

        <%# Scrollable columns %>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Target Date</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Ship To</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Qty</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">SKU</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Fuse</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Loop</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Item Type</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Profile</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Wattage</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Voltage</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">Length</th>
        <th class="px-4 py-3 border-r border-gray-300" style="min-width:120px">CCT</th>
        <th class="px-4 py-3" style="min-width:120px">Cover</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-100">
      <% @order_entries.each do |order| %>
        <tr class="hover:bg-gray-50">
          <td class="px-4 py-3 sticky left-0 bg-white z-10 border-r border-gray-300 text-center" style="width:220px">
            <%= link_to order.order_no, order_entry_path(order), class: "text-blue-600 hover:underline font-semibold" %>
          </td>
          <td class="px-4 py-3 sticky left-[220px] bg-white z-10 border-r border-gray-300 text-center" style="width:220px"><%= order.article_no %></td>
          <td class="px-4 py-3 sticky left-[440px] bg-white z-10 border-r border-gray-300 text-center" style="width:220px"><%= order.client&.name %></td>

          <%# Scrollable columns %>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.target_date %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.ship_to_location %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.qty %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.sku_number %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.fuse_type %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.loop %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.item_type %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.profile %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.wattage %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.voltage %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.length %></td>
          <td class="px-4 py-3 border-r border-gray-300 text-center" style="width:220px"><%= order.cct %></td>
          <td class="px-4 py-3 text-center" style="width:220px"><%= order.cover_type %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>



  
  </div>
</div>
