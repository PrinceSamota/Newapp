<div>
  <div class="bg-white rounded-lg shadow-md border border-gray-200">
    
    <div class="flex flex-col md:flex-row justify-between items-center gap-3 p-4 h-18">
      <h2 class="text-xl font-semibold w-full md:w-auto text-center md:text-left">
        Pending Orders
      </h2>
      <div data-controller="bom-search" class="relative">
        <%= search_form_for @q, html: { class: "flex items-center gap-2 w-full max-w-xl mx-auto" } do |f| %>
          <div class="relative w-full">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
              <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2"
                viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 103 10.5a7.5 7.5 0 0013.15 6.15z"></path>
              </svg>
            </div>
            <%= f.search_field :order_no_or_article_no_or_sku_number_cont,
              class: "w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "Search by Item Name, SKU ID, Category, Measurement..." %>
          </div>
          <%= f.submit "Search",
            class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-150 ease-in-out" %>
        <% end %>
      </div>

      
    
      <%= link_to new_order_entry_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300" do %>
        <i class="fa-solid fa-plus"></i>
        <span class="font-semibold">New Order</span>
      <% end %>
      <div class="relative">
      <div id="cartIconWrapper" class="cursor-pointer ml-4 inline-block">
        <i class="fa-solid fa-tasks text-2xl text-gray-700"></i>
        <span id="cartCount"
          class="absolute -top-2 -right-2 bg-red-500 text-white text-xs px-2 py-0.5 rounded-full">
          0
        </span>
      </div>
    
      <div id="cartModal"
        class="absolute top-full right-0 mt-2 bg-white p-4 rounded-lg shadow-lg border border-gray-200 hidden z-[999] transform opacity-0 scale-95 transition-all duration-200 ease-out"
        style="width: 800px;">
        <div class="flex justify-between items-center border-b pb-2">
          <h2 class="text-lg font-bold">Selected Orders</h2>
          <button id="closeCartModal" class="text-gray-500 hover:text-red-500 text-lg">&times;</button>
        </div>
    
        <ul id="cartOrderList" class="mt-4 space-y-2"></ul>
        <div id="cartError" class="text-red-600 font-semibold mb-2 hidden"></div>

        <div class="mt-4 flex justify-end items-center gap-2">
          <%= form_with model: @dispatch, url: dispatches_path, method: :post, local: true do |f| %>
            <%= f.hidden_field :progress, value: "Shipment" %>
            <div id="hiddenFieldsContainer"></div>
            <%= f.submit "Create Dispatch", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 cursor-pointer" %>
          <% end %>

          <button id="reportButton"
            class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700 cursor-pointer">
            Report
          </button>
        </div>
      </div>
    </div>
    </div>
    <div id="topScroll" 
    class="overflow-x-auto"
    style="overflow-y:hidden; height:20px; position:sticky; top:0; background:white; z-index:20;">
 <div id="scrollWidth" style="height:1px;"></div>
</div>
    <div id="bottomScroll" class="overflow-x-auto max-h-[80vh] overflow-y-auto">
      <table class="text-sm divide-y divide-gray-200 border border-gray-300 rounded min-w-full">
        <thead class="bg-gray-100 text-gray-700 text-xs uppercase sticky top-0 z-50">
          <tr>
            <th class="px-4 py-3 border-r border-gray-300 text-center">
               <input type="checkbox" id="selectAll" class="w-4 h-4">
            </th>
            <th class="px-4 sticky left-0 bg-gray-100 z-10 text-center relative sticky-border" style="min-width:320px; height:52px;">
              <style>
                .sticky-border::after {
                  content: "";
                  position: absolute;
                  right: 0;
                  top: 0;
                  height: 100%;
                  width: 2px;
                  background-color: black;
                  z-index: 50;
                }
                #bottomScroll::-webkit-scrollbar {
                  display: none;
                }
                #bottomScroll {
                  scrollbar-width: none;
                }
                #cartIconWrapper {
                  position: relative; 
                }

                #cartModal {
                  position: absolute;
                  top: 120%;
                  right: 0; 
                  background: white;
                  z-index: 999;
                }
              </style>
              <div class="flex items-center justify-between h-full">
                <div class="w-1/2 pr-2 font-semibold h-full flex items-center justify-center"><%= sort_link(@q, :order_no) %></div>
                <div class="w-1/2 pl-2 border-l-2 border-black font-semibold h-full flex items-center justify-center">Article No</div>
              </div>
            </th>
            <th class="px-4 py-3 bg-gray-100 z-10 border-r border-gray-300">Client</th>
            <th class="px-6 py-3 border-r border-gray-300"><%= sort_link(@q, :target_date) %></th>
            <th class="px-4 py-3 border-r border-gray-300">SKU</th>
            <th class="px-4 py-3 border-r border-gray-300"><%= sort_link(@q, :dispatch_no) %></th>
            <th class="px-4 py-3 border-r border-gray-300">Ship To</th>
            <th class="px-4 py-3 border-r border-gray-300">No Of Box</th>
            <th class="px-4 py-3 border-r border-gray-300">Current Stock</th>
            <th class="px-4 py-3 border-r border-gray-300">Qty</th>
            <th class="px-4 py-3 border-r border-gray-300">Item Type</th>
            <th class="px-4 py-3 border-r border-gray-300">Profile</th>
            <th class="px-4 py-3 border-r border-gray-300">Wattage</th>
            <th class="px-4 py-3 border-r border-gray-300">Voltage</th>
            <th class="px-4 py-3 border-r border-gray-300">Length</th>
            <th class="px-4 py-3 border-r border-gray-300">CCT</th>
            <th class="px-4 py-3 border-r border-gray-300">Cover</th>
            <th class="px-4 py-3 border-r border-gray-300">Fuse</th>
            <th class="px-4 py-3 border-r border-gray-300">Loop</th>
            <th class="px-4 py-3 border-r border-gray-300">Extra</th>
            <th class="px-4 py-3 border-r border-gray-300">Start Serial</th>
            <th class="px-4 py-3 border-r border-gray-300">End Serial</th>
            <th class="px-4 py-3 border-r border-gray-300">MFG Date</th>
            <th class="px-4 py-3 border-r border-gray-300">Driver Rev. No</th>
            <th class="px-4 py-3 border-r border-gray-300">Remark</th>
            <th class="px-4 py-3 border-r border-gray-300">Status</th>
            <th class="px-6 py-3"><%= sort_link(@q, :created_at, "Order Date") %></th>
          </tr>
        </thead>

        <tbody id="bomTableBody" class="bg-white divide-y divide-gray-100">
          <% @order_entries.each do |order| %>
            <% row_color = @dispatch_color_map[order.dispatch_no&.strip] || '#FFFFFF' %>
            <tr style="background-color: <%= row_color %>;" data-order-id="<%= order.id %>">
              <td class="px-4 py-3 border-r border-gray-300 text-center">
              <input type="checkbox" 
              class="order-checkbox w-4 h-4 disabled:opacity-50 disabled:cursor-not-allowed" 
              value="<%= order.id %>" 
              data-order-no="<%= order.order_no %>">            
                     </td>
              <td class="px-4 sticky left-0   z-10 text-center relative" style="width:320px; height:52px; background-color: <%= row_color %>;">
                <div class="sticky-border flex justify-between h-full">
                  <div class="pr-2 w-1/2 h-full flex items-center justify-center">
                    <%= link_to order.order_no, order_entry_path(order), class: "text-blue-600 hover:underline font-semibold" %>
                  </div>
                  <div class="pl-2 w-1/2 border-l-2 border-black h-full flex items-center justify-center">
                    <%= order.article_no %>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.client&.name %></td>
              <td class="py-3 border-r border-gray-300 text-center"><%= order.target_date&.strftime("%d-%m-%Y") || "-" %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.sku_number %></td>
              <% dispatch = Dispatch.find_by(d_id: order.dispatch_no) %>
              <td class="px-4 py-3 border-r border-gray-300 text-center">
                <% if dispatch.present? %>
                  <%= link_to order.dispatch_no, edit_dispatch_path(dispatch), class: "text-blue-600 hover:underline" %>
                <% else %>
                  <%= order.dispatch_no || "-" %>
                <% end %>
              </td>

              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.location&.name %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.box %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= ItemMaster.find_by(sku_id: order.sku_number)&.opening_stock %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.qty %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.item_type %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.profile %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.wattage %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.voltage %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.length %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.cct %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.cover_type %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.fuse_type %></td>
              <% raw_color = order.loop.to_s.downcase %>
              <% bg_color = raw_color == 'golden' ? 'gold' : raw_color %>
              <td class="px-4 py-3 border-r border-gray-300 text-center"
                  style="background-color: <%= bg_color %>; color: <%= bg_color == 'black' ? 'white' : 'black' %>;">
                <%= order.loop %>
              </td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.extra %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.start_serial_no %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.end_serial_no %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.mfg_date %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.driver_revision_no %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.remark %></td>
              <td class="px-4 py-3 border-r border-gray-300 text-center"><%= order.status %></td>
              <td class="py-3 text-center"><%= order.created_at.strftime("%d-%m-%Y") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="flex items-center justify-between px-4 py-4 border-t border-gray-200 bg-gray-50 text-sm text-gray-600">
      <div>
        Showing 
        <%= @order_entries.offset_value + 1 %> -
        <%= [@order_entries.offset_value + @order_entries.length, @order_entries.total_entries].min %>
        of <%= @order_entries.total_entries %> results
      </div>
      <div class="flex items-center space-x-1">
        <%= will_paginate @order_entries, renderer: PaginationRenderer, previous_label: "&laquo;".html_safe, next_label: "&raquo;".html_safe, container: false %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener("turbo:load", function () {
  const topScroll = document.getElementById("topScroll");
  const bottomScroll = document.getElementById("bottomScroll");
  const scrollWidth = document.getElementById("scrollWidth");

  function syncWidth() {
    if (scrollWidth && bottomScroll) {
      scrollWidth.style.width = bottomScroll.scrollWidth + "px";
    }
  }

  if (topScroll && bottomScroll && scrollWidth) {
    syncWidth();

    topScroll.addEventListener("scroll", () => {
      bottomScroll.scrollLeft = topScroll.scrollLeft;
    });
    bottomScroll.addEventListener("scroll", () => {
      topScroll.scrollLeft = bottomScroll.scrollLeft;
    });

    window.addEventListener("resize", syncWidth);
  }

  const cartIconWrapper = document.getElementById("cartIconWrapper");
  const cartModal = document.getElementById("cartModal");
  const closeCartModal = document.getElementById("closeCartModal");
  const cartOrderList = document.getElementById("cartOrderList");
  const hiddenFieldsContainer = document.getElementById("hiddenFieldsContainer");
  const selectAll = document.getElementById("selectAll");
  const cartError = document.getElementById("cartError"); 

  let selectedOrders = JSON.parse(localStorage.getItem("selectedOrders")) || [];

  function saveSelection() {
    localStorage.setItem("selectedOrders", JSON.stringify(selectedOrders));
  }

  function updateCart() {
    const cartCount = document.getElementById("cartCount");
    if (cartCount) cartCount.textContent = selectedOrders.length;
    saveSelection();
  }

  document.addEventListener("change", function (e) {
    if (e.target.matches(".order-checkbox")) {
      const id = e.target.value;
      const orderNo = e.target.dataset.orderNo;

      if (e.target.checked) {
        if (!selectedOrders.some(o => o.id === id)) {
          selectedOrders.push({ id: id, orderNo: orderNo });
        }
      } else {
        selectedOrders = selectedOrders.filter(o => o.id !== id);
      }
      updateCart();
    }

    if (e.target === selectAll) {
      const checkboxes = document.querySelectorAll(".order-checkbox");
      selectedOrders = [];
      checkboxes.forEach(cb => {
        cb.checked = selectAll.checked;
        if (selectAll.checked) {
          selectedOrders.push({ id: cb.value, orderNo: cb.dataset.orderNo });
        }
      });
      updateCart();
    }
  });

  function restoreSelection() {
    const checkboxes = document.querySelectorAll(".order-checkbox");
    checkboxes.forEach(cb => {
      if (selectedOrders.some(o => o.id === cb.value)) cb.checked = true;
    });
    if (selectAll) selectAll.checked = checkboxes.length && [...checkboxes].every(cb => cb.checked);
    updateCart();
  }
  restoreSelection();

  cartIconWrapper.addEventListener("click", function (e) {
    if (e.target.id === "closeCartModal") return;

    cartOrderList.innerHTML = "";
    hiddenFieldsContainer.innerHTML = "";
    if (cartError) cartError.textContent = ""; 

    selectedOrders.forEach(order => {
      let li = document.createElement("li");
      li.textContent = `Order No: ${order.orderNo}`;
      cartOrderList.appendChild(li);

      ["order_entry_id", "order_no", "quantity"].forEach((field, i) => {
        let input = document.createElement("input");
        input.type = "hidden";
        input.name = `dispatch[dispatch_items_attributes][][${field}]`;
        input.value = i === 2 ? 1 : (field === "order_entry_id" ? order.id : order.orderNo);
        hiddenFieldsContainer.appendChild(input);
      });
    });

    cartModal.classList.remove("hidden");
    cartModal.classList.remove("opacity-0", "scale-95");
  });

  closeCartModal.addEventListener("click", function () {
    cartModal.classList.add("opacity-0", "scale-95");
    cartModal.classList.add("hidden");
  });

  document.addEventListener("turbo:submit-end", function (event) {
    if (event.target.closest("#cartModal form")) {
      selectedOrders = [];
      localStorage.removeItem("selectedOrders");

      document.querySelectorAll(".order-checkbox").forEach(cb => cb.checked = false);
      if (selectAll) selectAll.checked = false;

      updateCart();
      cartOrderList.innerHTML = "";
      hiddenFieldsContainer.innerHTML = "";

      cartModal.classList.add("opacity-0", "scale-95");
      cartModal.classList.add("hidden");
    }
  });

  const reportButton = document.getElementById("reportButton");
  if (reportButton) {
    reportButton.addEventListener("click", function () {
      if (selectedOrders.length === 0) {
        alert("Please select at least one order for report.");
        return;
      }

      const ids = selectedOrders.map(o => o.id).join(",");
      const url = `/reports?order_ids=${ids}`;
      window.open(url, "_blank");
    });
  }

  const cartForm = document.querySelector("#cartModal form");
  if (cartForm) {
    cartForm.addEventListener("submit", function (e) {
      let invalidOrders = [];

      selectedOrders.forEach(order => {
        let row = document.querySelector(`tr[data-order-id='${order.id}']`);
        if (row) {
          let dispatchCell = row.querySelector("td:nth-child(6)");
          if (dispatchCell && dispatchCell.textContent.trim() !== "-" && dispatchCell.textContent.trim() !== "") {
            invalidOrders.push(order.orderNo);
          }
        }
      });

      if (invalidOrders.length > 0) {
        e.preventDefault();
        if (cartError) {
          cartError.textContent = "Dispatch already exists for these orders: " + invalidOrders.join(", ");
          cartError.classList.remove("hidden");
        }
      }
    });
  }
});
</script>
