<% content_for(:title, "Order Management") %>
<%= link_to order_entries_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300 w-22 mt-5" do %>
  <i class="fa-solid fa-arrow-left"></i>
  <span class="font-bold">Back</span>
<% end %>
<% if @order_entry&.errors&.any? %>
  <div class="fixed top-4 right-4 bg-red-500 text-white px-6 py-4 rounded-lg shadow-lg z-50 max-w-md animate-pulse">
    <div class="flex items-start justify-between">
      <div>
        <div class="flex items-center">
          <i class="fa-solid fa-exclamation-triangle mr-2"></i>
          <strong>Error!</strong>
        </div>
        <div class="mt-2 text-sm">
          <% @order_entry.errors.full_messages.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      </div>
      <button type="button" onclick="this.parentElement.parentElement.remove()" class="ml-4 text-white hover:text-gray-200 text-2xl cursor-pointer">
        ×
      </button>
    </div>
  </div>
<% end %>
<div class="min-h-screen bg-gray-50 py-4 mt-5">
  <div class="bg-white p-8 rounded-2xl shadow-xl max-w-full mx-auto">
    <h2 class="text-3xl font-bold text-center mb-8 text-gray-800">New Order</h2>
    
    <%= form_with model: @order_entry, id: "order-form", local: true do |f| %>
      <!-- Row 1 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <%= f.label :order_no, "Order Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :order_no, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>

        <div class="relative mb-6">
  <label for="articleSearchInput" class="block text-sm font-medium text-gray-700 mb-1">Article Number</label>
      <div class="relative">
      <input type="text"
      name="order_entry[article_no]"
      id="articleSearchInput"
      onkeyup="filterDropdown()"
      placeholder="Search articles..."
      class="required-field w-full px-4 py-2 border border-gray-300 rounded-lg pr-10" />

        <button type="button"
        id="clearArticleBtn"
        onclick="clearSelectedArticle()"
        class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-red-500 text-sm hidden cursor-pointer">
        ✕
      </button>
    </div>
  <div id="articleDropdownList"
    class="absolute z-10 w-full bg-white border border-gray-300 rounded-lg mt-1 max-h-60 overflow-auto hidden">
    <% @item_masters.each do |item| %>
      <div 
        class="px-4 py-2 cursor-pointer hover:bg-gray-100"
        onclick="selectArticle(this)"
        data-article="<%= item.article_number %>"
        data-sku="<%= item.sku_id %>"
        data-fuse="<%= item.fuse_type&.name %>"
        data-loop="<%= item.loop&.name %>"
        data-item-type="<%= item.item_type&.name %>"
        data-profile="<%= item.profile&.name %>"
        data-wattage="<%= item.wattage&.name %>"
        data-voltage="<%= item.voltage&.name %>"
        data-length="<%= item.length&.name %>"
        data-cct="<%= item.cct&.name %>"
        data-cover-type="<%= item.cover_type&.name %>"
        data-extra="<%= item.extra&.name %>">
        <%= item.article_number %>
      </div>
    <% end %>
  </div>

  <input type="hidden" name="order_entry[article_no]" id="selectedArticle">
</div>

        <div>
          <%= f.label :target_date, "Target Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :target_date, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>
      </div>

      <!-- Row 2 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
        <div>
          <%= f.label :qty, "Quantity", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :qty, class: " w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>
        <%= hidden_field_tag 'order_entry[sku_number]', '', id: 'sku_id_field' %>

        <div class="relative mb-6">
        <label for="skuSearchInput" class="block text-sm font-medium text-gray-700 mb-1">Search by SKU ID</label>
        <div class="relative">
        <input type="text"
        name="order_entry[sku_number]"
        id="skuSearchInput"
        onkeyup="filterSkuDropdown()"
        placeholder="Search SKU IDs..."
        class="w-full px-4 py-2 border border-gray-300 rounded-lg pr-10" />
 
          <button type="button"
            id="clearSkuBtn"
            onclick="clearSelectedSku()"
            class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-red-500 text-sm hidden cursor-pointer">
            ✕
          </button>
        </div>
      
        <div id="skuDropdownList"
          class="absolute z-10 w-full bg-white border border-gray-300 rounded-lg mt-1 max-h-60 overflow-auto hidden">
          <% @item_masters.each do |item| %>
            <div 
              class="px-4 py-2 cursor-pointer hover:bg-gray-100"
              onclick="selectSku(this)"
              data-sku="<%= item.sku_id %>">
              <%= item.sku_id %>
            </div>
          <% end %>
        </div>
      </div>
        <div>
          <%= f.label :remark, "Remark", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :remark, class: " w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>
        
        <!--  <%= f.label :ship_to_location, "Ship To Location", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :ship_to_location, class: " w-full border border-gray-300 rounded-lg px-4 py-2" %> --!>
      </div>

      <!-- Row 3 (Client + Add New) -->
         <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

    <div>
     <%= render partial: "uploads/client_dropdown", locals: { selected_client_id: @order_entry.client_id, show_form: false, errors: [] } %>
    </div>
      <div>
    <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 mb-1 mt-6" %>
    <%= f.text_field :status, class: " w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>
          <div>
          <%= render partial: "uploads/location_dropdown", locals: { selected_location_id: @order_entry.location_id, show_form: false, errors: [] } %>
          </div>
         </div>
      <!-- Row 3: Autofill fields from Article Number -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
       <div>
    <%= f.label :fuse_type, "Fuse Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :fuse_type, class: " w-full border border-gray-300 rounded-lg px-4 py-2", id: "fuse_type_field" %>
  </div>

  <div>
    <%= f.label :loop, "Loop", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :loop, class: " w-full border border-gray-300 rounded-lg px-4 py-2", id: "loop_field" %>
  </div>

  <div>
    <%= f.label :item_type, "Item Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :item_type, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "item_type_field" %>
  </div>

  <div>
    <%= f.label :profile, "Profile", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :profile, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "profile_field" %>
  </div>

  <div>
    <%= f.label :wattage, "Wattage", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :wattage, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "wattage_field" %>
  </div>

  <div>
    <%= f.label :voltage, "Voltage", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :voltage, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "voltage_field" %>
  </div>

  <div>
    <%= f.label :length, "Length", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :length, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "length_field" %>
  </div>

  <div>
    <%= f.label :cct, "CCT", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :cct, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "cct_field" %>
  </div>

  <div>
    <%= f.label :cover_type, "Cover Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :cover_type, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "cover_type_field" %>
  </div>
   <div>
    <%= f.label :extra, "Extra", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :extra, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "extra_field" %>
  </div>
     <div>
<%= f.label :generate_sno, "Generate SNO.", class: "block text-sm font-medium text-gray-700 mb-1" %>
<%= f.select :generate_sno, [["Yes", true], ["No", false]], { prompt: "Select Option" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>

  </div>


      </div>
      
      <!-- Submit Button -->
   <div class="mt-10 flex justify-end">
  <%= f.submit "Create Order", class: "bg-blue-600 text-white w-64 py-3 rounded-lg text-lg font-semibold hover:bg-blue-700 shadow cursor-pointer" %>
</div>
    <% end %>
  </div>
</div>


<script>
 
  document.addEventListener("turbo:load", function () {
    const articleInput = document.querySelector("#order_entry_article_no");
  
    articleInput.addEventListener("input", function () {
      const articleNumber = articleInput.value.trim();
      if (articleNumber === "") return;
  
      fetch(`/item_masters/fetch_by_article?article_number=${articleNumber}`)
        .then(response => {
          if (!response.ok) throw new Error("Not found");
          return response.json();
        })
        .then(data => {
          document.getElementById("fuse_type_field").value = data.fuse_type || "";
          document.getElementById("loop_field").value = data.loop || "";
          document.getElementById("item_type_field").value = data.item_type || "";
          document.getElementById("profile_field").value = data.profile || "";
          document.getElementById("wattage_field").value = data.wattage || "";
          document.getElementById("voltage_field").value = data.voltage || "";
          document.getElementById("length_field").value = data.length || "";
          document.getElementById("cct_field").value = data.cct || "";
          document.getElementById("cover_type_field").value = data.cover_type || "";
          document.getElementById("extra_field").value = data.extra || "";
          const skuSelect = document.querySelector('select[name="order_entry[sku_number]"]');
          if (skuSelect && data.sku_id) {
            for (const option of skuSelect.options) {
              option.selected = option.value === data.sku_id;
            }
          }
        })
        .catch(() => {
          console.warn("Article not found in Item Master");
        });
    });
  });
  function submitNewStatus() {
    const name = document.getElementById('new_status_name').value;

    fetch("/statuses", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
      },
      body: JSON.stringify({ status: { name: name } })
    })
    .then(response => response.json())
    .then(data => {
      if (data.id) {
        const select = document.querySelector("select[name='order_entry[status_id]']");
        const option = document.createElement("option");
        option.value = data.id;
        option.text = data.name;
        option.selected = true;
        select.appendChild(option);
        document.getElementById('new_status_name').value = "";
        document.getElementById('newStatusForm').classList.add('hidden');
        document.getElementById('status-errors').innerText = "";
      } else if (data.errors) {
        document.getElementById('status-errors').innerText = data.errors.join(", ");
      }
    });
  }
  function filterDropdown() {
    const input = document.getElementById("articleSearchInput");
    const filter = input.value.toLowerCase();
    const dropdown = document.getElementById("articleDropdownList");
    const items = dropdown.getElementsByTagName("div");

    dropdown.classList.remove("hidden");

    for (let i = 0; i < items.length; i++) {
      const txtValue = items[i].textContent || items[i].innerText;
      items[i].style.display = txtValue.toLowerCase().includes(filter) ? "" : "none";
    }
  }

  function selectArticle(value) {
    document.getElementById("articleSearchInput").value = value;
    document.getElementById("selectedArticle").value = value;
    document.getElementById("articleDropdownList").classList.add("hidden");
  }

  // Optional: Close dropdown if clicked outside
  document.addEventListener('click', function (e) {
    const dropdown = document.getElementById("articleDropdownList");
    const input = document.getElementById("articleSearchInput");

    if (!input.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.add("hidden");
    }
  });
  function filterDropdown() {
  const input = document.getElementById("articleSearchInput").value.toLowerCase();
  const dropdown = document.getElementById("articleDropdownList");
  dropdown.classList.remove("hidden");

  const items = dropdown.querySelectorAll("div");
  items.forEach(item => {
    item.style.display = item.dataset.article.toLowerCase().includes(input) ? "block" : "none";
  });
}

function selectArticle(el) {
  document.getElementById("articleSearchInput").value = el.dataset.article;
  document.getElementById("selectedArticle").value = el.dataset.article;

  document.getElementById("skuSearchInput").value = el.dataset.sku;
  document.getElementById("fuse_type_field").value = el.dataset.fuse;
  document.getElementById("loop_field").value = el.dataset.loop;
  document.getElementById("item_type_field").value = el.dataset.itemType;
  document.getElementById("profile_field").value = el.dataset.profile;
  document.getElementById("wattage_field").value = el.dataset.wattage;
  document.getElementById("voltage_field").value = el.dataset.voltage;
  document.getElementById("length_field").value = el.dataset.length;
  document.getElementById("cct_field").value = el.dataset.cct;
  document.getElementById("cover_type_field").value = el.dataset.coverType;
  document.getElementById("extra_field").value = el.dataset.extra;
  document.getElementById("articleDropdownList").classList.add("hidden");
  const clearBtn = document.getElementById("clearArticleBtn");
clearBtn.classList.remove("hidden");
}
document.addEventListener("turbo:load", () => {
  const form = document.getElementById("order-form");
  if (!form) return;

  form.addEventListener("submit", async (e) => {
    let isValid = true;

    // Remove previous errors
    form.querySelectorAll(".required-field").forEach((field) => {
      field.classList.remove("border-red-500");
      const next = field.nextElementSibling;
      if (next && next.classList.contains("text-red-500")) {
        next.remove();
      }
    });

    // Validate fields
   

    // Only prevent if validation fails
    if (!isValid) {
      e.preventDefault();
      return;
    }

    if (form.dataset.skipCheck === "true") {
      return;
    }

    e.preventDefault();

    const orderNo = document.getElementById("order_entry_order_no")?.value;
    const clientId = document.getElementById("client-select")?.value;
    const articleNo = document.getElementById("articleSearchInput")?.value;

    if (orderNo && clientId && articleNo) {
      try {
        const response = await fetch(`/order_entries/check_duplicate?order_no=${encodeURIComponent(orderNo)}&client_id=${encodeURIComponent(clientId)}&article_no=${encodeURIComponent(articleNo)}`);
        const data = await response.json();
        
        if (data.exists) {
          if (confirm("This order may already exist. Continue?")) {
            form.dataset.skipCheck = "true";
            form.submit();
          }
        } else {
          form.dataset.skipCheck = "true";
          form.submit();
        }
      } catch (err) {
        form.dataset.skipCheck = "true";
        form.submit();
      }
    } else {
      form.dataset.skipCheck = "true";
      form.submit();
    }
  });

});

function submitNewLocation() {
  const name = document.getElementById('new_location_name').value;

  fetch("/locations", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
      "Accept": "text/vnd.turbo-stream.html"
    },
    body: JSON.stringify({ location: { name: name } })
  })
  .then(response => response.text())
  .then(html => {
    document.getElementById("location_section").innerHTML = html;
  })
  .catch(error => {
    document.getElementById("location-errors").innerText = "Something went wrong.";
    console.error(error);
  });
}
function clearSelectedArticle() {
  document.getElementById("articleSearchInput").value = "";
  document.getElementById("selectedArticle").value = "";

  document.getElementById("sku_id_field").value = "";
  document.getElementById("fuse_type_field").value = "";
  document.getElementById("loop_field").value = "";
  document.getElementById("item_type_field").value = "";
  document.getElementById("profile_field").value = "";
  document.getElementById("wattage_field").value = "";
  document.getElementById("voltage_field").value = "";
  document.getElementById("length_field").value = "";
  document.getElementById("cct_field").value = "";
  document.getElementById("cover_type_field").value = "";
  document.getElementById("extra_field").value = "";

  document.getElementById("clearArticleBtn").classList.add("hidden");
}
function filterSkuDropdown() {
  const input = document.getElementById("skuSearchInput").value.toLowerCase();
  const dropdown = document.getElementById("skuDropdownList");
  dropdown.classList.remove("hidden");

  const items = dropdown.querySelectorAll("div");
  items.forEach(item => {
    item.style.display = item.dataset.sku.toLowerCase().includes(input) ? "block" : "none";
  });
}

function selectSku(el) {
  const sku = el.dataset.sku;
  document.getElementById("skuSearchInput").value = sku;
  document.getElementById("sku_id_field").value = sku;
  document.getElementById("skuDropdownList").classList.add("hidden");
  document.getElementById("clearSkuBtn").classList.remove("hidden");

  // Fetch and autofill fields
  fetch(`/item_masters/fetch_by_sku?sku_id=${sku}`)
    .then(response => {
      if (!response.ok) throw new Error("Not found");
      return response.json();
    })
    .then(data => {
      document.getElementById("articleSearchInput").value = data.article_number || "";
      document.getElementById("selectedArticle").value = data.article_number || "";

      document.getElementById("fuse_type_field").value = data.fuse_type || "";
      document.getElementById("loop_field").value = data.loop || "";
      document.getElementById("item_type_field").value = data.item_type || "";
      document.getElementById("profile_field").value = data.profile || "";
      document.getElementById("wattage_field").value = data.wattage || "";
      document.getElementById("voltage_field").value = data.voltage || "";
      document.getElementById("length_field").value = data.length || "";
      document.getElementById("cct_field").value = data.cct || "";
      document.getElementById("cover_type_field").value = data.cover_type || "";
      document.getElementById("extra_field").value = data.extra || "";
    })
    .catch(() => {
      console.warn("SKU not found in Item Master");
    });
}

function clearSelectedSku() {
  document.getElementById("skuSearchInput").value = "";
  document.getElementById("sku_id_field").value = "";

  document.getElementById("articleSearchInput").value = "";
  document.getElementById("selectedArticle").value = "";

  document.getElementById("fuse_type_field").value = "";
  document.getElementById("loop_field").value = "";
  document.getElementById("item_type_field").value = "";
  document.getElementById("profile_field").value = "";
  document.getElementById("wattage_field").value = "";
  document.getElementById("voltage_field").value = "";
  document.getElementById("length_field").value = "";
  document.getElementById("cct_field").value = "";
  document.getElementById("cover_type_field").value = "";
  document.getElementById("extra_field").value = "";

  document.getElementById("clearSkuBtn").classList.add("hidden");
}

</script>
