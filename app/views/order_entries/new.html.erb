<div class="max-w-5xl mx-auto mt-10 bg-white p-6 rounded-lg shadow-md">
  <h1 class="text-3xl font-semibold mb-6 text-gray-800">New Order Entry</h1>

  <!-- STEP 1: Decode Form -->
  <div class="mb-8">
    <%= form_with url: manual_decode_path, method: :post, local: true do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="md:col-span-2">
          <%= f.label :article_number, "Enter Article Number to Decode:", class: "block text-gray-700 font-medium mb-1" %>
          <%= f.text_field :article_number, value: @article_number, required: true,
                class: "w-full border border-gray-300 rounded-md px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                placeholder: "e.g. 000123456" %>
        </div>
        <div class="flex items-end">
          <%= f.submit "Decode", data: { turbo: false }, class: "w-full bg-white hover:bg-gray-100 border-2 border-gray-400 px-4 py-2 rounded-md text-black font-semibold" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- STEP 2: Full Order Entry Form -->
  <%= form_with model: @order_entry, local: true do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Standard Fields -->
      <div>
        <%= f.label :order_no, "Order Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :order_no, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :article_no, "Article Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :article_no, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <!-- Client with inline create option -->
      <turbo-frame id="client_section">
        <div class="space-y-2">
          <div class="flex justify-between items-center">
            <label class="text-sm font-medium text-gray-700">Client</label>
            <button type="button" onclick="document.getElementById('newClientForm').classList.toggle('hidden')" class="text-blue-600 text-xl font-bold">+</button>
          </div>

          <div>
            <%= f.collection_select :client_id,
                  Client.where(org_id: current_user.org_id),
                  :id, :name,
                  { include_blank: "Select Client" },
                  { class: "w-full border border-gray-300 rounded-md px-4 py-2 text-sm" } %>
          </div>

          <!-- Inline form -->
          <div id="newClientForm" class="hidden">
            <div class="flex gap-2 mt-2">
              <input id="new_client_name" type="text" placeholder="New client name" class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm" />
              <button type="button" onclick="submitNewClient()" class="bg-green-600 text-white px-4 py-2 rounded-md text-sm">Add</button>
            </div>
            <div id="client-errors" class="text-red-600 text-sm mt-1"></div>
          </div>

          <% if flash[:client_errors].present? %>
            <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
              <% flash[:client_errors].each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </turbo-frame>

      <div>
        <%= f.label :target_date, "Target Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :target_date, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :ship_to_location, "Ship To Location", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :ship_to_location, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :qty, "Quantity", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :qty, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :fuse_type, "Fuse Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :fuse_type, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :loop, "Loop", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :loop, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <!-- Decoded Fields -->
      <div>
        <%= f.label :type, "Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :ptype, value: @decoded&.type, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :profile, "Profile", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :profile, value: @decoded&.profile, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :wattage, "Wattage", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :wattage, value: @decoded&.watt, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :voltage, "Voltage", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :voltage, value: @decoded&.voltage, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :length, "Length", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :length, value: @decoded&.length, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :cct, "CCT", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :cct, value: @decoded&.cct, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :cover_type, "Cover Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :cover_type, value: @decoded&.cover, class: "w-full border border-gray-300 rounded-md px-4 py-2" %>
      </div>

      <div>
        <%= f.label :sku_number, "SKU ID", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :sku_number,
          options_for_select(@item_masters.map { |item| [item.sku_id, item.sku_id] }, f.object.sku_number),
          { include_blank: "Choose SKU" },
          class: "w-full border border-gray-300 rounded-md px-4 py-2 text-sm" %>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="mt-8">
      <%= f.submit "Create Order", class: "bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700" %>
    </div>
  <% end %>
</div>

<script>
  function submitNewClient() {
    const name = document.getElementById("new_client_name").value;

    fetch("/clients", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({ client: { name: name } })
    })
    .then(response => response.json())
    .then(data => {
      if (data.id) {
        const select = document.querySelector('select[name="order_entry[client_id]"]');
        const option = new Option(data.name, data.id, true, true);
        select.add(option);
        document.getElementById("new_client_name").value = "";
        document.getElementById("newClientForm").classList.add("hidden");
      } else if (data.errors) {
        document.getElementById("client-errors").innerText = data.errors.join(", ");
      }
    });
  }
</script>
