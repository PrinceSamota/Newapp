<%= link_to order_entries_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300 w-22 mt-5" do %>
  <i class="fa-solid fa-arrow-left"></i>
  <span class="font-bold">Back</span>
<% end %>
<div class="min-h-screen bg-gray-50 py-4 mt-5">
  <div class="bg-white p-8 rounded-2xl shadow-xl max-w-full mx-auto">
    <h2 class="text-3xl font-bold text-center mb-8 text-gray-800">New Order Entry</h2>

    <%= form_with model: @order_entry, local: true do |f| %>
      <!-- Row 1 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <%= f.label :order_no, "Order Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :order_no, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>

        <div class="relative">
  <label for="articleDropdown" class="block text-sm font-medium text-gray-700 mb-1">Article Number</label>
  
  <input type="text" id="articleSearchInput" onkeyup="filterDropdown()" placeholder="Search articles..."
    class="w-full px-4 py-2 border border-gray-300 rounded-lg" />

  <div id="articleDropdownList"
    class="absolute z-10 w-full bg-white border border-gray-300 rounded-lg mt-1 max-h-60 overflow-auto hidden">
    <% @item_articles.each do |article| %>
      <div class="px-4 py-2 cursor-pointer hover:bg-gray-100"
           onclick="selectArticle('<%= article %>')">
        <%= article %>
      </div>
    <% end %>
  </div>

  <input type="hidden" name="order_entry[article_no]" id="selectedArticle">
</div>

        <div>
          <%= f.label :target_date, "Target Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :target_date, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>
      </div>

      <!-- Row 2 -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mt-6">
        <div>
          <%= f.label :qty, "Quantity", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :qty, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>

        <div>
          <%= f.label :sku_number, "SKU ID", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :sku_number,
                options_for_select(@item_masters.map { |item| [item.sku_id, item.sku_id] }, f.object.sku_number),
                { include_blank: "Choose SKU" },
                class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm" %>
        </div>

        <div class="md:col-span-2">
          <%= f.label :ship_to_location, "Ship To Location", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :ship_to_location, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>
      </div>

      <!-- Row 3 (Client + Add New) -->
      <turbo-frame id="client_section" class="block mt-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="md:col-span-2">
            <div class="flex justify-between items-center mb-1">
              <label class="text-sm font-medium text-gray-700">Client</label>
              <button type="button" onclick="document.getElementById('newClientForm').classList.toggle('hidden')" class="text-blue-600 text-xl font-bold">+</button>
            </div>
            <%= f.collection_select :client_id,
                  Client.where(org_id: current_user.org_id),
                  :id, :name,
                  { include_blank: "Select Client" },
                  { class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm" } %>
          </div>

          <!-- Inline form -->
          <div class="md:col-span-1">
            <div id="newClientForm" class="hidden">
              <div class="flex gap-2">
                <input id="new_client_name" type="text" placeholder="New client name" class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm" />
                <button type="button" onclick="submitNewClient()" class="bg-green-600 text-white px-4 py-2 rounded-md text-sm">Add</button>
              </div>
              <div id="client-errors" class="text-red-600 text-sm mt-1"></div>
            </div>

            <% if flash[:client_errors].present? %>
              <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
                <% flash[:client_errors].each do |msg| %>
                  <li><%= msg %></li>
                <% end %>
              </ul>
            <% end %>
          </div>
        </div>
      </turbo-frame>
      <turbo-frame id="status_section" class="block mt-6">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="md:col-span-2">
      <div class="flex justify-between items-center mb-1">
        <label class="text-sm font-medium text-gray-700">Status</label>
        <button type="button" onclick="document.getElementById('newStatusForm').classList.toggle('hidden')" class="text-blue-600 text-xl font-bold">+</button>
      </div>
      <%= f.collection_select :status_id,
            Status.where(org_id: current_user.org_id),
            :id, :name,
            { include_blank: "Select Status" },
            { class: "w-full border border-gray-300 rounded-lg px-4 py-2 text-sm" } %>
    </div>

    <!-- Inline form -->
    <div class="md:col-span-1">
      <div id="newStatusForm" class="hidden">
        <div class="flex gap-2">
          <input id="new_status_name" type="text" placeholder="New status name" class="flex-1 rounded-md border border-gray-300 px-3 py-2 text-sm" />
          <button type="button" onclick="submitNewStatus()" class="bg-green-600 text-white px-4 py-2 rounded-md text-sm">Add</button>
        </div>
        <div id="status-errors" class="text-red-600 text-sm mt-1"></div>
      </div>

      <% if flash[:status_errors].present? %>
        <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
          <% flash[:status_errors].each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</turbo-frame>

      <!-- Row 3: Autofill fields from Article Number -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
      
        <div>
          <%= f.label :fuse_type, "Fuse Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :fuse_type, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "fuse_type_field" %>
        </div>
      
        <div>
          <%= f.label :loop, "Loop", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :loop, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "loop_field" %>
        </div>
      
        <div>
          <%= f.label :item_type, "Item Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :item_type, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "item_type_field" %>
        </div>
      
        <div>
          <%= f.label :profile, "Profile", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :profile, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "profile_field" %>
        </div>
      
        <div>
          <%= f.label :wattage, "Wattage", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :wattage, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "wattage_field" %>
        </div>
      
        <div>
          <%= f.label :voltage, "Voltage", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :voltage, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "voltage_field" %>
        </div>
      
        <div>
          <%= f.label :length, "Length", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :length, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "length_field" %>
        </div>
      
        <div>
          <%= f.label :cct, "CCT", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :cct, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "cct_field" %>
        </div>
      
        <div>
          <%= f.label :cover_type, "Cover Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :cover_type, class: "w-full border border-gray-300 rounded-lg px-4 py-2", id: "cover_type_field" %>
        </div>
      
      </div>
      
      <!-- Submit Button -->
   <div class="mt-10 flex justify-end">
  <%= f.submit "Create Order", class: "bg-blue-600 text-white w-64 py-3 rounded-lg text-lg font-semibold hover:bg-blue-700 shadow" %>
</div>
    <% end %>
  </div>
</div>


<script>
  function submitNewClient() {
    const name = document.getElementById("new_client_name").value;

    fetch("/clients", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({ client: { name: name } })
    })
    .then(response => response.json())
    .then(data => {
      if (data.id) {
        const select = document.querySelector('select[name="order_entry[client_id]"]');
        const option = new Option(data.name, data.id, true, true);
        select.add(option);
        document.getElementById("new_client_name").value = "";
        document.getElementById("newClientForm").classList.add("hidden");
      } else if (data.errors) {
        document.getElementById("client-errors").innerText = data.errors.join(", ");
      }
    });
  }
  document.addEventListener("turbo:load", function () {
    const articleInput = document.querySelector("#order_entry_article_no");
  
    articleInput.addEventListener("input", function () {
      const articleNumber = articleInput.value.trim();
      if (articleNumber === "") return;
  
      fetch(`/item_masters/fetch_by_article?article_number=${articleNumber}`)
        .then(response => {
          if (!response.ok) throw new Error("Not found");
          return response.json();
        })
        .then(data => {
          document.getElementById("fuse_type_field").value = data.fuse_type || "";
          document.getElementById("loop_field").value = data.loop || "";
          document.getElementById("item_type_field").value = data.item_type || "";
          document.getElementById("profile_field").value = data.profile || "";
          document.getElementById("wattage_field").value = data.wattage || "";
          document.getElementById("voltage_field").value = data.voltage || "";
          document.getElementById("length_field").value = data.length || "";
          document.getElementById("cct_field").value = data.cct || "";
          document.getElementById("cover_type_field").value = data.cover_type || "";
          const skuSelect = document.querySelector('select[name="order_entry[sku_number]"]');
          if (skuSelect && data.sku_id) {
            for (const option of skuSelect.options) {
              option.selected = option.value === data.sku_id;
            }
          }
        })
        .catch(() => {
          console.warn("Article not found in Item Master");
        });
    });
  });
  function submitNewStatus() {
    const name = document.getElementById('new_status_name').value;

    fetch("/statuses", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content
      },
      body: JSON.stringify({ status: { name: name } })
    })
    .then(response => response.json())
    .then(data => {
      if (data.id) {
        const select = document.querySelector("select[name='order_entry[status_id]']");
        const option = document.createElement("option");
        option.value = data.id;
        option.text = data.name;
        option.selected = true;
        select.appendChild(option);
        document.getElementById('new_status_name').value = "";
        document.getElementById('newStatusForm').classList.add('hidden');
        document.getElementById('status-errors').innerText = "";
      } else if (data.errors) {
        document.getElementById('status-errors').innerText = data.errors.join(", ");
      }
    });
  }
  function filterDropdown() {
    const input = document.getElementById("articleSearchInput");
    const filter = input.value.toLowerCase();
    const dropdown = document.getElementById("articleDropdownList");
    const items = dropdown.getElementsByTagName("div");

    dropdown.classList.remove("hidden");

    for (let i = 0; i < items.length; i++) {
      const txtValue = items[i].textContent || items[i].innerText;
      items[i].style.display = txtValue.toLowerCase().includes(filter) ? "" : "none";
    }
  }

  function selectArticle(value) {
    document.getElementById("articleSearchInput").value = value;
    document.getElementById("selectedArticle").value = value;
    document.getElementById("articleDropdownList").classList.add("hidden");
  }

  // Optional: Close dropdown if clicked outside
  document.addEventListener('click', function (e) {
    const dropdown = document.getElementById("articleDropdownList");
    const input = document.getElementById("articleSearchInput");

    if (!input.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.add("hidden");
    }
  });
</script>
