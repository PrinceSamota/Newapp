<% content_for(:title, "Generated QR Links") %>

<div class="max-w-4xl mx-auto mt-10 bg-white border border-gray-100 rounded-2xl shadow-xl p-8 space-y-6">
  
  <!-- Header -->
  <div class="flex justify-between items-center pb-5 border-b border-gray-100">
    <div>
      <h2 class="text-2xl font-bold text-gray-800">Generated QR Links</h2>
      <p class="text-sm text-gray-500 mt-1">Order No: <span class="font-semibold text-gray-700"><%= @order_entry.order_no %></span> | SKU: <span class="font-semibold text-gray-700"><%= @order_entry.sku_number %></span></p>
    </div>
    <%= link_to order_entry_path(@order_entry), class: "inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-blue-600 hover:bg-blue-50 border border-gray-200 rounded-xl px-4 py-2 transition duration-200" do %>
      <i class="fa-solid fa-arrow-left"></i>
      <span>Back to Order</span>
    <% end %>
  </div>

  <% if @links.any? %>
    <div class="space-y-6 max-h-[600px] overflow-y-auto pr-2">
      <% @links.each_with_index do |group, index| %>
        <div class="bg-gray-50 border border-gray-200/60 rounded-2xl p-5 hover:border-blue-200 hover:shadow-md transition duration-200 space-y-4">
          
          <!-- Parent Section -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 bg-white p-4 border border-gray-100 rounded-xl shadow-sm">
            <div class="flex items-center gap-3">
              <span class="inline-flex items-center justify-center bg-blue-100 text-blue-700 p-2 rounded-lg text-xs font-bold uppercase tracking-wider">
                Parent
              </span>
              <a href="<%= group[:parent][:url] %>" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 hover:underline font-mono text-sm font-semibold break-all">
                <%= group[:parent][:url] %>
              </a>
            </div>
            
            <div class="flex items-center gap-4 self-end md:self-auto">
              <div class="text-right">
                <span class="text-[10px] uppercase font-bold tracking-wider text-gray-400 block">Parent Article</span>
                <span class="text-sm font-mono font-bold text-gray-700 bg-gray-100 px-2 py-0.5 rounded border border-gray-200"><%= group[:parent][:article_no] %></span>
              </div>
              
              <button onclick="navigator.clipboard.writeText('<%= group[:parent][:url] %>')" class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-600 hover:text-blue-600 bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-200 rounded-lg px-3 py-2 transition duration-150 flex-shrink-0" title="Copy parent link">
                <i class="fa-solid fa-copy"></i> Copy
              </button>
            </div>
          </div>

          <!-- Component/Children Section -->
          <% if group[:children].any? %>
            <div class="pl-4 md:pl-6 border-l-2 border-gray-200 space-y-3">
              <p class="text-xs uppercase font-bold tracking-wider text-gray-400 mb-2">Child Component Links</p>
              <% group[:children].each do |child| %>
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 bg-white p-3.5 border border-gray-100 rounded-xl hover:border-gray-200 transition duration-150">
                  <div class="flex items-center gap-3">
                    <span class="text-xs font-bold font-mono text-gray-500 bg-gray-100 px-2 py-1 rounded">
                      <%= child[:sno].split('_').last %>
                    </span>
                    <a href="<%= child[:url] %>" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 hover:underline font-mono text-sm break-all">
                      <%= child[:url] %>
                    </a>
                  </div>
                  
                  <div class="flex items-center gap-4 self-end md:self-auto">
                    <div class="text-right">
                      <span class="text-[10px] uppercase font-bold tracking-wider text-gray-400 block">Article No</span>
                      <span class="text-xs font-mono font-bold text-gray-600 bg-gray-100 px-2.5 py-1 rounded border border-gray-200"><%= child[:article_no] %></span>
                    </div>

                    <button onclick="navigator.clipboard.writeText('<%= child[:url] %>')" class="inline-flex items-center gap-1.5 text-xs font-bold text-gray-600 hover:text-blue-600 bg-gray-50 hover:bg-blue-50 border border-gray-200 hover:border-blue-200 rounded-lg px-3 py-2 transition duration-150 flex-shrink-0" title="Copy child link">
                      <i class="fa-solid fa-copy"></i> Copy
                    </button>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

        </div>
      <% end %>
    </div>

    <div class="mt-6 pt-5 border-t border-gray-100 flex justify-end">
      <button onclick="copyAllLinks()" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition duration-200 cursor-pointer">
        Copy All Links
      </button>
    </div>
  <% else %>
    <div class="bg-yellow-50 border border-yellow-100 text-yellow-800 p-5 rounded-2xl">
      <div class="flex gap-3">
        <i class="fa-solid fa-triangle-exclamation text-xl mt-0.5"></i>
        <div>
          <p class="font-bold">No links generated</p>
          <p class="text-sm mt-1 text-yellow-700">Please make sure starting and ending serial numbers are present on the order.</p>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  function copyAllLinks() {
    const links = [];
    <% @links.each do |group| %>
      links.push("<%= group[:parent][:url] %>");
      <% group[:children].each do |child| %>
        links.push("<%= child[:url] %>");
      <% end %>
    <% end %>
    
    navigator.clipboard.writeText(links.join("\n")).then(() => {
      alert("All links copied to clipboard!");
    });
  }
</script>
