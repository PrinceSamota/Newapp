<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/tom-select/dist/css/tom-select.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select/dist/js/tom-select.complete.min.js"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
      <%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" %>
      <style>
  .ts-control {
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
  .ts-control input {
    padding: 0 !important;
    margin: 0 !important;
  }
</style>

  </head>

  <body class="bg-gray-100">
  <p class="notice"><%#= notice %></p>
  <p class="alert"><%#= alert %></p>



  <!-- Main Layout (fills remaining screen height after header) -->
  <div class="flex flex-col h-screen bg-[#e5e1dc]">

  <!-- Header (always on top) -->
  <header class="bg-white text-white h-18 border-b border-gray-200">
    <div class="mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-18">
        <!-- Logo -->
        <div class="flex items-center">
          <!-- Add logo if needed -->
        </div>

        <!-- Right Navigation -->
        <div class="flex items-center space-x-4">
          <% if user_signed_in? %>
            <!-- User Profile Dropdown -->
            <div class="relative">
              <button id="userMenuButton" class="flex items-center space-x-2 p-2 rounded-full hover:bg-gray-100 transition cursor-pointer">
                <div class="w-8 h-8 bg-gray-300 rounded-full flex items-center justify-center">
                  <i class="fas fa-user text-gray-600"></i>
                </div>
              </button>
              
              <!-- Dropdown Menu -->
              <div id="userDropdown" class="hidden absolute right-2 mt-2 w-64 bg-white rounded-md shadow-lg border border-gray-200 z-50">
                <div class="py-2">
                  <div class="px-4 py-3 border-b border-gray-200">
                    <p class="text-sm font-medium text-black">Hi, <%= current_user.name %></p>
                    <p class="text-xs text-gray-500"><%= current_user.email %></p>
                  </div>
                  <%= link_to "/users/#{current_user.id}/edit", class: "flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-gray-100" do %>
                    <i class="fas fa-edit w-4 mr-2"></i>
                    Edit Profile
                  <% end %>
                  <a href="#" class="flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-gray-100">
                    <i class="fas fa-headset w-4 mr-2"></i>
                    Support
                  </a>
                  <a href="#" class="flex items-center px-4 py-3 text-sm text-gray-700 hover:bg-gray-100">
                    <i class="fas fa-cog w-4 mr-2"></i>
                    Other
                  </a>
                  <div class="border-t border-gray-200">
                    <%= button_to destroy_user_session_path, method: :delete, 
                          class: "flex items-center w-full px-4 py-3 text-sm text-red-600 hover:bg-red-50 transition",
                          form: { class: "w-full" } do %>
                      <i class="fas fa-sign-out-alt w-4 mr-2"></i>
                      Logout
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% else %>
            <%= link_to "Login", new_user_session_path,
                  class: " px-4 py-1 text-black font-bold transition cursor-pointer" %>
          <% end %>
        </div>
      </div>
    </div>
  </header>

  <!-- Body: Sidebar + Main Content -->
  <div class="flex flex-1 overflow-hidden">
    
  <% if user_signed_in? %>
  <!-- Sidebar -->
  <div id="sidebar" class="bg-white w-64 fixed h-screen border-r border-gray-200 shadow-md transition-all duration-300 ease-in-out flex flex-col z-50">
    <!-- Toggle Button -->
    <div id="sidebarToggleWrapper" class="flex justify-end px-4 py-2 transition-all duration-300">
  <button id="toggleSidebar" class="text-gray-600 hover:text-gray-800 focus:outline-none cursor-pointer">
    <i class="fas fa-bars"></i>
  </button>
</div>

    <!-- Links -->
    <div class="space-y-2 px-4 mt-4">
      <% sidebar_links = [
        { name: "Item Master", path: item_masters_path, icon: "fa-box" },
        { name: "Raw Material Inward Stock", path: raw_material_stock_batches_path, icon: "fa-dolly" },
        { name: "Bill of Material", path: bill_of_materials_path, icon: "fa-list-alt" },
        { name: "Production Order", path: production_orders_path, icon: "fa-industry" },
        { name: "Order Management", path: order_entries_path, icon: "fa-file-invoice" },
        { name: "Dispatch Management", path: dispatches_path, icon: "fa-truck" },
        { name: "Report Management", path: new_order_report_reports_path, icon: "fa-file-excel" }
      ] %>

      <% sidebar_links.each do |link| %>
        <% active = current_page?(link[:path]) ? "bg-blue-100 text-blue-700 font-semibold" : "text-black" %>
        <%= link_to link[:path], class: "flex items-center gap-4 rounded-md p-2 w-full hover:bg-gray-200 transition #{active}" do %>
          <i class="fas <%= link[:icon] %> w-5 text-center"></i>
          <span class="sidebar-label"><%= link[:name] %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

  
    <!-- Main content area -->
    <main id="mainContent" class="flex-1 overflow-auto bg-[#f9fafb] ml-64 transition-all duration-300">
    <%= yield %>
  </main>
  </div>
            
</div>

</html>
<script>
document.addEventListener("turbo:load", function () {
  const sidebar = document.getElementById("sidebar");
  const toggleBtn = document.getElementById("toggleSidebar");
  const mainContent = document.getElementById("mainContent");
  const toggleWrapper = document.getElementById("sidebarToggleWrapper");

  if (toggleBtn) {
    toggleBtn.replaceWith(toggleBtn.cloneNode(true));
    const newToggleBtn = document.getElementById("toggleSidebar");

    function collapseSidebar() {
      sidebar.classList.remove("w-64");
      sidebar.classList.add("w-16");
      mainContent.classList.remove("ml-64");
      mainContent.classList.add("ml-16");
      toggleWrapper.classList.remove("justify-end");
      toggleWrapper.classList.add("justify-center");
      document.querySelectorAll(".sidebar-label").forEach(el => el.classList.add("hidden"));
    }

    function expandSidebar() {
      sidebar.classList.remove("w-16");
      sidebar.classList.add("w-64");
      mainContent.classList.remove("ml-16");
      mainContent.classList.add("ml-64");
      toggleWrapper.classList.remove("justify-center");
      toggleWrapper.classList.add("justify-end");
      document.querySelectorAll(".sidebar-label").forEach(el => el.classList.remove("hidden"));
    }

    collapseSidebar();

    newToggleBtn.addEventListener("click", () => {
      const isCollapsed = sidebar.classList.contains("w-16");
      if (isCollapsed) {
        expandSidebar();
      } else {
        collapseSidebar();
      }
    });

    document.querySelectorAll("#sidebar a").forEach(link => {
      link.addEventListener("click", () => {
        collapseSidebar();
      });
    });
  }

  const userMenuButton = document.getElementById("userMenuButton");
  const userDropdown = document.getElementById("userDropdown");

  if (userMenuButton && userDropdown) {
    userMenuButton.addEventListener("click", (e) => {
      e.stopPropagation();
      userDropdown.classList.toggle("hidden");
    });

    document.addEventListener("click", (e) => {
      if (!userMenuButton.contains(e.target) && !userDropdown.contains(e.target)) {
        userDropdown.classList.add("hidden");
      }
    });
  }
});
</script>
