<% content_for(:title, "Item Master") %>
<div class="flex items-center justify-between mb-4">
  <%= link_to root_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300" do %>
    <i class="fa-solid fa-arrow-left"></i>
    <span class="font-bold">Back</span>
  <% end %>
  <h2 class="text-xl font-semibold">
    <%= link_to @item_master.sku_id, edit_item_master_path(@item_master), class: "text-blue-600 hover:underline" %>
  </h2>
  <h2 class="text-xl font-semibold">
    <%= @item_master.item_name %> - History
  </h2>
</div>
<% if flash[:notice].present? %>
  <div 
    id="flash-message" 
    class="fixed top-6 right-6 z-50 max-w-sm w-full bg-green-100 border border-green-400 text-green-800 rounded-xl shadow-lg p-4 flex items-start gap-3 transition-all duration-300 transform animate-slide-in"
  >
    <div class="flex-1 text-sm font-medium">
      <%= flash[:notice] %>
    </div>
  </div>
<% elsif flash[:alert].present? %>
  <div 
    id="flash-message" 
    class="fixed top-6 right-6 z-50 max-w-sm w-full bg-red-100 border border-red-400 text-red-800 rounded-xl shadow-lg p-4 flex items-start gap-3 transition-all duration-300 transform animate-slide-in"
  >
    <div class="flex-1 text-sm font-medium">
      <%= flash[:alert] %>
    </div>
  </div>
<% end %>

<div class="mb-6 bg-white p-4 rounded-lg shadow border border-gray-200">
  <%= form_with url: update_stock_item_master_path(@item_master), method: :patch, local: true do |f| %>
    <div class="flex flex-col md:flex-row md:items-end gap-4">

      <!-- Stock Value -->
      <div class="flex-1">
        <%= f.label :stock_value, "Stock", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :stock_value, step: 1, placeholder: "Quantity", required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
      </div>

      <!-- Reason -->
      <div class="flex-1">
        <%= f.label :comment, "Reason", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :comment, placeholder: "Reason for stock update", required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
      </div>

      <!-- Operation -->
      <div class="flex-2">
        <%= f.label :operation, "Action", class: "block text-sm font-medium text-gray-700" %>
        <div class="flex items-center gap-4 border border-gray-300 rounded-md px-3 py-2">
          <label class="flex items-center gap-1">
            <%= f.radio_button :operation, "add", checked: true, required: true, class: "text-green-600 cursor-pointer" %>
            <span>Add</span>
          </label>
          <label class="flex items-center gap-1">
            <%= f.radio_button :operation, "subtract", required: true, class: "text-red-600 cursor-pointer" %>
            <span>Subtract</span>
          </label>
        </div>
      </div>

      <!-- Submit -->
      <div class="flex-none">
        <%= f.submit "Update", class: " mt-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl text-sm cursor-pointer" %>
      </div>

    </div>
  <% end %>
</div>

<div class="mb-6 bg-white p-4 rounded-lg shadow border border-gray-200">
  <%= form_with url: update_block_stock_item_master_path(@item_master), method: :patch, local: true do |f| %>
    <div class="flex flex-col md:flex-row md:items-end gap-4">

      <!-- Block Stock Value -->
      <div class="flex-1">
        <%= f.label :block_value, "Quantity", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :block_value, step: 1, placeholder: "Enter quantity", required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
      </div>

      <!-- Reason -->
      <div class="flex-1">
        <%= f.label :comment, "Reason", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :comment, placeholder: "Reason for block/unblock", required: true, class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
      </div>

      <!-- Operation -->
      <div class="flex-2">
        <%= f.label :operation, "Action", class: "block text-sm font-medium text-gray-700" %>
        <div class="flex items-center gap-4 border border-gray-300 rounded-md px-3 py-2">
          <label class="flex items-center gap-1">
            <%= f.radio_button :operation, "block", checked: true, required: true, class: "text-yellow-600 cursor-pointer operation-radio" %>
            <span>Block Stock</span>
          </label>
          <label class="flex items-center gap-1">
            <%= f.radio_button :operation, "unblock", required: true, class: "text-green-600 cursor-pointer operation-radio" %>
            <span>Unblock Stock</span>
          </label>
        </div>
      </div>

      <!-- Submit -->
      <div class="flex-none">
        <%= f.submit "Block Stock", id: "operationSubmitBtn", class: "mt-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl text-sm cursor-pointer" %>
      </div>

    </div>
  <% end %>
</div>


<div class="overflow-x-auto rounded-lg shadow">
  <div class="overflow-hidden rounded-lg border border-gray-200">
    <table class="min-w-full text-sm bg-white">
      <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
        <tr>
          <th class="px-6 py-3 text-left">Time</th>
          <th class="px-6 py-3 text-left">Source</th>
          <th class="px-6 py-3 text-left">Reason</th>
          <th class="px-6 py-3 text-left">Before Stock</th>
          <th class="px-6 py-3 text-left">Change</th>
          <th class="px-6 py-3 text-left">After Stock</th>
          <th class="px-6 py-3 text-left">Block Stock</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @versions.each do |version| %>
          <% begin %>
          <% permitted_classes = [Time, ActiveSupport::TimeWithZone, ActiveSupport::TimeZone, BigDecimal, String, Hash, Array] %>
            <% changes = YAML.safe_load(version.object_changes || '', permitted_classes: permitted_classes, aliases: true) %>
            <% old_data = YAML.safe_load(version.object || '', permitted_classes: permitted_classes, aliases: true) %>

            <% if changes.present? && changes.is_a?(Hash) %>
              <% stock_fields = ["opening_stock", "total_inward", "inward_quantity", "received_stock", "total_outward", "outward_quantity", "used_stock"] %>
              <% stock_fields.each do |field| %>
                <% if changes[field].present? %>
                  <% old_val, new_val = changes[field] %>
                  <% next if old_val == new_val %>
                  <% diff = new_val.to_f - old_val.to_f %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                      <%= version.created_at.in_time_zone("Asia/Kolkata").strftime("%d-%m-%Y %I:%M %p") %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm">
                    <% if version.source_type == "Dispatch" %>
                    <%= link_to "Dispatch ( #{version.source_id} )",
                                edit_dispatch_path(version.source_id),
                                class: "text-red-600 underline hover:text-red-800" %>
                  <% elsif version.source_type == "ProductionOrder" %>
                    <%= link_to "Production Order ( #{version.source_id} )",
                                production_order_path(version.source_id),
                                class: "text-purple-600 underline hover:text-purple-800" %>
                  <% elsif version.source_type == "BillOfMaterial" %>
                    <%= link_to "Bill Of Material ( #{version.source_id} )",
                                bill_of_material_path(version.source_id),
                                class: "text-blue-600 underline hover:text-blue-800" %>
                  <% elsif version.source_type == "RawMaterialStockBatch" %>
                    <%= link_to "Raw Material Stock ( #{version.source_id} )",
                                raw_material_stock_batch_path(version.source_id),
                                class: "text-green-600 underline hover:text-green-800" %>
                  <% else %>
                    -
                  <% end %>                 
                  </td>                
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700">
                    <%= version.reason.presence || "-" %>
                  </td>
                    <td class="px-6 py-4 whitespace-nowrap text-gray-700 font-semibold"><%= old_val %></td>
                    <td class="px-6 py-4 whitespace-nowrap">
                      <% if diff > 0 %>
                        <span class="text-green-600 font-bold">+<%= diff %></span>
                      <% elsif diff < 0 %>
                        <span class="text-red-600 font-bold"><%= diff %></span>
                      <% else %>
                        <span>-</span>
                      <% end %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-gray-700 font-semibold"><%= new_val %></td>
                    <td class="px-6 py-4 whitespace-nowrap text-gray-700 font-semibold">
                    <% if changes["block_stock"].present? %>
                      <% old_block, new_block = changes["block_stock"] %>
                      <%= new_block %>
                    <% elsif old_data.present? && old_data["block_stock"].present? %>
                      <%= old_data["block_stock"] %>
                    <% else %>
                      0
                    <% end %>
                  </td>
                  </tr>
                <% end %>
              <% end %>
            <% end %>
          <% rescue Psych::SyntaxError, ArgumentError => e %>
            <tr>
              <td colspan="5" class="px-6 py-4 text-red-500 text-sm">YAML Error: <%= e.message %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<script>
  document.addEventListener("turbo:load", () => {
    const radios = document.querySelectorAll(".operation-radio");
    const submitBtn = document.getElementById("operationSubmitBtn");

    radios.forEach(radio => {
      radio.addEventListener("change", () => {
        if (radio.value === "block") {
          submitBtn.value = "Block Stock";
        } else {
          submitBtn.value = "Unblock Stock";
        }
      });
    });
  });
  setTimeout(() => {
    const flash = document.getElementById('flash-message');
    if (flash) {
      flash.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => flash.remove(), 400); // fade-out smooth remove
    }
  }, 4000);
</script>

<style>
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateY(-10px) translateX(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0) translateX(0);
    }
  }
  .animate-slide-in {
    animation: slide-in 0.3s ease-out;
  }
</style>