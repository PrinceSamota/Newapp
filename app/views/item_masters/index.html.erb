<div class="relative min-h-screen ">

	<!-- Body (if needed) -->
	<div class=" text-center text-gray-700">
		<div class="flex items-center justify-between mb-4">
			<!-- Add Item Master Modal -->
			<div id="itemMasterModal" class="absolute top-20 right-5 z-50 hidden bg-white border border-gray-200 rounded-2xl shadow-2xl p-6 w-full max-w-3xl transition-all duration-300">
				<div class="w-full relative">

					<!-- Close Button -->
					<button onclick="toggleItemMasterModal(false)" class="absolute top-4 right-5 text-gray-500 hover:text-red-600 text-2xl font-bold">&times;</button>

					<!-- Heading -->
					<h2 class="text-2xl font-bold text-gray-800 mb-8 text-center">Add Item Master</h2>

					<%= form_with model: ItemMaster.new, url: item_masters_path,  html: { id: "item-form" } do |f| %>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

						<!-- Item Name -->
						<div>
							<%= f.label :item_name, "Item Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                             <%= f.text_field :item_name, id: "item_name_field", placeholder: "Enter item name", class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
							 <span id="item-name-error" class="text-red-500 text-sm mt-1 hidden">This Item Name already exists.</span>
							 </div>

						<!-- Opening Stock -->
						<div>
							<%= f.label :opening_stock, "Opening Stock", class: "block text-sm font-medium text-gray-700 mb-1" %>
							<%= f.number_field :opening_stock, placeholder: "Enter opening stock",  step: :any, class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
						</div>

						<!-- Purchase Price -->
						<div>
							<%= f.label :purchase_price, "Purchase Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
							<%= f.number_field :purchase_price, placeholder: "Enter purchase price", step: :any, class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
						</div>

						<!-- Sale Price -->
						<div>
							<%= f.label :sale_price, "Sale Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
							<%= f.number_field :sale_price, placeholder: "Enter sale price", step: :any, class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
						</div>

						<!-- Minimum Stock Level -->
						<div>
							<%= f.label :minimum_stock_level, "Minimum Stock Level", class: "block text-sm font-medium text-gray-700 mb-1" %>
							<%= f.number_field :minimum_stock_level, placeholder: "Enter minimum stock level", step: :any, class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
						</div>

						<!-- BOM Radio Buttons -->
						<div class="flex items-center gap-4 mt-2" id="is_bom_radio_group">
							<%= f.label :is_bom, "BOM", class: "block text-sm font-medium text-gray-700" %>
							<div class="flex gap-4 ml-4">
								<label class="inline-flex items-center">
									<%= f.radio_button :is_bom, true, id: "is_bom_yes", class: "form-radio text-blue-600" %>
									<span class="ml-2 text-sm text-gray-800">Yes</span>
								</label>
								<label class="inline-flex items-center">
									<%= f.radio_button :is_bom, false,id: "is_bom_no", class: "form-radio text-blue-600", checked: true %>
									<span class="ml-2 text-sm text-gray-800">No</span>
								</label>
							</div>
						</div>
						<div id="bom-fields" class="mt-4 hidden col-span-1 md:col-span-2">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">

								<!-- Article Number -->
								<div class="w-full" >
									<%= f.label :article_number, "Article Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
									<%= f.text_field :article_number, placeholder: "Enter article number", class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
								</div>

								<!-- Fuse Type Dropdown -->
								<div class="w-full" >
									<%= render partial: "uploads/fuse_type_dropdown", locals: {
										selected_fuse_type_id: @selected_fuse_type_id || nil,
										show_form: @show_fuse_form || false,
										errors: @fuse_type_errors || []
									} %>
								</div>

								<!-- Loop Dropdown -->
								<div>
									<%= render partial: "uploads/loop_dropdown", locals: {
										selected_loop_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>

								<!-- Item Type Dropdown -->
								<div>
									<%= render partial: "uploads/item_type_dropdown", locals: {
										selected_item_type_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>

								<!-- Profile Dropdown -->
								<div>
									<%= render partial: "uploads/profile_dropdown", locals: {
										selected_profile_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>

								<!-- Wattage Dropdown -->
								<div>
									<%= render partial: "uploads/wattage_dropdown", locals: {
										selected_wattage_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>

								<!-- Voltage Dropdown -->
								<div>
									<%= render partial: "uploads/voltage_dropdown", locals: {
										selected_voltage_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>

								<!-- Length Dropdown -->
								<div>
									<%= render partial: "uploads/length_dropdown", locals: {
										selected_length_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>

								<!-- CCT Dropdown -->
								<div>
									<%= render partial: "uploads/cct_dropdown", locals: {
										selected_cct_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>

								<!-- Cover Type Dropdown -->
								<div>
									<%= render partial: "uploads/cover_type_dropdown", locals: {
										selected_cover_type_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>

								<div>
									<%= render partial: "uploads/extra_dropdown", locals: {
										selected_extra_id: nil,
										show_form: false,
										errors: []
									} %>
								</div>
							</div>
						</div>

						<!-- Category Dropdown -->
						<div class="col-span-1 md:col-span-2">
							<%= render partial: "uploads/category_dropdown", locals: { selected_category_id: nil, show_form: false, errors: [] } %>
						</div>

						<!-- Measurement Dropdown -->
						<div class="col-span-1 md:col-span-2">
							<%= render partial: "uploads/measurement_dropdown", locals: { selected_measurement_id: nil, show_form: false, errors: [] } %>
							<!-- Save Button with Tooltip -->
							<div class="col-span-1 md:col-span-2 mt-8 relative group flex flex-col items-center">
								<!-- Tooltip (placed above the button) -->
								<div id="save-tooltip"
								class="text-red-500 text-sm mb-2 hidden absolute z-50 bg-white border border-red-300 rounded p-2 shadow-lg max-w-xs text-center"
								style="bottom: 100%; left: 50%; transform: translateX(-50%); white-space: normal;">
							</div>

							<!-- Save button -->
							<%= f.submit "Save", id: "item-master-save-btn", disabled: true,
							class: "cursor-not-allowed bg-gray-400 px-6 py-2 rounded-xl w-full text-white text-sm font-semibold shadow-md transition-all duration-200" %>
						</div>

					</div>

					<!-- Submit Button -->

				</div>
				<% end %>
			</div>
		</div>

		<!-- Add Raw Material Modal -->
		<div id="RawMaterialModal" class="absolute top-20 right-5 z-50 hidden bg-white border border-gray-300 rounded-lg shadow-lg p-6 w-full max-w-4xl">
			<div class="bg-white border border-gray-300 rounded-xl shadow-2xl w-full max-w-5xl overflow-y-auto max-h-[90vh] p-6 relative">

				<!-- Close Button -->
				<button onclick="toggleRawMaterialModal(false)" class="absolute top-4 right-5 text-gray-500 hover:text-red-600 text-2xl font-bold">&times;</button>

				<h2 class="text-2xl font-bold text-gray-800 mb-6">New Raw Material Inward</h2>

				<%= form_with model: @raw_material_inward, url: raw_material_inwards_path, local: true do |form| %>
				<div class="grid grid-cols-2 gap-6">  
					<div>
						<%= form.label :supplier_name, "Supplier Name", class: "text-sm font-medium text-gray-700" %>
						<%= form.text_field :supplier_name, class: "border rounded-md px-3 py-2 w-full" %>
					</div>

					<div>
						<%= form.label :receiving_date, "Receiving Date", class: "text-sm font-medium text-gray-700" %>
						<%= form.date_field :receiving_date, class: "border rounded-md px-3 py-2 w-full" %>
					</div>

					<div>
						<%= form.label :sku_id, "SKU ID", class: "text-sm font-medium text-gray-700" %>
						<%= form.text_field :sku_id, class: "border rounded-md px-3 py-2 w-full" %>
					</div>

					<div>
						<%= form.label :item_name, "Item Name", class: "text-sm font-medium text-gray-700" %>
						<%= form.text_field :item_name, class: "border rounded-md px-3 py-2 w-full" %>
					</div>

					<div>
						<%= form.label :receiving_quantity, "Receiving Quantity", class: "text-sm font-medium text-gray-700" %>
						<%= form.number_field :receiving_quantity, class: "border rounded-md px-3 py-2 w-full" %>
					</div>

					<div>
						<%= form.label :purchase_price, "Purchase Price", class: "text-sm font-medium text-gray-700" %>
						<%= form.text_field :purchase_price, class: "border rounded-md px-3 py-2 w-full" %>
					</div>
				</div>

				<div class="mt-8">
					<%= form.submit "Create", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow transition" %>
				</div>
				<% end %>
			</div>
		</div>
		<!-- Upload Modal -->
		<div id="uploadModal" class="absolute top-20 right-5 z-50 hidden bg-white border border-gray-300 rounded-lg shadow-lg p-6 w-full max-w-md">
			<div class="bg-white w-full max-w-md rounded-xl p-6 shadow-lg relative">

				<!-- Close Button -->
				<button onclick="toggleModal(false)" class="absolute top-2 right-3 text-gray-600 hover:text-red-500 text-xl font-bold">&times;</button>

				<% @data ||= [] %>
				<% @decoded_result ||= {} %>

				<% if current_user %>
				<!-- File Upload Form -->
				<%= form_with model: UploadedFile.new, url: uploads_path, local: true, multipart: true, html: { id: "file-upload-form" } do |form| %>
				<div class="mb-4">
					<%= form.file_field :file, id: "fileInput", class: "hidden" %>
					<div class="flex items-center space-x-4">
						<label for="fileInput" class="px-4 py-2 bg-gray-200 text-gray-700 rounded cursor-pointer hover:bg-gray-300">
							Choose file
						</label>
						<span id="fileName" class="text-gray-600 text-sm">No file chosen</span>
					</div>
				</div>
				<div>
					<%= form.submit "Upload", class: "w-full hover:bg-gray-100 px-4 py-1 rounded-full text-black font-bold transition cursor-pointer border-2" %>
				</div>
				<% end %>

				<hr class="border-t border-gray-300 my-6" />

				<!-- Manual Decode Form -->
				<%= form_with url: manual_decode_path, method: :post, local: true do |f| %>
				<div class="mb-4">
					<%= f.label :article_number, "Enter Article Number:", class: "block text-gray-700 font-medium mb-1" %>
					<%= f.text_field :article_number, value: @article_number, required: true,
					class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
						placeholder: "e.g. 000123456" %>
					</div>
					<div>
						<%= f.submit "Decode", class: "w-full hover:bg-gray-100 px-4 py-1 rounded-full text-black font-bold transition cursor-pointer border-2" %>
					</div>
					<% end %>
					<% end %>
				</div>
			</div>

			<div class="p-5">

				
				<div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
					<div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 h-20">
						<div class="flex items-center space-x-2 font-semibold text-xl">
							Item Master
						</div>
						<div class="flex items-center gap-2 pt-4 mb-4">
							<div class="relative mb:w-1/3">
								
								<%= search_form_for @q, html: { class: "flex items-center gap-2 w-full max-w-xl mx-auto" } do |f| %>
								<div class="relative w-full">
									<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
										<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2"
										viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round"
										d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 103 10.5a7.5 7.5 0 0013.15 6.15z"></path>
									</svg>
								</div>
								<%= f.search_field :item_name_or_sku_id_or_article_number_cont,
								class: "w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
									placeholder: "Search by Item Name, SKU ID, Category, Measurement..." %>
								</div>

								<%= f.submit "Search",
								class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-150 ease-in-out" %>
								<% end %>

							</div>
						</div>
						<div>   <div class="flex items-center gap-2">
							<button onclick="toggleItemMasterModal(true)" class="flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-400 font-bold">
								<i class="fa-solid fa-plus text-lg"></i>
								<span class="sidebar-label">Add Item</span>
							</button>


						</div>


					</div>
				</div>

				<div class="overflow-x-auto">
					<table class="min-w-full divide-y divide-gray-200 text-sm">
						<thead class="bg-gray-100 text-gray-600 uppercase text-xs">
							<tr>
								<% ["SKU","Item Name", "Category", "Stock", "Purchase Price", "Sale Price", "Minimum Stock Level", "Is BOM", "Extra", "Article No", "Measurement"].each_with_index do |header, index| %>
								<th class="px-6 py-3 text-left whitespace-nowrap border-r border-gray-300 <%= 'last:border-r-0' if index == 19 %>">
									<%= header %>
								</th>
								<% end %>
							</tr>
						</thead>
						<tbody class="bg-white divide-y divide-gray-200">
							<% @item_masters.each do |item| %>
							<tr class="hover:bg-gray-50 text-left">
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200 text-blue-600 hover:underline">
									<%= link_to item.sku_id, edit_item_master_path(item) %>
									
								</td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.item_name %></td>
								
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.category&.name %></td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.opening_stock %></td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.purchase_price %></td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.sale_price %></td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.minimum_stock_level %></td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.is_bom ? "Yes" : "No" %></td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.extra&.name %></td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.article_number %></td>
								<td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.measurement&.name %></td>
							</tr>
							<% end %>
						</tbody>
					</table>
				</div>

				<div class="flex items-center justify-between px-4 py-4 border-t border-gray-200 bg-gray-50 text-sm text-gray-600">
					<div>
						Showing 
						<%= @item_masters.offset_value + 1 %> -
						<%= [@item_masters.offset_value + @item_masters.length, @item_masters.total_entries].min %>
						of <%= @item_masters.total_entries %> results
					</div>

					<div class="flex items-center space-x-1">
					<%= will_paginate @item_masters, renderer: WillPaginate::ActionView::LinkRenderer,
						class: "pagination flex space-x-1",
						previous_label: '<span class="px-3 py-1 text-sm bg-white border border-gray-300 rounded hover:bg-gray-100">&laquo;</span>'.html_safe,
						next_label: '<span class="px-3 py-1 text-sm bg-white border border-gray-300 rounded hover:bg-gray-100">&raquo;</span>'.html_safe,
						container: false %>
					</div>

			    </div>
			</div>
		</div>


		<!-- Optional: Show Decoded or Excel Data -->
		<div class="p-6">
			<% if @data.present? %>
			<h2 class="text-xl font-semibold mb-2">Excel Contents</h2>
			<table class="w-full table-auto border-collapse border border-gray-300 text-sm">
				<% @data.each do |row| %>
				<tr>
					<% row.each do |cell| %>
					<td class="border border-gray-300 px-2 py-1"><%= cell %></td>
					<% end %>
				</tr>
				<% end %>
			</table>
			<% end %>

			<% if @decoded_result.present? %>
			<h3 class="text-xl font-semibold mt-6 mb-2">Decoded Result</h3>
			<table class="w-full table-auto border-collapse border border-gray-300 text-sm">
				<% @decoded_result.each do |key, value| %>
				<tr>
					<td class="border border-gray-300 px-2 py-1 font-medium"><%= key.to_s.humanize %></td>
					<td class="border border-gray-300 px-2 py-1"><%= value %></td>
				</tr>
				<% end %>
			</table>
			<% end %>
		</div>
	</div>

	<!-- JS for Modal & File Name -->
	<script>
		function toggleItemMasterModal(show) {
			const modal = document.getElementById("itemMasterModal");
			if (modal) {
				modal.classList.toggle("hidden", !show);
				modal.classList.toggle("flex", show);
			}
		}

		function toggleRawMaterialModal(show) {
			const modal = document.getElementById("RawMaterialModal");
			if (modal) {
				modal.classList.toggle("hidden", !show);
				modal.classList.toggle("flex", show);
			}
		}

		function toggleModal(show) {
			const modal = document.getElementById("uploadModal");
			if (modal) {
				modal.classList.toggle("hidden", !show);
				modal.classList.toggle("flex", show);
			}
		}

		document.addEventListener("turbo:load", function () {
			const fileInput = document.getElementById("fileInput");
			const fileName = document.getElementById("fileName");

			if (fileInput && fileName) {
				fileInput.addEventListener("change", function () {
					fileName.textContent = fileInput.files.length > 0 ? fileInput.files[0].name : "No file chosen";
				});
			}
		});




		function filterItems() {
			const input = document.getElementById("itemSearch");
			const filter = input.value.toLowerCase();
			const rows = document.querySelectorAll("tbody tr");

			rows.forEach((row) => {
				const itemName = row.children[0]?.innerText.toLowerCase();
				const category = row.children[2]?.innerText.toLowerCase();
				const measurement = row.children[1]?.innerText.toLowerCase();

				const match = itemName.includes(filter) || category.includes(filter) || measurement.includes(filter);
				row.style.display = match ? "" : "none";
			});
		}

		document.addEventListener("turbo:load", () => {
			const form = document.querySelector("#itemMasterModal form");
			const saveBtn = document.querySelector("#item-master-save-btn");

			const requiredSelectors = [	
			"#item_master_opening_stock",
			"#item_master_purchase_price",
			"#item_master_sale_price",
			"#item_master_minimum_stock_level",
			"#item_master_category_id",
			"#item_master_measurement_id",
			];

			const bomSelectors = [
			"#item_master_article_number",
			"#item_master_fuse_type_id",
			"#item_master_loop_id",
			"#item_master_item_type_id",
			"#item_master_profile_id",
			"#item_master_wattage_id",
			"#item_master_voltage_id",
			"#item_master_length_id",
			"#item_master_cct_id",
			"#item_master_cover_type_id"
			];

			const fieldLabelMap = {
				"#item_master_item_name": "Item Name",
				"#item_master_opening_stock": "Opening Stock",
				"#item_master_purchase_price": "Purchase Price",
				"#item_master_sale_price": "Sale Price",
				"#item_master_minimum_stock_level": "Minimum Stock",
				"#item_master_category_id": "Category",
				"#item_master_measurement_id": "Measurement",
				"#item_master_article_number": "Article Number",
				"#item_master_fuse_type_id": "Fuse Type",
				"#item_master_loop_id": "Loop",
				"#item_master_item_type_id": "Item Type",
				"#item_master_profile_id": "Profile",
				"#item_master_wattage_id": "Wattage",
				"#item_master_voltage_id": "Voltage",
				"#item_master_length_id": "Length",
				"#item_master_cct_id": "CCT",
				"#item_master_cover_type_id": "Cover Type"
			};

			const tooltip = document.getElementById("save-tooltip");

			function isFieldFilled(selector) {
				const el = document.querySelector(selector);
				return el && el.value.trim() !== "";
			}

			function getMissingFields() {
				let missing = [];
				requiredSelectors.forEach(sel => {
					if (!isFieldFilled(sel)) missing.push(fieldLabelMap[sel]);
				});

				const isBOM = document.querySelector('input[name="item_master[is_bom]"]:checked')?.value === "true";
				if (isBOM) {
					bomSelectors.forEach(sel => {
						if (!isFieldFilled(sel)) missing.push(fieldLabelMap[sel]);
					});
				}

				return missing;
			}

			function validateForm() {
				const missing = getMissingFields();
				const isValid = missing.length === 0;

				saveBtn.disabled = !isValid;
				saveBtn.classList.toggle("cursor-not-allowed", !isValid);
				saveBtn.classList.toggle("bg-gray-400", !isValid);
				saveBtn.classList.toggle("bg-[#465fff]", isValid);

				tooltip.innerHTML = !isValid ? "Please fill:<br>" + missing.map(f => `• ${f}`).join("<br>") : "";
			}

			form.querySelectorAll("input, select").forEach(input => {
				input.addEventListener("input", validateForm);
				input.addEventListener("change", validateForm);
			});

  // Tooltip on hover
  saveBtn.parentElement.addEventListener("mouseenter", () => {
  	if (saveBtn.disabled && tooltip.innerHTML.trim() !== "") {
  		tooltip.classList.remove("hidden");
  	}
  });

  saveBtn.parentElement.addEventListener("mouseleave", () => {
  	tooltip.classList.add("hidden");
  });

  validateForm(); 
});

