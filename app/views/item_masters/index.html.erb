<% content_for(:title, "Item Master") %>

			<div>

				
				<div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
					<div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 h-18">
						<div class="flex items-center space-x-2 font-semibold text-xl">
							Item Master
						</div>
						<div class="flex items-center gap-2 pt-4 mb-4">
							<div class="relative mb:w-1/3">
								
								<%= search_form_for @q, html: { class: "flex items-center gap-2 w-full max-w-xl mx-auto" } do |f| %>
								<div class="relative w-full">
									<div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
										<svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2"
										viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
										<path stroke-linecap="round" stroke-linejoin="round"
										d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 103 10.5a7.5 7.5 0 0013.15 6.15z"></path>
									</svg>
								</div>
								<%= f.search_field :item_name_or_sku_id_or_article_number_cont,
								class: "w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
									placeholder: "Search by Item Name, SKU ID, Category, Measurement..." %>
								</div>

								<%= f.submit "Search",
								class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-150 ease-in-out cursor-pointer" %>
								<% end %>

							</div>
						</div>

						<div class="flex items-center gap-2">
							<%= link_to item_masters_path(format: :csv),
								class: "py-2 px-6  border border-gray-300 rounded-md hover:bg-gray-200 transition cursor-pointer",
								title: "Download CSV" do %>

								<i class="fa-solid fa-download text-lg"></i>

							<% end %>
						</div>

						<div>   <div class="flex items-center gap-2">
						<%= link_to new_item_master_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300" do %>
							<i class="fa-solid fa-plus"></i>
							<span class="font-semibold">New Item</span>
						  <% end %>
						</div>
					</div>
				</div>

				<div class="overflow-x-auto max-h-[80vh] overflow-y-auto">
				<table class="min-w-full divide-y divide-gray-200 text-sm">
				  <thead class="bg-gray-100 text-gray-600 uppercase text-xs sticky top-0 z-10">
					<tr>
					  <% ["SKU","Item Name", "Category", "Stock", "Purchase Price", "Sale Price", "Minimum Stock Level", "Is BOM", "Extra", "Article No", "Measurement", "Action"].each do |header| %>
						<th class="px-6 py-3 text-left whitespace-nowrap border-r border-gray-300 bg-gray-100">
						  <%= header %>
						</th>
					  <% end %>
					</tr>
				  </thead>
				  <tbody class="bg-white divide-y divide-gray-200">
					<% @item_masters.each do |item| %>
					  <tr class="hover:bg-gray-50 text-left">
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200 text-blue-600 hover:underline">
						  <%= link_to item.sku_id, edit_item_master_path(item) %>
						</td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.item_name %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.category&.name %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.opening_stock %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.purchase_price %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.sale_price %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.minimum_stock_level %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.is_bom ? "Yes" : "No" %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.extra&.name %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.article_number %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= item.measurement&.name %></td>
						<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200 text-center"><%= link_to "Clone", new_item_master_path(clone_id: item.id), class: "text-blue-600 hover:text-blue-800 font-medium" %></td>

					  </tr>
					<% end %>
				  </tbody>
				</table>
			  </div>
			  


<div class="flex items-center justify-between px-4 py-4 border-t border-gray-200 bg-gray-50 text-sm text-gray-600">
  <div>
    Showing 
    <%= @item_masters.offset_value + 1 %> -
    <%= [@item_masters.offset_value + @item_masters.length, @item_masters.total_entries].min %>
    of <%= @item_masters.total_entries %> results
  </div>

  <div class="flex items-center space-x-1">
    <%= will_paginate @item_masters,
      renderer: PaginationRenderer,
      previous_label: "&laquo;".html_safe,
      next_label: "&raquo;".html_safe,
      container: false %>
  </div>
</div>

			</div>
		</div>

