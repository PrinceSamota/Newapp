    toggleBOMFields();
});
document.addEventListener("turbo:load", () => {
    const itemNameField = document.getElementById("item_name_field");
    const bomYes = document.getElementById("is_bom_yes");
    const bomNo = document.getElementById("is_bom_no");

    function updateItemNameField() {
      if (bomYes.checked) {
        // Generate item name (you can update logic below as needed)
        const timestamp = new Date().getTime();
        itemNameField.value = `auto-gen`;
        itemNameField.readOnly = true;
        itemNameField.classList.add("bg-gray-100", "cursor-not-allowed");
      } else {
        itemNameField.value = "";
        itemNameField.readOnly = false;
        itemNameField.classList.remove("bg-gray-100", "cursor-not-allowed");
      }
    }

    bomYes.addEventListener("change", updateItemNameField);
    bomNo.addEventListener("change", updateItemNameField);

    updateItemNameField();
  });
  
  document.addEventListener("turbo:load", () => {
  const itemNameInput = document.getElementById("item_name_field");
  const saveBtn = document.getElementById("item-master-save-btn");
  const tooltip = document.getElementById("save-tooltip");
  const form = document.getElementById("item-form");

  const itemNameError = document.getElementById("item-name-error");

  function validateItemName() {
	const name = itemNameInput.value.trim().toLowerCase();
  
	if (existingItemNames.includes(name)) {
	  itemNameInput.classList.add("border-red-500");
	  tooltip.innerText = "This Item Name already exists.";
	  tooltip.classList.remove("hidden");
	  itemNameError.classList.remove("hidden");
	  saveBtn.disabled = true;
	  return false;
	} else {
	  itemNameInput.classList.remove("border-red-500");
	  tooltip.classList.add("hidden");
	  tooltip.innerText = "";
	  itemNameError.classList.add("hidden");
	  saveBtn.disabled = false;
	  return true;
	}
  }

  itemNameInput.addEventListener("input", validateItemName);

  if (form) {
    form.addEventListener("submit", function (e) {
      if (!validateItemName()) {
        e.preventDefault(); 
      }
    });
  }
});

</script>
<script>
  const existingItemNames = <%= raw ItemMaster.pluck(:item_name).map(&:strip).map(&:downcase).to_json %>;
</script>
