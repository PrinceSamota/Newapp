<%= link_to item_masters_path, class: "inline-flex items-center gap-2 text-gray-700 hover:bg-gray-200 rounded-md px-3 py-2 border border-gray-300 shadow-sm" do %>
    <i class="fa-solid fa-arrow-left"></i>
    <span class="font-semibold">Back</span>
  <% end %>
<div class="bg-white p-8 rounded-2xl shadow-xl max-w-full mx-auto  bg-gray-50 py-4 mt-5 text-center text-gray-700 p-8">
  <h2 class="text-2xl font-bold text-gray-800 mb-10 text-left">New Item</h2>

  <%= form_with model: @item_master, url: item_masters_path, html: { id: "item-form" } do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <div>
        <%= f.label :item_name, "Item Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :item_name, id: "item_name_field", class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2" %>
        <span id="item-name-error" class="text-red-500 text-sm mt-1 hidden">This Item Name already exists.</span>
      </div>

      <div>
        <%= f.label :opening_stock, "Opening Stock", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :opening_stock, placeholder: "Enter opening stock", step: :any, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2" %>
      </div>

      <div>
        <%= f.label :purchase_price, "Purchase Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :purchase_price, placeholder: "Enter purchase price", step: :any, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2" %>
      </div>

      <div>
        <%= f.label :sale_price, "Sale Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :sale_price, placeholder: "Enter sale price", step: :any, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2" %>
      </div>

      <div>
        <%= f.label :minimum_stock_level, "Minimum Stock Level", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :minimum_stock_level, placeholder: "Enter minimum stock level", step: :any, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2" %>
      </div>

      <div class="flex items-center gap-4 mt-2" id="is_bom_radio_group">
      <%= f.label :is_bom, "BOM", class: "block text-sm font-medium text-gray-700" %>
      <div class="flex gap-4 ml-4">
        <label class="inline-flex items-center">
          <%= f.radio_button :is_bom, true, id: "is_bom_yes", class: "form-radio text-blue-600" %>
          <span class="ml-2 text-sm text-gray-800">Yes</span>
        </label>
        <label class="inline-flex items-center">
          <%= f.radio_button :is_bom, false, id: "is_bom_no", class: "form-radio text-blue-600" %>
          <span class="ml-2 text-sm text-gray-800">No</span>
        </label>
      </div>
    </div>
    

      <div class="md:col-span-1">
      <%= render partial: "uploads/measurement_dropdown", locals: { selected_measurement_id: @item_master.measurement_id, show_form: false, errors: [] } %>
    </div>
    <div class="md:col-span-3">
    <%= render partial: "uploads/category_dropdown", locals: { selected_category_id: @item_master.category_id, show_form: false, errors: [] } %>
  </div>
    
      <div id="bom-fields" class="md:col-span-3 hidden grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <%= f.label :article_number, "Article Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :article_number, placeholder: "Enter article number", class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>

        <div>
          <%= render partial: "uploads/item_type_dropdown", locals: { selected_item_type_id: @item_master.item_type_id, show_form: false, errors: [] } %>
        </div>

        <div>
          <%= render partial: "uploads/profile_dropdown", locals: { selected_profile_id: @item_master.profile_id, show_form: false, errors: [] } %>
        </div>

        <div>
          <%= render partial: "uploads/voltage_dropdown", locals: { selected_voltage_id: @item_master.voltage_id, show_form: false, errors: [] } %>
        </div>

        <div>
         <%= render partial: "uploads/wattage_dropdown", locals: { selected_wattage_id: @item_master.wattage_id, show_form: false, errors: [] } %>
        </div>

        <div>
         <%= render partial: "uploads/length_dropdown", locals: { selected_length_id: @item_master.length_id, show_form: false, errors: [] } %>
        </div>

        <div>
          <%= render partial: "uploads/cct_dropdown", locals: { selected_cct_id: @item_master.cct_id, show_form: false, errors: [] } %>
        </div>

        <div>
         <%= render partial: "uploads/cover_type_dropdown", locals: { selected_cover_type_id: @item_master.cover_type_id, show_form: false, errors: [] } %>
        </div>

        <div>
          <%= render partial: "uploads/fuse_type_dropdown", locals: { selected_fuse_type_id: @item_master.fuse_type_id, show_form: false, errors: [] } %>
        </div>

        <div>
          <%= render partial: "uploads/loop_dropdown", locals: { selected_loop_id: @item_master.loop_id, show_form: false, errors: [] } %>
        </div>

        <div>
          <%= render partial: "uploads/extra_dropdown", locals: { selected_extra_id: @item_master.extra_id, show_form: false, errors: [] } %>
        </div>
      </div>

      <div class="md:col-span-3 mt-10 text-right">
        <%= f.submit "Save", id: "item-master-save-btn", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg shadow-md transition duration-300 cursor-pointer" %>
        <div id="save-tooltip" class="text-red-500 text-sm mt-2 hidden"></div>
      </div>
    </div>
  <% end %>
</div>

<script>
document.addEventListener("turbo:load", () => {
  const itemNameField = document.getElementById("item_name_field");
  const saveBtn = document.getElementById("item-master-save-btn");
  const tooltip = document.getElementById("save-tooltip");
  const form = document.getElementById("item-form");
  const itemNameError = document.getElementById("item-name-error");

  const bomYes = document.getElementById("is_bom_yes");
  const bomNo = document.getElementById("is_bom_no");

  const bomFieldsSection = document.getElementById("bom-fields");

  const dropdownIds = [
    "item_type_id", "profile_id", "voltage_id", "wattage_id",
    "length_id", "cct_id", "cover_type_id", "fuse_type_id", "extra_id"
  ];

  const disableIds = [
    "article_number", "fuse_type_id", "loop_id", "item_type_id",
    "profile_id", "wattage_id", "voltage_id", "length_id",
    "cct_id", "cover_type_id", "extra_id"
  ];

  function generateItemName() {
    const getText = (id) => {
      const el = document.getElementById(id);
      return el?.options[el.selectedIndex]?.text?.trim() || null;
    };

    const nameParts = dropdownIds.map(getText).filter(Boolean);
    itemNameField.value = nameParts.join("_");
  }

  function toggleBOMFields() {
    const isBom = bomYes.checked;

    if (bomFieldsSection) {
      bomFieldsSection.classList.toggle("hidden", !isBom);
    }

    itemNameField.readOnly = isBom;
    itemNameField.value = "";
    itemNameField.placeholder = isBom ? "Will be auto-generated" : "Enter Item Name";
    console.log("BOM is", isBom, "=> Placeholder:", itemNameField.placeholder);
    itemNameField.classList.toggle("bg-gray-100", isBom);
    itemNameField.classList.toggle("cursor-not-allowed", isBom);

    disableIds.forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        el.disabled = !isBom;
        el.classList.toggle("bg-gray-100", !isBom);
        el.classList.toggle("cursor-not-allowed", !isBom);
      }
    });

    if (isBom) {
      generateItemName();
    }
  }

  function validateItemName() {
    const name = itemNameField.value.trim().toLowerCase();
  
    if (bomNo.checked) {
      if (existingItemNames.includes(name)) {
        itemNameField.classList.add("border-red-500");
        tooltip.innerText = "This Item Name already exists.";
        tooltip.classList.remove("hidden");
        itemNameError.classList.remove("hidden");
        if (saveBtn) saveBtn.disabled = true;
        return false;
      } else {
        itemNameField.classList.remove("border-red-500");
        tooltip.classList.add("hidden");
        tooltip.innerText = "";
        itemNameError.classList.add("hidden");
        if (saveBtn) saveBtn.disabled = false;
        return true;
      }
    }
  
    itemNameField.classList.remove("border-red-500");
    tooltip.classList.add("hidden");
    itemNameError.classList.add("hidden");
    saveBtn.disabled = false;
    return true;
  }
  

  if (bomYes && bomNo) {
    bomYes.addEventListener("change", toggleBOMFields);
    bomNo.addEventListener("change", toggleBOMFields);
  }

  if (itemNameField) {
    itemNameField.addEventListener("input", validateItemName);
  }

  if (form) {
    form.addEventListener("submit", function (e) {
      let isValid = true;
  
      const isBom = bomYes.checked;
  
      form.querySelectorAll(".required-field").forEach((field) => {
        field.classList.remove("border-red-500");
        const next = field.nextElementSibling;
        if (next && next.classList.contains("text-red-500") && next.textContent === "This field is required") {
          next.remove();
        }
      });
  
      form.querySelectorAll(".required-field").forEach((field) => {
        if (field.id === "item_name_field" && bomYes.checked) {
            return; // skip validation
          }
        if (field.offsetParent !== null && !field.value.trim()) {
          isValid = false;
          field.classList.add("border-red-500");
  
          const error = document.createElement("p");
          error.textContent = "This field is required";
          error.className = "text-red-500 text-xs mt-1";
          field.insertAdjacentElement("afterend", error);
        }
      });
  
      if (isBom) {
        const bomFields = [
          "article_number", "fuse_type_id", "loop_id", "item_type_id",
          "profile_id", "wattage_id", "voltage_id", "length_id",
          "cct_id", "cover_type_id", "extra_id"
        ];
  
        bomFields.forEach(id => {
          const field = document.getElementById(id);
          if (field && field.offsetParent !== null && !field.value.trim()) {
            isValid = false;
            field.classList.add("border-red-500");
  
            const error = document.createElement("p");
            error.textContent = "This field is required";
            error.className = "text-red-500 text-xs mt-1";
            field.insertAdjacentElement("afterend", error);
          }
        });
      }
  
      if (!validateItemName()) {
        isValid = false;
      }
  
      if (!isValid) {
        e.preventDefault();
        tooltip.classList.remove("hidden");
        tooltip.innerText = "Please fix the errors before submitting.";
      }
    });
  }
  


  dropdownIds.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener("change", () => {
        if (bomYes.checked) {
  generateItemName();

} else {
  validateItemName(); 
}
      });
    }
  });

  toggleBOMFields();
});

const existingItemNames = <%= raw ItemMaster.pluck(:item_name).map(&:strip).map(&:downcase).to_json %>;
</script>
