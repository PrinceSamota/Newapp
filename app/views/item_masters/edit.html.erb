<% content_for(:title, "Item Master") %>
<div class="min-h-screen bg-gray-50 px-4 py-8">
  <!-- Back Button -->
  <!-- Top Button Row -->
  <div class="mb-6 flex items-center justify-between">
    <!-- Back Button -->
    <%= link_to root_path, class: "inline-flex items-center gap-2 text-gray-700 hover:bg-gray-200 rounded-md px-3 py-2 border border-gray-300 shadow-sm" do %>
      <i class="fa-solid fa-arrow-left"></i>
      <span class="font-semibold">Back</span>
    <% end %>
  
    <!-- Stock History Button -->
    <%= link_to versions_item_master_path(@item_master), class: "inline-flex items-center gap-2 text-gray-700 hover:bg-gray-200 rounded-md px-3 py-2 border border-gray-300 shadow-sm" do %>
      <i class="fa-solid fa-clock-rotate-left"></i>
      <span class="font-semibold">Stock History</span>
    <% end %>
  </div>
  <% if @item_master.errors.any? %>
  <div id="error-alert" class="relative mb-4 rounded-lg border border-red-300 bg-red-50 p-4 text-red-700">
    <!-- ❌ Close Button -->
    <button onclick="document.getElementById('error-alert').style.display='none'" class="absolute top-2 right-2 text-red-500 hover:text-red-700 text-lg font-bold">
      &times;
    </button>

    <h4 class="font-semibold mb-2">Please fix the following errors:</h4>
    <ul class="list-disc pl-5 text-sm">
      <% @item_master.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
  <!-- Main Card -->
  <div class="bg-white p-8 rounded-2xl shadow-xl max-w-[100%] mx-auto">
    <h2 class="text-2xl font-bold text-center mb-8 text-gray-800">Edit Item</h2>

    <%= form_with(model: @item_master, local: true, data: { turbo: false }, class: "space-y-6") do |f| %>


      <!-- Row 1 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :item_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :item_name, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :measurement_id, "Measurement", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :measurement_id, Measurement.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :category_id, "Category", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.collection_select :category_id, Category.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-2 focus:ring-blue-500" %>
        </div>
      </div>

      <!-- Row 2 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :opening_stock, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :opening_stock, step: :any, class: "w-full border border-gray-300 rounded-lg px-4 py-2 bg-gray-100 cursor-not-allowed", disabled: true %>
        </div>

        <div>
          <%= f.label :purchase_price, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :purchase_price, step: :any, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>

        <div>
          <%= f.label :sale_price, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :sale_price, step: :any, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>
      </div>

      <!-- Row 3 -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <%= f.label :minimum_stock_level, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :minimum_stock_level, step: :any, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
        </div>

        <div class="mb-4 mt-8">
        <%= f.hidden_field :is_bom, value: false %>
<%= f.check_box :is_bom, { id: 'is_bom_checkbox', class: 'mr-2', onchange: 'toggleBomFields()' }, true, false %>
<%= f.label :is_bom, "Is BOM?" %>



      </div>
      
        <div>
          <%= f.label :sku_id, "SKU ID", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :sku_id, class: "w-full border border-gray-300 rounded-lg px-4 py-2 bg-gray-100 cursor-not-allowed", disabled: true %>
        </div>
      </div>
      <!-- Row 4 -->
      <div id="bom-fields" style="<%= @item_master.is_bom? ? '' : 'display: none;' %>">
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div>
    <%= f.label :fuse_type_id, "Fuse Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :fuse_type_id, FuseType.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>

  <div>
    <%= f.label :loop_id, "Loop", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :loop_id, Loop.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>

  <div>
    <%= f.label :item_type_id, "Item Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :item_type_id, ItemType.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>
</div>

<!-- Row 5 -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div>
    <%= f.label :profile_id, "Profile", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :profile_id, Profile.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>

  <div>
    <%= f.label :wattage_id, "Wattage", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :wattage_id, Wattage.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>

  <div>
    <%= f.label :voltage_id, "Voltage", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :voltage_id, Voltage.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>
</div>

<!-- Row 6 -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div>
    <%= f.label :length_id, "Length", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :length_id, Length.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>

  <div>
    <%= f.label :cct_id, "CCT", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :cct_id, Cct.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>

  <div>
    <%= f.label :cover_type_id, "Cover Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :cover_type_id, CoverType.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<div>
<%= f.label :article_number, "Article Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
<%= f.text_field :article_number, placeholder: "Enter article number", class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
</div>
<div>
<%= f.label :extra_id, "Extra", class: "block text-sm font-medium text-gray-700 mb-1" %>
<%= f.collection_select :extra_id, Extra.all, :id, :name, { include_blank: "Select" }, class: "w-full border border-gray-300 rounded-lg px-4 py-2" %>
</div>
</div>

</div>
      <!-- Submit -->
      <div>
        <%= f.submit "Update Item", class: "bg-blue-600 text-white w-64 py-2 rounded-md font-semibold hover:bg-blue-700 shadow cursor-pointer" %>
      </div>
    <% end %>

    <!-- Link to Stock History -->

  </div>
</div>
<script>
  function toggleBomFields() {
    const isBOM = document.getElementById('is_bom_checkbox').checked;
    const bomFields = document.getElementById('bom-fields');
    if (isBOM) {
      bomFields.style.display = 'block';
    } else {
      bomFields.style.display = 'none';
    }
  }

  // Trigger on page load (for edit form)
  document.addEventListener('DOMContentLoaded', () => {
    toggleBomFields();
  });
</script>
