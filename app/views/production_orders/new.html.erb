<% content_for(:title, "Production Order") %>
<%= link_to production_orders_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 rounded border border-gray-300" do %>
  <i class="fa-solid fa-arrow-left"></i>
    <span class="font-bold">Back</span>
  <% end %>
  <% if @production_order.errors.any? %>
  <div id="error-box" class="fixed right-6 top-6 max-w-sm bg-red-100 border border-red-300 text-red-700 rounded-lg p-4 shadow-xl z-50">
    <button type="button" onclick="document.getElementById('error-box').remove()" class="absolute top-2 right-2 text-red-500 hover:text-red-700 text-lg font-bold">
      &times;
    </button>
    <p class="font-bold mb-2 pr-6">Please fix the following errors:</p>
    <ul class="list-disc pl-5 space-y-1 text-sm pr-6">
      <% @production_order.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

  <div class="bg-white p-6 rounded-lg shadow border border-gray-200 mt-6">
  <div class="flex justify-between items-center mb-4">
    <h2 class="text-xl font-bold">Create Production Order</h2>

  </div>

  <%= form_with model: @production_order, local: true do |f| %>
    <div id="items">
      <%= f.fields_for :production_order_items do |item_form| %>
        <%= render "item_fields", f: item_form, item_masters: @item_masters %>
      <% end %>
    </div>


     <!--<div>
      <button
        type="button"
        id="add-item"
        class="bg-green-500 text-white px-4 py-2 rounded mt-4 shadow hover:bg-green-600 cursor-pointer"
      >
        <i class="fa-solid fa-plus mr-1"></i> Add new row
      </button>
    </div>-->

    <!-- Submit Button -->
    <div class="mt-6 text-right">
      <%= f.submit "Order", class: "bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 shadow cursor-pointer" %>
    </div>
  <% end %>

  <%= render "item_fields_template", item_masters: @item_masters %>
</div>

<!-- Add Item Template Script -->
<script>
document.addEventListener("turbo:load", () => {
  const addItemBtn = document.getElementById("add-item");
  const form = document.getElementById("po-form");

  // === ADD ITEM BUTTON ===
  if (addItemBtn && !addItemBtn.dataset.listenerAttached) {
    addItemBtn.dataset.listenerAttached = "true"; // prevent multiple bindings
    addItemBtn.addEventListener("click", () => {
      const template = document.getElementById("item-template").innerHTML;
      const container = document.getElementById("items");
      container.insertAdjacentHTML("beforeend", template.replace(/TEMPLATE/g, new Date().getTime()));
      initSearchableInputs(); // reinit for new row
    });
  }

  // === REMOVE ITEM ROW ===
  document.body.addEventListener("click", function (e) {
    if (e.target.closest(".remove-raw-material")) {
      const row = e.target.closest(".production-order-row");
      if (row) row.remove();
    }
  });

  // === VALIDATION ON SUBMIT ===
  if (form) {
    form.addEventListener("submit", (e) => {
      let isValid = true;

      // Clear previous errors
      form.querySelectorAll(".required-field").forEach((field) => {
        field.classList.remove("border-red-500");
        const next = field.nextElementSibling;
        if (next && next.classList.contains("text-red-500")) {
          next.remove();
        }
      });

      // Validate fields
      form.querySelectorAll(".required-field").forEach((field) => {
        if (field.offsetParent !== null && !field.value.trim()) {
          isValid = false;
          field.classList.add("border-red-500");

          const error = document.createElement("p");
          error.textContent = "This field is required";
          error.className = "text-red-500 text-xs mt-1";
          field.insertAdjacentElement("afterend", error);
        }
      });

      if (!isValid) e.preventDefault();
    });
  }

  // === INITIALIZE SEARCHABLE INPUT + BOM LOGIC ===
  initSearchableInputs();

  function initSearchableInputs() {
    document.querySelectorAll('[data-role="searchable-input"]').forEach(input => {
      if (input.dataset.listenerAttached) return; // prevent duplicate listeners
      input.dataset.listenerAttached = "true";

      const wrapper = input.closest(".searchable-wrapper");
      const dropdown = wrapper.querySelector('[data-role="searchable-dropdown"]');
      const clearBtn = wrapper.querySelector(".clear-search-input");

      if (input.value.trim() !== "") clearBtn.classList.remove("hidden");

      input.addEventListener("input", () => {
        const filter = input.value.toLowerCase();
        dropdown.querySelectorAll("li").forEach(li => {
          li.style.display = li.textContent.toLowerCase().includes(filter) ? "" : "none";
        });
        dropdown.classList.remove("hidden");
        clearBtn.classList.remove("hidden");
      });

      input.addEventListener("focus", () => dropdown.classList.remove("hidden"));
      input.addEventListener("blur", () => setTimeout(() => dropdown.classList.add("hidden"), 200));

      dropdown.querySelectorAll("li").forEach(li => {
        li.addEventListener("click", () => {
          input.value = li.textContent;
          dropdown.classList.add("hidden");
          clearBtn.classList.remove("hidden");
        
          const row = input.closest(".production-order-row");
          const skuInput = row.querySelector(".sku-input");
          const itemInput = row.querySelector(".item-name-input");
          const stockField = row.querySelector("#current-stock-field");
          const itemMasterIdField = row.querySelector(".item-master-id-field");
        
          const sku = li.dataset.skuId;
          const itemName = li.dataset.itemName;
          const stock = li.dataset.stock;
          const itemId = li.dataset.itemId;
        
          skuInput.value = sku;
          itemInput.value = itemName;
          skuInput.readOnly = true;
          itemInput.readOnly = true;
        
          stockField.value = stock;
          itemMasterIdField.value = itemId;
        
          checkBOMUsage(row, sku);
        });
      });

      clearBtn?.addEventListener("click", (e) => {
        e.preventDefault();
        const row = clearBtn.closest(".production-order-row");
        const skuInput = row.querySelector(".sku-input");
        const itemInput = row.querySelector(".item-name-input");
        const stockField = row.querySelector("#current-stock-field");
        const itemMasterIdField = row.querySelector(".item-master-id-field");
        const bomField = row.querySelector(".bom-field");
        const bomIdContainer = row.querySelector(".bom-id-container");
        const createBtn = row.querySelector(".create-bom-btn");

        skuInput.value = "";
        itemInput.value = "";
        stockField.value = "";
        itemMasterIdField.value = "";

        skuInput.readOnly = false;
        itemInput.readOnly = false;

        bomField.value = "";
        bomIdContainer.innerHTML = "";

        createBtn?.classList.add("hidden");
        clearBtn.classList.add("hidden");
      });
    });
  }

  // === BOM FETCH FUNCTION ===
  function checkBOMUsage(row, sku) {
    const bomField = row.querySelector(".bom-field");
    const bomWrapper = row.querySelector(".bom-input-wrapper");
    const createBtn = row.querySelector(".create-bom-btn");
    const bomIdContainer = row.querySelector(".bom-id-container");

    const inputField = row.querySelector('[name*="[sku_id]"]');
    const itemIndex = inputField?.name?.match(/\[(\d+)\]/)?.[1];

    fetch(`/check_bom_usage?sku_id=${sku}`)
      .then(res => res.json())
      .then(data => {
        bomIdContainer.innerHTML = "";

        if (data.used) {
          bomField.value = data.bom_names.join(", ");
          data.bom_ids.forEach(id => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = `production_order[production_order_items_attributes][${itemIndex}][bom_ids][]`;
            input.value = id;
            input.classList.add("bom-id-field");
            bomIdContainer.appendChild(input);
          });
          bomWrapper.classList.remove("hidden");
          createBtn.classList.add("hidden");
        } else {
          bomField.value = "";
          bomWrapper.classList.add("hidden");
          createBtn.classList.remove("hidden");
        }
      });
  }
});
</script>
