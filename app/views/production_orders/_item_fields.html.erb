<%= tag.script type: "application/json", id: "item-master-mapping-data" do %>
  <%= raw item_masters.map { |item|
    {
      id: item.id,          
      sku_id: item.sku_id,
      item_name: item.item_name,
      opening_stock: item.opening_stock
    }
  }.to_json %>
<% end %>

<div class="production-order-row relative grid grid-cols-6 gap-4 items-end bg-white border border-gray-200 rounded-lg px-4 py-3 shadow-sm mt-6">
  <%= f.hidden_field :item_master_id, class: "item-master-id-field" %>

  <%= render 'shared/searchable_input',
    field_id: "sku-input-#{SecureRandom.hex(4)}",
    field_name: "#{f.object_name}[sku_id]",
    label_text: "SKU ID",
    selected_value: f.object.sku_id,
    items: item_masters,
    value_method: :sku_id,
    field_type: "sku",
    extra_class: "sku-input" %>

  <%= render 'shared/searchable_input',
    field_id: "item-name-input-#{SecureRandom.hex(4)}",
    field_name: "#{f.object_name}[item_name]",
    label_text: "Item Name",
    selected_value: f.object.item_name,
    items: item_masters,
    value_method: :item_name,
    field_type: "item",
    extra_class: "item-name-input" %>

  <!-- Current Stock -->
  <div>
    <%= f.label :current_stock, "Current Stock", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.number_field :current_stock, class: " w-full border border-gray-300 rounded-md px-3 py-2 text-sm", disabled: true, id: 'current-stock-field' %>
  </div>

  <!-- Quantity -->
  <div>
    <%= f.label :quantity, "Quantity", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.number_field :quantity, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
  </div>

  <!-- BOM + Hidden BOM IDs -->
  <div>
    <%= f.label :bom, "BOM", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <div class="flex items-center gap-2">
      <div class="bom-input-wrapper w-full">
        <%= f.text_field :bom, class: "bom-field w-full border border-gray-300 rounded-md px-3 py-2 text-sm", readonly: true %>
        <div class="bom-id-container"></div>
      </div>
      <a href="/bill_of_materials/new"
      target="_blank"
      class="create-bom-btn hidden flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer text-sm font-medium border border-gray-300 shadow-sm">
      <i class="fa-solid fa-plus text-lg"></i> Create BOM
    </a>
    </div>
  </div>
</div>

<script>
document.addEventListener("turbo:load", () => {
  document.querySelectorAll('[data-role="searchable-input"]').forEach(input => {
    const wrapper = input.closest(".searchable-wrapper");
    const dropdown = wrapper.querySelector('[data-role="searchable-dropdown"]');
    const clearBtn = wrapper.querySelector(".clear-search-input");

    if (input.value.trim() !== "") {
      clearBtn.classList.remove("hidden");
    }

    input.addEventListener("input", () => {
      const filter = input.value.toLowerCase();
      dropdown.querySelectorAll("li").forEach(li => {
        li.style.display = li.textContent.toLowerCase().includes(filter) ? "" : "none";
      });
      dropdown.classList.remove("hidden");
      clearBtn.classList.remove("hidden");
    });

    input.addEventListener("focus", () => dropdown.classList.remove("hidden"));
    input.addEventListener("blur", () => setTimeout(() => dropdown.classList.add("hidden"), 200));

    dropdown.querySelectorAll("li").forEach(li => {
      li.addEventListener("click", () => {
        input.value = li.textContent;
        dropdown.classList.add("hidden");
        clearBtn.classList.remove("hidden");
      
        const row = input.closest(".production-order-row");
        const skuInput = row.querySelector(".sku-input");
        const itemInput = row.querySelector(".item-name-input");
        const stockField = row.querySelector("#current-stock-field");
        const itemMasterIdField = row.querySelector(".item-master-id-field");
      
        const sku = li.dataset.skuId;
        const itemName = li.dataset.itemName;
        const stock = li.dataset.stock;
        const itemId = li.dataset.itemId;
      
        // Set both fields and make both readonly
        skuInput.value = sku;
        itemInput.value = itemName;
      
        skuInput.readOnly = true;
        itemInput.readOnly = true;
      
        stockField.value = stock;
        itemMasterIdField.value = itemId;
      
        checkBOMUsage(row, sku);
      });
      
    });
    clearBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      const row = clearBtn.closest(".production-order-row");
      const skuInput = row.querySelector(".sku-input");
      const itemInput = row.querySelector(".item-name-input");
      const stockField = row.querySelector("#current-stock-field");
      const itemMasterIdField = row.querySelector(".item-master-id-field");
      const bomField = row.querySelector(".bom-field");
      const bomIdContainer = row.querySelector(".bom-id-container");
      const createBtn = row.querySelector(".create-bom-btn");

      // Reset fields
      skuInput.value = "";
      itemInput.value = "";
      stockField.value = "";
      itemMasterIdField.value = "";

      skuInput.readOnly = false;
      itemInput.readOnly = false;

      bomField.value = "";
      bomIdContainer.innerHTML = "";

      createBtn?.classList.add("hidden");
      clearBtn.classList.add("hidden");
    });
  });

  function checkBOMUsage(row, sku) {
    const bomField = row.querySelector(".bom-field");
    const bomWrapper = row.querySelector(".bom-input-wrapper");
    const createBtn = row.querySelector(".create-bom-btn");
    const bomIdContainer = row.querySelector(".bom-id-container");

    // Get index for the nested attributes (e.g., [0], [1])
    const inputField = row.querySelector('[name*="[sku_id]"]');
    const itemIndex = inputField?.name?.match(/\[(\d+)\]/)?.[1];

    fetch(`/check_bom_usage?sku_id=${sku}`)
      .then(res => res.json())
      .then(data => {
        bomIdContainer.innerHTML = "";

        if (data.used) {
          bomField.value = data.bom_names.join(", ");

          data.bom_ids.forEach(id => {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = `production_order[production_order_items_attributes][${itemIndex}][bom_ids][]`;
            input.value = id;
            input.classList.add("bom-id-field");
            bomIdContainer.appendChild(input);
          });

          bomWrapper.classList.remove("hidden");
          createBtn.classList.add("hidden");
        } else {
          bomField.value = "";
          bomWrapper.classList.add("hidden");
          createBtn.classList.remove("hidden");
        }
      });
  }
});
</script>
