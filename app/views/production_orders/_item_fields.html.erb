<%= tag.script type: "application/json", id: "item-master-mapping-data" do %>
  <%= raw item_masters.map { |item|
    {
      sku_id: item.sku_id,
      item_name: item.item_name,
      opening_stock: item.opening_stock
    }
  }.to_json %>
<% end %>

<div class="production-order-row relative grid grid-cols-6 gap-4 items-end bg-white border border-gray-200 rounded-lg px-4 py-3 shadow-sm mt-6">

  <!-- SKU ID -->
  <div>
    <%= f.label :sku_id, "SKU ID", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.select :sku_id,
      options_for_select(item_masters.map { |item| [item.sku_id, item.sku_id] }, f.object.sku_id),
      { include_blank: "Choose SKU" },
      class: "required-field sku-id-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <!-- Item Name -->
  <div>
    <%= f.label :item_name, "Item Name", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.select :item_name,
      options_for_select(item_masters.map { |item| [item.item_name, item.item_name] }, f.object.item_name),
      { include_blank: "Choose Item" },
      class: "required-field item-name-select w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <!-- Current Stock -->
  <div>
    <%= f.label :current_stock, "Current Stock", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.number_field :current_stock,
      class: "required-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <!-- Quantity -->
  <div>
    <%= f.label :quantity, "Quantity", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.number_field :quantity,
      class: "required-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :stage, "Stage", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.text_field :stage,
      class: "required-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
  </div>

  <!-- BOM -->
  <div>
    <%= f.label :bom, "BOM", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <div class="flex items-center gap-2">
      <!-- This will show BOM field if exists, else show Create BOM link -->
      <div class="bom-input-wrapper w-full">
        <%= f.text_field :bom,
        class: "required-field bom-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm",
          readonly: true %>
      </div>
      <a href="/bill_of_materials/new"
      target="_blank"
      class="create-bom-btn hidden flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer text-sm font-medium border border-gray-300 shadow-sm">
        <i class="fa-solid fa-plus text-lg"></i> Create BOM
   </a>
    </div>
  </div>
  <button type="button"
    class="remove-raw-material absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer">
    ✕
  </button>
</div>
<script>
document.addEventListener("turbo:load", () => {
  const mappingData = JSON.parse(document.getElementById("item-master-mapping-data").textContent || "[]");

  const skuToItem = {};
  const itemToSku = {};
  const skuToStock = {};
  const itemToStock = {};

  // Setup mappings
  mappingData.forEach(item => {
    skuToItem[item.sku_id] = item.item_name;
    itemToSku[item.item_name] = item.sku_id;

    skuToStock[item.sku_id] = item.opening_stock;
    itemToStock[item.item_name] = item.opening_stock;
  });

  document.body.addEventListener("change", (e) => {
    const target = e.target;

    // Find the parent row
    const row = target.closest(".grid");
    if (!row) return;

    const skuSelect = row.querySelector(".sku-id-field");
    const itemSelect = row.querySelector(".item-name-select");
    const stockField = row.querySelector("input[name*='current_stock']");

    // When SKU is selected
    if (target.classList.contains("sku-id-field")) {
      const sku = skuSelect.value;
      const itemName = skuToItem[sku];

      if (itemName) {
        itemSelect.value = itemName;
      }

      if (stockField && skuToStock[sku] !== undefined) {
        stockField.value = skuToStock[sku];
      }

      checkBOMUsage(row);
    }

    // When Item Name is selected
    if (target.classList.contains("item-name-select")) {
      const itemName = itemSelect.value;
      const sku = itemToSku[itemName];

      if (sku) {
        skuSelect.value = sku;
      }

      if (stockField && itemToStock[itemName] !== undefined) {
        stockField.value = itemToStock[itemName];
      }

      checkBOMUsage(row);
    }
  });

  function checkBOMUsage(row) {
    const skuField = row.querySelector(".sku-id-field");
    const bomFieldWrapper = row.querySelector(".bom-input-wrapper");
    const bomField = row.querySelector(".bom-field");
    const createLink = row.querySelector(".create-bom-btn");

    const sku = skuField.value;

    if (sku) {
      fetch(`/check_bom_usage?sku_id=${sku}`)
        .then(res => res.json())
        .then(data => {
          if (data.used) {
            bomField.value = data.bom_names.join(", ");
            bomFieldWrapper.classList.remove("hidden");
            createLink.classList.add("hidden");
          } else {
            bomField.value = "";
            bomFieldWrapper.classList.add("hidden");
            createLink.classList.remove("hidden");
          }
        })
        .catch(err => {
          console.error("BOM check failed:", err);
        });
    }
  }
});
</script>
