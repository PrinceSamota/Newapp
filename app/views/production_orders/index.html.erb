<% content_for(:title, "Production Order") %>
<div>
    <div class="bg-white  rounded-lg shadow-md border border-gray-200">
  <!-- Header + Search + Add in one row -->
  <div class="flex flex-col md:flex-row justify-between items-center gap-4 p-4 h-18">
  <!-- Left: Title -->
  <div class="w-full md:w-1/3 text-center md:text-left">
    <h2 class="text-xl font-semibold">Production Order</h2>
  </div>

  <!-- Center: Search -->
  <div class="w-full md:w-1/3 flex justify-center">
    <%= search_form_for @q, url: production_orders_path, method: :get, html: { class: "w-full max-w-xs flex items-center gap-2" } do |f| %>
      <div class="relative w-full">
        <%= f.search_field :pid_or_production_order_items_item_master_item_name_cont,
          class: "pl-10 pr-4 py-2 border border-gray-300 rounded-md text-sm w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
          placeholder: "Search by PID or Finished Good" %>
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">
          <i class="fa-solid fa-magnifying-glass"></i>
        </span>
      </div>
      <%= f.submit "Search",
        class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-150 ease-in-out" %>
    <% end %>
  </div>

  <!-- Right: Add Button -->
  <div class="w-full md:w-1/3 flex justify-end">
    <%= link_to new_production_order_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300" do %>
      <i class="fa-solid fa-plus"></i>
      <span class="font-semibold">Production Order</span>
    <% end %>
  </div>
</div>


  <!-- Table -->
  <div class="overflow-x-auto">
  <div class="max-h-[80vh] overflow-y-auto border border-gray-300 rounded">
    <table class="min-w-full text-sm divide-y divide-gray-200">
      <thead class="bg-gray-100 text-gray-700 text-xs uppercase sticky top-0 z-10">
        <tr>
          <th class="px-4 py-3 text-left border-r border-gray-300">PID</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">BOM Number</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">SKU</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">current stock</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">Finished Good</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">Executed</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">Action</th>
        </tr>
      </thead>
      <tbody id="production-orders-table" class="bg-white divide-y divide-gray-100">
        <% @production_orders.each do |order| %>
          <% order.production_order_items.each do |item| %>
            <% bom_number, finished_good = item.bom.to_s.split(",", 2) %>
            <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 border-r border-gray-300">
            <% if item.sku_id.present? && item.item_name.present? %>
              <%= form_with url: bom_details_production_order_path(order.id), method: :post, class: "inline", data: { turbo: false } do %>
              <%= hidden_field_tag :quantity, item.quantity %>
              <%= submit_tag order.pid, class: "text-blue-600 hover:underline bg-transparent border-none p-0 cursor-pointer" %>
            <% end %>
            <% else %>
              <%= order.pid %>
            <% end %>
          </td>        
              <% item_master = ItemMaster.find_by(id: item.item_master_id) %>
              <td class="px-4 py-3 border-r border-gray-300"><%= bom_number %></td>
              <td class="px-4 py-3 border-r border-gray-300"><%= item.sku_id %></td>
              <td class="px-4 py-3 border-r border-gray-300"><%= item_master&.opening_stock %></td>
              <td class="px-4 py-3 border-r border-gray-300"><%= item_master&.item_name %></td>
              <td class="px-4 py-3 border-r border-gray-300"><%= order.executed ? "Yes" : "No" %></td>
              <td class="px-4 py-3 border-r border-gray-300">
                <% unless order.executed %>
                  <%= button_to production_order_path(order),
                      method: :delete,
                      data: { confirm: "Are you sure you want to delete this Production Order?" },
                      class: "bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded-full text-sm cursor-pointer" do %>
                    <i class="fa-solid fa-trash"></i> 
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>


    <div class="flex items-center justify-between px-4 py-4 border-t border-gray-200 bg-gray-50 text-sm text-gray-600">
					<div>
						Showing 
						<%= @production_orders.offset_value + 1 %> -
						<%= [@production_orders.offset_value + @production_orders.length, @production_orders.total_entries].min %>
						of <%= @production_orders.total_entries %> results
					</div>

          <div class="flex items-center space-x-1">
          <%= will_paginate @production_orders,
            renderer: PaginationRenderer,
            previous_label: "&laquo;".html_safe,
            next_label: "&raquo;".html_safe,
            container: false %>
        </div>
			    </div>
  </div>
</div>
<div id="bom-detail-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
  <div class="bg-white p-6 rounded shadow max-w-lg w-full relative">
    <button id="close-bom-modal" class="absolute top-2 right-4 text-gray-500 hover:text-black text-xl">×</button>
    <div id="bom-detail-display" class="mt-4 text-sm text-gray-700">
      <!-- BOM details will be loaded here -->
    </div>
  </div>
</div>
</div>
<!-- JS for Search -->
<!-- JS for Search and BOM Fetch -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Search
    const input = document.getElementById("search-input");
    const rows = document.querySelectorAll("#production-orders-table tr");

    input.addEventListener("input", function () {
      const query = input.value.toLowerCase();
      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        row.style.display = rowText.includes(query) ? "" : "none";
      });
    });

    // BOM Fetch
    document.querySelectorAll(".show-bom-details").forEach(button => {
      button.addEventListener("click", () => {
        const skuId = button.dataset.sku;
        const itemName = button.dataset.itemName;

        fetch(`/boms/find_by_sku?sku_id=${encodeURIComponent(skuId)}&item_name=${encodeURIComponent(itemName)}`)
          .then(response => response.json())
          .then(data => {
            if (data.error) {
              alert("No BOM found for this Finished Good.");
              return;
            }

            let html = `<h2 class="font-bold mb-2">BOM: ${data.bom_name}</h2>`;
            html += "<ul class='list-disc pl-5'>";
            data.raw_materials.forEach(rm => {
              html += `<li>${rm.item_name} (${rm.sku_id}) - ${rm.quantity} ${rm.unit}</li>`;
            });
            html += "</ul>";

            document.getElementById("bom-detail-display").innerHTML = html;
            document.getElementById("bom-detail-modal").classList.remove("hidden");
          });
      });
    });

    // Close modal
    document.getElementById("close-bom-modal")?.addEventListener("click", () => {
      document.getElementById("bom-detail-modal").classList.add("hidden");
    });
  });
</script>
