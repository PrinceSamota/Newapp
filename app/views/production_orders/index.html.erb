<div class="pl-6 pr-6">
    <div class="bg-white  rounded-lg shadow-md border border-gray-200 mt-6">
  <!-- Header + Search + Add in one row -->
  <div class="flex flex-col md:flex-row justify-between items-center gap-3 mb-4 p-6 h-14">
    
    <!-- Title -->
    <h2 class="text-xl font-semibold w-full md:w-1/7 text-center md:text-left mt-4">
      Production Order
    </h2>

    <!-- Search Input -->
    <div class="relative  md:w-1/6 mt-4">
  <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">
    <i class="fa-solid fa-magnifying-glass"></i>
  </span>
  <input
    type="text"
    id="search-input"
    placeholder="PID, BOM or Finished Good..."
    class="border border-gray-300 pl-10 pr-4 py-2 rounded w-full text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
  />
</div>


    <!-- Add Button -->
    <%= link_to new_production_order_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300 mt-4" do %>
  <i class="fa-solid fa-plus"></i>
  <span class="font-semibold">Production Order</span>
<% end %>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm divide-y divide-gray-200 border border-gray-300 rounded">
      <thead class="bg-gray-100 text-gray-700 text-xs uppercase">
        <tr>
          <th class="px-4 py-3 text-left border-r border-gray-300">PID</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">BOM Number</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">Finished Good</th>
          <th class="px-4 py-3 text-left">Stage</th>
        </tr>
      </thead>
      <tbody id="production-orders-table" class="bg-white divide-y divide-gray-100">
        <% @production_orders.each do |order| %>
          <% order.production_order_items.each do |item| %>
            <% bom_number, finished_good = item.bom.to_s.split(",", 2) %>
            <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 border-r border-gray-300">
            <%= link_to order.pid,
                bill_of_material_bom_details_path(item.sku_id, item.item_name),
                class: "text-blue-600 hover:underline" %>
          </td>
              <td class="px-4 py-3 border-r border-gray-300"><%= bom_number %></td>
              <td class="px-4 py-3 border-r border-gray-300"><%= item.item_name%> </td>
            <td class="px-4 py-3 border-r border-gray-300"></td>

            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<div id="bom-detail-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
  <div class="bg-white p-6 rounded shadow max-w-lg w-full relative">
    <button id="close-bom-modal" class="absolute top-2 right-4 text-gray-500 hover:text-black text-xl">×</button>
    <div id="bom-detail-display" class="mt-4 text-sm text-gray-700">
      <!-- BOM details will be loaded here -->
    </div>
  </div>
</div>
</div>
<!-- JS for Search -->
<!-- JS for Search and BOM Fetch -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Search
    const input = document.getElementById("search-input");
    const rows = document.querySelectorAll("#production-orders-table tr");

    input.addEventListener("input", function () {
      const query = input.value.toLowerCase();
      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        row.style.display = rowText.includes(query) ? "" : "none";
      });
    });

    // BOM Fetch
    document.querySelectorAll(".show-bom-details").forEach(button => {
      button.addEventListener("click", () => {
        const skuId = button.dataset.sku;
        const itemName = button.dataset.itemName;

        fetch(`/boms/find_by_sku?sku_id=${encodeURIComponent(skuId)}&item_name=${encodeURIComponent(itemName)}`)
          .then(response => response.json())
          .then(data => {
            if (data.error) {
              alert("No BOM found for this Finished Good.");
              return;
            }

            let html = `<h2 class="font-bold mb-2">BOM: ${data.bom_name}</h2>`;
            html += "<ul class='list-disc pl-5'>";
            data.raw_materials.forEach(rm => {
              html += `<li>${rm.item_name} (${rm.sku_id}) - ${rm.quantity} ${rm.unit}</li>`;
            });
            html += "</ul>";

            document.getElementById("bom-detail-display").innerHTML = html;
            document.getElementById("bom-detail-modal").classList.remove("hidden");
          });
      });
    });

    // Close modal
    document.getElementById("close-bom-modal")?.addEventListener("click", () => {
      document.getElementById("bom-detail-modal").classList.add("hidden");
    });
  });
</script>
