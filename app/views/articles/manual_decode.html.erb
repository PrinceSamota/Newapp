<h1>Manual Article Number Decoder</h1>

<%= form_with url: manual_decode_path, method: :post, local: true do |f| %>
  <div>
    <%= f.label :article_number, "Enter Article Number:" %><br>
    <%= f.text_field :article_number, value: @article_number, required: true, class: "form-control", placeholder: "e.g. 000123456" %>
  </div>

  <div class="mt-2">
    <%= f.submit "Decode", class: "btn btn-primary" %>
  </div>
<% end %>

<% if @decoded.present? %>
  <h2 class="mt-4">Decoded Result:</h2>
  <table class="table table-bordered">
    <% @decoded.each do |key, value| %>
      <tr>
        <th><%= key.to_s.humanize %></th>
        <td><%= value.presence || "-" %></td>
      </tr>
    <% end %>
  </table>
<% end %>
