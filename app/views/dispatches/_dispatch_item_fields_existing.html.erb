<div class="dispatch-item mb-4">
  <%= f.hidden_field :id %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border border-gray-300 rounded-xl p-4 bg-gray-50 shadow-sm relative">
    <div class="relative searchable-wrapper w-full">
      <label class="block text-sm font-medium text-gray-700 mb-1">Order No</label>
      
      <input
        type="text"
        name="<%= "#{f.object_name}[order_no]" %>"
        value="<%= f.object.order_no %>"
        placeholder="Search Order No..."
        autocomplete="off"
        data-role="searchable-input"
        data-type="order_no"
        class="order-no-input w-full rounded-xl border border-gray-300 p-2.5 text-sm" />

      <ul class="absolute z-10 w-full bg-white border border-gray-300 rounded-md mt-1 max-h-60 overflow-y-auto hidden text-sm shadow-md"
          data-role="searchable-dropdown">
        <% OrderEntry.pluck(:order_no).each do |order_no| %>
          <li class="cursor-pointer px-3 py-2 hover:bg-blue-100"
              data-value="<%= order_no %>">
            <%= order_no %>
          </li>
        <% end %>
      </ul>
    </div>

    <%= f.hidden_field :quantity, value: "1" %>
    <%= f.hidden_field :_destroy %>

    <button type="button"
      class="remove-item absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer">
      ✕
    </button>
  </div>
</div>
<script>
document.addEventListener("turbo:load", () => {
  document.querySelectorAll("[data-role='searchable-input']").forEach((input) => {
    const dropdown = input.nextElementSibling;

    input.addEventListener("input", () => {
      const searchTerm = input.value.toLowerCase();
      const items = dropdown.querySelectorAll("li");
      let hasMatch = false;

      items.forEach((item) => {
        const match = item.textContent.toLowerCase().includes(searchTerm);
        item.style.display = match ? "block" : "none";
        if (match) hasMatch = true;
      });

      dropdown.classList.toggle("hidden", !hasMatch);
    });

    input.addEventListener("focus", () => {
      dropdown.classList.remove("hidden");
    });

    input.addEventListener("blur", () => {
      setTimeout(() => dropdown.classList.add("hidden"), 200); // give time to click
    });

    dropdown.querySelectorAll("li").forEach((item) => {
      item.addEventListener("click", () => {
        input.value = item.dataset.value;
        dropdown.classList.add("hidden");
      });
    });
  });
});
</script>