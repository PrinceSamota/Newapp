<div class="dispatch-item mb-4">
  <%= f.hidden_field :id %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border border-gray-300 rounded-t-xl p-4 bg-gray-50 shadow-sm relative">
    <div class="relative searchable-wrapper w-full">
      <label class="block text-sm font-medium text-gray-700 mb-1">Order Number</label>

      <input
        type="text"
        name="<%= "#{f.object_name}[order_no]" %>"
        value="<%= f.object.order_no %>"
        placeholder="Search Order Number..."
        autocomplete="off"
        data-role="searchable-input"
        class=" required-field order-no-input w-full rounded-xl border border-gray-300 p-2.5 text-sm" />

      <%= f.hidden_field :order_entry_id, class: "order-entry-id-field" %>

      <ul class="absolute z-10 w-full bg-white border border-gray-300 rounded-md mt-1 max-h-60 overflow-y-auto hidden text-sm shadow-md"
          data-role="searchable-dropdown">
        <% OrderEntry.select(:id, :order_no, :sku_number).distinct.each do |entry| %>
          <li class="cursor-pointer px-3 py-2 hover:bg-blue-100"
              data-id="<%= entry.id %>"
              data-value="<%= entry.order_no %>">
            <%= "#{entry.order_no} | #{entry.sku_number}" %>
          </li>
        <% end %>
      </ul>
    </div>

    <%= f.hidden_field :quantity, value: "1" %>
    <%= f.hidden_field :_destroy %>

    <button type="button"
      class="remove-item absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer">
      ✕
    </button>
  </div>
  <div class="order-details-container mt-3"></div>
</div>


<script>
document.addEventListener("turbo:load", () => {
  document.querySelectorAll("[data-role='searchable-input']").forEach((input) => {
    const wrapper = input.closest(".relative");
    const dropdown = wrapper.querySelector("[data-role='searchable-dropdown']");
    const hiddenIdField = wrapper.querySelector(".order-entry-id-field");

    // Show dropdown on focus
    input.addEventListener("focus", () => {
      dropdown.classList.remove("hidden");
    });

    input.addEventListener("input", () => {
      const searchTerm = input.value.toLowerCase();
      const items = dropdown.querySelectorAll("li");
      let hasMatch = false;

      items.forEach((item) => {
        const match = item.textContent.toLowerCase().includes(searchTerm);
        item.style.display = match ? "block" : "none";
        if (match) hasMatch = true;
      });

      dropdown.classList.toggle("hidden", !hasMatch);
    });

    input.addEventListener("blur", () => {
      setTimeout(() => dropdown.classList.add("hidden"), 200); 
    });

    dropdown.querySelectorAll("li").forEach((item) => {
      item.addEventListener("click", () => {
        input.value = item.dataset.value; 
        hiddenIdField.value = item.dataset.id; 
        dropdown.classList.add("hidden");
        fetch(`/dispatches/order_details?order_entry_id=${item.dataset.id}`, {
          headers: { "Accept": "text/vnd.turbo-stream.html" }
        })
        .then(response => response.text())
        .then(html => {
          wrapper.closest(".dispatch-item").querySelector(".order-details-container").innerHTML = html;
        });
      });
    });
  });
});
</script>