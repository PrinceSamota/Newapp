
<div class="dispatch-item mb-4">
  <%= f.hidden_field :id %>
<% disabled_order_no = f.object.persisted? %>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 border border-gray-300 rounded-t-xl p-4 bg-gray-50 shadow-sm relative">
 <div class="relative searchable-wrapper w-full">
      <label class="block text-sm font-medium text-gray-700 mb-1">Order No</label>

      <input
        type="text"
        name="<%= "#{f.object_name}[order_no]" %>"
        value="<%= f.object.order_no %>"
        placeholder="Search Order No..."
        autocomplete="off"
        data-role="searchable-input"
        class="order-no-input w-full rounded-xl border border-gray-300 p-2.5 text-sm" />

      <%= f.hidden_field :order_entry_id, class: "order-entry-id-field" %>

      <ul class="absolute z-10 w-full bg-white border border-gray-300 rounded-md mt-1 max-h-60 overflow-y-auto hidden text-sm shadow-md"
          data-role="searchable-dropdown">
        <% OrderEntry.select(:id, :order_no, :sku_number).distinct.each do |entry| %>
          <li class="cursor-pointer px-3 py-2 hover:bg-blue-100"
              data-id="<%= entry.id %>"
              data-value="<%= entry.order_no %>">
            <%= "#{entry.order_no} | #{entry.sku_number}" %>
          </li>
        <% end %>
      </ul>
    </div>
  <%= f.hidden_field :quantity, value: "1" %>
  <%= f.hidden_field :_destroy %>
  <% unless @dispatch.progress == "Dispatched" %>
  <button type="button"
    class="remove-item absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer">
    ✕
  </button>
  <% end %>
</div>


  <% order = OrderEntry.find_by(id: f.object.order_entry_id) %>
  <% item_master = ItemMaster.find_by(sku_id: order&.sku_number) %>
  <% if order.present? %>
    <div class="grid grid-cols-1 md:grid-cols-9 gap-3 bg-gray-50 border border-gray-200 rounded-b-xl p-4 text-sm">
      <div><label class="text-xs font-semibold text-gray-500">Article No</label><div><%= order.article_no %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">SKU Number</label><div><%= order.sku_number %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Quantity</label><div><%= order.qty %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Target Date</label><div><%= order.target_date %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Start Serial</label><div><%= order.start_serial_no %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">End Serial</label><div><%= order.end_serial_no %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Profile</label><div><%= order.profile %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">CCT</label><div><%= order.cct %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Cover Type</label><div><%= order.cover_type %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Length</label><div><%= order.length %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Wattage</label><div><%= order.wattage %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Voltage</label><div><%= order.voltage %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Loop</label><div><%= order.loop %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Item Type</label><div><%= order.item_type %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Fuse Type</label><div><%= order.fuse_type %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Remark</label><div><%= order.remark %></div></div>
      <div><label class="text-xs font-semibold text-gray-500">Status</label><div><%= order.status %></div></div>
      <% if item_master.present? %>
      <% if item_master.opening_stock < order.qty %>
        <div class="col-span-full text-red-600 font-semibold bg-red-100 border border-red-300 rounded p-2 mt-2" data-insufficient-stock="true">
          🚫 Not enough stock for SKU <strong><%= order.sku_number %></strong>. 
          Required: <%= order.qty %>, Available: <%= item_master.opening_stock %>
        </div>
      <% end %>
    <% else %>
      <div class="col-span-full text-red-500 mt-2">❗ SKU <%= order.sku_number %> not found in Item Master.</div>
    <% end %>
 
    </div>

  <% else %>
        <div class="text-red-500 text-sm mt-2">No order found for Order No: <%= f.object.order_no %></div>
  <% end %>
</div>
