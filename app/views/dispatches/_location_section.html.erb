<turbo-frame id="location_section">
  <div class="flex flex-col gap-2 w-full md:w-[500px]">
    <div class="flex justify-between items-center">
      <label class="text-sm font-semibold text-gray-700">Location</label>
      <button type="button" onclick="document.getElementById('newLocationForm').classList.toggle('hidden')" class="text-blue-600 text-xl font-bold">+</button>
    </div>

    <div class="flex items-center">
      <%= select_tag "dispatch[location_id]",
        options_from_collection_for_select(Location.where(org_id: current_user.org_id), :id, :name, selected_location_id),
        include_blank: "Select Location",
        class: "w-full rounded-md border border-gray-300 px-4 py-2 text-sm" %>
    </div>

    <!-- Inline form to add new location -->
    <div id="newLocationForm" class="mt-2 hidden">
      <div class="flex gap-2">
        <input id="new_location_name" type="text" placeholder="New location name" class="w-full rounded-md border px-3 py-2 text-sm" />
        <button type="button" onclick="submitNewLocation()" class="bg-green-600 text-white px-3 py-2 rounded text-sm whitespace-nowrap">Add</button>
      </div>
      <div id="location-errors" class="text-red-600 text-sm mt-2"></div>
    </div>

    <% if flash[:location_errors].present? %>
      <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
        <% flash[:location_errors].each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</turbo-frame>
