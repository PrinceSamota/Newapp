<%= turbo_stream.update "modal" do %>
    <div class="fixed inset-0 bg-black/50 z-40" onclick="closeModal()"> <!-- Overlay -->
      <div class="slide-in relative z-50 bg-white h-full w-[800px] ml-auto shadow-xl overflow-y-auto" onclick="event.stopPropagation()">
        <!-- Close Button -->
        <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-500 hover:text-gray-700 text-2xl leading-none cursor-pointer">
          <i class="fa-solid fa-x"></i>
        </button>
  
        <!-- Form Partial -->
        <%= render "form", dispatch: @dispatch %>
      </div>
    </div>
  <% end %>
  