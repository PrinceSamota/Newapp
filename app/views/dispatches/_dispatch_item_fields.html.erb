<%= fields_for "dispatch[dispatch_items_attributes][#{index}]", dispatch_item do |f| %>
  <div class="dispatch-item relative grid grid-cols-1 md:grid-cols-2 gap-4 mb-6 border border-gray-300 rounded-lg p-4 shadow-sm bg-gray-50">

    <!-- Order Number (Searchable Input) -->
    <div class="relative searchable-wrapper w-full">
      <%= f.label :order_no, "Order Number", class: "block text-sm font-medium text-gray-700 mb-1" %>

      <input
        type="text"
        name="<%= "#{f.object_name}[order_no]" %>"
        value="<%= f.object.order_no %>"
        placeholder="Search Order Number..."
        autocomplete="off"
        data-role="searchable-input"
        class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" />

      <ul class="absolute z-10 w-full bg-white border border-gray-300 rounded-md mt-1 max-h-60 overflow-y-auto hidden text-sm shadow-md"
          data-role="searchable-dropdown">
        <% OrderEntry.pluck(:order_no).uniq.each do |order_no| %>
          <li class="cursor-pointer px-3 py-2 hover:bg-blue-100"
              data-value="<%= order_no %>">
            <%= order_no %>
          </li>
        <% end %>
      </ul>
    </div>

    <!-- Quantity -->
    <%= f.hidden_field :quantity, value: "1" %>

    <!-- Hidden field for destroy -->
    <%= f.hidden_field :_destroy %>

    <!-- Remove Button -->
    <button type="button"
      class="remove-item absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer">
      ✕
    </button>
  </div>
<% end %>
