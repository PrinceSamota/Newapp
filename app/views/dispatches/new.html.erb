<%= link_to dispatches_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300 w-22 mt-5" do %>
  <i class="fa-solid fa-arrow-left"></i>
  <span class="font-bold">Back</span>
<% end %>

<% if @dispatch.errors.any? %>
  <div class="bg-red-100 border border-red-300 text-red-800 p-4 rounded-lg mb-4">
    <p class="font-semibold">Please fix the following errors:</p>
    <ul class="mt-2 list-disc list-inside text-sm">
      <% @dispatch.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @dispatch, local: true, html: { id: "dispatch-form" } do |f| %>
  <div class="mx-auto bg-white p-8 rounded-2xl shadow-md mt-8 space-y-6">

    <h2 class="text-2xl font-semibold text-gray-800">Create Dispatch</h2>

    <!-- Grid Fields -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 border-b border-gray-300 pb-6">

      <!-- Location (Turbo Frame) -->
  
       <!-- 
          <%#= render partial: "dispatches/location_section", locals: { selected_location_id: @dispatch.location_id } %>
        </div> --!>
      

      <!-- Dispatch Date -->
      <div>
        <%= f.label :dispatch_date, "Dispatch Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :dispatch_date, class: "w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:ring-blue-500 focus:border-blue-500 " %>
      </div>

      <!-- Delivery Date -->
      <div>
        <%= f.label :delivery_date, "Delivery Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.date_field :delivery_date, class: "w-full border border-gray-300 rounded-md px-4 py-2 text-sm focus:ring-blue-500 focus:border-blue-500" %>
      </div>

      <!-- Courier Company -->
      <div>
        <%= f.label :courier_company, "Courier Company", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :courier_company, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none " %>
      </div>

      <!-- Mode of Shipment (Optional) -->
      <div>
        <%= f.label :mode_of_shipment, "Mode of Shipment", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :mode_of_shipment, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
      </div>
<%= f.hidden_field :progress, value: "Shipment" %>
      <!-- Tracking No. -->
      <div>
        <%= f.label :track_no, "Tracking No.", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :track_no, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none " %>
      </div>

    </div>

    <!-- Dispatch Items -->
    <div>
      <h3 class="text-lg font-semibold text-gray-800 mb-2">Dispatch Items</h3>
      <div id="dispatch-items" class="space-y-4">
        <%= f.fields_for :dispatch_items do |item_form| %>
          <%= render partial: 'dispatch_item_fields_existing', locals: { f: item_form } %>
        <% end %>
      </div>

      <!-- Add Item Button -->
      <div class="mt-2">
        <button type="button" id="add-item" class="mt-4 bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">+ Add Order</button>
      </div>
    </div>

    <!-- Submit -->
    <div class="text-right">
      <%= f.submit "Save", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg cursor-pointer" %>
    </div>

  </div>
<% end %>

<!-- Scripts -->
<script>
document.addEventListener("turbo:load", function () {
  const addItemBtn = document.getElementById("add-item");
  const container = document.getElementById("dispatch-items");
  const form = document.getElementById("dispatch-form");

  if (!addItemBtn || !form) return;

  if (addItemBtn.dataset.listenerAttached === "true") return;
  addItemBtn.dataset.listenerAttached = "true";

  let index = <%= @dispatch.dispatch_items.size %>;

  addItemBtn.addEventListener("click", function () {
    fetch("<%= new_item_row_dispatches_path %>?index=" + index)
      .then(response => response.text())
      .then(html => {
        container.insertAdjacentHTML("beforeend", html);
        index++;
      });
  });

  container.addEventListener("click", function (e) {
    if (e.target.classList.contains("remove-item")) {
      const item = e.target.closest(".dispatch-item");
      if (item.querySelector('input[name*="_destroy"]')) {
        item.querySelector('input[name*="_destroy"]').value = "1";
        item.style.display = "none";
      } else {
        item.remove();
      }
    }
  });

  // Frontend Validation
  form.addEventListener("submit", function (e) {
    let valid = true;
    const requiredFields = form.querySelectorAll(".required-field");

    requiredFields.forEach((field) => {
      const hasValue = field.value.trim() !== "";
      field.classList.remove("border-red-500");
      if (field.nextElementSibling && field.nextElementSibling.classList.contains("text-red-500")) {
        field.nextElementSibling.remove();
      }

      if (!hasValue) {
        field.classList.add("border-red-500");
        const error = document.createElement("p");
        error.classList.add("text-red-500", "text-xs", "mt-1");
        error.textContent = "This field is required";
        field.after(error);
        valid = false;
      }
    });

    // Validate location manually
    const locationSelect = document.querySelector("#dispatch_location_id");
    if (locationSelect && !locationSelect.value) {
      locationSelect.classList.add("border-red-500");
      if (!locationSelect.nextElementSibling || !locationSelect.nextElementSibling.classList.contains("text-red-500")) {
        const error = document.createElement("p");
        error.classList.add("text-red-500", "text-xs", "mt-1");
        error.textContent = "Please select a location";
        locationSelect.after(error);
      }
      valid = false;
    }

    if (!valid) e.preventDefault();
  });
});

// New Location JS
function submitNewLocation() {
  const name = document.getElementById('new_location_name').value;

  fetch("/locations", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
      "Accept": "text/vnd.turbo-stream.html"
    },
    body: JSON.stringify({ location: { name: name } })
  })
  .then(response => response.text())
  .then(html => {
    document.getElementById("location_section").innerHTML = html;
  })
  .catch(error => {
    document.getElementById("location-errors").innerText = "Something went wrong.";
    console.error(error);
  });
}
</script>
