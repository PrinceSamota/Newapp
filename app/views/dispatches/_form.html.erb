<%= form_with(model: dispatch, local: true) do |f| %>
  <!-- Dispatch main fields -->
  <div class="mb-4">
    <%= f.label :client_id, "Client", class: "block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :client_id, Client.all, :id, :name, include_blank: "Select Client", class: "w-full border p-2 rounded" %>
  </div>

  <div class="mb-4">
    <%= f.label :dispatch_date, "Dispatch Date", class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :dispatch_date, class: "w-full border p-2 rounded" %>
  </div>

  <div class="mb-4">
    <%= f.label :delivery_date, "Delivery Date", class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :delivery_date, class: "w-full border p-2 rounded" %>
  </div>

  <h3 class="font-bold text-lg my-4">Dispatch Items</h3>

  <%= f.fields_for :dispatch_items do |item_fields| %>
    <div class="bg-gray-100 p-4 rounded-lg mb-4">
      <div class="mb-2">
        <%= item_fields.label :order_no, "Order Number", class: "block text-sm font-medium text-gray-700" %>
        <%= item_fields.select :order_no,
              options_from_collection_for_select(OrderEntry.all, :order_no, :order_no, item_fields.object.order_no),
              { include_blank: "Select Order No" },
              class: "w-full border p-2 rounded" %>
      </div>

      <div class="mb-2">
        <%= item_fields.label :quantity %>
        <%= item_fields.number_field :quantity, class: "w-full border p-2 rounded" %>
      </div>

    </div>
  <% end %>

  <%= f.submit "Create Dispatch", class: "bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700" %>
<% end %>
