<tr class="hover:bg-gray-50 text-left border-b border-gray-200" 
data-order="<%= dispatch.dispatch_items.map(&:order_no).join(' ').downcase %>"
data-client="<%= dispatch.client.name.downcase %>"
data-courier="<%= dispatch.courier_company.to_s.downcase %>"
data-dispatch-items="<%= dispatch.dispatch_items.map(&:order_no).join(' ').downcase %>">
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200">
    <%= link_to(dispatch.client&.name || "N/A", edit_dispatch_path(dispatch), class: "text-blue-600 hover:underline") %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200">
    <%= dispatch.dispatch_date&.strftime("%d-%b-%Y") || "N/A" %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200">
    <%= dispatch.delivery_date&.strftime("%d-%b-%Y") || "N/A" %>
  </td>
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200">
  <%= dispatch.courier_company || "N/A" %>
</td>
<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200">
<%= dispatch.mode_of_shipment || "N/A" %>
</td>
</tr>
