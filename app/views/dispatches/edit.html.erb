<%= link_to dispatches_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 border border-gray-300" do %>
  <i class="fa-solid fa-arrow-left"></i>
  <span class="font-bold">Back</span>
<% end %>

<%= form_with(model: @dispatch, local: true) do |f| %>
  <div class="max-w-[100%] mx-auto mt-10 bg-white border border-gray-200 rounded-2xl shadow p-8 space-y-6">
    <h2 class="text-2xl font-bold text-gray-800">Edit Dispatch</h2>

    <!-- TOP SECTION -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Location</label>
        <%= f.collection_select :location_id, Location.all, :id, :name, { prompt: 'Select Location' }, class: "w-full rounded-xl border border-gray-300 p-2.5" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Dispatch Date</label>
        <%= f.date_field :dispatch_date, class: "w-full rounded-xl border border-gray-300 p-2.5" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Delivery Date</label>
        <%= f.date_field :delivery_date, class: "w-full rounded-xl border border-gray-300 p-2.5" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Mode of Shipment</label>
        <%= f.text_field :mode_of_shipment, class: "w-full rounded-xl border border-gray-300 p-2.5" %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Courier Company</label>
        <%= f.text_field :courier_company, class: "w-full rounded-xl border border-gray-300 p-2.5" %>
      </div>
    </div>

    <!-- DISPATCH ITEMS SECTION -->
    <h3 class="text-lg font-semibold text-gray-700 pt-4">Dispatch Items</h3>

    <div class="">
      <% @dispatch.dispatch_items.each_with_index do |item, index| %>
        <%= fields_for "dispatch[dispatch_items_attributes][#{index}]", item do |df| %>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border border-gray-300 rounded-t-xl p-4 bg-gray-50 shadow-sm mt-8">
            <!-- Order No -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Order No</label>
              <%= df.text_field :order_no, class: "w-full rounded-xl border border-gray-300 p-2.5" %>
            </div>

            <!-- Quantity -->
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Quantity</label>
              <%= df.number_field :quantity, step: 1, class: "w-full rounded-xl border border-gray-300 p-2.5" %>
            </div>
          </div>

          <!-- SHOW ORDER ENTRY DETAILS -->
          <% order = OrderEntry.find_by(order_no: item.order_no) %>
          <% if order.present? %>
            <div class="grid grid-cols-1 md:grid-cols-9 gap-3 bg-gray-50 border border-gray-200 rounded-b-xl p-4 text-sm">
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Article No</label>
                <div class="text-gray-800"><%= order.article_no %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">SKU Number</label>
                <div class="text-gray-800"><%= order.sku_number %></div>
              </div>
              <div>
              <label class="text-xs font-semibold text-gray-500 block">Quantity</label>
              <div class="text-gray-800"><%= order.qty %></div>
            </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Target Date</label>
                <div class="text-gray-800"><%= order.target_date %></div>
              </div>
              <div>
              <label class="text-xs font-semibold text-gray-500 block">Start Seria</label>
              <div class="text-gray-800"><%= order.start_serial_no %></div>
            </div>
            <div>
            <label class="text-xs font-semibold text-gray-500 block">End Serial</label>
            <div class="text-gray-800"><%= order.end_serial_no %></div>
          </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Profile</label>
                <div class="text-gray-800"><%= order.profile %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">CCT</label>
                <div class="text-gray-800"><%= order.cct %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Cover Type</label>
                <div class="text-gray-800"><%= order.cover_type %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Length</label>
                <div class="text-gray-800"><%= order.length %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Wattage</label>
                <div class="text-gray-800"><%= order.wattage %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Voltage</label>
                <div class="text-gray-800"><%= order.voltage %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Loop</label>
                <div class="text-gray-800"><%= order.loop %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Item Type</label>
                <div class="text-gray-800"><%= order.item_type %></div>
              </div>
              <div>
                <label class="text-xs font-semibold text-gray-500 block">Fuse Type</label>
                <div class="text-gray-800"><%= order.fuse_type %></div>
              </div>
              <div>
              <label class="text-xs font-semibold text-gray-500 block">Remark</label>
              <div class="text-gray-800"><%= order.remark %></div>
            </div>
            <div>
            <label class="text-xs font-semibold text-gray-500 block">Status</label>
            <div class="text-gray-800"><%= order.status&.name %></div>
          </div>
            </div>
          <% else %>
            <div class="text-red-500 text-sm mt-2">No order found for Order No: <%= item.order_no %></div>
          <% end %>
        <% end %>          
      <% end %>
    </div>

    <!-- SUBMIT BUTTON -->
    <div class="flex justify-end pt-6">
      <%= f.submit "Update Dispatch", class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm cursor-pointer" %>
    </div>
  </div>
<% end %>
