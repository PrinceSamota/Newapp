<%= link_to dispatches_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 border border-gray-300" do %>
  <i class="fa-solid fa-arrow-left"></i>
  <span class="font-bold">Back</span>
<% end %>

<%= form_with(model: @dispatch, local: true) do |f| %>
  <% disabled = @dispatch.progress == "Dispatched" %>

  <div class="max-w-[100%] mx-auto mt-10 bg-white border border-gray-200 rounded-2xl shadow p-8 space-y-6">
  <div class="flex justify-between mt-0">
    <h2 class="text-2xl font-bold text-gray-800">Edit Dispatch</h2>
    <div class="flex justify-end mt-0">
    <%= link_to download_pdf_dispatch_path(@dispatch, format: :pdf),
    class: "flex items-center gap-2 text-white bg-red-600 hover:bg-red-700 rounded-md p-2 w-fit",
    target: "_blank" do %>
      <i class="fa-solid fa-file-pdf"></i>
      <span class="font-bold">Download PDF</span>
    <% end %>
  </div>
  </div>

    <!-- TOP SECTION -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Dispatch Date</label>
        <%= f.date_field :dispatch_date, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Delivery Date</label>
        <%= f.date_field :delivery_date, class: "w-full rounded-xl border border-gray-300 p-2.5"%>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Mode of Shipment</label>
        <%= f.text_field :mode_of_shipment, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Tracking No</label>
        <%= f.text_field :track_no, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Invoice No</label>
      <%= f.text_field :invoice_no, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
    </div>
    <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Courier Company</label>
    <%= f.text_field :courier_company, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
  </div>
      <div>
        <%= f.label :progress, "Progress", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :progress,
              options_for_select([["Shipment", "Shipment"], ["Dispatched", "Dispatched"]], selected: f.object.progress || "Shipment"),
              {},
              class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none",
              disabled: disabled %>
      </div>
    </div>

    <!-- DISPATCH ITEMS SECTION -->
    <h3 class="text-lg font-semibold text-gray-700 pt-4">Dispatch Items</h3>

 
    <div id="dispatch-items">
    <%= f.fields_for :dispatch_items do |dispatch_item_form| %>
      <%= render 'dispatch_item_fields_edit', f: dispatch_item_form %>
    <% end %>
</div>
<% unless disabled %>
  <div class="mt-4">
    <button type="button" id="add-item" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">
      + Add Order
    </button>
  </div>
<% end %>
    <!-- SUBMIT BUTTON or MESSAGE -->
    <% unless disabled %>
      <div class="flex justify-end pt-6">
        <%= f.submit "Update Dispatch", class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm cursor-pointer" %>
      </div>
    <% else %>
      <div class="flex justify-end pt-6">
        <%= f.submit "Update Dispatch Date", class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% end %>
<script>
  document.addEventListener("turbo:load", function () {
    const addItemBtn = document.getElementById("add-item");
    const container = document.getElementById("dispatch-items");
    if (!addItemBtn || !container) return;

    if (addItemBtn.dataset.listenerAttached === "true") return;
    addItemBtn.dataset.listenerAttached = "true";

    let index = container.querySelectorAll(".dispatch-item").length;

    addItemBtn.addEventListener("click", function () {
      fetch("<%= new_item_row_dispatches_path %>?index=" + index)
        .then(response => response.text())
        .then(html => {
          container.insertAdjacentHTML("beforeend", html);
          index++;
          initSearchableDropdowns();
        });
    });

    container.addEventListener("click", function (e) {
      if (e.target.classList.contains("remove-item")) {
        const item = e.target.closest(".dispatch-item");
        const destroyFlag = item.querySelector("input[name*='_destroy']");
        if (destroyFlag) {
          destroyFlag.value = "1";
          item.style.display = "none";
        } else {
          item.remove();
        }
      }
    });
  });
  document.addEventListener("turbo:load", function () {
    const checkStockAndToggleButton = () => {
      const errorBlocks = document.querySelectorAll("[data-insufficient-stock='true']");
      const submitBtn = document.querySelector("input[type='submit']");
      const progressSelect = document.querySelector("select[name='dispatch[progress]']");

      if (!submitBtn || !progressSelect) return;

      const isDispatching = progressSelect.value === "Dispatched";

      if (isDispatching && errorBlocks.length > 0) {
        submitBtn.disabled = true;
        submitBtn.classList.add("opacity-50", "cursor-not-allowed");
        submitBtn.title = "Cannot update: insufficient stock.";
      } else {
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
        submitBtn.title = "";
      }
    };

    checkStockAndToggleButton(); 
    const container = document.getElementById("dispatch-items");
    if (container) {
      const observer = new MutationObserver(() => {
        setTimeout(checkStockAndToggleButton, 200);
      });
      observer.observe(container, { childList: true, subtree: true });
    }


    const progressSelect = document.querySelector("select[name='dispatch[progress]']");
    if (progressSelect) {
      progressSelect.addEventListener("change", checkStockAndToggleButton);
    }
  });

  document.addEventListener("turbo:load", initSearchableDropdowns);
  document.addEventListener("turbo:frame-load", initSearchableDropdowns);  

function initSearchableDropdowns() {
  document.querySelectorAll("[data-role='searchable-input']:not([data-bound='true'])").forEach((input) => {
    input.dataset.bound = "true";
    const wrapper = input.closest(".searchable-wrapper");
    const dropdown = wrapper.querySelector("[data-role='searchable-dropdown']");
    const hiddenIdField = wrapper.querySelector(".order-entry-id-field");

    input.addEventListener("focus", () => {
      dropdown.classList.remove("hidden");
    });

    input.addEventListener("input", () => {
      const searchTerm = input.value.toLowerCase();
      let hasMatch = false;
      dropdown.querySelectorAll("li").forEach((item) => {
        const match = item.textContent.toLowerCase().includes(searchTerm);
        item.style.display = match ? "block" : "none";
        if (match) hasMatch = true;
      });
      dropdown.classList.toggle("hidden", !hasMatch);
    });

    dropdown.querySelectorAll("li").forEach((item) => {
      item.addEventListener("click", () => {
        input.value = item.dataset.value;
        hiddenIdField.value = item.dataset.id;
        dropdown.classList.add("hidden");
        fetch(`/dispatches/order_details?order_entry_id=${item.dataset.id}`, {
          headers: { "Accept": "text/vnd.turbo-stream.html" }
        })
        .then(response => response.text())
        .then(html => {
          wrapper.closest(".dispatch-item").querySelector(".order-details-container").innerHTML = html;
        });
      });
    });

    input.addEventListener("blur", () => {
      setTimeout(() => dropdown.classList.add("hidden"), 200);
    });
  });
}

document.addEventListener("turbo:load", initSearchableDropdowns);
document.addEventListener("turbo:frame-load", initSearchableDropdowns); 
</script>
