<% content_for(:title, "Dispatch Management") %>
<%= link_to dispatches_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 border border-gray-300" do %>
  <i class="fa-solid fa-arrow-left"></i>
  <span class="font-bold">Back</span>
<% end %>

<%= form_with(model: @dispatch, local: true) do |f| %>
  <% if @dispatch.errors.any? %>
    <div class="fixed top-4 right-4 bg-red-500 text-white px-6 py-4 rounded-lg shadow-lg z-50 max-w-md animate-pulse">
      <div class="flex items-start justify-between">
        <div>
          <div class="flex items-center">
            <i class="fa-solid fa-exclamation-triangle mr-2"></i>
            <strong>Error!</strong>
          </div>
          <div class="mt-2 text-sm">
            <% @dispatch.errors.full_messages.each do |message| %>
              <div><%= message %></div>
            <% end %>
          </div>
        </div>
        <button type="button" onclick="this.parentElement.parentElement.remove()" class="ml-4 text-white hover:text-gray-200 text-2xl cursor-pointer">
          ×
        </button>
      </div>
    </div>
  <% end %>

  <% disabled = @dispatch.progress == "Dispatched" %>

  <div class="max-w-[100%] mx-auto mt-10 bg-white border border-gray-200 rounded-2xl shadow p-8 space-y-6">
  <div class="flex justify-between mt-0">
    <h2 class="text-2xl font-bold text-gray-800">Edit Dispatch</h2>
    <div class="flex justify-end mt-0 gap-3">
    <% if @input.present? %>
    <% if @input.status == "draft" %>
      <!-- If input is a draft -->
      <%= link_to edit_input_path(@input), 
          class: "flex items-center gap-2 text-white bg-yellow-600 hover:bg-yellow-600 rounded-md p-2 w-fit" do %>
        <i class="fa-solid fa-pen-to-square"></i>
        <span class="font-bold">View Draft</span>
      <% end %>
    <% else %>
      <!-- If input is completed -->
      <%= link_to input_path(@input), 
          class: "flex items-center gap-2 text-white bg-blue-600 hover:bg-blue-700 rounded-md p-2 w-fit" do %>
        <i class="fa-solid fa-eye"></i>
        <span class="font-bold">View Input</span>
      <% end %>
    <% end %>
  <% else %>
    <!-- If no input exists yet -->
    <%= link_to new_input_path(from_dispatch: true, dispatch_id: @dispatch.id), 
        class: "flex items-center gap-2 text-white bg-green-600 hover:bg-green-700 rounded-md p-2 w-fit" do %>
      <i class="fa-solid fa-file-import"></i>
      <span class="font-bold">Create Input</span>
    <% end %>
  <% end %>
  
      
      <%= link_to download_pdf_dispatch_path(@dispatch, format: :pdf),
          class: "flex items-center gap-2 text-white bg-red-600 hover:bg-red-700 rounded-md p-2 w-fit",
          target: "_blank" do %>
        <i class="fa-solid fa-file-pdf"></i>
        <span class="font-bold">Download PDF</span>
      <% end %>
    </div>
  </div>

    <!-- TOP SECTION -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Dispatch Date</label>
        <%= f.date_field :dispatch_date, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Delivery Date</label>
        <%= f.date_field :delivery_date, class: "w-full rounded-xl border border-gray-300 p-2.5"%>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Mode of Shipment</label>
        <%= f.text_field :mode_of_shipment, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Tracking No</label>
        <%= f.text_field :track_no, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Invoice No</label>
    
      <%= f.text_field :invoice_no,
          value: (@dispatch.inputs.last&.invoice_no || @dispatch.invoice_no),
          class: "w-full rounded-xl border border-gray-300 p-2.5" %>
    </div>
    <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Courier Company</label>
    <%= f.text_field :courier_company, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
  </div>


      <div>
        <%= f.label :progress, "Progress", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :progress,
              options_for_select([["Shipment", "Shipment"], ["Dispatched", "Dispatched"]], selected: f.object.progress || "Shipment"),
              {},
              class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none",
              disabled: disabled %>
      </div>

        <div>
          <label class="block text-sm font-medium">Row Color</label>
          <%= f.select :color,
              dispatch_color_options_html.map { |name, value| 
                [
                  "<span style='display:flex; align-items:center; gap:6px;'>
                    <span style='display:inline-block; width:15px; height:15px; border:1px solid #555; background:#{value};'></span>
                    #{name}
                  </span>".html_safe,
                  value
                ] 
              },
              { include_blank: "Select Color" },
              class: "border rounded p-1 w-full",
              style: "font-size:14px;" %>
        </div>

    </div>

    <!-- DISPATCH ITEMS SECTION -->
    <h3 class="text-lg font-semibold text-gray-700 pt-4">Dispatch Items</h3>

    <p id="dispatch-warning-message" class="text-red-600 text-sm mt-2 hidden"></p>
    <div id="dispatch-items">
    <%= f.fields_for :dispatch_items do |dispatch_item_form| %>
      <%= render 'dispatch_item_fields_edit', f: dispatch_item_form %>
    <% end %>
</div>
<% unless disabled %>
  <div class="mt-4">
    <button type="button" id="add-item" class="bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">
      + Add Order
    </button>
  </div>
<% end %>
    <!-- SUBMIT BUTTON or MESSAGE -->
    <% unless disabled %>
      <div class="flex justify-end pt-6">
        <%= f.submit "Update Dispatch", class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm cursor-pointer" %>
      </div>
    <% else %>
      <div class="flex justify-end pt-6">
        <%= f.submit "Update Dispatch Date", class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% end %>

<script>
document.addEventListener("turbo:load", function () {
  const addItemBtn = document.getElementById("add-item");
  const container = document.getElementById("dispatch-items");

  if (addItemBtn && container && addItemBtn.dataset.listenerAttached !== "true") {
    addItemBtn.dataset.listenerAttached = "true";
    let index = container.querySelectorAll(".dispatch-item").length;

    addItemBtn.addEventListener("click", function () {
      fetch("<%= new_item_row_dispatches_path %>?index=" + index)
        .then(r => r.text())
        .then(html => {
          container.insertAdjacentHTML("beforeend", html);
          index++;
          initSearchableDropdowns();
        });
    });

    container.addEventListener("click", function (e) {
      if (e.target.classList.contains("remove-item")) {
        const item = e.target.closest(".dispatch-item");
        const destroyFlag = item.querySelector("input[name*='_destroy']");
        if (destroyFlag) {
          destroyFlag.value = "1";
          item.style.display = "none";
        } else {
          item.remove();
        }
      }
    });
  }

  function checkDispatchValidation() {
    const submitBtn = document.querySelector("input[type='submit']");
    const progressSelect = document.querySelector("select[name='dispatch[progress]']");
    const warningMessage = document.getElementById("dispatch-warning-message");
  
    if (!submitBtn || !progressSelect || !warningMessage) return;
  
    const isDispatching = progressSelect.value?.trim().toLowerCase() === "dispatched";
  
    const orderItems = Array.from(document.querySelectorAll(".dispatch-item"));
    let hasMissingMfgDate = false;
    let hasMissingVarNo = false;
    let hasMissingReceivingDate = false;
    let hasInsufficientStock = false;
    const skuTotals = {};
  
    orderItems.forEach(item => {
      // Check for hidden or deleted items (ignore them)
      if (item.style.display === "none") return;
  
      const grid = item.querySelector("[data-sku]");
      if (!grid) return;
  
      const sku = grid.dataset.sku;
      const qty = parseInt(grid.dataset.requiredQty) || 0;
      const available = parseInt(grid.dataset.availableStock) || 0;
  
      if (!skuTotals[sku]) {
        skuTotals[sku] = { required: 0, available: available, rows: [] };
      }
      skuTotals[sku].required += qty;
      skuTotals[sku].rows.push(item);
  
      // Previous checks (MFG date, etc.)
      const mfgEl = item.querySelector("[data-field='mfg-date']");
      const varEl = item.querySelector("[data-field='var-no']");
      const recvEl = item.querySelector("[data-field='order-receiving-date']");
  
      const mfgText = mfgEl ? mfgEl.textContent.trim() : "";
      const varText = varEl ? varEl.textContent.trim() : "";
      const recvText = recvEl ? recvEl.textContent.trim() : "";
  
      const mfgMissing = !mfgText || mfgText === "-" || mfgText.toLowerCase() === "null";
      const varMissing = !varText || varText === "-" || varText.toLowerCase() === "null";
      const recvMissing = !recvText || recvText === "-" || recvText.toLowerCase() === "null";
  
      if (mfgMissing) {
        hasMissingMfgDate = true;
        mfgEl?.classList.add("border", "border-red-500", "rounded-md", "px-1");
      } else {
        mfgEl?.classList.remove("border", "border-red-500", "rounded-md", "px-1");
      }
  
      if (varMissing) {
        hasMissingVarNo = true;
        varEl?.classList.add("border", "border-red-500", "rounded-md", "px-1");
      } else {
        varEl?.classList.remove("border", "border-red-500", "rounded-md", "px-1");
      }
  
      if (recvMissing) {
        hasMissingReceivingDate = true;
        recvEl?.classList.add("border", "border-red-500", "rounded-md", "px-1");
      } else {
        recvEl?.classList.remove("border", "border-red-500", "rounded-md", "px-1");
      }
    });
  
    // Check combined stock
    Object.keys(skuTotals).forEach(sku => {
      const data = skuTotals[sku];
      const isInsufficient = data.required > data.available;
      
      data.rows.forEach(item => {
        const errorEl = item.querySelector(".combined-stock-error");
        if (errorEl) {
          if (isInsufficient) {
            hasInsufficientStock = true;
            errorEl.classList.remove("hidden");
            errorEl.dataset.insufficientStock = "true";
            
            if (data.rows.length > 1) {
              errorEl.innerHTML = `🚫 Not enough combined stock for SKU <strong>${sku}</strong>. <br> Required (All Rows): ${data.required}, Available: ${data.available}`;
            } else {
              errorEl.innerHTML = `🚫 Not enough stock for SKU <strong>${sku}</strong>. <br> Required: ${data.required}, Available: ${data.available}`;
            }
          } else {
            errorEl.classList.add("hidden");
            errorEl.dataset.insufficientStock = "false";
          }
        }
      });
    });
  
    const shouldDisable = isDispatching && (
      hasMissingMfgDate ||
      hasMissingVarNo ||
      hasMissingReceivingDate ||
      hasInsufficientStock
    );
  
    let messages = [];
  
    if (hasMissingMfgDate) messages.push("MFG Date");
    if (hasMissingVarNo) messages.push("VAR No");
    if (hasMissingReceivingDate) messages.push("Order Receiving Date");
    if (hasInsufficientStock) messages.push("Sufficient Stock");
  
    if (shouldDisable) {
      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-50", "cursor-not-allowed");
      warningMessage.classList.remove("hidden");
      warningMessage.textContent =
        `⚠️ Please ensure ${messages.join(", ")} for all Dispatch items before dispatch.`;
    } else {
      submitBtn.disabled = false;
      submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
      warningMessage.classList.add("hidden");
      warningMessage.textContent = "";
    }
  }

  

  checkDispatchValidation();

  const dispatchItemsContainer = document.getElementById("dispatch-items");
  if (dispatchItemsContainer) {
    const observer = new MutationObserver(() => setTimeout(checkDispatchValidation, 200));
    observer.observe(dispatchItemsContainer, { childList: true, subtree: true });
  }

  const progressSelect = document.querySelector("select[name='dispatch[progress]']");
  progressSelect?.addEventListener("change", checkDispatchValidation);

  if (typeof initSearchableDropdowns === "function") {
    initSearchableDropdowns();
  }
});


function initSearchableDropdowns() {
  document.querySelectorAll("[data-role='searchable-input']:not([data-bound='true'])").forEach((input) => {
    input.dataset.bound = "true";
    const wrapper = input.closest(".searchable-wrapper");
    const dropdown = wrapper.querySelector("[data-role='searchable-dropdown']");
    const hiddenIdField = wrapper.querySelector(".order-entry-id-field");

    input.addEventListener("focus", () => dropdown.classList.remove("hidden"));

    input.addEventListener("input", () => {
      const searchTerm = input.value.toLowerCase();
      let hasMatch = false;
      dropdown.querySelectorAll("li").forEach((item) => {
        const match = item.textContent.toLowerCase().includes(searchTerm);
        item.style.display = match ? "block" : "none";
        if (match) hasMatch = true;
      });
      dropdown.classList.toggle("hidden", !hasMatch);
    });

    dropdown.querySelectorAll("li").forEach((item) => {
      item.addEventListener("click", () => {
        input.value = item.dataset.value;
        hiddenIdField.value = item.dataset.id;
        dropdown.classList.add("hidden");

        fetch(`/dispatches/order_details?order_entry_id=${item.dataset.id}`, {
          headers: { "Accept": "text/vnd.turbo-stream.html" }
        })
        .then(response => response.text())
        .then(html => {
          wrapper.closest(".dispatch-item").querySelector(".order-details-container").innerHTML = html;
        });
      });
    });

    input.addEventListener("blur", () => setTimeout(() => dropdown.classList.add("hidden"), 200));
  });
}

document.addEventListener("turbo:load", initSearchableDropdowns);
document.addEventListener("turbo:frame-load", initSearchableDropdowns);
</script>
