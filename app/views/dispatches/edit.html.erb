<%= link_to dispatches_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 border border-gray-300" do %>
  <i class="fa-solid fa-arrow-left"></i>
  <span class="font-bold">Back</span>
<% end %>

<%= form_with(model: @dispatch, local: true) do |f| %>
  <% disabled = @dispatch.progress == "Dispatched" %>

  <div class="max-w-[100%] mx-auto mt-10 bg-white border border-gray-200 rounded-2xl shadow p-8 space-y-6">
    <h2 class="text-2xl font-bold text-gray-800">Edit Dispatch</h2>

    <!-- TOP SECTION -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Dispatch Date</label>
        <%= f.date_field :dispatch_date, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Delivery Date</label>
        <%= f.date_field :delivery_date, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Mode of Shipment</label>
        <%= f.text_field :mode_of_shipment, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Tracking No</label>
        <%= f.text_field :track_no, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
      </div>
      <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Invoice No</label>
      <%= f.text_field :invoice_no, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
    </div>
    <div>
    <label class="block text-sm font-medium text-gray-700 mb-1">Courier Company</label>
    <%= f.text_field :courier_company, class: "w-full rounded-xl border border-gray-300 p-2.5", disabled: disabled %>
  </div>
      <div>
        <%= f.label :progress, "Progress", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :progress,
              options_for_select([["Shipment", "Shipment"], ["Dispatched", "Dispatched"]], selected: f.object.progress || "Shipment"),
              {},
              class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none",
              disabled: disabled %>
      </div>
    </div>

    <!-- DISPATCH ITEMS SECTION -->
    <h3 class="text-lg font-semibold text-gray-700 pt-4">Dispatch Items</h3>

    <div>
      <% @dispatch.dispatch_items.each_with_index do |item, index| %>
        <%= fields_for "dispatch[dispatch_items_attributes][#{index}]", item do |df| %>
          <%= df.hidden_field :id %>

          <!-- Editable Fields -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 border border-gray-300 rounded-t-xl p-4 bg-gray-50 shadow-sm mt-8">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Order No</label>
              <%= df.select :order_no,
                    OrderEntry.pluck(:order_no, :order_no),
                    { include_blank: "Select Order Number" },
                    class: "w-full rounded-xl border border-gray-300 p-2.5",
                    disabled: disabled %>
            </div>

            
          </div>

          <!-- READONLY Order Entry Summary -->
          <% order = OrderEntry.find_by(order_no: item.order_no) %>
          <% if order.present? %>
            <div class="grid grid-cols-1 md:grid-cols-9 gap-3 bg-gray-50 border border-gray-200 rounded-b-xl p-4 text-sm">
              <div><label class="text-xs font-semibold text-gray-500">Article No</label><div><%= order.article_no %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">SKU Number</label><div><%= order.sku_number %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Quantity</label><div><%= order.qty %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Target Date</label><div><%= order.target_date %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Start Serial</label><div><%= order.start_serial_no %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">End Serial</label><div><%= order.end_serial_no %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Profile</label><div><%= order.profile %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">CCT</label><div><%= order.cct %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Cover Type</label><div><%= order.cover_type %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Length</label><div><%= order.length %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Wattage</label><div><%= order.wattage %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Voltage</label><div><%= order.voltage %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Loop</label><div><%= order.loop %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Item Type</label><div><%= order.item_type %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Fuse Type</label><div><%= order.fuse_type %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Remark</label><div><%= order.remark %></div></div>
              <div><label class="text-xs font-semibold text-gray-500">Status</label><div><%= order.status %></div></div>
            </div>
          <% else %>
            <div class="text-red-500 text-sm mt-2">No order found for Order No: <%= item.order_no %></div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <!-- SUBMIT BUTTON or MESSAGE -->
    <% unless disabled %>
      <div class="flex justify-end pt-6">
        <%= f.submit "Update Dispatch", class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm cursor-pointer" %>
      </div>
    <% else %>
      <div class="text-right pt-6 text-sm text-gray-500 italic">
        <strong>Dispatched</strong>. Editing is disabled.
      </div>
    <% end %>
  </div>
<% end %>
