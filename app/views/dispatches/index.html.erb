<div>
<div class="max-w-full mx-auto relative">
  <div class="flex flex-col md:flex-row justify-between items-center p-4 bg-white border border-gray-300 rounded-t-md shadow gap-4">
    <h1 class="text-xl font-semibold text-gray-800">Dispatched Orders</h1>
    <div class="relative w-full md:w-96">
    <%= search_form_for @q, url: dispatches_path, method: :get, html: { class: "flex items-center gap-2" } do |f| %>
      <div class="relative flex-1">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">
          <i class="fa-solid fa-magnifying-glass"></i>
        </span>
        <%= f.search_field :search_all_cont,
          placeholder: "Search by DID, Courier, or Mode of Shipment...",
          class: "pl-10 pr-4 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring focus:ring-blue-200 w-full" %>
      </div>
      <%= f.submit "Search",
        class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-150 ease-in-out cursor-pointer whitespace-nowrap" %>
    <% end %>
  </div>
  

    <%= link_to new_dispatch_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300 font-bold" do %>
      <i class="fa-solid fa-plus"></i>
      <span class="font-semibold">New Dispatch</span>
    <% end %>
  </div>

  

  <div class="overflow-x-auto max-h-[80vh] overflow-y-auto">
  <table class="min-w-full bg-white border border-gray-200 shadow-sm text-sm">
    <thead class="bg-gray-100 text-gray-700 text-sm sticky top-0 z-10">
      <tr>
        <th class="px-6 py-3 border-b border-gray-200 border-r border-gray-300 text-left">DID</th>
        <th class="px-6 py-3 border-b border-gray-200 border-r border-gray-300 text-left">Dispatch Date</th>
        <th class="px-6 py-3 border-b border-gray-200 border-r border-gray-300 text-left">Delivery Date</th>
        <th class="px-6 py-3 border-b border-gray-200 border-r border-gray-300 text-left">Courier Company</th>
        <th class="px-6 py-3 border-b border-gray-200 border-r border-gray-300 text-left">Mode of Shipment</th>
        <th class="px-6 py-3 border-b border-gray-200 border-r border-gray-300 text-left">Tracking No</th>
        <th class="px-6 py-3 border-b border-gray-200 border-r border-gray-300 text-left">Invoice No</th>
        <th class="px-6 py-3 border-b border-gray-200 border-r border-gray-300 text-left">Progress</th>
        <th class="px-6 py-3 border-b border-gray-200 text-left">Order Nos</th>
      </tr>
    </thead>
    <tbody class="text-sm" id="dispatches_list">
      <%= render partial: "dispatch_row", collection: @dispatches, as: :dispatch %>
    </tbody>
  </table>
</div>


<div class="flex items-center justify-between px-4 py-4 border-t border-gray-200 bg-gray-50 text-sm text-gray-600 shadow-lg">
					<div>
						Showing 
						<%= @dispatches.offset_value + 1 %> -
						<%= [@dispatches.offset_value + @dispatches.length, @dispatches.total_entries].min %>
						of <%= @dispatches.total_entries %> results
					</div>

          <div class="flex items-center space-x-1">
          <%= will_paginate @dispatches,
            renderer: PaginationRenderer,
            previous_label: "&laquo;".html_safe,
            next_label: "&raquo;".html_safe,
            container: false %>
        </div>
			    </div>
</div>
</div>

<script>
  function closeModal() {
    const modalFrame = document.getElementById("modal");
    const slideInDiv = modalFrame.querySelector(".slide-in");

    if (slideInDiv) {
      slideInDiv.classList.remove("slide-in");
      slideInDiv.classList.add("slide-out");

      setTimeout(() => {
        if (modalFrame) modalFrame.innerHTML = "";
      }, 300); 
    } else {
      if (modalFrame) modalFrame.innerHTML = "";
    }
  }
document.addEventListener("turbo:load", () => {
  const modalFrame = document.getElementById("modal");
  if (modalFrame) modalFrame.innerHTML = "";

  const openModalBtn = document.getElementById("open-modal-btn");

  if (openModalBtn && !openModalBtn.dataset.listenerAttached) {
    openModalBtn.dataset.listenerAttached = "true"; 

    openModalBtn.addEventListener("click", () => {
      fetch("<%= new_dispatch_path %>", {
        headers: { Accept: "text/vnd.turbo-stream.html" }
      })
        .then(response => response.text())
        .then(html => Turbo.renderStreamMessage(html));
    });
  }
});
document.addEventListener("turbo:load", function () {
  const searchInput = document.getElementById("dispatchSearch");
  const tableRows = document.querySelectorAll("#dispatches_list tr");

  searchInput.addEventListener("keyup", function () {
    const query = this.value.toLowerCase().trim();
    const numericQuery = query.replace(/[^0-9]/g, ""); 

    tableRows.forEach(row => {
      const order = row.dataset.order || "";
      const courier = row.dataset.courier || "";
      const dispatchItems = row.dataset.dispatchItems || "";
      const dispatchId = row.dataset.dispatchId || "";
      const combined = `${order} ${courier} ${dispatchItems} ${dispatchId}`.toLowerCase();

      let matches = combined.includes(query);

      const serialStart = parseInt(row.dataset.serialStart || "0");
      const serialEnd = parseInt(row.dataset.serialEnd || "0");
      const queryNum = parseInt(numericQuery);

      if (!matches && !isNaN(queryNum)) {
        if (queryNum >= serialStart && queryNum <= serialEnd) {
          matches = true;
        }
      }

      row.style.display = matches ? "" : "none";
    });
  });
});

function filterBySerialNumber(min, max) {
  document.querySelectorAll('tr[data-serial-start]').forEach(row => {
    const start = parseInt(row.dataset.serialStart || 0);
    const end = parseInt(row.dataset.serialEnd || 0);
    
    if ((min && start < min) || (max && end > max)) {
      row.style.display = "none";
    } else {
      row.style.display = "";
    }
  });
}

</script>

<style>
  @keyframes slideIn {
    to {
      transform: translateX(0%);
    }
  }

  @keyframes slideOut {
    to {
      transform: translateX(100%);
    }
  }

  .slide-in {
    position: absolute;
    top: 10%;
    right: 3%;
    height: 60%;
    width: 800px;
    background-color: white;
    box-shadow: -2px 0 10px rgba(0, 0, 0, 0.2);
    transform: translateX(100%);
    animation: slideIn 0.3s forwards;
    z-index: 50;
    padding: 20px;
    border: 1px solid white;
    border-radius: 8px;
  }

  .slide-out {
    animation: slideOut 0.3s forwards;
    
  }
</style>