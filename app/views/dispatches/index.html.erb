<div class="pl-6 pr-6">
<div class="max-w-full mx-auto mt-10 relative">
  <!-- Unified Header Section -->
  <div class="flex flex-col md:flex-row justify-between items-center p-4 bg-white border border-gray-300 rounded-t-md shadow gap-4">
    <!-- Heading -->
    <h1 class="text-xl font-semibold text-gray-800">Dispatch Management</h1>

    <!-- Search input in center -->
    <div class="relative w-full md:w-96">
      <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">
        <i class="fa-solid fa-magnifying-glass"></i>
      </span>
      <input
        type="text"
        id="dispatchSearch"
        placeholder="Order No, Client, or Courier..."
        class="pl-10 pr-4 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring focus:ring-blue-200 w-full"
      />
    </div>

    <!-- Add Dispatch Button -->
    <button
      id="open-modal-btn"
      class="flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300 font-bold"
    >
      <i class="fa-solid fa-plus"></i> New Dispatch
    </button>
  </div>

  <!-- Dispatches Table -->
  <div class="overflow-x-auto border border-t-0 border-gray-300 shadow-xl rounded-b-lg">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
        <tr>
          <% ["Order No", "Client", "Quantity", "Mode of shipment", "Dispatch Date", "Delivery Date", "Courier Company"].each_with_index do |header, index| %>
            <th class="px-6 py-3 text-left whitespace-nowrap border-r border-gray-300 <%= 'last:border-r-0' if index == 6 %>">
              <%= header %>
            </th>
          <% end %>
        </tr>
      </thead>

      <tbody id="dispatches_list" class="bg-white divide-y divide-gray-200">
        <%= render @dispatches %>
      </tbody>
    </table>
  </div>

  <!-- Slide-in Modal -->
  <turbo-frame id="modal">
    <!-- filled via Turbo Stream -->
  </turbo-frame>
</div>

</div>
<script>
  function closeModal() {
    const modalFrame = document.getElementById("modal");
    const slideInDiv = modalFrame.querySelector(".slide-in");

    if (slideInDiv) {
      slideInDiv.classList.remove("slide-in");
      slideInDiv.classList.add("slide-out");

      setTimeout(() => {
        if (modalFrame) modalFrame.innerHTML = "";
      }, 300); // match animation time
    } else {
      if (modalFrame) modalFrame.innerHTML = "";
    }
  }
document.addEventListener("turbo:load", () => {
  const modalFrame = document.getElementById("modal");
  if (modalFrame) modalFrame.innerHTML = "";

  const openModalBtn = document.getElementById("open-modal-btn");

  if (openModalBtn && !openModalBtn.dataset.listenerAttached) {
    openModalBtn.dataset.listenerAttached = "true"; // prevent double listeners

    openModalBtn.addEventListener("click", () => {
      fetch("<%= new_dispatch_path %>", {
        headers: { Accept: "text/vnd.turbo-stream.html" }
      })
        .then(response => response.text())
        .then(html => Turbo.renderStreamMessage(html));
    });
  }
});
document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("dispatchSearch");
    const tableRows = document.querySelectorAll("#dispatches_list tr");

    searchInput.addEventListener("keyup", function () {
      const query = this.value.toLowerCase();

      tableRows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        row.style.display = rowText.includes(query) ? "" : "none";
      });
    });
  });
</script>

<style>
  @keyframes slideIn {
    to {
      transform: translateX(0%);
    }
  }

  @keyframes slideOut {
    to {
      transform: translateX(100%);
    }
  }

  .slide-in {
    position: absolute;
    top: 10%;
    right: 3%;
    height: 60%;
    width: 800px;
    background-color: white;
    box-shadow: -2px 0 10px rgba(0, 0, 0, 0.2);
    transform: translateX(100%);
    animation: slideIn 0.3s forwards;
    z-index: 50;
    padding: 20px;
    border: 1px solid white;
    border-radius: 8px;
  }

  .slide-out {
    animation: slideOut 0.3s forwards;
    
  }
</style>