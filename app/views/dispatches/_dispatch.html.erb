<tr class="hover:bg-gray-50 text-left">
<td class="px-6 py-4 whitespace-nowrap border-r border-gray-200">
  <%= link_to dispatch.order_no, edit_dispatch_path(dispatch), class: "text-blue-600 hover:underline" %>
</td>
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= dispatch.client&.name || "N/A" %></td>
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= dispatch.quantity %></td>
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= dispatch.mode_of_shipment %></td>
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= dispatch.dispatch_date %></td>
  <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= dispatch.delivery_date %></td>
  <td class="px-6 py-4 whitespace-nowrap"><%= dispatch.courier_company %></td>
</tr>
