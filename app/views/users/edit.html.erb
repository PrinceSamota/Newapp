

<div class="min-h-screen bg-gray-100 py-8">
  <div class="max-w-2xl mx-auto bg-white rounded-lg shadow-md p-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Edit Profile</h2>

    <% if @user.errors.any? %>
      <div id="error-alert" class="fixed top-4 right-4 bg-red-50 border border-red-400 text-red-800 px-6 py-4 rounded-lg shadow-lg mb-6 max-w-md z-50">
        <!-- Close Button -->
        <button onclick="document.getElementById('error-alert').remove()" class="absolute top-2 right-3 text-red-700 hover:text-red-900 text-xl font-bold leading-none focus:outline-none">
          &times;
        </button>

        <div class="flex items-start gap-3 pr-6">
          <i class="fa-solid fa-circle-exclamation text-red-500 mt-1"></i>
          <div>
            <p class="font-semibold mb-2">Please fix the following errors:</p>
            <ul class="list-disc list-inside text-sm space-y-1">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    <% end %>

    <%= form_with model: @user, local: true, class: "space-y-6" do |f| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.text_field :name, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <input type="email" value="<%= @user.email %>" readonly class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 cursor-not-allowed" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :phone, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= f.telephone_field :phone, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>

      </div>

      <div>
        <%= f.label :address, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_area :address, rows: 3, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="border-t pt-6">
        <h3 class="text-lg font-medium text-gray-800 mb-4">Change Password</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= f.label :password, "New Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <p class="text-xs text-gray-500 mb-2">(leave blank if you don't want to change it)</p>
            <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
            <p class="text-xs text-gray-500 mt-1">6 characters minimum</p>
          </div>

          <div class="mt-6">
            <%= f.label :password_confirmation, "Confirm New Password", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          </div>
        </div>

        <div class="mt-4">
          <%= f.label :current_password, class: "block text-sm font-medium text-gray-700 mb-2" %>
          <p class="text-xs text-gray-500 mb-2">(we need your current password to confirm your changes)</p>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" %>
        </div>
      </div>

      <div class="flex justify-between items-center pt-6">
        <%= link_to "Back", root_path, class: "bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition" %>
        <%= f.submit "Update Profile", class: "bg-blue-600 text-white px-6 py-2 rounded-md hover:bg-blue-700 transition" %>
      </div>
    <% end %>
  </div>
</div>
