<div class="grid grid-cols-4 gap-4 mb-2 border-b pb-2">
  <!-- Item Name (Dropdown or Text Field) -->
  <div>
    <%= f.label :item_master_id, "Item" %>
<%= f.collection_select :item_master_id, ItemMaster.all, :id, :item_name, {}, class: "w-full border p-2 rounded" %>

  </div>

  <!-- Quantity -->
  <div>
    <%= f.label :receiving_quantity %>
    <%= f.number_field :receiving_quantity, class: "w-full border p-2 rounded" %>
  </div>

  <!-- Purchase Price -->
  <div>
    <%= f.label :purchase_price %>
    <%= f.number_field :purchase_price, class: "w-full border p-2 rounded" %>
  </div>

  <!-- Remove Button -->
  <div class="flex items-end">
    <% if f.object.persisted? %>
      <%= f.check_box :_destroy %>
      <%= f.label :_destroy, "Remove" %>
    <% else %>
      <button type="button" class="remove-item bg-red-600 text-white px-3 py-1 rounded">Remove</button>
    <% end %>
  </div>
</div>
