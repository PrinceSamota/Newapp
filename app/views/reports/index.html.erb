<div class="p-6 bg-white rounded-lg shadow-md border border-gray-200">

  <h2 class="text-xl font-semibold mb-4 text-center">Report</h2>

  <% if @selected_order_numbers.present? %>
    <div class="mb-4 text-center">
      <p class="text-sm text-gray-600">
        Selected Orders:
        <span class="font-semibold"><%= @selected_order_numbers.join(", ") %></span>
      </p>
    </div>
  <% end %>

  <% if @report_data.present? %>
    <table class="min-w-full text-sm border border-gray-300 rounded">
      <thead class="bg-gray-100 text-gray-700 text-xs uppercase">
        <tr>
          <th class="px-4 py-2 border text-center">Item Name</th>
          <th class="px-4 py-2 border text-center">SKU</th>
          <th class="px-4 py-2 border text-center">Category</th>
          <th class="px-4 py-2 border text-center">Order Quantity</th>
          <th class="px-4 py-2 border text-center">Stock</th>
          <th class="px-4 py-2 border text-center">Requirement</th>
        </tr>
      </thead>
      <tbody>
        <% @report_data.each do |row| %>
          <tr>
            <td class="px-4 py-2 border text-center"><%= row[:item_name] %></td>
            <td class="px-4 py-2 border text-center"><%= row[:sku] %></td>
            <td class="px-4 py-2 border text-center"><%= row[:category] || "-" %></td>
            <td class="px-4 py-2 border text-center"><%= row[:quantity] %></td>
            <td class="px-4 py-2 border text-center"><%= row[:stock] %></td>
            <td class="px-4 py-2 border text-center 
              <%= row[:requirement].to_i >= 0 ? 'text-green-600 font-semibold' : 'text-red-600 font-semibold' %>">
              <%= row[:requirement] %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Button right aligned -->
    <div class="mb-4 text-right mt-4">
      <%= link_to "Download Excel", reports_path(order_ids: params[:order_ids], format: :xlsx),
          class: "px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700" %>
    </div>

  <% else %>
    <p class="text-center text-gray-500">No orders selected.</p>
  <% end %>
</div>
