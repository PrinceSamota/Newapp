<div class="p-6 bg-white rounded-lg shadow-md border border-gray-200">
  <h2 class="text-xl font-semibold mb-4 text-center">Report</h2>

  <% if @report_data.present? %>
    <table class="min-w-full text-sm border border-gray-300 rounded">
      <thead class="bg-gray-100 text-gray-700 text-xs uppercase">
        <tr>
          <th colspan="3" class="px-4 py-2 border text-center">Input</th>
          <th colspan="3" class="px-4 py-2 border text-center">Output</th>
        </tr>
        <tr>
          <th class="px-4 py-2 border">Order No</th>
          <th class="px-4 py-2 border">FG SKU</th>
          <th class="px-4 py-2 border">RM SKU</th>
          <th class="px-4 py-2 border">Quantity</th>
          <th class="px-4 py-2 border">Stock</th>
          <th class="px-4 py-2 border">Requirement</th>
        </tr>
      </thead>
      <tbody>
        <% @report_data.each do |row| %>
          <tr>
            <td class="px-4 py-2 border text-center"><%= row[:order_no] %></td>
            <td class="px-4 py-2 border text-center"><%= row[:fg_sku] %></td>
            <td class="px-4 py-2 border text-center"><%= row[:rm_sku] %></td>
            <td class="px-4 py-2 border text-center"><%= row[:quantity] %></td>
            <td class="px-4 py-2 border text-center"><%= row[:stock] %></td>
            <td class="px-4 py-2 border text-center 
              <%= row[:requirement].to_i > 0 ? 'text-green-600 font-semibold' : 'text-red-600 font-semibold' %>">
              <%= row[:requirement] %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center text-gray-500">No orders selected.</p>
  <% end %>
</div>
