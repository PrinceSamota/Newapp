<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: Helvetica;
      font-size: 12px;
      margin: 0;
      position: relative;
    }

    .absolute {
      position: absolute;
    }
  </style>
</head>
<body>

<!-- ARTICLE BIG NUMBER -->
<div class="absolute" style="top: 113mm; left: 133mm; font-size: 16px; font-weight: bold;">
  <span style="font-size: 22px;">400900 </span><br><span style="font-size: 12px;">TTM Rail Pty Ltd </span>
</div>
<div class="absolute" style="top: 130mm; left: 152mm; font-size: 18px; font-weight: bold;">
  01
</div>
<div class="absolute" style="top: 130mm; left: 170mm; font-size: 18px; font-weight: bold;">
  20
</div>

<!-- MAIN BOX -->
<div class="absolute" style="top: 99mm; left: 26mm;">

  <div>

    <!-- LEFT COLUMN -->
    <div style="position: absolute; top: 0mm; white-space: nowrap;">
      <div><strong style="font-size: 16px; font-weight: bold;">Product Name:</strong></div>
      <div><strong style="font-weight: 400;">Description:</strong></div>
      <div><strong style="font-weight: 400;">Quantity:</strong></div>
      <div><strong style="font-weight: 400;">Net Weight:</strong></div>
      <div><strong style="font-weight: 400;">Gross Weight:</strong></div>
      <div><strong style="font-weight: 400;">Packing Date:</strong></div>
      <div><strong style="font-weight: bold;">Article No:</strong></div>
    </div>

    <!-- RIGHT COLUMN (Always 80mm from the left of the PAGE) -->
    <% order = OrderEntry.find_by(order_no: @item.order_no) %>
    <div style="position: absolute; top: 0mm; left: 80mm; width: 100mm;">
      <div style="font-size: 16px; font-weight: bold;">LED Light Fixture For Train</div>
      <div><%= @item.description_of_good&.name.presence || "—" %></div>
      <div><%= @item.qty_per_box.presence || "—" %></div>
      <div><%= @item.net_weight.presence || "—" %></div>
      <div><%= @item.gross_weight.presence || "—" %></div>
      <div>Nov 2025</div>
      <div style="font-weight: bold;"><%= order&.article_no || "—" %></div>
    </div>

  </div>

</div>



<div class="absolute" style="top: 253mm; left: 133mm; font-size: 16px; font-weight: bold;">
<span style="font-size: 22px;">400900 </span><br><span style="font-size: 12px;">TTM Rail Pty Ltd </span>
</div>
<div class="absolute" style="top: 270mm; left: 152mm; font-size: 18px; font-weight: bold;">
  01
</div>
<div class="absolute" style="top: 270mm; left: 170mm; font-size: 18px; font-weight: bold;">
  20
</div>

<!-- MAIN BOX -->
<div class="absolute" style="top: 238mm; left: 26mm;">

  <div>

    <!-- LEFT COLUMN -->
    <div style="position: absolute; top: 0mm; white-space: nowrap;">
      <div><strong style="font-size: 16px; font-weight: bold;">Product Name:</strong></div>
      <div><strong style="font-weight: 400;">Description:</strong></div>
      <div><strong style="font-weight: 400;">Quantity:</strong></div>
      <div><strong style="font-weight: 400;">Net Weight:</strong></div>
      <div><strong style="font-weight: 400;">Gross Weight:</strong></div>
      <div><strong style="font-weight: 400;">Packing Date:</strong></div>
      <div><strong style="font-weight: bold;">Article No:</strong></div>
    </div>

    <!-- RIGHT COLUMN (Always 80mm from the left of the PAGE) -->
    <div style="position: absolute; top: 0mm; left: 80mm; width: 100mm;">
      <div style="font-size: 16px; font-weight: bold;">LED Light Fixture For Train</div>
      <div><%= @item.description_of_good&.name.presence || "—" %></div>
      <div><%= @item.qty_per_box.presence || "—" %></div>
      <div><%= @item.net_weight.presence || "—" %></div>
      <div><%= @item.gross_weight.presence || "—" %></div>
      <div>Nov 2025</div>
      <div style="font-weight: bold;"><%= order&.article_no || "—" %></div>
    </div>

  </div>

</div>


</body>
</html>
