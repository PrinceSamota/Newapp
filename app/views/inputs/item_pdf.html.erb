<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: Helvetica;
      font-size: 12px;
      margin: 0;
      position: relative;
    }

    .absolute {
      position: absolute;
    }
  </style>
</head>
<body>

<!-- ARTICLE BIG NUMBER -->
<div class="absolute" style="top: 113mm; left: 113mm;">
  400900<br>TTM Rail Pty Ltd
</div>
<div class="absolute" style="top: 130mm; left: 152mm;">
  01
</div>
<div class="absolute" style="top: 130mm; left: 170mm;">
  20
</div>

<!-- MAIN BOX -->
<div class="absolute" style="top: 99mm; left: 26mm;">

  <div>

    <!-- LEFT COLUMN -->
    <div style="position: absolute; top: 0mm; white-space: nowrap;">
      <div><strong>Product Name:</strong></div>
      <div><strong>Description:</strong></div>
      <div><strong>Quantity:</strong></div>
      <div><strong>Net Weight:</strong></div>
      <div><strong>Gross Weight:</strong></div>
      <div><strong>Packing Date:</strong></div>
      <div><strong>Article No:</strong></div>
    </div>

    <!-- RIGHT COLUMN (Always 80mm from the left of the PAGE) -->
    <div style="position: absolute; top: 0mm; left: 80mm;">
      <div>LED Light Fixture For Train</div>
      <div><%= @item.description_of_good&.name.presence || "—" %></div>
      <div><%= @item.qty_per_box.presence || "—" %></div>
      <div><%= @item.net_weight.presence || "—" %></div>
      <div><%= @item.gross_weight.presence || "—" %></div>
      <div>Nov 2025</div>
      <div>00021-2342</div>
    </div>

  </div>

</div>



