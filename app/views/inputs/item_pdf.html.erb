<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body { font-family: Helvetica; font-size: 12px; margin: 20px; }
    .box {
      width: 70%;
      margin: 20px auto;
      border: 1px solid #000;
      padding: 20px;
    }
    .row { margin-bottom: 10px; }
  </style>
</head>
<body>

  <h2 style="text-align:center;">Input Item Details</h2>

  <div class="box">

    <div class="row"><strong>Product Name:</strong> ________________________</div>

    <div class="row"><strong>Description:</strong>
      <%= @item.description_of_good&.name.presence || "—" %>
    </div>

    <div class="row"><strong>Quantity:</strong>
      <%= @item.qty_per_box.presence || "—" %>
    </div>

    <div class="row"><strong>Net Weight:</strong>
      <%= @item.net_weight.presence || "—" %>
    </div>

    <div class="row"><strong>Gross Weight:</strong>
      <%= @item.gross_weight.presence || "—" %>
    </div>

    <div class="row"><strong>Packing Date:</strong> ________________________</div>

    <div class="row"><strong>Article No:</strong> ________________________</div>

  </div>

</body>
</html>
