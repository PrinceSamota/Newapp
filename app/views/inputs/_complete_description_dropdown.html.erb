<div>
<turbo-frame id="complete_description_section">
  <div class="flex flex-col space-y-2">
    <div class="flex justify-between items-center">
      <label class="text-sm font-semibold text-gray-800">Complete Description of Goods</label>
      <button type="button"
        onclick="document.getElementById('newCompleteDescriptionForm').classList.toggle('hidden')"
        class="text-blue-600 text-xl font-bold">+</button>
    </div>

    <%= select_tag "input[input_details_attributes][#{local_assigns[:detail_index] || 0}][complete_description_of_good_id]",
    options_from_collection_for_select(
      CompleteDescriptionOfGood.where(org_id: current_user.org_id), :id, :name, local_assigns[:selected_complete_description_id]
    ),
    id: "complete-description-select-#{local_assigns[:detail_index] || 0}",
    include_blank: "Select Complete Description",
    class: "required-field w-full rounded-md border border-gray-300 px-4 py-2 text-sm",
    data: { placeholder: "Select Complete Description" } %>


    <!-- Add New Complete Description -->
    <div id="newCompleteDescriptionForm" class="mt-2 <%= 'hidden' unless local_assigns[:show_form] %>">
      <div class="flex gap-2">
        <textarea id="new_complete_description_name" placeholder="New complete description"
          class="flex-1 rounded-md border px-3 py-2 text-sm" rows="3"></textarea>
        <button type="button" onclick="submitNewCompleteDescription()"
          class="bg-green-600 text-white px-3 py-2 rounded text-sm">Add</button>
      </div>
      <div id="complete-description-errors" class="text-red-600 text-sm mt-2"></div>
      <% if local_assigns[:errors].present? %>
        <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
          <% local_assigns[:errors].each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </div>
</turbo-frame>
</div>

<script>
  function submitNewCompleteDescription() {
    const name = document.getElementById('new_complete_description_name').value;
    const errorsDiv = document.getElementById('complete-description-errors');

    if (!name) {
      errorsDiv.textContent = "Complete Description cannot be blank.";
      return;
    }

    fetch("/complete_description_of_goods", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
        "Accept": "text/vnd.turbo-stream.html"
      },
      body: JSON.stringify({ complete_description_of_good: { name } })
    })
    .then(response => {
      if (!response.ok) throw new Error("Error creating complete description");
      return response.text();
    })
    .then(html => {
      document.getElementById("complete_description_section").innerHTML = html;
      document.getElementById('new_complete_description_name').value = "";
      errorsDiv.textContent = "";
    })
    .catch(() => {
      errorsDiv.textContent = "Something went wrong.";
    });
  }
</script>
