
  <div class="container mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-3xl font-bold text-gray-900">Inputs</h1>
      <%= link_to "New Input", new_input_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg" %>
    </div>
    
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice No</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Shipper</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @inputs.each do |input| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= input.invoice_no %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= input.invoice_date %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= input.shipper_name&.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium flex items-center space-x-4">
              <%= link_to input, class: "text-indigo-600 hover:text-indigo-900" do %>
                <i class="fa-solid fa-eye text-lg"></i>
              <% end %>
            
              <%= link_to edit_input_path(input), class: "text-green-600 hover:text-green-900" do %>
                <i class="fa-solid fa-file-pen text-lg"></i>
              <% end %>
            
              <%= button_to input_path(input), 
              method: :delete, 
              form: { data: { turbo_confirm: "Are you sure?" } }, 
              class: "text-red-600 hover:text-red-900 cursor-pointer p-2 rounded" do %>
              <i class="fa-solid fa-trash text-lg"></i>
              <% end %> 

            </td>
            
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
