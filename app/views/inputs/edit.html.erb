<% content_for(:title, "Edit Input") %>

<div class="min-h-screen bg-gray-50 py-6">
  <div class="max-w-7xl mx-auto px-4">

    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
      <%= link_to input_path(@input), class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="font-bold">Back</span>
      <% end %>

      <h2 class="text-2xl font-bold text-gray-800">Edit Input</h2>
    </div>

    <!-- ✅ Single Form Starts -->
    <%= form_with(model: @input, local: true, class: "space-y-6 bg-white rounded-lg shadow-lg p-8") do |f| %>

      <% if @input.errors.any? %>
        <div id="error-box" class="relative bg-red-50 border border-red-200 rounded p-4 mb-6">
          <button type="button" onclick="document.getElementById('error-box').remove()" class="absolute top-2 right-2 text-red-500 hover:text-red-700 font-bold text-2xl cursor-pointer">×</button>
          <h4 class="text-red-800 font-medium">Please fix the following errors:</h4>
          <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
            <% @input.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- 🧾 Basic Info -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <%= f.label :invoice_no, "Invoice Number" %>
          <%= f.text_field :invoice_no, class: "w-full border border-gray-300 rounded-lg p-2" %>
        </div>

        <div>
          <%= f.label :invoice_date, "Invoice Date" %>
          <%= f.date_field :invoice_date, class: "w-full border border-gray-300 rounded-lg p-2" %>
        </div>

        <div>
        <%= f.label :shipper_name_id, "Shipper" %>
      
        <%= f.collection_select :shipper_name_id,
          Client.all,
          :id,
          :company_name,
          {},
          {
            class: "tom-select w-full border border-gray-300 rounded-lg p-2",
            data: { placeholder: "Select Shipper" }
          }
        %>
      </div>
      <div>
      <%= f.label :consignee_name_id, "Consignee" %>
    
      <%= f.collection_select :consignee_name_id,
        Client.all,
        :id,
        :company_name,
        {},
        {
          class: "tom-select w-full border border-gray-300 rounded-lg p-2",
          data: { placeholder: "Select Consignee" }
        }
      %>
    </div>

      <div>
      <%= f.label :importer_name_id, "Importer" %>

      <%= f.collection_select :importer_name_id,
        Client.all,
        :id,
        :company_name,
        {},
        {
          class: "tom-select w-full border border-gray-300 rounded-lg p-2",
          data: { placeholder: "Select Importer" }
        }
      %>
      </div>

        <div>
          <%= f.label :order_no_from_dispatch, "Order No from Dispatch" %>
          <%= f.text_field :order_no_from_dispatch, class: "w-full border border-gray-300 rounded-lg p-2" %>
        </div>

        <div>
        <%= f.label :currency_id, "Currency" %>
      
        <%= f.collection_select :currency_id,
          Currency.all,
          :id,
          :name,
          {},
          {
            class: "tom-select w-full border border-gray-300 rounded-lg p-2",
            data: { placeholder: "Select Currency" }
          }
        %>
      </div>

        <div>
          <%= f.label :fedex_awb_no, "FedEx AWB No" %>
          <%= f.text_field :fedex_awb_no, class: "w-full border border-gray-300 rounded-lg p-2" %>
        </div>
      </div>

      <div class="bg-blue-50 p-6 rounded-xl shadow-sm mt-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Input Details</h3>

        <div id="input-details" class="space-y-4">
          <%= f.fields_for :input_details do |detail_form| %>
            <%= render 'input_detail_fields', f: detail_form, show_remove_button: true %>
          <% end %>
        </div>

        <button type="button" id="add-input-detail" class="mt-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">
          + Add Input Detail
        </button>
      </div>

      <!-- Template for new input detail row -->
      <div id="input-detail-template" class="hidden">
        <% new_detail = InputDetail.new %>
        <% detail_index = "NEW_DETAIL_INDEX" %>
        <%= f.fields_for :input_details, new_detail, child_index: detail_index do |detail_form| %>
          <%= render 'input_detail_fields', f: detail_form %>
        <% end %>
      </div>

      <div class="bg-green-50 p-6 rounded-xl shadow-sm mt-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Input Items</h3>

        <div id="input-items" class="space-y-4">
          <%= f.fields_for :input_items do |item_form| %>
            <%= render 'input_item_fields', f: item_form, show_remove_button: true %>
          <% end %>
        </div>

        <button type="button" id="add-input-item" class="mt-4 bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">
          + Add Input Item
        </button>
      </div>

      <div id="input-item-template" class="hidden">
        <% new_object = InputItem.new %>
        <% index = "NEW_INDEX" %>
        <%= f.fields_for :input_items, new_object, child_index: index do |item_form| %>
          <%= render 'input_item_fields', f: item_form %>
        <% end %>
      </div>

      <!-- Submit Buttons -->
      <div class="flex justify-end gap-4 mt-8">
        <%= link_to input_path(@input), class: "bg-gray-200 hover:bg-gray-300 text-gray-800 p-3 rounded-lg font-medium flex items-center gap-2" do %>
          <i class="fa-solid fa-xmark"></i> Cancel
        <% end %>

        <%= f.submit "Save Draft",
      name: "save_draft",
      class: "bg-yellow-500 hover:bg-yellow-600 text-white p-3 rounded-lg font-medium flex items-center gap-2 cursor-pointer" %>

        <%= f.submit "Update & Finalize", class: "bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-lg font-medium flex items-center gap-2 cursor-pointer" %>
      </div>

    <% end %> 

  </div>
</div>
<script>
function initTomSelect(element) {
  if (!element || element.tomselect) return;

  new TomSelect(element, {
    create: false,
    allowEmptyOption: true,
    placeholder: element.dataset.placeholder || "Select Option",
    hidePlaceholder: true,
    persist: false,

    searchField: ["text"],
    maxOptions: 1000,

    sortField: {
      field: "text",
      direction: "asc"
    },

    onInitialize: function () {
      this.clear();
    },

    onDropdownOpen: function () {
      if (this.getValue()) {
        this.clear(true);
      }
    }
  });
}


function initAllTomSelects() {
  document.querySelectorAll(".tom-select").forEach((select) => {
    initTomSelect(select);
  });
}


function initInputForm() {
  const itemContainer = document.getElementById("input-items");
  const detailContainer = document.getElementById("input-details");

  if (!itemContainer || itemContainer.dataset.initialized === "true") return;
  itemContainer.dataset.initialized = "true";

  const itemTemplate = document.getElementById("input-item-template")?.innerHTML;
  const detailTemplate = document.getElementById("input-detail-template")?.innerHTML;

  const addItemButton = document.getElementById("add-input-item");
  const addDetailButton = document.getElementById("add-input-detail");

  let itemIndex = itemContainer.querySelectorAll(".input-item-row").length;
  let detailIndex = detailContainer.querySelectorAll(".input-detail-row").length;


  addItemButton?.addEventListener("click", function () {
    if (!itemTemplate) return;

    const newRowHTML = itemTemplate.replace(/NEW_INDEX/g, itemIndex);
    itemContainer.insertAdjacentHTML("beforeend", newRowHTML);

    const newRow = itemContainer.lastElementChild;

    newRow.querySelectorAll(".tom-select").forEach((select) => {
      initTomSelect(select);
    });

    itemIndex++;
  });

  addDetailButton?.addEventListener("click", function () {
    if (!detailTemplate) return;

    const newDetailHTML = detailTemplate.replace(/NEW_DETAIL_INDEX/g, detailIndex);
    detailContainer.insertAdjacentHTML("beforeend", newDetailHTML);

    const newRow = detailContainer.lastElementChild;

    newRow.querySelectorAll(".tom-select").forEach((select) => {
      initTomSelect(select);
    });

    detailIndex++;
  });

  itemContainer?.addEventListener("click", function (e) {
    if (e.target.classList.contains("remove-input-item")) {
      const row = e.target.closest(".input-item-row");

      const destroyInput = row.querySelector('input[name*="[_destroy]"]');
      if (destroyInput) {
        destroyInput.value = "1";
        row.style.display = "none";
      } else {
        row.remove();
      }
    }
  });


  detailContainer?.addEventListener("click", function (e) {
    if (e.target.classList.contains("remove-input-detail")) {
      const row = e.target.closest(".input-detail-row");

      const destroyInput = row.querySelector('input[name*="[_destroy]"]');
      if (destroyInput) {
        destroyInput.value = "1";
        row.style.display = "none";
      } else {
        row.remove();
      }
    }
  });
}

document.addEventListener("turbo:load", () => {
  initInputForm();
  initAllTomSelects();
});

document.addEventListener("turbo:frame-load", () => {
  initAllTomSelects();
});

document.addEventListener("DOMContentLoaded", () => {
  initInputForm();
  initAllTomSelects();
});
// ===============================
// INIT INPUT FORM (ADD / REMOVE ROW)
// ===============================
function initInputForm() {
  const itemContainer = document.getElementById("input-items");
  const detailContainer = document.getElementById("input-details");

  if (!itemContainer || itemContainer.dataset.initialized === "true") return;
  itemContainer.dataset.initialized = "true";

  const itemTemplate = document.getElementById("input-item-template")?.innerHTML;
  const detailTemplate = document.getElementById("input-detail-template")?.innerHTML;

  const addItemButton = document.getElementById("add-input-item");
  const addDetailButton = document.getElementById("add-input-detail");

  let itemIndex = itemContainer.querySelectorAll(".input-item-row").length;
  let detailIndex = detailContainer.querySelectorAll(".input-detail-row").length;

  // ✅ ADD INPUT ITEM
  addItemButton?.addEventListener("click", function () {
    if (!itemTemplate) return;

    const html = itemTemplate.replace(/NEW_INDEX/g, itemIndex);
    itemContainer.insertAdjacentHTML("beforeend", html);

    const newRow = itemContainer.lastElementChild;

    // 🔥 APPLY SEARCH DROPDOWN
    initAllTomSelects(newRow);

    itemIndex++;
  });

  // ✅ ADD INPUT DETAIL
  addDetailButton?.addEventListener("click", function () {
    if (!detailTemplate) return;

    const html = detailTemplate.replace(/NEW_DETAIL_INDEX/g, detailIndex);
    detailContainer.insertAdjacentHTML("beforeend", html);

    const newRow = detailContainer.lastElementChild;

    // 🔥 APPLY SEARCH DROPDOWN
    initAllTomSelects(newRow);

    detailIndex++;
  });

  // ✅ REMOVE ITEM
  itemContainer.addEventListener("click", function (e) {
    if (e.target.classList.contains("remove-input-item")) {
      e.target.closest(".input-item-row")?.remove();
    }
  });

  // ✅ REMOVE DETAIL
  detailContainer.addEventListener("click", function (e) {
    if (e.target.classList.contains("remove-input-detail")) {
      e.target.closest(".input-detail-row")?.remove();
    }
  });
}


// ===============================
// TOM SELECT INIT
// ===============================
function initTomSelect(element) {
  if (!element || element.tomselect) return;

  new TomSelect(element, {
    create: false,
    allowEmptyOption: true,
    placeholder: element.dataset.placeholder || "Select Option",
    hidePlaceholder: true,
    persist: false,
    searchField: ["text"],
    maxOptions: 1000,

    sortField: {
      field: "text",
      direction: "asc"
    },

    onDropdownOpen: function () {
      if (this.getValue()) {
        this.clear(true);
      }
    }
  }).clear();
}


// ===============================
// INIT ALL SELECTS
// ===============================
function initAllTomSelects(scope = document) {
  scope.querySelectorAll("select[data-placeholder]").forEach((select) => {
    if (!select.tomselect) {
      initTomSelect(select);
    }
  });
}


// ===============================
// TURBO + PAGE LOAD SUPPORT
// ===============================
document.addEventListener("turbo:load", () => {
  initInputForm();
  initAllTomSelects();
});

document.addEventListener("turbo:frame-load", () => {
  initAllTomSelects();
});

document.addEventListener("DOMContentLoaded", () => {
  initInputForm();
  initAllTomSelects();
});


// ===============================
// MARKS NO AJAX (TURBO FIX)
// ===============================
function submitNewMarksNo(button) {
  const wrapper = button.closest("[id^='marks_no_section']");
  const input = wrapper.querySelector("#new_marks_no_name");
  const errorsDiv = wrapper.querySelector("#marks-no-errors");

  const name = input.value;

  if (!name) {
    errorsDiv.textContent = "Marks No cannot be blank.";
    return;
  }

  fetch("/marks_nos", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
      "Accept": "text/vnd.turbo-stream.html"
    },
    body: JSON.stringify({ marks_no: { name } })
  })
    .then(res => res.text())
    .then(html => {
      wrapper.innerHTML = html;

      // 🔥 RE-INIT DROPDOWN AFTER UPDATE
      initAllTomSelects(wrapper);
    })
    .catch(() => {
      errorsDiv.textContent = "Something went wrong.";
    });
}
</script>