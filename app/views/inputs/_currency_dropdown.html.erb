<div>
  <turbo-frame id="currency_section">
    <div class="flex flex-col space-y-2">

      <!-- Label + Add Button -->
      <div class="flex justify-between items-center">
        <label class="text-sm font-semibold text-gray-800">Currency</label>
        <button type="button"
          onclick="document.getElementById('newCurrencyForm').classList.toggle('hidden')"
          class="text-blue-600 text-xl font-bold">+</button>
      </div>

      <!-- Searchable Dropdown -->
      <%= select_tag "input[currency_id]",
      options_from_collection_for_select(
        Currency.all, :id, :name, local_assigns[:selected_currency_id]
      ),
      id: "currency-select",
      class: "required-field w-full rounded-md border border-gray-300 px-4 py-2 text-sm",
      data: { placeholder: "Select Currency" } %>

      <!-- Add New Currency -->
      <div id="newCurrencyForm" class="mt-2 <%= 'hidden' unless local_assigns[:show_form] %>">
        <div class="flex gap-2">
          <input id="new_currency_name" type="text" placeholder="New currency name"
            class="flex-1 rounded-md border px-3 py-2 text-sm" />
          <button type="button" onclick="submitNewCurrency()"
            class="bg-green-600 text-white px-3 py-2 rounded text-sm">Add</button>
        </div>

        <div id="currency-errors" class="text-red-600 text-sm mt-2"></div>

        <% if local_assigns[:errors].present? %>
          <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
            <% local_assigns[:errors].each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        <% end %>
      </div>

    </div>
  </turbo-frame>
</div>

<!-- JS: Create Currency -->
<script>
function submitNewCurrency() {
  const name = document.getElementById('new_currency_name').value;
  const errorsDiv = document.getElementById('currency-errors');

  if (!name) {
    errorsDiv.textContent = "Currency cannot be blank.";
    return;
  }

  fetch("/currencies", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
      "Accept": "text/vnd.turbo-stream.html"
    },
    body: JSON.stringify({ currency: { name } })
  })
  .then(response => response.text())
  .then(html => {
    Turbo.renderStreamMessage(html);   // ✅ Turbo fix
  })
  .catch(() => {
    errorsDiv.textContent = "Something went wrong.";
  });
}
</script>

<script>
function initCurrencySelect() {
  const select = document.getElementById('currency-select');

  if (select && !select.tomselect) {
    let ts = new TomSelect(select, {
      create: false,
      allowEmptyOption: true,
      placeholder: select.dataset.placeholder || 'Select Currency',
      hidePlaceholder: true,
      persist: false,

      searchField: ['text'],
      maxOptions: 1000,

      sortField: {
        field: 'text',
        direction: 'asc'
      },

      // ✅ जब dropdown खुले → value clear हो जाए
      onDropdownOpen: function() {
        if (this.getValue()) {
          this.clear(true);   // 🔥 THIS LINE DOES THE MAGIC
        }
      }
    });

    // ❌ IMPORTANT: default selection हटाना
    ts.clear();   // 👈 no value selected initially
  }
}

// Turbo support
document.addEventListener('turbo:load', initCurrencySelect);
document.addEventListener('turbo:frame-load', initCurrencySelect);
</script>