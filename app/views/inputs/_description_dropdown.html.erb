<div>
<turbo-frame id="description_section">
  <div class="flex flex-col space-y-2">
    <div class="flex justify-between items-center">
      <label class="text-xs font-medium text-gray-700 block mb-1">Description of Good</label>
    </div>

    <%= select_tag "input[input_items_attributes][#{local_assigns[:item_index] || 0}][description_of_goods_id]",
      options_from_collection_for_select(
        CompleteDescriptionOfGood.where(org_id: current_user.org_id), :id, :name, local_assigns[:selected_description_id]
      ),
      id: "description-select-#{local_assigns[:item_index] || 0}",
      include_blank: "Select Description",
      class: "required-field w-full rounded-md border border-gray-300 px-4 py-2 text-sm",
      data: { placeholder: "Select Description" } %>
  </div>
</turbo-frame>
</div>
