<div class="max-w-xl mx-auto bg-white shadow p-6 mt-8 rounded-lg">
  <h2 class="text-2xl font-bold mb-4">Enter Label Details</h2>

  <form action="<%= generate_item_pdf_path(@input_item.id, format: :pdf) %>" method="post" target="_blank">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

    <div class="mb-3">
      <label class="block font-medium">Select Client <span class='text-red-500'>*</span></label>
      <select name="client_id" class="border rounded w-full p-2 required-field">
        <option value="">Choose Client</option>
        <% @clients.each do |client| %>
          <option value="<%= client.id %>"><%= client.company_name %></option>
        <% end %>
      </select>
    </div>

    <div class="mb-3">
      <label class="block font-medium">Box No <span class='text-red-500'>*</span></label>
      <input type="text" name="box_no" class="border rounded w-full p-2 required-field">
    </div>

    <div class="mb-3">
      <label class="block font-medium">Start Serial No <span class='text-red-500'>*</span></label>
      <input type="text" name="start_serial_no" class="border rounded w-full p-2 required-field">
    </div>

    <div class="mb-3">
      <label class="block font-medium">End Serial No <span class='text-red-500'>*</span></label>
      <input type="text" name="end_serial_no" class="border rounded w-full p-2 required-field">
    </div>

    <div class="mb-3">
      <label class="block font-medium">Custom Article No</label>
      <input type="text" name="custom_article_no" class="border rounded w-full p-2">
    </div>

    <div class="mb-3">
      <label class="block font-medium">Packing Date <span class='text-red-500'>*</span></label>
      <input type="date" name="packing_date" class="border rounded w-full p-2 required-field">
    </div>
    <%= hidden_field_tag :input_id, @input.id %>

    <input type="submit" value="Generate PDF" id="submit_btn" disabled class="bg-blue-400 text-white px-4 py-2 rounded cursor-not-allowed opacity-50">
  </form>
</div>
<script>
document.addEventListener("turbo:load", function () {
  const requiredFields = document.querySelectorAll(".required-field");
  const submitBtn = document.getElementById("submit_btn");

  function validateForm() {
    let allFilled = true;
    requiredFields.forEach(field => {
      if (!field.value.trim()) {
        allFilled = false;
      }
    });

    submitBtn.disabled = !allFilled;
    if (allFilled) {
      submitBtn.classList.remove("cursor-not-allowed", "opacity-50", "bg-blue-400");
      submitBtn.classList.add("bg-blue-600", "hover:bg-blue-700", "cursor-pointer");
    } else {
      submitBtn.classList.add("cursor-not-allowed", "opacity-50", "bg-blue-400");
      submitBtn.classList.remove("bg-blue-600", "hover:bg-blue-700", "cursor-pointer");
    }
  }

  requiredFields.forEach(field => {
    field.addEventListener("input", validateForm);
    field.addEventListener("change", validateForm);
  });

  validateForm();
});
</script>
