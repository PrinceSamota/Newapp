<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: 'Arial', sans-serif;
      font-size: 15px;
      margin: 0;
      position: relative;
    }

    .absolute {
      position: absolute;
    }
  </style>
</head>
<body>

<!-- ARTICLE BIG NUMBER -->
<div class="absolute" style="top: 490px; left: 570px; font-size: 16px; font-weight: bold; word-wrap: break-word; width: 45mm;">
  <span style="font-size: 24px;"><%= @item.order_no %> </span><br><span style="font-size: 16px;"><%= client.company_name %> </span>
</div>
<div class="absolute" style="top: 600px; left: 738px; font-weight: bold; font-size: 40px;">
  <%= box_no.to_s.rjust(2, '0') %>
</div>
<div class="absolute" style="top: 600px; left: 825px; font-weight: bold; font-size: 40px;">
  <%= total_boxes.to_s.rjust(2, '0') %>
</div>

<!-- MAIN BOX -->
<div class="absolute" style="top: 420px; left:  126px;">

  <div>

    <!-- LEFT COLUMN -->
    <div style="position: absolute; white-space: nowrap;">
      <div style="margin-bottom: 10px;"><strong style="font-size: 20px; font-weight: bold;">Product Name:</strong></div>
      <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Description:</strong></div>
      <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Quantity:</strong></div>
      <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Net Weight:</strong></div>
      <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Gross Weight:</strong></div>
      <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Packing Date:</strong></div>
      <div style="margin-bottom: 5px;"><strong style="font-weight: bold;">Article No:</strong></div>
      <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Serial No:</strong></div>
    </div>

    <!-- RIGHT COLUMN (Always 80mm from the left of the PAGE) -->
    <% 
    order = OrderEntry.find_by(order_no: @item.order_no)
    sku_id = order&.sku_number
    item_name = ItemMaster.find_by(sku_id: sku_id)&.shortcode
  %>

    <div style="position: absolute; top: 0mm; left: 308px; width: 100mm;">
      <div style="font-size: 20px; font-weight: bold; margin-bottom: 10px;"><%= @item.description_of_good&.name.presence || "—" %></div>
      <div style="margin-bottom: 5px;"><%= item_name || "—" %></div>
      <div style="margin-bottom: 5px;"><%= @item.qty_per_box.presence || "—" %></div>
      <div style="margin-bottom: 5px;"><%= @item.net_weight.presence || "—" %></div>
      <div style="margin-bottom: 5px;"><%= @item.gross_weight.presence || "—" %></div>
      <div style="margin-bottom: 5px;"><% if packing_date.present? %>
      <% safe_date = Date.parse(packing_date) rescue nil %>
      <%= safe_date.strftime("%b-%Y") if safe_date %>
      <% end %></div>
      <div style="font-weight: bold; margin-bottom: 5px;"><%= custom_article_no.present? ? custom_article_no : order&.article_no %></div>
      <div style="margin-bottom: 5px;"><%= start_serial %> - <%= end_serial %></div>
    </div>

  </div>

</div>



<div class="absolute" style="top: 1180px; left: 570px; font-size: 16px; font-weight: bold; word-wrap: break-word; width: 45mm;">
<span style="font-size: 24px;"><%= @item.order_no %> </span><br><span style="font-size: 16px;"><%= client.company_name %> </span>
</div>
<div class="absolute" style="top: 1300px; left: 738px; font-weight: bold; font-size: 40px;">
  <%= box_no.to_s.rjust(2, '0') %>
</div>
<div class="absolute" style="top: 1300px; left: 825px; font-weight: bold; font-size: 40px;">
  <%= total_boxes.to_s.rjust(2, '0') %>
</div>

<!-- MAIN BOX -->
<div class="absolute" style="top: 1110px; left: 126px;">
  <div>

  <!-- LEFT COLUMN -->
  <div style="position: absolute; white-space: nowrap;">
    <div style="margin-bottom: 10px;"><strong style="font-size: 20px; font-weight: bold;">Product Name:</strong></div>
    <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Description:</strong></div>
    <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Quantity:</strong></div>
    <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Net Weight:</strong></div>
    <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Gross Weight:</strong></div>
    <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Packing Date:</strong></div>
    <div style="margin-bottom: 5px;"><strong style="font-weight: bold;">Article No:</strong></div>
    <div style="margin-bottom: 5px;"><strong style="font-weight: 400;">Serial No:</strong></div>
  </div>


  <div style="position: absolute; top: 0mm; left: 308px; width: 100mm;">
    <div style="font-size: 20px; font-weight: bold; margin-bottom: 10px;"><%= @item.description_of_good&.name.presence || "—" %></div>
    <div style="margin-bottom: 5px;"><%= item_name || "—" %></div>
    <div style="margin-bottom: 5px;"><%= @item.qty_per_box.presence || "—" %></div>
    <div style="margin-bottom: 5px;"><%= @item.net_weight.presence || "—" %></div>
    <div style="margin-bottom: 5px;"><%= @item.gross_weight.presence || "—" %></div>
    <div style="margin-bottom: 5px;"><% if packing_date.present? %>
    <% safe_date = Date.parse(packing_date) rescue nil %>
    <%= safe_date.strftime("%b-%Y") if safe_date %>
    <% end %></div>
    <div style="font-weight: bold; margin-bottom: 5px;"><%= custom_article_no.present? ? custom_article_no : order&.article_no %></div>
    <div style="margin-bottom: 5px;"><%= start_serial %> - <%= end_serial %></div>
  </div>

  </div>

    
</div>


</body>
</html>
