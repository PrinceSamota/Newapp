<div class="container mx-auto px-4 py-6">
  <div class="flex items-center mb-6">
  <% back_path =
  if params[:from_dispatch].present? && params[:dispatch_id].present?
    edit_dispatch_path(params[:dispatch_id])
  else
    inputs_path
  end
%>

<%= link_to back_path,
  class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300 mr-4" do %>
<i class="fa-solid fa-arrow-left"></i>
<span class="font-bold">Back</span>
<% end %>

  </div>
  
  <div class="bg-white p-8 rounded-2xl shadow-xl max-w-6xl mx-auto">
    <%= form_with(model: @input, local: true, class: "space-y-6") do |f| %>
      
<% if @input.errors.any? %>
  <div id="error-box" class="relative bg-red-50 border border-red-200 rounded p-4">
    <!-- Close button -->
    <button 
      type="button" 
      onclick="document.getElementById('error-box').remove()" 
      class="absolute top-2 right-2 text-red-500 hover:text-red-700 font-bold text-2xl cursor-pointer"
      aria-label="Close"
    >
      ×
    </button>

    <h4 class="text-red-800 font-medium">Please fix the following errors:</h4>
    <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
      <% @input.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>


      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :invoice_no, "Invoice Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :invoice_no, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :invoice_date, "Invoice Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :invoice_date, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>


      <div>
        <%= f.label :order_no_from_dispatch, "Order No from Dispatch", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :order_no_from_dispatch, id: "order_no_from_dispatch_field", class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
      

        <div id="currency_section">
        <%= render "inputs/currency_dropdown", f: f, detail_index: f.index, selected_currency_id: f.object.currency_id %>
      </div>
      

        <div>
          <%= f.label :fedex_awb_no, "FedEx AWB Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :fedex_awb_no, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

            <div>
            <%= f.label :shipper_name_id, "Shipper Name",
                class: "block text-sm font-medium text-gray-700 mb-1" %>
          
            <%= f.select :shipper_name_id, 
                options_from_collection_for_select(
                  Client.where(org_id: current_user.org_id).select { |c| c.has_type?("shipper") }, 
                  :id, :company_name, @input.shipper_name_id
                ),
                {},  
                {
                  id: "shipper-select",
                  class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500",
                  data: { placeholder: "Select Shipper" }
                } %>
          </div>

          <div>
          <%= f.label :consignee_name_id, "Consignee Name",
              class: "block text-sm font-medium text-gray-700 mb-1" %>
        
          <%= f.select :consignee_name_id, 
              options_from_collection_for_select(
                Client.where(org_id: current_user.org_id).select { |c| c.has_type?("consignee") }, 
                :id, :company_name, @input.consignee_name_id
              ),
              {},
              {
                id: "consignee-select",
                class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500",
                data: { placeholder: "Select Consignee" }
              } %>
        </div>

        <div>
        <%= f.label :importer_name_id, "Importer Name",
            class: "block text-sm font-medium text-gray-700 mb-1" %>
      
        <%= f.select :importer_name_id, 
            options_from_collection_for_select(
              Client.where(org_id: current_user.org_id).select { |c| c.has_type?("buyer") }, 
              :id, :company_name, @input.importer_name_id
            ),
            {},  
            {
              id: "importer-select",
              class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500",
              data: { placeholder: "Select Importer" }
            } %>
      </div>
      </div>

      <!-- Input Details Section -->
      <div class="bg-blue-50 p-6 rounded-xl shadow-sm mt-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Input Details</h3>

        <div id="input-details" class="space-y-4">
          <%= f.fields_for :input_details do |detail_form| %>
            <%= render 'input_detail_fields', f: detail_form, show_remove_button: true %>
          <% end %>
        </div>

        <button type="button" id="add-input-detail" class="mt-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">
          + Add Input Detail
        </button>
      </div>

      <!-- Template for new input detail row -->
      <div id="input-detail-template" class="hidden">
        <% new_detail = InputDetail.new %>
        <% detail_index = "NEW_DETAIL_INDEX" %>
        <%= f.fields_for :input_details, new_detail, child_index: detail_index do |detail_form| %>
          <%= render 'input_detail_fields', f: detail_form %>
        <% end %>
      </div>

      <!-- Input Items Section -->
      <div class="bg-green-50 p-6 rounded-xl shadow-sm mt-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Input Items</h3>

        <div id="input-items" class="space-y-4">
          <%= f.fields_for :input_items do |item_form| %>
            <%= render 'input_item_fields', f: item_form, show_remove_button: true %>
          <% end %>
        </div>

        <button type="button" id="add-input-item" class="mt-4 bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">
          + Add Input Item
        </button>
      </div>

      <!-- Template for new input item row -->
      <div id="input-item-template" class="hidden">
        <% new_object = InputItem.new %>
        <% index = "NEW_INDEX" %>
        <%= f.fields_for :input_items, new_object, child_index: index do |item_form| %>
          <%= render 'input_item_fields', f: item_form %>
        <% end %>
      </div>
      <%= f.hidden_field :dispatch_id, value: params[:dispatch_id] || @input.dispatch_id %>

      <div class="flex justify-end space-x-4 mt-8">
  <!-- Save Draft Button -->
  <%= f.submit "Save Draft", 
      name: "save_draft", 
      class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl text-lg cursor-pointer" %>

  <!-- Normal Submit Button -->
  <%= f.submit "Create Input", 
      name: "commit", 
      class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl text-lg cursor-pointer" %>
</div>

    <% end %>
  </div>
</div>
<script>
// ===============================
// INIT INPUT FORM (ADD / REMOVE ROW)
// ===============================
function initInputForm() {
  const itemContainer = document.getElementById("input-items");
  const detailContainer = document.getElementById("input-details");

  if (!itemContainer || itemContainer.dataset.initialized === "true") return;
  itemContainer.dataset.initialized = "true";

  const itemTemplate = document.getElementById("input-item-template")?.innerHTML;
  const detailTemplate = document.getElementById("input-detail-template")?.innerHTML;

  const addItemButton = document.getElementById("add-input-item");
  const addDetailButton = document.getElementById("add-input-detail");

  let itemIndex = itemContainer.querySelectorAll(".input-item-row").length;
  let detailIndex = detailContainer.querySelectorAll(".input-detail-row").length;

  // ✅ ADD INPUT ITEM
  addItemButton?.addEventListener("click", function () {
    if (!itemTemplate) return;

    const html = itemTemplate.replace(/NEW_INDEX/g, itemIndex);
    itemContainer.insertAdjacentHTML("beforeend", html);

    const newRow = itemContainer.lastElementChild;

    // 🔥 APPLY SEARCH DROPDOWN
    initAllTomSelects(newRow);

    itemIndex++;
  });

  // ✅ ADD INPUT DETAIL
  addDetailButton?.addEventListener("click", function () {
    if (!detailTemplate) return;

    const html = detailTemplate.replace(/NEW_DETAIL_INDEX/g, detailIndex);
    detailContainer.insertAdjacentHTML("beforeend", html);

    const newRow = detailContainer.lastElementChild;

    // 🔥 APPLY SEARCH DROPDOWN
    initAllTomSelects(newRow);

    detailIndex++;
  });

  // ✅ RECALCULATE ORDER NOS
  function recalculateOrderNos() {
    const orderNos = new Set();
    
    // Collect from items
    itemContainer.querySelectorAll(".input-item-row").forEach(row => {
      if (row.style.display !== "none") {
        const val = row.querySelector('input[name*="[order_no]"]')?.value;
        if (val) orderNos.add(val.trim());
      }
    });

    const field = document.getElementById("order_no_from_dispatch_field");
    if (field) {
      field.value = Array.from(orderNos).join(", ");
    }
  }

  // ✅ REMOVE ITEM (Correctly sets _destroy for existing, removes for new)
  itemContainer.addEventListener("click", function (e) {
    if (e.target.classList.contains("remove-input-item")) {
      const row = e.target.closest(".input-item-row");
      const idInput = row.querySelector('input[name$="[id]"]');
      const destroyInput = row.querySelector('input[name*="[_destroy]"]');
      
      if (idInput && destroyInput) {
        destroyInput.value = "1";
        row.style.display = "none";
      } else {
        row.remove();
      }
      recalculateOrderNos();
    }
  });

  // ✅ REMOVE DETAIL (Correctly sets _destroy for existing, removes for new)
  detailContainer.addEventListener("click", function (e) {
    if (e.target.classList.contains("remove-input-detail")) {
      const row = e.target.closest(".input-detail-row");
      const idInput = row.querySelector('input[name$="[id]"]');
      const destroyInput = row.querySelector('input[name*="[_destroy]"]');
      
      if (idInput && destroyInput) {
        destroyInput.value = "1";
        row.style.display = "none";
      } else {
        row.remove();
      }
      recalculateOrderNos();
    }
  });

  // Also listen for changes to the order_no fields themselves
  document.addEventListener("change", (e) => {
    if (e.target.name && e.target.name.includes("[order_no]")) {
      recalculateOrderNos();
    }
  });

  // ✅ DYNAMIC TOTAL CALCULATION FOR DETAILS
  detailContainer.addEventListener("input", function(e) {
    if (e.target.classList.contains("detail-qty-field") || e.target.classList.contains("detail-price-field")) {
      const row = e.target.closest(".input-detail-row");
      const qty = parseFloat(row.querySelector(".detail-qty-field").value) || 0;
      const price = parseFloat(row.querySelector(".detail-price-field").value) || 0;
      const totalField = row.querySelector(".detail-total-field");
      if (totalField) {
        totalField.value = (qty * price).toFixed(4);
      }
    }
  });
}


// ===============================
// TOM SELECT INIT
// ===============================
function initTomSelect(element) {
  if (!element || element.tomselect) return;

  new TomSelect(element, {
    create: false,
    allowEmptyOption: true,
    placeholder: element.dataset.placeholder || "Select Option",
    hidePlaceholder: true,
    persist: false,
    searchField: ["text"],
    maxOptions: 1000,
    sortField: {
      field: "text",
      direction: "asc"
    }
  });
}


// ===============================
// INIT ALL SELECTS
// ===============================
function initAllTomSelects(scope = document) {
  scope.querySelectorAll("select[data-placeholder]").forEach((select) => {
    if (!select.tomselect) {
      initTomSelect(select);
    }
  });
}


// ===============================
// TURBO + PAGE LOAD SUPPORT
// ===============================
document.addEventListener("turbo:load", () => {
  initInputForm();
  initAllTomSelects();
});

document.addEventListener("turbo:frame-load", () => {
  initAllTomSelects();
});

document.addEventListener("DOMContentLoaded", () => {
  initInputForm();
  initAllTomSelects();
});


// ===============================
// MARKS NO AJAX (TURBO FIX)
// ===============================
function submitNewMarksNo(button) {
  const wrapper = button.closest("[id^='marks_no_section']");
  const input = wrapper.querySelector("#new_marks_no_name");
  const errorsDiv = wrapper.querySelector("#marks-no-errors");

  const name = input.value;

  if (!name) {
    errorsDiv.textContent = "Marks No cannot be blank.";
    return;
  }

  fetch("/marks_nos", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
      "Accept": "text/vnd.turbo-stream.html"
    },
    body: JSON.stringify({ marks_no: { name } })
  })
    .then(res => res.text())
    .then(html => {
      wrapper.innerHTML = html;

      // 🔥 RE-INIT DROPDOWN AFTER UPDATE
      initAllTomSelects(wrapper);
    })
    .catch(() => {
      errorsDiv.textContent = "Something went wrong.";
    });
}
</script>