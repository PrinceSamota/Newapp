<div class="container mx-auto px-4 py-6">
  <div class="flex items-center mb-6">
    <%= link_to inputs_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300 mr-4" do %>
      <i class="fa-solid fa-arrow-left"></i>
      <span class="font-bold">Back</span>
    <% end %>
    <h1 class="text-2xl font-bold">New Input</h1>
  </div>
  
  <div class="bg-white p-8 rounded-2xl shadow-xl max-w-6xl mx-auto">
    <%= form_with(model: @input, local: true, class: "space-y-6") do |f| %>
      
      <% if @input.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded p-4">
          <h4 class="text-red-800 font-medium">Please fix the following errors:</h4>
          <ul class="text-red-600 text-sm mt-2">
            <% @input.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <%= f.label :invoice_no, "Invoice Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :invoice_no, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :invoice_date, "Invoice Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.date_field :invoice_date, class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>


        <div>
          <%= f.label :order_no_from_dispatch, "Order No from Dispatch", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :order_no_from_dispatch, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :currency, "Currency", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :currency, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :fedex_awb_no, "FedEx AWB Number", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :fedex_awb_no, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div id="marks_no_section">
          <%= render "inputs/marks_no_dropdown", selected_marks_no_id: @input.marks_no_id, show_form: false, errors: [] %>
        </div>

        <div>
          <%= f.label :no_of_packages, "No of Packages", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :no_of_packages, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div id="type_of_package_section">
          <%= render "inputs/type_of_package_dropdown", selected_type_of_package_id: @input.type_of_packages_id, show_form: false, errors: [] %>
        </div>

        <div id="complete_description_section">
          <%= render "inputs/complete_description_dropdown", selected_complete_description_id: @input.complete_description_of_goods_id, show_form: false, errors: [] %>
        </div>

        <div id="hsn_section">
          <%= render "inputs/hsn_dropdown", selected_hsn_id: @input.hsn_id, show_form: false, errors: [] %>
        </div>

        <div>
          <%= f.label :qty_pcb, "Qty PCS", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :qty_pcs, step: 0.01, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :price, "Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.number_field :price, step: 0.01, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>

        <div>
          <%= f.label :shipper_name_id, "Shipper Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :shipper_name_id, 
              options_from_collection_for_select(
                Client.where(org_id: current_user.org_id).select { |c| c.has_type?("shipper") }, 
                :id, :name, @input.shipper_name_id
              ),
              { include_blank: "Select Shipper" },
              { class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>

        <div>
          <%= f.label :consignee_name_id, "Consignee Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :consignee_name_id, 
              options_from_collection_for_select(
                Client.where(org_id: current_user.org_id).select { |c| c.has_type?("consignee") }, 
                :id, :name, @input.consignee_name_id
              ),
              { include_blank: "Select Consignee" },
              { class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>

        <div>
          <%= f.label :importer_name_id, "Importer Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :importer_name_id, 
              options_from_collection_for_select(
                Client.where(org_id: current_user.org_id).select { |c| c.has_type?("buyer") }, 
                :id, :name, @input.importer_name_id
              ),
              { include_blank: "Select Importer" },
              { class: "required-field w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-blue-500 focus:border-blue-500" } %>
        </div>
      </div>

      <!-- Input Items Section -->
      <div class="bg-green-50 p-6 rounded-xl shadow-sm mt-8">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Input Items</h3>

        <div id="input-items" class="space-y-4">
          <%= f.fields_for :input_items do |item_form| %>
            <%= render 'input_item_fields', f: item_form %>
          <% end %>
        </div>

        <button type="button" id="add-input-item" class="mt-4 bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">
          + Add Input Item
        </button>
      </div>

      <!-- Template for new input item row -->
      <div id="input-item-template" class="hidden">
        <% new_object = InputItem.new %>
        <% index = "NEW_INDEX" %>
        <%= f.fields_for :input_items, new_object, child_index: index do |item_form| %>
          <%= render 'input_item_fields', f: item_form %>
        <% end %>
      </div>

      <div class="flex justify-end space-x-4 mt-8">
        <%= f.submit "Create Input", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl text-lg cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>

<script>
function initInputForm() {
  const container = document.getElementById("input-items");
  if (!container || container.dataset.initialized === "true") return;
  container.dataset.initialized = "true";

  const template = document.getElementById("input-item-template")?.innerHTML;
  const addButton = document.getElementById("add-input-item");
  const form = document.querySelector("form");

  let index = container.querySelectorAll(".input-item-row").length;

  // Add input item row
  function addRow() {
    if (!template) return;
    const html = template.replace(/NEW_INDEX/g, index);
    container.insertAdjacentHTML("beforeend", html);
    
    // Naye row mein description dropdown ko properly initialize karo
    const newRow = container.lastElementChild;
    const descriptionSelect = newRow.querySelector('select[name*="description_of_goods_id"]');
    if (descriptionSelect) {
      console.log('New description field added:', descriptionSelect.name);
    }
    
    index++;
  }

  // Form submit se pehle cleanup
  form?.addEventListener("submit", (e) => {
    console.log('Form submitting...');
    
    // NEW_INDEX fields ko remove karo
    const newIndexFields = form.querySelectorAll('[name*="NEW_INDEX"]');
    console.log('Removing NEW_INDEX fields:', newIndexFields.length);
    newIndexFields.forEach(field => field.remove());
    
    // Description fields check karo
    const descriptionFields = form.querySelectorAll('select[name*="description_of_goods_id"]:not([name*="NEW_INDEX"])');
    console.log('Description fields found:', descriptionFields.length);
    
    descriptionFields.forEach((field, i) => {
      console.log(`Field ${i}: name="${field.name}", value="${field.value}"`);
      if (!field.value) {
        console.log('Empty description field found!');
        field.style.border = '2px solid red';
      }
    });
    
    normalizeFieldNames();
  });

  function normalizeFieldNames() {
    const rows = container.querySelectorAll(".input-item-row");
    console.log('Normalizing field names for', rows.length, 'rows');
    
    rows.forEach((row, i) => {
      const inputs = row.querySelectorAll("input, select, textarea");
      inputs.forEach((input) => {
        const oldName = input.name;
        if (input.name && !input.name.includes("NEW_INDEX")) {
          input.name = input.name.replace(/\[input_items_attributes\]\[[^\]]+\]/, `[input_items_attributes][${i}]`);
          console.log(`Renamed: ${oldName} -> ${input.name}`);
        }
      });
    });
  }

  addButton?.addEventListener("click", addRow);
  container?.addEventListener("click", removeRow);

  function removeRow(event) {
    if (event.target.classList.contains("remove-input-item")) {
      const row = event.target.closest(".input-item-row");
      row?.remove();
    }
  }
}

document.addEventListener("turbo:load", initInputForm);
document.addEventListener("turbo:frame-load", initInputForm);
</script>
