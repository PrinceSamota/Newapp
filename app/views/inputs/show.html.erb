<% content_for(:title, "Input Details") %>

<div class="min-h-screen bg-gray-50 py-6">
  <div class="max-w-7xl mx-auto px-4">
    
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
      <%= link_to inputs_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="font-bold">Back</span>
      <% end %>

      <div class="flex gap-3">
        <%= link_to edit_input_path(@input), class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg" do %>
          <i class="fa-solid fa-edit mr-2"></i>Edit
        <% end %>

        <%= link_to input_path(@input), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg" do %>
          <i class="fa-solid fa-trash mr-2"></i>Delete
        <% end %>
      </div>
    </div>

    <!-- Input Details Section -->
    <div class="bg-white rounded-lg shadow-lg p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Input Details</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <%# List of main input fields %>
        <% [
          ["Invoice Number", @input.invoice_no],
          ["Invoice Date", @input.invoice_date&.strftime("%d-%b-%Y")],
          ["Shipper", @input.shipper_name&.name],
          ["Consignee", @input.consignee_name&.name],
          ["Importer", @input.importer_name&.name],
          ["Order No from Dispatch", @input.order_no_from_dispatch],
          ["Currency", @input.currency],
          ["FedEx AWB No", @input.fedex_awb_no]
        ].each do |label, value| %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"><%= label %></label>
            <p class="text-gray-900 font-semibold"><%= value.presence || "—" %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Input Items Section -->
    <div class="bg-white rounded-lg shadow-lg p-8 mb-6">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Input Items</h3>
      <% if @input.input_items.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order No</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">No of Boxes</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Qty per Box</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Net Weight</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Gross Weight</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dimensions (L×W×H)</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @input.input_items.each do |item| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= item.order_no.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.no_of_boxes.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.description_of_good&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.qty_per_box.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.net_weight.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.gross_weight.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= [item.length, item.width, item.height].all? ? "#{item.length}×#{item.width}×#{item.height}" : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <i class="fa-solid fa-box-open text-4xl mb-4"></i>
          <p>No input items found</p>
        </div>
      <% end %>
    </div>

    <!-- Input Details Section -->
    <div class="bg-white rounded-lg shadow-lg p-8">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Input Details</h3>
      <% if @input.input_details.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Marks No</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">No of Packages</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type of Package</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description of Goods</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">HSN</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Qty PCS</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @input.input_details.each do |detail| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.marks_no&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.no_of_packages.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.type_of_package&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.complete_description_of_good&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.hsn&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.qty_pcs.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.price.presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <i class="fa-solid fa-box-open text-4xl mb-4"></i>
          <p>No input details found</p>
        </div>
      <% end %>
    </div>
    <div class="bg-blue-50 p-6 rounded-xl shadow-sm mt-8">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Generate Documents</h3>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
      <%= form_with url: generate_pdf_documents_path(format: :pdf), method: :post, target: "_blank", local: true, class: "inline" do |f| %>
        <%= f.hidden_field :input_id, value: @input.id %>
        <%= f.hidden_field :document_type, value: "invoice" %>
        <%= f.submit "Invoice PDF", class: "text-white px-4 py-3 rounded-lg transition text-center w-full", style: "background-color: #2563eb;" %>
      <% end %>
      
      <%= form_with url: generate_pdf_documents_path(format: :pdf), method: :post, target: "_blank", local: true, class: "inline" do |f| %>
        <%= f.hidden_field :input_id, value: @input.id %>
        <%= f.hidden_field :document_type, value: "packing_list" %>
        <%= f.submit "Packing List PDF", class: "text-white px-4 py-3 rounded-lg transition text-center w-full", style: "background-color: #16a34a;" %>
      <% end %>
      
      <%= form_with url: generate_pdf_documents_path(format: :pdf), method: :post, target: "_blank", local: true, class: "inline" do |f| %>
        <%= f.hidden_field :input_id, value: @input.id %>
        <%= f.hidden_field :document_type, value: "new_si" %>
        <%= f.submit "New SI PDF", class: "text-white px-4 py-3 rounded-lg transition text-center w-full", style: "background-color: #ca8a04;" %>
      <% end %>
      
      <%= form_with url: generate_pdf_documents_path(format: :pdf), method: :post, target: "_blank", local: true, class: "inline" do |f| %>
        <%= f.hidden_field :input_id, value: @input.id %>
        <%= f.hidden_field :document_type, value: "value_letter" %>
        <%= f.submit "Value Letter PDF", class: "text-white px-4 py-3 rounded-lg transition text-center w-full", style: "background-color: #9333ea;" %>
      <% end %>
      
      <%= form_with url: generate_pdf_documents_path(format: :pdf), method: :post, target: "_blank", local: true, class: "inline" do |f| %>
        <%= f.hidden_field :input_id, value: @input.id %>
        <%= f.hidden_field :document_type, value: "sheet_5" %>
        <%= f.submit "Sheet 5 PDF", class: "text-white px-4 py-3 rounded-lg transition text-center w-full", style: "background-color: #dc2626;" %>
      <% end %>
      
      <%= form_with url: generate_pdf_documents_path(format: :pdf), method: :post, target: "_blank", local: true, class: "inline" do |f| %>
        <%= f.hidden_field :input_id, value: @input.id %>
        <%= f.hidden_field :document_type, value: "scomet" %>
        <%= f.submit "Scomet PDF", class: "text-white px-4 py-3 rounded-lg transition text-center w-full", style: "background-color: #4f46e5;" %>
      <% end %>
    </div>
  </div>
  </div>
</div>
