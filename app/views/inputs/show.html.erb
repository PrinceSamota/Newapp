<% content_for(:title, "Input Details") %>

<div class="min-h-screen bg-gray-50 py-6">
  <div class="max-w-7xl mx-auto px-4">
    
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
      <%= link_to dispatches_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 border border-gray-300" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span class="font-bold">Back</span>
      <% end %>
<div class="flex items-center gap-3">
  <%= link_to edit_input_path(@input), class: "text-green-600 hover:text-green-900" do %>
    <i class="fa-solid fa-file-pen text-lg"></i>
  <% end %>

  <%= button_to input_path(@input), 
        method: :delete, 
        form: { data: { turbo_confirm: "Are you sure?" } }, 
        class: "text-red-600 hover:text-red-900 cursor-pointer inline-flex items-center p-0" do %>
    <i class="fa-solid fa-trash text-lg"></i>
  <% end %>
</div>

    </div>

    <!-- Input Details Section -->
    <div class="bg-white rounded-lg shadow-lg p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Input Details (<%= @input.dispatch&.d_id %>)</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <%# List of main input fields %>
        <% [
          ["Invoice Number", @input.invoice_no],
          ["Invoice Date", @input.invoice_date&.strftime("%d-%b-%Y")],
          ["Shipper", @input.shipper_name&.company_name],
          ["Consignee", @input.consignee_name&.company_name],
          ["Importer", @input.importer_name&.company_name],
          ["Order No from Dispatch", @input.order_no_from_dispatch],
          ["Currency", @input.currency&.name],
          ["FedEx AWB No", @input.fedex_awb_no]
        ].each do |label, value| %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1"><%= label %></label>
            <p class="text-gray-900 font-semibold"><%= value.presence || "—" %></p>
          </div>
        <% end %>
      </div>
    </div>
   <!-- Input Details Section -->
    <div class="bg-white rounded-lg shadow-lg p-8">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Input Details</h3>
      <% if @input.input_details.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Marks No</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">No of Packages</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Type of Package</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description of Goods</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">HSN</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Qty PCS</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Price</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @input.input_details.each do |detail| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.marks_no&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.no_of_packages.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.type_of_package&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.complete_description_of_good&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.hsn&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.qty_pcs.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= detail.price.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm font-semibold text-gray-900">
                    <%= number_with_precision((detail.qty_pcs || 0) * (detail.price || 0), precision: 2) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <i class="fa-solid fa-box-open text-4xl mb-4"></i>
          <p>No input details found</p>
        </div>
      <% end %>
    </div>

    <!-- Input Items Section -->
    <div class="bg-white rounded-lg shadow-lg p-8 mb-6 mt-8">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Input Items</h3>
      <% if @input.input_items.any? %>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order No</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">No of Boxes</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Qty per Box</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Net Weight</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Gross Weight</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dimensions (L×W×H)</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Download</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @input.input_items.each do |item| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= item.order_no.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.no_of_boxes.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.description_of_good&.name.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.qty_per_box.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.net_weight.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= item.gross_weight.presence || "—" %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= [item.length, item.width, item.height].all? ? "#{item.length}×#{item.width}×#{item.height}" : "—" %></td>
                  <td class="px-6 py-4 text-center">
                    <%= link_to new_item_pdf_path(item.id,input_id: @input.id), 
                        class: "text-blue-600 hover:text-blue-800" do %>
                          <i class="fa-solid fa-file-pdf text-xl"></i>
                    <% end %>
                  </td>

                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-8 text-gray-500">
          <i class="fa-solid fa-box-open text-4xl mb-4"></i>
          <p>No input items found</p>
        </div>
      <% end %>
    </div>

 <% if @input.status == "completed" %>
    <div class="bg-blue-50 p-6 rounded-xl shadow-sm mt-8">
  <h3 class="text-lg font-semibold text-gray-800 mb-6">Generate Documents</h3>

  <ul class="space-y-4">
    <% docs = [
      { type: "invoice", label: "Invoice", color: "#2563eb" },
      { type: "packing_list", label: "Packing List", color: "#16a34a" },
      { type: "new_si", label: "Shipping Instructions", color: "#ca8a04" },
      { type: "value_letter", label: "EVD", color: "#9333ea" },
      { type: "sheet_5", label: "Declaration", color: "#dc2626" },
      { type: "scomet", label: "Scomet", color: "#4f46e5" },
      { type: "anx", label: "ANX", color: "#0ea5e9" }
    ] %>

    <% docs.each do |doc| %>
      <li>
        <%= link_to generate_pdf_documents_path(input_id: @input.id, document_type: doc[:type], format: :pdf),
                    target: "_blank",
                    class: "flex items-center justify-between w-full text-white px-5 py-3.5 rounded-lg shadow-md transition-transform hover:scale-[1.02] hover:opacity-95 cursor-pointer",
                    style: "background-color: #{doc[:color]};" do %>

          <span class="flex items-center space-x-3 p-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V4" />
            </svg>
            <span class="font-medium text-sm md:text-base"><%= doc[:label] %></span>
          </span>
          <span class="text-xs md:text-sm opacity-90 italic p-4">(Download PDF)</span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
<% end %>

  </div>
</div>

<script>
document.addEventListener("turbo:load", () => {
  const openBtn = document.getElementById("openPdfPopup");
  const closeBtn = document.getElementById("closePdfPopup");
  const popup = document.getElementById("pdfPopup");

  openBtn?.addEventListener("click", () => popup.classList.remove("hidden"));
  closeBtn?.addEventListener("click", () => popup.classList.add("hidden"));
});

function openPdfModal(itemId) {
  document.getElementById("pdfModal").classList.remove("hidden");

  // Set hidden field
  document.getElementById("modal_item_id").value = itemId;

  // Update form action dynamically
  const form = document.getElementById("pdfForm");
  form.action = "/download_item_pdf/" + itemId + ".pdf";
}

function closePdfModal() {
  document.getElementById("pdfModal").classList.add("hidden");
}
</script>
