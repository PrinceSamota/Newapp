<div class="grid grid-cols-6 gap-2 items-center border-b py-2 item-row">
  <!-- Index -->
  <div class="text-center font-bold text-blue-500 item-index">1</div>

  <!-- SKU ID -->
  <div>
    <%= f.select :sku_id, options_for_select(item_masters.map { |m| [m.sku_id, m.sku_id] }), { include_blank: "Choose SKU" }, class: "w-full border rounded px-2 py-1 text-sm" %>
  </div>

  <!-- Item Name -->
  <div>
    <%= f.select :item_master_id, options_from_collection_for_select(item_masters, :id, :item_name), { include_blank: "Choose Item" }, class: "w-full border rounded px-2 py-1 text-sm" %>
  </div>

  <!-- Quantity -->
  <div>
    <%= f.number_field :receiving_quantity, class: "w-full border rounded px-2 py-1 text-sm", placeholder: "Qty" %>
  </div>

  <!-- Price -->
  <div>
    <%= f.number_field :purchase_price, step: 0.01, class: "w-full border rounded px-2 py-1 text-sm", placeholder: "₹" %>
  </div>

  <!-- Remove -->
  <div class="text-center">
    <button type="button" class="remove-item bg-red-500 text-white px-2 py-1 rounded hover:bg-red-600">−</button>
  </div>
</div>
