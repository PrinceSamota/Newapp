<%= link_to raw_material_stock_batches_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 rounded border border-gray-300" do %>
    <i class="fa-solid fa-arrow-left"></i>
      <span class="font-bold">Back</span>
    <% end %>

<%= form_with model: @batch, id: "RMI-form", local: true do |form| %>
    <div class="max-w-8xl mx-auto bg-white p-8 rounded-2xl shadow-xl space-y-8 mt-10">
  
      <!-- Header -->
      <h2 class="text-2xl font-semibold text-gray-800">Raw Material Inward Stock Management</h2>
  
      <!-- Supplier Info Section (Top) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <turbo-frame id="supplier_section">
  <div class="flex flex-col gap-2 w-full md:w-[500px]">
    <!-- Supplier label and + button -->
    <div class="flex justify-between items-center">
      <label class="text-sm font-semibold text-gray-700">Supplier</label>
      <button type="button"
              onclick="document.getElementById('newSupplierForm').classList.toggle('hidden')"
              class="text-blue-600 text-xl font-bold">+</button>
    </div>

    <!-- ✅ Corrected select_tag -->
    <div class="flex items-center">
      <%= select_tag "raw_material_stock_batch[supplier_id]",
        options_from_collection_for_select(Supplier.where(org_id: current_user.org_id), :id, :name),
        include_blank: "Select Supplier",
        class: "required-field w-full rounded-md border border-gray-300 px-4 py-2 text-sm" %>
    </div>

    <!-- Inline form to add new supplier -->
    <div id="newSupplierForm" class="mt-2 hidden">
      <div class="flex gap-2">
        <input id="new_supplier_name" type="text" placeholder="New supplier name"
               class="w-full rounded-md border px-3 py-2 text-sm" />
        <button type="button" onclick="submitNewSupplier()"
                class="bg-green-600 text-white px-3 py-2 rounded text-sm whitespace-nowrap">Add</button>
      </div>
      <div id="supplier-errors" class="text-red-600 text-sm mt-2"></div>
    </div>

    <!-- Flash error messages -->
    <% if flash[:supplier_errors].present? %>
      <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
        <% flash[:supplier_errors].each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
</turbo-frame>

    
        <div>
          <label class="block text-sm font-medium text-gray-700">Receiving Date</label>
          <%= form.date_field :receiving_date, class: "required-field mt-1 block w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
  
        <div>
          <label class="block text-sm font-medium text-gray-700">Supplier Invoice No.</label>
          <%= form.text_field :supplier_invoice_number, placeholder: "Enter invoice number", class: "required-field mt-1 block w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
        </div>
      </div>
  
      <!-- Divider -->
      <div class="border-t border-gray-300"></div>
  
      <!-- Dynamic Items (Start Below Supplier Info) -->
      <div id="items" class="space-y-4">
        <h3 class="text-lg font-semibold text-gray-800">Items</h3>
       <%= form.fields_for :raw_material_stock_items do |item_form| %>
            <div class="item-fields">
              <%= render 'item_fields', f: item_form %>
            </div>
          <% end %>
      </div>
  
      <!-- Add Item Button -->
      <div class="pt-2">
        <button type="button" id="add-item" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded-md cursor-pointer">
          + Add Item
        </button>
      </div>
      <div class="text-right text-lg font-semibold text-gray-800 mt-4">
  Total Price:  <span id="total-only-price">0.00</span>
</div>

  
      <!-- Submit Button -->
      <%= turbo_frame_tag "raw_material_form" do %>
  <%= form_with model: @batch, local: false do |form| %>
      <div class="pt-6">
        <%= form.submit "Submit", class: "w-32 relative left-[94%] bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-xl text-lg cursor-pointer" %>
      </div>
    </div>
    <% end %>
    <% end %>
    
  <% end %>
  

<div id="item-template" style="display: none;">
  <div class="relative item-fields grid grid-cols-7 gap-4 w-full items-center bg-white border border-gray-200 rounded-md px-4 py-3 mb-2 shadow-sm mt-6">
    <div class="col-span-2">
      <%= render 'shared/searchable_dropdown',
          field_id: "sku_INDEX",  
          label_text: "SKU ID",
          field_name: "raw_material_stock_batch[raw_material_stock_items_attributes][INDEX][sku_id]",
          items: @item_masters,
          value_method: :sku_id,
          selected_value: nil %>
    </div>
    <div class="col-span-2">
      <%= render 'shared/searchable_dropdown',
          field_id: "item_INDEX", 
          label_text: "Item Name",
          field_name: "raw_material_stock_batch[raw_material_stock_items_attributes][INDEX][item_name]",
          items: @item_masters,
          value_method: :item_name,
          selected_value: nil %>
    </div>
    <div class="col-span-1">
      <label class="text-xs font-medium text-gray-700 block mb-1">Quantity</label>
      <input type="number"
             name="raw_material_stock_batch[raw_material_stock_items_attributes][INDEX][receiving_quantity]"
             placeholder="Qty",
             min="1",
             class="required-field w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
    </div>
    <div class="col-span-1 w-[130%]">
      <label class="text-xs font-medium text-gray-700 block mb-1">Price</label>
      <input type="number" step="0.01"
             name="raw_material_stock_batch[raw_material_stock_items_attributes][INDEX][purchase_price]"
             placeholder="Price"
             class="required-field w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
    </div>
    <div class="col-span-1 text-right">
      <label class="text-xs font-medium text-gray-700 block mb-1">Total</label>
      <div class="text-sm font-semibold text-gray-800">
         <span class="row-total-price">0.00</span>
      </div>
    </div>
    <button type="button"
      class="remove-raw-material absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer"
      title="Remove">
      ✕
    </button>

  </div>
</div>

</div>
<script>
  document.addEventListener("turbo:load", function () {
    if (window.rawMaterialStockFormInitialized) return;
    window.rawMaterialStockFormInitialized = true;

    const itemsContainer = document.getElementById("items");
    const addItemBtn = document.getElementById("add-item");
    const template = document.getElementById("item-template")?.innerHTML;
    const itemDataEl = document.getElementById("item_masters_json");
    const itemMasters = itemDataEl ? JSON.parse(itemDataEl.textContent) : [];

    let index = itemsContainer?.querySelectorAll(".item-fields").length || 0;

    function attachSkuItemSync(row) {
      const skuInput = row.querySelector("[id*='sku_search']");
      const skuHidden = row.querySelector("[id*='sku_hidden']");
      const itemInput = row.querySelector("[id*='item_search']");
      const itemHidden = row.querySelector("[id*='item_hidden']");

      if (!skuInput || !itemInput || !skuHidden || !itemHidden) return;

      skuInput.addEventListener("change", () => {
        const val = skuInput.value.trim();
        const match = itemMasters.find(item => item.sku_id === val);
        if (match) {
          itemInput.value = match.item_name;
          itemHidden.value = match.item_name;

          const clear = row.querySelector("[id*='item_clear']");
          if (clear) clear.classList.remove("hidden");
        }
      });

      itemInput.addEventListener("change", () => {
        const val = itemInput.value.trim();
        const match = itemMasters.find(item => item.item_name === val);
        if (match) {
          skuInput.value = match.sku_id;
          skuHidden.value = match.sku_id;

          const clear = row.querySelector("[id*='sku_clear']");
          if (clear) clear.classList.remove("hidden");
        }
      });
    }

    function calculatePriceTotal() {
      let grandTotal = 0;
      const itemRows = itemsContainer.querySelectorAll(".item-fields");

      itemRows.forEach(row => {
        const qtyInput = row.querySelector("input[name*='[receiving_quantity]']");
        const priceInput = row.querySelector("input[name*='[purchase_price]']");
        const rowTotalSpan = row.querySelector(".row-total-price");

        const qty = parseFloat(qtyInput?.value || 0);
        const price = parseFloat(priceInput?.value || 0);
        const rowTotal = qty * price;

        if (rowTotalSpan) rowTotalSpan.textContent = rowTotal.toFixed(2);
        if (!isNaN(rowTotal)) grandTotal += rowTotal;
      });

      const totalDisplay = document.getElementById("total-only-price");
      if (totalDisplay) totalDisplay.innerText = grandTotal.toFixed(2);
    }

    function attachListenersToPriceFields() {
      const itemRows = itemsContainer.querySelectorAll(".item-fields");

      itemRows.forEach(row => {
        const qtyInput = row.querySelector("input[name*='[receiving_quantity]']");
        const priceInput = row.querySelector("input[name*='[purchase_price]']");

        if (qtyInput) {
          qtyInput.removeEventListener("input", calculatePriceTotal);
          qtyInput.addEventListener("input", calculatePriceTotal);
        }

        if (priceInput) {
          priceInput.removeEventListener("input", calculatePriceTotal);
          priceInput.addEventListener("input", calculatePriceTotal);
        }
      });
    }

    function handleAddItem() {
      const newItemHTML = template.replace(/INDEX/g, index);
      itemsContainer.insertAdjacentHTML("beforeend", newItemHTML);
      const newRow = itemsContainer.querySelectorAll(".item-fields")[index];

      attachSkuItemSync(newRow);
      attachListenersToPriceFields();
      calculatePriceTotal();
      index++;
    }

    if (addItemBtn && template && itemsContainer) {
      addItemBtn.addEventListener("click", handleAddItem);
    }

    itemsContainer.querySelectorAll(".item-fields").forEach(attachSkuItemSync);
    attachListenersToPriceFields();
    calculatePriceTotal();
  });

  document.addEventListener("turbo:before-cache", function () {
    window.rawMaterialStockFormInitialized = false;
  });

  function submitNewSupplier() {
    const nameField = document.getElementById("new_supplier_name");
    const name = nameField.value.trim();
    const errorsDiv = document.getElementById("supplier-errors");

    if (name === "") {
      errorsDiv.textContent = "Supplier name cannot be blank.";
      return;
    }

    fetch("/suppliers", {
      method: "POST",
      headers: {
        "X-CSRF-Token": document.querySelector("[name='csrf-token']").content,
        "Content-Type": "application/json",
        Accept: "text/vnd.turbo-stream.html"
      },
      body: JSON.stringify({ supplier: { name: name } })
    })
      .then(response => {
        if (!response.ok) throw new Error("Error creating supplier");
        return response.text();
      })
      .then(html => {
        Turbo.renderStreamMessage(html);
        nameField.value = "";
        document.getElementById("newSupplierForm").classList.add("hidden");
        errorsDiv.textContent = "";
      })
      .catch(() => {
        errorsDiv.textContent = "Failed to add supplier.";
      });
  }

  function selectLinkedDropdown(fieldId, selectedDiv) {
    const value = selectedDiv.textContent.trim();
    const input = document.getElementById(`${fieldId}_search`);
    const hidden = document.getElementById(`${fieldId}_hidden`);
    const list = document.getElementById(`${fieldId}_list`);
    const clearBtn = document.getElementById(`${fieldId}_clear`);

    input.value = value;
    hidden.value = value;
    list.classList.add("hidden");

    if (clearBtn) clearBtn.classList.remove("hidden");

    const itemDataEl = document.getElementById("item_masters_json");
    const itemMasters = itemDataEl ? JSON.parse(itemDataEl.textContent) : [];

    if (fieldId.includes("sku")) {
      const itemFieldId = fieldId.replace("sku", "item");
      const itemInput = document.getElementById(`${itemFieldId}_search`);
      const itemHidden = document.getElementById(`${itemFieldId}_hidden`);
      const match = itemMasters.find(item => item.sku_id === value);
      if (match && itemInput && itemHidden) {
        itemInput.value = match.item_name;
        itemHidden.value = match.item_name;
        const clear = document.getElementById(`${itemFieldId}_clear`);
        if (clear) clear.classList.remove("hidden");
      }
    }

    if (fieldId.includes("item")) {
      const skuFieldId = fieldId.replace("item", "sku");
      const skuInput = document.getElementById(`${skuFieldId}_search`);
      const skuHidden = document.getElementById(`${skuFieldId}_hidden`);
      const match = itemMasters.find(item => item.item_name === value);
      if (match && skuInput && skuHidden) {
        skuInput.value = match.sku_id;
        skuHidden.value = match.sku_id;
        const clear = document.getElementById(`${skuFieldId}_clear`);
        if (clear) clear.classList.remove("hidden");
      }
    }
  }

  function clearDropdownSelection(fieldId) {
    const input = document.getElementById(`${fieldId}_search`);
    const hidden = document.getElementById(`${fieldId}_hidden`);
    const clearBtn = document.getElementById(`${fieldId}_clear`);
  
    input.value = "";
    hidden.value = "";
    if (clearBtn) clearBtn.classList.add("hidden");
  
    // 🔄 Clear linked field also
    const linkedFieldId = fieldId.includes("sku") ? fieldId.replace("sku", "item") : fieldId.replace("item", "sku");
    const linkedInput = document.getElementById(`${linkedFieldId}_search`);
    const linkedHidden = document.getElementById(`${linkedFieldId}_hidden`);
    const linkedClear = document.getElementById(`${linkedFieldId}_clear`);
  
    if (linkedInput) linkedInput.value = "";
    if (linkedHidden) linkedHidden.value = "";
    if (linkedClear) linkedClear.classList.add("hidden");
  }

  // Row removal
  document.addEventListener("DOMContentLoaded", function () {
    document.addEventListener("click", function (e) {
      if (e.target.classList.contains("remove-raw-material")) {
        const row = e.target.closest(".item-fields");
        if (row) row.remove();
        document.dispatchEvent(new Event("turbo:load")); // recalculate totals
      }
    });
  });

  // Form validation
  document.addEventListener("turbo:load", () => {
    const form = document.getElementById("RMI-form");
    if (!form) return;

    form.addEventListener("submit", (e) => {
      let isValid = true;
      form.querySelectorAll(".required-field").forEach((field) => {
        field.classList.remove("border-red-500");
        const next = field.nextElementSibling;
        if (next && next.classList.contains("text-red-500")) next.remove();
      });

      form.querySelectorAll(".required-field").forEach((field) => {
        if (field.offsetParent !== null && !field.value.trim()) {
          isValid = false;
          field.classList.add("border-red-500");
          const error = document.createElement("p");
          error.textContent = "This field is required";
          error.className = "text-red-500 text-xs mt-1";
          field.insertAdjacentElement("afterend", error);
        }
      });

      if (!isValid) e.preventDefault();
    });
  });
</script>
