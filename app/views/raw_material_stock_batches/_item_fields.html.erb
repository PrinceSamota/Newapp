<%= content_tag :script, id: "item_masters_json", type: "application/json" do %>
  <%= raw @item_masters.to_json(only: [:id, :sku_id, :item_name]) %>
<% end %>

<!-- Dynamic Row -->
<div class="grid grid-cols-7 gap-4 w-full items-center bg-white border border-gray-200 rounded-md px-4 py-3 mb-2 shadow-sm item-row">

  <!-- SKU ID Dropdown -->
  <div class="col-span-2">
  <%= render 'shared/searchable_dropdown',
        field_id: "sku_#{f.index || SecureRandom.hex(4)}",
        label_text: "SKU ID",
        field_name: "#{f.object_name}[sku_id]",
        items: @item_masters,
        value_method: :sku_id,
        selected_value: f.object.sku_id,
        readonly: f.object.raw_material_stock_batch&.purchase_order_id.present? %>
</div>

  <!-- Item Name Dropdown -->
  <div class="col-span-2">
  <%= render 'shared/searchable_dropdown',
      field_id: "item_#{f.index || 'new'}",
      label_text: 'Item Name',
      field_name: f.object_name + '[item_name]',
      items: @item_masters,
      value_method: :item_name,
      selected_value: f.object.item_name,
      readonly: f.object.raw_material_stock_batch&.purchase_order_id.present? %>
</div>
  <!-- Quantity -->
  <div class="col-span-1">
    <%= f.label :receiving_quantity, "Quantity", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.number_field :receiving_quantity,
      step: :any,
      min: 1,
      placeholder: "Qty",
      class: "required-field w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <!-- Price -->
  <div class="col-span-1 w-[130%]">
    <%= f.label :purchase_price, "Price", class: "block text-xs font-medium text-gray-600 mb-1" %>
    <%= f.number_field :purchase_price,
      step: :any,
      placeholder: "Price",
      class: "required-field w-full border border-gray-300 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <!-- Total for Row -->
  <div class="col-span-1 text-right">
    <label class="text-xs font-medium text-gray-700 block mb-1">Total</label>
    <div class="text-sm font-semibold text-gray-800">
       <span class="row-total-price">0.00</span>
    </div>
  </div>
</div>
<script>
  function filterDropdown(fieldId) {
    const input = document.getElementById(`${fieldId}_search`);
    const filter = input.value.toLowerCase();
    const list = document.getElementById(`${fieldId}_list`);
    const options = list.getElementsByTagName('div');

    list.classList.remove('hidden');

    Array.from(options).forEach(option => {
      const text = option.textContent.toLowerCase();
      option.style.display = text.includes(filter) ? '' : 'none';
    });
  }

  function toggleDropdown(fieldId) {
    document.getElementById(`${fieldId}_list`).classList.toggle('hidden');
  }

  function selectLinkedDropdown(fieldId, element) {
  const selectedText = element.textContent.trim();
  const sku = element.dataset.sku;
  const itemName = element.dataset.itemName;

  document.getElementById(`${fieldId}_search`).value = selectedText;
  document.getElementById(`${fieldId}_hidden`).value = fieldId.startsWith("sku_") ? sku : itemName;
  document.getElementById(`${fieldId}_list`).classList.add('hidden');

  const index = fieldId.split('_')[1]; // eg. sku_3 → 3

  const otherSkuId = `sku_${index}`;
  const otherItemId = `item_${index}`;

  if (fieldId.startsWith('sku_')) {
    document.getElementById(`${otherItemId}_search`).value = itemName;
    document.getElementById(`${otherItemId}_hidden`).value = itemName;
  } else if (fieldId.startsWith('item_')) {
    document.getElementById(`${otherSkuId}_search`).value = sku;
    document.getElementById(`${otherSkuId}_hidden`).value = sku;
  }
}

  // Hide dropdown on click outside
  document.addEventListener("click", function(event) {
    document.querySelectorAll('[id$="_list"]').forEach(list => {
      if (!list.parentElement.contains(event.target)) {
        list.classList.add('hidden');
      }
    });
  });
</script>
