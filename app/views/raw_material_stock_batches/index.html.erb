<div class="p-6">
  <!-- Card wrapper -->
  <div class="bg-white shadow-md rounded-lg border border-gray-200">
    
    <!-- Header row: Title + Search + Add Button -->
    <div class="flex flex-col md:flex-row md:justify-between md:items-center p-4 gap-4">
  <!-- Left: Title -->
  <h2 class="text-xl font-semibold text-gray-800 md:order-1">Raw Material Inward</h2>

  <!-- Center: Search Input -->
  <div class="flex justify-center  md:w-auto md:flex-1 md:order-2">
  <div class="relative w-full md:w-80">
  <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">
    <i class="fa-solid fa-magnifying-glass"></i>
  </span>
  <input
    type="text"
    id="stockBatchSearchInput"
    placeholder="Supplier, Date, or Invoice"
    class="pl-10 border border-gray-300 rounded-md px-3 py-2 text-sm w-full focus:ring-blue-500 focus:border-blue-500"
  />
</div>
  </div>

  <!-- Right: Add Button -->
  <div class="flex justify-end md:order-3">
    <%= link_to new_raw_material_stock_batch_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-400 font-bold" do %>
      <i class="fa-solid fa-plus"></i>
      <span>Add RMI Stock</span>
    <% end %>
  </div>
</div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm border border-gray-200 rounded-lg">
        <thead class="bg-gray-100 text-gray-700 text-xs uppercase">
          <tr>
            <th class="px-4 py-3 text-left border-r border-gray-300">Supplier Name</th>
            <th class="px-4 py-3 text-left border-r border-gray-300">Receiving Date</th>
            <th class="px-4 py-3 text-left">Invoice Number</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-100">
          <% @batches.each do |batch| %>
            <tr
              class="hover:bg-gray-50 transition"
              data-supplier="<%= batch.supplier_name.to_s.downcase %>"
              data-date="<%= batch.receiving_date.present? ? batch.receiving_date.strftime('%d-%m-%Y').downcase : '' %>"
              data-invoice="<%= batch.supplier_invoice_number.to_s.downcase %>"
            >
              <td class="px-4 py-3 border-r border-gray-200">
  <%= link_to (batch.supplier_name.presence || "N/A"), raw_material_stock_batch_path(batch), class: "text-blue-600 hover:underline font-medium" %>
</td>

              <td class="px-4 py-3 border-r border-gray-200">
                <%= batch.receiving_date.present? ? batch.receiving_date.strftime('%d-%m-%Y') : "N/A" %>
              </td>
              <td class="px-4 py-3"><%= batch.supplier_invoice_number.presence || "N/A" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("stockBatchSearchInput");
    const rows = document.querySelectorAll("tbody tr[data-supplier]");

    searchInput.addEventListener("input", function () {
      const query = this.value.toLowerCase();

      rows.forEach(row => {
        const supplier = row.dataset.supplier;
        const date = row.dataset.date;
        const invoice = row.dataset.invoice;

        const isMatch =
          supplier.includes(query) ||
          date.includes(query) ||
          invoice.includes(query);

        row.style.display = isMatch ? "" : "none";
      });
    });
  });
</script>
