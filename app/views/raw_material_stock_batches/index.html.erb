<div class="flex justify-between items-center mb-4">
  <%= link_to root_path, class: "" do %>
  
  <% end %>
<div class="flex justify-end mb-4">
  <input
    type="text"
    id="stockBatchSearchInput"
    placeholder="Search by Supplier, Date, or Invoice"
    class="border border-gray-300 rounded-md px-3 py-2 text-sm w-64 focus:ring-blue-500 focus:border-blue-500"
  />
</div>
  <%= link_to new_raw_material_stock_batch_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-32 border border-gray-300" do %>
    <i class="fa-solid fa-plus"></i>
    <span class="font-bold">RMI Stock</span>
  <% end %>
</div>

<table class="w-full text-sm border border-gray-200 rounded-lg shadow-sm mb-6">
  <thead class="bg-gray-100 text-gray-700 text-xs uppercase">
    <tr>
      <th class="px-4 py-3 text-left border-r border-gray-300">Supplier Name</th>
      <th class="px-4 py-3 text-left border-r border-gray-300">Receiving Date</th>
      <th class="px-4 py-3 text-left">Invoice Number</th>
    </tr>
  </thead>
  <tbody>
   <% @batches.each do |batch| %>
    <tr class="bg-white" data-supplier="<%= batch.supplier_name.to_s.downcase %>"  data-date="<%= batch.receiving_date.present? ? batch.receiving_date.strftime('%d-%m-%Y').downcase : '' %>" data-invoice="<%= batch.supplier_invoice_number.to_s.downcase %>" >
      <td class="px-4 py-3 border-t border-r border-gray-200"><%= batch.supplier_name.presence || "N/A" %></td>
      <td class="px-4 py-3 border-t border-r border-gray-200">
        <%= batch.receiving_date.present? ? batch.receiving_date.strftime('%d-%m-%Y') : "N/A" %>
      </td>
      <td class="px-4 py-3 border-t border-gray-200"><%= batch.supplier_invoice_number.presence || "N/A" %></td>
    </tr>
    <% end %>
  </tbody>
</table>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("stockBatchSearchInput");
    const rows = document.querySelectorAll("tbody tr[data-supplier]");

    searchInput.addEventListener("input", function () {
      const query = this.value.toLowerCase();

      rows.forEach(row => {
        const supplier = row.dataset.supplier;
        const date = row.dataset.date;
        const invoice = row.dataset.invoice;

        const isMatch =
          supplier.includes(query) ||
          date.includes(query) ||
          invoice.includes(query);

        row.style.display = isMatch ? "" : "none";
      });
    });
  });
</script>
