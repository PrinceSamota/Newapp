<% content_for(:title, "Raw Material Inward Stock") %>
<div>
  <div class="bg-white shadow-md rounded-lg border border-gray-200">
      <div class="flex flex-col md:flex-row md:justify-between md:items-center p-4 h-18 gap-4">
    <h2 class="text-xl font-semibold text-gray-800 md:order-1">Raw Material Inward</h2>
      <div class="w-full md:flex-1 md:flex md:justify-center md:order-2">
        <%= search_form_for @q, url: raw_material_stock_batches_path, method: :get, html: { class: "w-full flex items-center justify-center gap-2" } do |f| %>
          <div class="relative w-full md:w-96">
            <%= f.search_field :supplier_name_or_supplier_invoice_number_cont,
              class: "pl-10 pr-4 py-2 border border-gray-300 rounded-md text-sm w-full focus:ring-2 focus:ring-blue-500 focus:border-blue-500",
              placeholder: "Search by Supplier or Invoice" %>
            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-500">
              <i class="fa-solid fa-magnifying-glass"></i>
            </span>
          </div>
          <%= f.submit "Search",
            class: "whitespace-nowrap px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-150 ease-in-out cursor-pointer" %>
        <% end %>
      </div>

      <div class="flex justify-end md:order-3">
          <%= link_to raw_material_stock_batches_path(format: :csv),
          class: "py-2 px-6  border border-gray-300 rounded-md hover:bg-gray-200 transition cursor-pointer",
          title: "Download CSV" do %>
        
          <i class="fa-solid fa-download text-lg"></i>
        
        <% end %>
      </div>
      <div class="flex justify-end md:order-3">
        <%= link_to new_raw_material_stock_batch_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-400 font-bold" do %>
          <i class="fa-solid fa-plus"></i>
          <span>Add RMI Stock</span>
        <% end %>
      </div>
  </div>


    <!-- Table -->
    <div class="overflow-x-auto max-h-[80vh] overflow-y-auto border border-gray-200 rounded-lg">
    <table class="min-w-full text-sm">
      <thead class="bg-gray-100 text-gray-700 text-xs uppercase sticky top-0 z-10">
        <tr>
          <th class="px-4 py-3 text-left border-r border-gray-300">Supplier Name</th>
          <th class="px-4 py-3 text-left border-r border-gray-300">Receiving Date</th>
          <th class="px-4 py-3 text-left">Invoice Number</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% @batches.each do |batch| %>
          <tr
            class="hover:bg-gray-50 transition"
            data-supplier="<%= batch.supplier&.name %>"
            data-date="<%= batch.receiving_date.present? ? batch.receiving_date.strftime('%d-%m-%Y').downcase : '' %>"
            data-invoice="<%= batch.supplier_invoice_number.to_s.downcase %>"
          >
            <td class="px-4 py-3 border-r border-gray-200">
              <%= link_to (batch.supplier&.name.presence || "N/A"), raw_material_stock_batch_path(batch), class: "text-blue-600 hover:underline font-medium" %>
            </td>
            <td class="px-4 py-3 border-r border-gray-200">
              <%= batch.receiving_date.present? ? batch.receiving_date.strftime("%d-%b-%Y") : "N/A" %>
            </td>
            <td class="px-4 py-3"><%= batch.supplier_invoice_number.presence || "N/A" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
    	<div class="flex items-center justify-between px-4 py-4 border-t border-gray-200 bg-gray-50">
  <div class="text-sm text-gray-600">
    Showing <%= @batches.offset_value + 1 %> -
    <%= [@batches.offset_value + @batches.length, @batches.total_entries].min %>
    of <%= @batches.total_entries %> results
  </div>
    <div class="flex items-center space-x-1">
    <%= will_paginate @batches,
      renderer: PaginationRenderer,
      previous_label: "&laquo;".html_safe,
      next_label: "&raquo;".html_safe,
      container: false %>
  </div>
</div>

  </div>
</div>
