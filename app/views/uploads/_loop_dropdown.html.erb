<div>
  <turbo-frame id="loop_section">
    <div class="flex flex-col space-y-2">
      <div class="flex justify-between items-center">
        <label class="text-sm font-semibold text-gray-800">Loop</label>
        <button type="button" onclick="document.getElementById('newLoopForm').classList.toggle('hidden')" class="text-blue-600 text-xl font-bold">+</button>
      </div>

      <% if current_user.present? %>
        <%= select_tag "item_master[loop_id]",
          options_from_collection_for_select(Loop.where(org_id: current_user.org_id), :id, :name, selected_loop_id),
          include_blank: "Select Loop",
          class: "w-full rounded-md border border-gray-300 px-4 py-2 text-sm" %>
      <% else %>
        <p class="text-red-500 text-sm">Please log in to select loop.</p>
      <% end %>

      <!-- Add new Loop -->
      <div id="newLoopForm" class="mt-2 <%= 'hidden' unless show_form %>">
        <div class="flex gap-2">
          <input id="new_loop_name" type="text" placeholder="New Loop name"
            class="flex-1 rounded-md border px-3 py-2 text-sm" />
          <button type="button" onclick="submitNewLoop()"
            class="bg-green-600 text-white px-3 py-2 rounded text-sm">Add</button>
        </div>
        <div id="loop-errors" class="text-red-600 text-sm mt-2"></div>
      </div>

      <% if errors.present? %>
        <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
          <% errors.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </turbo-frame>
</div>

<script>
  function submitNewLoop() {
    const name = document.getElementById('new_loop_name').value;

    fetch("/loops", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
        "Accept": "text/vnd.turbo-stream.html"
      },
      body: JSON.stringify({ loop: { name } })
    })
    .then(response => response.text())
    .then(html => {
      document.getElementById("loop_section").innerHTML = html;
    })
    .catch(error => {
      document.getElementById("loop-errors").innerText = "Something went wrong.";
      console.error(error);
    });
  }
</script>
