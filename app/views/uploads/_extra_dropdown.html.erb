<div>
  <turbo-frame id="extra_section">
    <div class="flex flex-col space-y-2">
      <div class="flex justify-between items-center">
        <label class="text-sm font-semibold text-gray-800">Extra</label>
        <button type="button"
          onclick="document.getElementById('newExtraForm').classList.toggle('hidden')"
          class="text-blue-600 text-xl font-bold">+</button>
      </div>

      <% if current_user.present? %>
        <%= select_tag "item_master[extra_id]",
          options_from_collection_for_select(
            Extra.where(org_id: current_user.org_id), :id, :name, selected_extra_id
          ),
          id: "extra-select",
          class: "required-field w-full rounded-md border border-gray-300 px-4 py-2 text-sm",
          data: { placeholder: "Select Extra" } %>
      <% else %>
        <p class="text-red-500 text-sm">Please log in to select extra.</p>
      <% end %>

      <!-- Add new Extra -->
      <div id="newExtraForm" class="mt-2 <%= 'hidden' unless show_form %>">
        <div class="flex gap-2">
          <input id="new_extra_name" type="text" placeholder="New Extra name"
            class="flex-1 rounded-md border px-3 py-2 text-sm" />
          <button type="button" onclick="submitNewExtra()"
            class="bg-green-600 text-white px-3 py-2 rounded text-sm">Add</button>
        </div>
        <div id="extra-errors" class="text-red-600 text-sm mt-2"></div>
      </div>

      <% if errors.present? %>
        <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
          <% errors.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </turbo-frame>
</div>

<script>
  function submitNewExtra() {
    const name = document.getElementById('new_extra_name').value;

    fetch("/extras", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
        "Accept": "text/vnd.turbo-stream.html"
      },
      body: JSON.stringify({ extra: { name } })
    })
    .then(response => response.text())
    .then(html => {
      document.getElementById("extra_section").innerHTML = html;
    })
    .catch(error => {
      document.getElementById("extra-errors").innerText = "Something went wrong.";
      console.error(error);
    });
  }

  function initExtraSelect() {
    const select = document.getElementById('extra-select');
    if (select && !select.tomselect) {
      let ts = new TomSelect(select, {
        create: false,
        allowEmptyOption: false,
        placeholder: select.dataset.placeholder || 'Select Extra',
        hidePlaceholder: true,
        persist: false,
        sortField: { field: 'text', direction: 'asc' },
        onDropdownOpen: function() {
          if (this.getValue()) this.clear(true);
        }
      });

      if (ts.getValue()) ts.clear(true);
    }
  }

  document.addEventListener('turbo:load', initExtraSelect);
  document.addEventListener('turbo:frame-load', initExtraSelect);
</script>
