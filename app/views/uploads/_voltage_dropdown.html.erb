<div>
  <turbo-frame id="voltage_section">
    <div class="flex flex-col space-y-2">
      <div class="flex justify-between items-center">
        <label class="text-sm font-semibold text-gray-800">Voltage</label>
        <button type="button"
          onclick="document.getElementById('newVoltageForm').classList.toggle('hidden')"
          class="text-blue-600 text-xl font-bold">+</button>
      </div>

      <% if current_user.present? %>
        <%= select_tag "item_master[voltage_id]",
          options_from_collection_for_select(
            Voltage.where(org_id: current_user.org_id), :id, :name, selected_voltage_id
          ),
          id: "voltage-select",
          include_blank: "Select Voltage",
          class: "required-field w-full rounded-md border border-gray-300 px-4 py-2 text-sm",
          data: { placeholder: "Select Voltage" } %>
      <% else %>
        <p class="text-red-500 text-sm">Please log in to select voltage.</p>
      <% end %>

      <!-- Add new Voltage -->
      <div id="newVoltageForm" class="mt-2 <%= 'hidden' unless show_form %>">
        <div class="flex gap-2">
          <input id="new_voltage_value" type="text" placeholder="New Voltage (e.g., 220V)"
            class="flex-1 rounded-md border px-3 py-2 text-sm" />
          <button type="button" onclick="submitNewVoltage()"
            class="bg-green-600 text-white px-3 py-2 rounded text-sm">Add</button>
        </div>
        <div id="voltage-errors" class="text-red-600 text-sm mt-2"></div>
      </div>

      <% if errors.present? %>
        <ul class="text-red-600 text-sm mt-2 list-disc pl-5">
          <% errors.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </turbo-frame>
</div>

<script>
  function submitNewVoltage() {
    const value = document.getElementById('new_voltage_value').value;

    fetch("/voltages", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector("meta[name='csrf-token']").content,
        "Accept": "text/vnd.turbo-stream.html"
      },
      body: JSON.stringify({ voltage: { name: value } })
    })
    .then(response => response.text())
    .then(html => {
      document.getElementById("voltage_section").innerHTML = html;
    })
    .catch(error => {
      document.getElementById("voltage-errors").innerText = "Something went wrong.";
      console.error(error);
    });
  }

  function initVoltageSelect() {
    const select = document.getElementById('voltage-select');
    if (select && !select.tomselect) {
      let ts = new TomSelect(select, {
        create: false,
        allowEmptyOption: false,
        placeholder: select.dataset.placeholder || 'Select Voltage',
        hidePlaceholder: true,
        persist: false,
        sortField: { field: 'text', direction: 'asc' },
        onDropdownOpen: function() {
          const urlParams = new URLSearchParams(window.location.search);
          const isClone = urlParams.has('clone_id');
          if (!isClone && this.getValue()) this.clear(true);
        }
      });

      const selectedValue = select.value;
      if (selectedValue) {
        ts.setValue(selectedValue, true);
      }
    }
  }

  document.addEventListener('turbo:load', initVoltageSelect);
  document.addEventListener('turbo:frame-load', initVoltageSelect);
</script>
