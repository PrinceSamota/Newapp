<div class="relative min-h-screen ">

            <!-- Body (if needed) -->
            <div class="p-6 text-center text-gray-700">
            <div class="flex items-center justify-between mb-4">
            <!-- Add Item Master Modal -->
          <div id="itemMasterModal" class="absolute top-20 right-5 z-50 hidden bg-white border border-gray-200 rounded-2xl shadow-2xl p-6 w-full max-w-3xl transition-all duration-300">
            <div class="w-full relative">

                  <!-- Close Button -->
                  <button onclick="toggleItemMasterModal(false)" class="absolute top-4 right-5 text-gray-500 hover:text-red-600 text-2xl font-bold">&times;</button>

                  <!-- Heading -->
                  <h2 class="text-2xl font-bold text-gray-800 mb-8 text-center">Add Item Master</h2>

                    <%= form_with model: ItemMaster.new, url: item_masters_path do |f| %>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <!-- Item Name -->
                        <div>
                          <%= f.label :item_name, "Item Name", class: "block text-sm font-medium text-gray-700 mb-1" %>
                          <%= f.text_field :item_name, placeholder: "Enter item name", class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                        </div>

                        <!-- Opening Stock -->
                        <div>
                          <%= f.label :opening_stock, "Opening Stock", class: "block text-sm font-medium text-gray-700 mb-1" %>
                          <%= f.number_field :opening_stock, placeholder: "Enter opening stock", class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                        </div>

                        <!-- Purchase Price -->
                        <div>
                          <%= f.label :purchase_price, "Purchase Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
                          <%= f.number_field :purchase_price, placeholder: "Enter purchase price", class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                        </div>

                        <!-- Sale Price -->
                        <div>
                          <%= f.label :sale_price, "Sale Price", class: "block text-sm font-medium text-gray-700 mb-1" %>
                          <%= f.number_field :sale_price, placeholder: "Enter sale price", class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                        </div>

                        <!-- Minimum Stock Level -->
                        <div>
                          <%= f.label :minimum_stock_level, "Minimum Stock Level", class: "block text-sm font-medium text-gray-700 mb-1" %>
                          <%= f.number_field :minimum_stock_level, placeholder: "Enter minimum stock level", class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
                        </div>

                        <!-- BOM Radio Buttons -->
                        <div class="flex items-center gap-4 mt-2">
                          <%= f.label :is_bOM, "BOM", class: "block text-sm font-medium text-gray-700" %>
                          <div class="flex gap-4 ml-4">
                            <label class="inline-flex items-center">
                              <%= f.radio_button :is_bOM, true, class: "form-radio text-blue-600" %>
                              <span class="ml-2 text-sm text-gray-800">Yes</span>
                            </label>
                            <label class="inline-flex items-center">
                              <%= f.radio_button :is_bOM, false, class: "form-radio text-blue-600" %>
                              <span class="ml-2 text-sm text-gray-800">No</span>
                            </label>
                          </div>
                        </div>
                        
                        <!-- Category Dropdown -->
                        <div class="col-span-1 md:col-span-2">
                          <%= render partial: "uploads/category_dropdown", locals: { selected_category_id: nil, show_form: false, errors: [] } %>
                        </div>

                        <!-- Measurement Dropdown -->
                        <div class="col-span-1 md:col-span-2">
                          <%= render partial: "uploads/measurement_dropdown", locals: { selected_measurement_id: nil, show_form: false, errors: [] } %>
                            <div class="col-span-1 md:col-span-2 mt-8">
                        <%= f.submit "Save", class: "bg-[#465fff] hover:bg-[#354edd] px-6 py-2 rounded-xl w-full text-white text-sm font-semibold shadow-md transition-all duration-200" %>
                      </div>
                        </div>
                      
                      <!-- Submit Button -->
                      
                    </div>
                    <% end %>
            </div>
          </div>

          <!-- Add Raw Material Modal -->
          <div id="RawMaterialModal" class="absolute top-20 right-5 z-50 hidden bg-white border border-gray-300 rounded-lg shadow-lg p-6 w-full max-w-4xl">
          <div class="bg-white border border-gray-300 rounded-xl shadow-2xl w-full max-w-5xl overflow-y-auto max-h-[90vh] p-6 relative">

            <!-- Close Button -->
            <button onclick="toggleRawMaterialModal(false)" class="absolute top-4 right-5 text-gray-500 hover:text-red-600 text-2xl font-bold">&times;</button>

            <h2 class="text-2xl font-bold text-gray-800 mb-6">New Raw Material Inward</h2>

            <%= form_with model: @raw_material_inward, url: raw_material_inwards_path, local: true do |form| %>
              <div class="grid grid-cols-2 gap-6">  
                <div>
                  <%= form.label :supplier_name, "Supplier Name", class: "text-sm font-medium text-gray-700" %>
                  <%= form.text_field :supplier_name, class: "border rounded-md px-3 py-2 w-full" %>
                </div>
            
                <div>
                  <%= form.label :receiving_date, "Receiving Date", class: "text-sm font-medium text-gray-700" %>
                  <%= form.date_field :receiving_date, class: "border rounded-md px-3 py-2 w-full" %>
                </div>
            
                <div>
                  <%= form.label :sku_id, "SKU ID", class: "text-sm font-medium text-gray-700" %>
                  <%= form.text_field :sku_id, class: "border rounded-md px-3 py-2 w-full" %>
                </div>
            
                <div>
                  <%= form.label :item_name, "Item Name", class: "text-sm font-medium text-gray-700" %>
                  <%= form.text_field :item_name, class: "border rounded-md px-3 py-2 w-full" %>
                </div>
            
                <div>
                  <%= form.label :receiving_quantity, "Receiving Quantity", class: "text-sm font-medium text-gray-700" %>
                  <%= form.number_field :receiving_quantity, class: "border rounded-md px-3 py-2 w-full" %>
                </div>
            
                <div>
                  <%= form.label :purchase_price, "Purchase Price", class: "text-sm font-medium text-gray-700" %>
                  <%= form.text_field :purchase_price, class: "border rounded-md px-3 py-2 w-full" %>
                </div>
              </div>
            
              <div class="mt-8">
                <%= form.submit "Create", class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow transition" %>
              </div>
            <% end %>
          </div>
          </div>
            <!-- Upload Modal -->
            <div id="uploadModal" class="absolute top-20 right-5 z-50 hidden bg-white border border-gray-300 rounded-lg shadow-lg p-6 w-full max-w-md">
              <div class="bg-white w-full max-w-md rounded-xl p-6 shadow-lg relative">

                <!-- Close Button -->
                <button onclick="toggleModal(false)" class="absolute top-2 right-3 text-gray-600 hover:text-red-500 text-xl font-bold">&times;</button>

                <% @data ||= [] %>
                <% @decoded_result ||= {} %>

                <% if current_user %>
                  <!-- File Upload Form -->
                  <%= form_with model: UploadedFile.new, url: uploads_path, local: true, multipart: true, html: { id: "file-upload-form" } do |form| %>
                    <div class="mb-4">
                      <%= form.file_field :file, id: "fileInput", class: "hidden" %>
                      <div class="flex items-center space-x-4">
                        <label for="fileInput" class="px-4 py-2 bg-gray-200 text-gray-700 rounded cursor-pointer hover:bg-gray-300">
                          Choose file
                        </label>
                        <span id="fileName" class="text-gray-600 text-sm">No file chosen</span>
                      </div>
                    </div>
                    <div>
                      <%= form.submit "Upload", class: "w-full hover:bg-gray-100 px-4 py-1 rounded-full text-black font-bold transition cursor-pointer border-2" %>
                    </div>
                  <% end %>

                  <hr class="border-t border-gray-300 my-6" />

                  <!-- Manual Decode Form -->
                  <%= form_with url: manual_decode_path, method: :post, local: true do |f| %>
                    <div class="mb-4">
                      <%= f.label :article_number, "Enter Article Number:", class: "block text-gray-700 font-medium mb-1" %>
                      <%= f.text_field :article_number, value: @article_number, required: true,
                            class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500",
                            placeholder: "e.g. 000123456" %>
                    </div>
                    <div>
                      <%= f.submit "Decode", class: "w-full hover:bg-gray-100 px-4 py-1 rounded-full text-black font-bold transition cursor-pointer border-2" %>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>

            <div class="p-6 pt-0">

            <% if @item_masters.present? %>
              <div class="bg-white shadow-md rounded-lg overflow-hidden border border-gray-200">
                <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
                  <div class="flex items-center space-x-2">
                  Item Master
                  </div>
                  <div>   <div class="flex items-center gap-2">
                  <button onclick="toggleItemMasterModal(true)" class="flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer ">
                    <i class="fa-solid fa-plus text-lg"></i>
                    <span class="sidebar-label">Add Item</span>
                  </button>
                

                </div>
          
                  
                  </div>
                </div>

                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200 text-sm">
                  <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                  <tr>
                    <% ["Item Name", "Measurement", "Category", "Opening Stock", "Purchase Price", "Sale Price", "Minimum Stock Level", "Is BOM", "SKU", "Action"].each_with_index do |header, index| %>
                      <th class="px-6 py-3 text-left whitespace-nowrap border-r border-gray-300 <%= 'last:border-r-0' if index == 9 %>">
                        <%= header %>
                      </th>
                    <% end %>
                  </tr>
                </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <% @item_masters.each do |item| %>
                        <tr class="hover:bg-gray-50  text-left">
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.item_name %></td>
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.measurement&.name %></td>
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.category&.name %></td>
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.opening_stock %></td>
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.purchase_price %></td>
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.sale_price %></td>
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.minimum_stock_level %></td>
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.is_bOM ? "Yes" : "No" %></td>
                          <td class="px-6 py-4 whitespace-nowrap border-r-1 border-gray-200"><%= item.sku_id %></td>
                          <td class="px-6 py-4 whitespace-nowrap flex gap-2">
                            <button class="text-gray-600 cursor-pointer hover:text-gray-700 "><i class="fa fa-pen-to-square"></i></button>
                            <button class="text-gray-600 cursor-pointer hover:text-gray-700"><i class="fa fa-trash"></i></button>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>

                <div class="flex items-center justify-between px-4 py-3 border-t border-gray-200 text-sm text-gray-600">
                  <div class="flex space-x-1">
                    <button class="px-3 py-1 rounded border border-gray-300 bg-white hover:bg-gray-100">Previous</button>
                    <button class="px-3 py-1 rounded border border-gray-300 bg-blue-500 text-white">1</button>
                    <button class="px-3 py-1 rounded border border-gray-300 bg-white hover:bg-gray-100">2</button>
                    <button class="px-3 py-1 rounded border border-gray-300 bg-white hover:bg-gray-100">Next</button>
                  </div>
                </div>
              </div>
            <% else %>
               <div class="flex items-center gap-2">
                  <button onclick="toggleItemMasterModal(true)" class="flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer ">
                    <i class="fa-solid fa-plus text-lg"></i>
                    <span class="sidebar-label">Add Item</span>
                  </button>
                
                  <button onclick="toggleModal(true)" class="flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer ">
                    <i class="fa-solid fa-upload text-lg"></i>
                    <span class="sidebar-label">Upload File</span>
                  </button>
                </div>
              <p class="text-gray-600 mt-4">No item masters available yet.</p>
            <% end %>
          </div>


            <!-- Optional: Show Decoded or Excel Data -->
            <div class="p-6">
              <% if @data.present? %>
                <h2 class="text-xl font-semibold mb-2">Excel Contents</h2>
                <table class="w-full table-auto border-collapse border border-gray-300 text-sm">
                  <% @data.each do |row| %>
                    <tr>
                      <% row.each do |cell| %>
                        <td class="border border-gray-300 px-2 py-1"><%= cell %></td>
                      <% end %>
                    </tr>
                  <% end %>
                </table>
              <% end %>

              <% if @decoded_result.present? %>
                <h3 class="text-xl font-semibold mt-6 mb-2">Decoded Result</h3>
                <table class="w-full table-auto border-collapse border border-gray-300 text-sm">
                  <% @decoded_result.each do |key, value| %>
                    <tr>
                      <td class="border border-gray-300 px-2 py-1 font-medium"><%= key.to_s.humanize %></td>
                      <td class="border border-gray-300 px-2 py-1"><%= value %></td>
                    </tr>
                  <% end %>
                </table>
              <% end %>
            </div>
</div>

<!-- JS for Modal & File Name -->
<script>
    function toggleItemMasterModal(show) {
      const modal = document.getElementById("itemMasterModal");
      if (modal) {
        modal.classList.toggle("hidden", !show);
        modal.classList.toggle("flex", show);
      }
    }

    function toggleRawMaterialModal(show) {
      const modal = document.getElementById("RawMaterialModal");
      if (modal) {
        modal.classList.toggle("hidden", !show);
        modal.classList.toggle("flex", show);
      }
    }

  function toggleModal(show) {
    const modal = document.getElementById("uploadModal");
    if (modal) {
      modal.classList.toggle("hidden", !show);
      modal.classList.toggle("flex", show);
    }
  }

  document.addEventListener("turbo:load", function () {
    const fileInput = document.getElementById("fileInput");
    const fileName = document.getElementById("fileName");

    if (fileInput && fileName) {
      fileInput.addEventListener("change", function () {
        fileName.textContent = fileInput.files.length > 0 ? fileInput.files[0].name : "No file chosen";
      });
    }
  });




document.addEventListener("DOMContentLoaded", function () {
  const decodeButton = document.getElementById("decode_button");
  const articleInput = document.getElementById("article_number_input");

  if (!decodeButton || !articleInput) {
    console.warn("Decode button or article input not found");
    return;
  }

  decodeButton.addEventListener("click", function () {
    const articleNumber = articleInput.value;

    fetch("/item_masters/decode_article", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').getAttribute("content")
      },
      body: JSON.stringify({ article_number: articleNumber })
    })
      .then(response => response.json())
      .then(data => {
                  const coverField = document.getElementById("cover_field");
        if (coverField) coverField.value = data.cover || "";

        const kelvinField = document.getElementById("kelvin_field");
        if (kelvinField) kelvinField.value = data.kelvin || "";

        const lengthField = document.getElementById("length_field");
        if (lengthField) lengthField.value = data.length || "";

        const serviceField = document.getElementById("service_field");
        if (serviceField) serviceField.value = data.service || "";

        const suspensionField = document.getElementById("suspension_field");
        if (suspensionField) suspensionField.value = data.suspension || "";

        const typeField = document.getElementById("type_field");
        if (typeField) typeField.value = data.type || "";

        const voltageField = document.getElementById("voltage_field");
        if (voltageField) voltageField.value = data.voltage || "";

        const nameField = document.querySelector('input[name="item_master[item_name]"]');
        if (nameField) nameField.value = data.item_name || "";

        const unitField = document.querySelector('input[name="item_master[unit_of_measurement]"]');
        if (unitField) unitField.value = data.unit_of_measurement || "";

        const categoryField = document.querySelector('input[name="item_master[item_category]"]');
        if (categoryField) categoryField.value = data.item_category || "";

        const clientField = document.querySelector('input[name="item_master[client]"]');
        if (clientField) clientField.value = data.client || "";

        const wattField = document.querySelector('input[name="item_master[watt]"]');
        if (wattField) wattField.value = data.watt || "";



        console.log(data);
      })
      .catch(error => {
        console.error("Error decoding:", error);
        alert("Decoding failed. Please check article number.");
      });
  });
});

</script>
