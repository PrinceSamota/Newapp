<div class="container mx-auto px-4 py-6">
  <h1 class="text-2xl font-bold mb-6">Generate <%= @label_type.humanize %> Label</h1>
  
  <%= form_with url: generate_pdf_labels_path(format: :pdf), method: :post, local: true, class: "space-y-6" do |form| %>
    <%= form.hidden_field :label_type, value: @label_type %>
    


    <!-- Sticker Information -->
    <div class="bg-white p-6 rounded-lg shadow">
      <h3 class="text-lg font-semibold mb-4">Sticker Information</h3>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :sticker_date, "Sticker Date", class: "block text-sm font-medium mb-1" %>
          <%= form.date_field :sticker_date,  class: "w-full p-2 border rounded" %>
        </div>
        <div>
          <%= form.label :sticker_quantity, "Sticker Quantity", class: "block text-sm font-medium mb-1" %>
          <%= form.number_field :sticker_quantity,  class: "w-full p-2 border rounded" %>
        </div>
        <div>
        <%= form.label :custom_article_no, "Custom Article No.", class: "block text-sm font-medium mb-1" %>
        <%= form.text_field :custom_article_no, placeholder: "Enter custom article no.", class: "w-full p-2 border rounded" %>
      </div>
        <div>
          <%= form.label :frame_colour, "Frame Colour", class: "block text-sm font-medium mb-1" %>
          <%= form.select :frame_colour, 
              options_for_select([
                ["Red", "red"],
                ["Black", "black"],
                ["Green", "green"],
                ["Blue", "blue"]
              ]), 
              { prompt: "Select Frame Colour" },
              { class: "w-full p-2 border rounded" } %>
        </div>
        <div>
          <%= form.label :language, "Language", class: "block text-sm font-medium mb-1" %>
          <%= form.select :language, 
              options_for_select([
                ["English", "english"],
                ["Hindi", "hindi"],
                ["German", "german"],
                ["French", "french"],
                ["Spanish", "spanish"]
              ]), 
              { prompt: "Select Language" },
              { class: "w-full p-2 border rounded" } %>
        </div>
        <%= form.hidden_field :order_id, value: @order_details[:order_id] %>
<%= form.hidden_field :article_no, value: @order_details[:article_no] %>
<%= form.hidden_field :sku_number, value: @order_details[:sku_number] %>
<%= form.hidden_field :qty, value: @order_details[:qty] %>
<%= form.hidden_field :type, value: @order_details[:type] %>
<%= form.hidden_field :length, value: @order_details[:length] %>
<%= form.hidden_field :voltage, value: @order_details[:voltage] %>
<%= form.hidden_field :wattage, value: @order_details[:wattage] %>
<%= form.hidden_field :cct, value: @order_details[:cct] %>
      </div>
    </div>

    <div class="bg-white p-6 rounded-lg shadow">
    <h3 class="text-lg font-semibold mb-4">Client Selection</h3>
  
    <div class="grid grid-cols-2 gap-4">
  
      <!-- Manufacturer Dropdown -->
      <div>
        <label class="block text-sm font-medium mb-1">Manufacturer</label>
        <%= form.select :manufacturer_id, 
          options_from_collection_for_select(
            Client.where(org_id: current_user.org_id).select { |c| c.has_type?("manufacturer") }, 
            :id, :company_name
          ), 
          { prompt: "Select Manufacturer" },
          { class: "w-full p-2 border rounded" } %>
      </div>
  
      <!-- Distributor Dropdown -->
      <div>
        <label class="block text-sm font-medium mb-1">Distributor</label>
        <%= form.select :distributor_id, 
          options_from_collection_for_select(
            Client.where(org_id: current_user.org_id).select { |c| c.has_type?("distributor") }, 
            :id, :company_name
          ), 
          { prompt: "Select Distributor" },
          { class: "w-full p-2 border rounded" } %>
      </div>
  
    </div>
  </div>
  
  

    <div class="text-center">
      <%= form.submit "Generate #{@label_type.humanize} Label PDF", class: " px-8 py-3 rounded-lg hover:bg-purple-700 transition" %>
    </div>
  <% end %>
</div>


