<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>LED Product Sticker</title>
  <style>
    <% type_d = @form_data[:type].to_s.downcase == 'd' %>

    @page { 
      size: A3 landscape; 
      margin:0; 
     }

    body { 
        font-family: Arial, sans-serif; 
        font-size: 5px; 
        margin-top: 0; 
        padding: 0; 
        background: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        } 
    
    .sticker {
      border: 1px solid #000;
      width: <%= type_d ? '199mm' : '299mm' %>;
      height: <%= type_d ? '17mm' : '32.6mm' %>; 
      padding: 1px; 
      box-sizing: border-box;
      position: relative;
      margin-top: 241mm;
      display: flex;
      flex-direction: row;
      align-items: center;
         }

    table {
      min-width:  <%= type_d ? '100mm' : '150mm' %>;
      max-height: <%= type_d ? '8mm' : '16mm' %>;
      min-height: <%= type_d ? '8mm' : '16mm' %>;
      border-collapse: collapse;
      table-layout: fixed;
    }

    th {
      border: 2px solid <%= @form_data[:frame_colour].to_s.split.first %>;
      padding: 1mm;
      font-size: <%= type_d ? '2.5px' : '6px' %>;
      text-align: center;
      vertical-align: middle;
      word-wrap: break-word;
    }
      
    td {
      border: 2px solid <%= @form_data[:frame_colour].to_s.split.first %>;
      padding: 1mm;
      font-size: <%= type_d ? '2.5px' : '6px' %>;
      text-align: center;
      vertical-align: middle;
      word-wrap: break-word;
    }

    td {
      height: <%= type_d ? '2mm' : '6mm' %>;
    }
    th {
      height: <%= type_d ? '2mm' : '6mm' %>;
    }

    th {
      font-weight: bold;
      background: #fff;
    }

    /* LEFT LOGO AREA */
    .left-logo {
      width: <%= type_d ? '35mm' : '60mm' %>;
      text-align: center;
      vertical-align: middle;
      border: none;
      position: relative;
    }

    /* RIGHT LOGO AREA */
    .right-logo {
      width: <%= type_d ? '35mm' : '75mm' %>;
      text-align: center;
      vertical-align: middle;
      border: none;
      position: relative;
    }

    /* LOGO & SIGNATURE IMAGE STYLES */
    .logo-container {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .logo-container img {
      margin: 0 2mm;
      max-width: <%= type_d ? '12mm' : '18mm' %>;
      max-height: <%= type_d ? '5mm' : '15mm' %>;
      object-fit: contain;
    }

    /* RIGHT SIDE LOGO BLOCK (EMC + Distribution + QR) */
    .right-logo-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1mm;
    }

    .right-logo-container img {
      max-width: <%= type_d ? '10mm' : '10mm' %>;
      max-height: <%= type_d ? '5mm' : '5mm' %>;
      object-fit: contain;
    }

    .footer {
      position: absolute;
      bottom: -15mm;    
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      font-weight: bold;
      font-size: <%= type_d ? '8px' : '25px' %>;
    }

  </style>
</head>
<body>




<div class="sticker">
            <div class="left-logo" rowspan="2">
              <div class="logo-container" style="display:flex; gap:3mm; justify-content:center; align-items:center;">
            
                <!-- Logo Block 1 -->
                <div style="text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; min-height:<%= type_d ? '18mm' : '28mm' %>;">

                  <% if @client&.logo&.attached? %>

                    <!-- Top text (fixed position) -->
                    <div style="
                      font-size:<%= type_d ? '4px' : '6px' %>;
                      font-weight:bold;
                      height:<%= type_d ? '4mm' : '6mm' %>;
                      line-height:<%= type_d ? '4mm' : '6mm' %>;
                      margin:0;
                      padding:2mm;
                    ">
                      Hersteller / Manufacturers
                    </div>

                    <!-- Logo -->
                    <div style="
                      height:<%= type_d ? '6mm' : '12mm' %>;
                      display:flex;
                      align-items:center;
                      justify-content:center;
                      margin-top:2mm;
                    ">
                      <%= image_tag @client.logo, alt: "Company Logo", style: "max-height:100%; width:auto;" %>
                    </div>

                    <!-- Bottom text -->
                    <% if @client&.company_url.present? %>
                      <div style="
                        font-size:<%= type_d ? '4px' : '6px' %>;
                        font-weight:bold;
                        height:<%= type_d ? '4mm' : '6mm' %>;
                        line-height:<%= type_d ? '4mm' : '6mm' %>;
                        margin:0;
                        padding:0;
                      ">
                        <%= @client.company_url %>
                      </div>
                    <% end %>

                  <% end %>

                </div>
            
                <!-- Logo Block 2 -->
                <div style="text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; min-height:<%= type_d ? '18mm' : '28mm' %>;">
                  
                  <!-- Top text -->
                  <div style="
                    font-size:<%= type_d ? '4px' : '6px' %>;
                    font-weight:bold;
                    height:<%= type_d ? '4mm' : '6mm' %>;
                    line-height:<%= type_d ? '4mm' : '6mm' %>;
                    margin:0;
                    padding:2mm;
                  ">
                    Coach LED Tube
                  </div>

                  <!-- Logo -->
                  <div style="
                    height:<%= type_d ? '6mm' : '12mm' %>;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    margin-top:2mm;
                  ">
                    <%= wicked_pdf_image_tag "sticker_data.png",
                        style: "max-height:100%; width:auto;" %>
                  </div>

                  <!-- Bottom text -->
                  <div style="
                    font-size:<%= type_d ? '4px' : '6px' %>;
                    font-weight:bold;
                    height:<%= type_d ? '4mm' : '6mm' %>;
                    line-height:<%= type_d ? '4mm' : '6mm' %>;
                    margin:0;
                    padding:0;
                  ">
                    Made in India
                  </div>

                  <div style="
                    font-size:<%= type_d ? '4px' : '6px' %>;
                    font-weight:bold;
                    margin-top:1mm;
                  ">
                    <% begin %>
                      <% if @form_data[:sticker_date].present? %>
                        <%#= Date.parse(@form_data[:sticker_date]).strftime('%m/%Y') %>
                      <% end %>
                    <% rescue %>
                    <% end %>
                  </div>

                </div>
            
              </div>
            </div>
              <div>
                <table style="border-collapse: collapse; table-layout: auto;">
                    <tr>
                    <th style="white-space: nowrap; max-width: 10%;">Type <br><%= params[:language] == "en" ? "" : t("pdf.type") %></th>
                    <th>Length <br><%= params[:language] == "en" ? "" : t("pdf.length") %></th>
                    <th>Power <br><%= params[:language] == "en" ? "" : t("pdf.power") %></th>
                    <th>Voltage <br><%= params[:language] == "en" ? "" : t("pdf.voltage") %></th>
                    <th>Current <br><%= params[:language] == "en" ? "" : t("pdf.current") %></th>
                    <th style="width:20%;">Operating temperature <br> <%= params[:language] == "en" ? "" : t("pdf.operating_temperature") %></th>
                    <th>Light color <br><%= params[:language] == "en" ? "" : t("pdf.light_color") %></th>
                    <th>Article No. <br><%= params[:language] == "en" ? "" : t("pdf.article_no") %></th>
                    </tr>
                    <% order = OrderEntry.find_by(id: @form_data[:order_id]) %>
                    <% sku_id = order&.sku_number %>
                    <% item_master = ItemMaster.find_by(sku_id: sku_id) %>
                    <tr>
                    <td style="font-weight: bold; white-space: nowrap;"><% if @client&.brand_name.present? %><%= @client&.brand_name %><% end %><%= @form_data[:type] %><br>
                    <%= @form_data[:profile] %>/<%= @form_data[:length].to_s.scan(/\d+/).first %>/<%= @form_data[:cct].to_s.scan(/\d+/).first %>/<%= @form_data[:cover] %>
                    </td>
                    <td style="font-weight: bold;"><%= @form_data[:length] %></td>
                    <td style="font-weight: bold;"><%= @form_data[:wattage] %></td>
                    <td style="font-weight: bold;"><%= @form_data[:voltage] %></td>
                    <td style="font-weight: bold;">
                      <%= begin
                            watt = @form_data[:wattage].to_s.gsub(/[^\d.]/, '').to_f
                            volt = @form_data[:voltage].to_s.gsub(/[^\d.]/, '').to_f
                            volt.zero? ? "-" : "#{(watt / volt).round(2)} A"
                          rescue
                            "-"
                          end %>
                    </td>
                    <td style="font-weight: bold; width: 15%;">-40°C to +85°C (OT6)</td>
                    <td style="font-weight: bold;"><%= @form_data[:cct] %></td>
                    <td style="font-weight: bold;"><%= @form_data[:custom_article_no].presence || @form_data[:article_no] %></td>
                  </tr>
                </table>
              </div>


              <div class="right-logo" rowspan="3" style="margin-left: 3mm;">
              <div class="logo-container" style="display:flex; gap:3mm; justify-content:center; align-items:center;">
            

              <div style="text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; min-height:<%= type_d ? '18mm' : '28mm' %>;">
  
                <% if @distributor&.qr_code&.attached? %>

                  <!-- Top Text -->
                  <div style="
                    font-size:<%= type_d ? '4px' : '6px' %>;
                    font-weight:bold;
                    height:<%= type_d ? '4mm' : '6mm' %>;
                    line-height:<%= type_d ? '4mm' : '6mm' %>;
                    margin:0;
                    padding:2mm;
                  ">
                    <%= params[:language] == "en" ? "" : t("pdf.serial_no") %> / Serial No.
                  </div>

                  <!-- QR Code -->
                  <div style="
                    height:<%= type_d ? '6mm' : '12mm' %>;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    margin-top:2mm;
                  ">
                    <%= image_tag @distributor.qr_code,
                        alt: "QR Code",
                        style: "max-height:100%; width:auto;" %>
                  </div>

                  <!-- Bottom Text -->
                  <div style="
                    font-size:<%= type_d ? '4px' : '6px' %>;
                    font-weight:bold;
                    margin-top:1mm;
                    line-height:1.2;
                  ">
                    10099686
                  </div>

                  <div style="
                    font-size:<%= type_d ? '4px' : '6px' %>;
                    font-weight:bold;
                    margin-top:0mm;
                    line-height:1.2;
                  ">
                    04/2026
                  </div>

                <% end %>

              </div>

              <div style="text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; min-height:<%= type_d ? '18mm' : '28mm' %>;">
                
              <% if @distributor&.qr_code&.attached? %>

                <!-- Top Text -->
                <div style="
                  font-size:<%= type_d ? '4px' : '6px' %>;
                  font-weight:bold;
                  height:<%= type_d ? '4mm' : '6mm' %>;
                  line-height:<%= type_d ? '4mm' : '6mm' %>;
                  margin:0;
                  padding:2mm;
                ">
                  Anieitung / Manual
                </div>

                <!-- QR Code -->
                <div style="
                  height:<%= type_d ? '6mm' : '12mm' %>;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  margin-top:2mm;
                ">
                  <%= image_tag @distributor.qr_code,
                      alt: "QR Code",
                      style: "max-height:100%; width:auto;" %>
                </div>

                <!-- Bottom Text -->
                <div style="
                  font-size:<%= type_d ? '4px' : '6px' %>;
                  font-weight:bold;
                  margin-top:1mm;
                  min-height:<%= type_d ? '4mm' : '6mm' %>;
                  line-height:1.2;
                ">
                </div>

              <% end %>

              </div>
                          
                              
              <div style="text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; min-height:<%= type_d ? '18mm' : '28mm' %>; margin-left: 3mm;">
                
              <% if @distributor&.distribution_logo&.attached? %>

                <!-- Top Text -->
                <div style="
                  font-size:<%= type_d ? '4px' : '6px' %>;
                  font-weight:bold;
                  height:<%= type_d ? '4mm' : '6mm' %>;
                  line-height:<%= type_d ? '4mm' : '6mm' %>;
                  margin:0;
                  padding:2mm;
                  width: auto; 
                ">
                  Vertrieb / Distribution
                </div>

                <!-- Distribution Logo -->
                <div style="
                  height:<%= type_d ? '6mm' : '12mm' %>;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  margin-top:2mm;
                ">
                  <%= image_tag @distributor.distribution_logo,
                      alt: "Distribution Logo",
                      style: "max-height:100%; width:auto;" %>
                </div>

                <!-- Bottom URL -->
                <% if @distributor&.distributor_url.present? %>
                  <div style="
                    font-size:<%= type_d ? '4px' : '6px' %>;
                    font-weight:bold;
                    height:<%= type_d ? '4mm' : '6mm' %>;
                    line-height:<%= type_d ? '4mm' : '6mm' %>;
                    margin:0;
                    padding:0;
                  ">
                    <%= @distributor.distributor_url %>
                  </div>
                <% end %>

              <% end %>

              </div>
            
              </div>
            </div>
            <div class="footer">
Quantity: <%= @form_data[:sticker_quantity] %> pcs
</div>
</div>
</body>
</html>
