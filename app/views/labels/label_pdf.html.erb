<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>LED Product Sticker</title>
  <style>
    @page { 
      size: 315mm 25mm; 
      margin: 0; 
    }
    
    body {
      font-family: Arial, sans-serif;
      font-size: 8px;
      margin: 0;
      padding: 0;
      background: #fff;
    }

    .sticker {
      border: 1px solid #000;
      width: 315mm;
      height: 25mm;
      padding: 2px;
      box-sizing: border-box;
    }

    table {
      width: 100%;
      height: 100%;
      border-collapse: collapse;
    }

    th, td {
      border: 1px solid #000;
      padding: 1px 2px;
      font-size: 7px;
      text-align: center;
      vertical-align: middle;
    }

    th {
      font-weight: bold;
      background: #fff;
    }

    .footer {
      position: absolute;
      bottom: 2px;
      right: 5px;
      font-size: 8px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <div class="sticker">
    <table>
      <tr>
        <th rowspan="2" style="width: 60mm; text-align: left; vertical-align: top; padding: 2px; font-size: 6px;">
          <div><b>Crous LED</b></div>
          <div>Coach LED Tube</div>
          <div>Made in India</div>
        </th>
        <th style="font-size: 6px;">Type</th>
        <th style="font-size: 6px;">Länge<br>Length</th>
        <th style="font-size: 6px;">Leistung<br>Power</th>
        <th style="font-size: 6px;">Spannung<br>Voltage</th>
        <th style="font-size: 6px;">Stromstärke<br>Current</th>
        <th style="font-size: 6px;">Betriebstemperatur<br>Operating Temp</th>
        <th style="font-size: 6px;">Lichtfarbe<br>Light color</th>
        <th style="font-size: 6px;">Artikel Nr.<br>Article No.</th>
        <th rowspan="2" style="width: 40mm; text-align: right; vertical-align: top; padding: 2px; font-size: 6px;">
          <div><b>Crous Chemicals</b></div>
          <div>www.crous-chemicals.com</div>
        </th>
      </tr>
      <tr>
        <td style="font-size: 6px;">CLED T8 Train Tube</td>
        <td style="font-size: 6px;">1200 mm</td>
        <td style="font-size: 6px;">22 W</td>
        <td style="font-size: 6px;">24 VDC</td>
        <td style="font-size: 6px;">0.92 A</td>
        <td style="font-size: 6px;">-40°C to +85°C (OT6)</td>
        <td style="font-size: 6px;">3000 K</td>
        <td style="font-size: 6px;">00C21-2332nf</td>
      </tr>
    </table>

    <div class="footer">
      Quantity: 50 pcs
    </div>
  </div>
</body>
</html>
