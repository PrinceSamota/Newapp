<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>LED Product Sticker</title>
  <style>
    <% type_d = @form_data[:type].to_s.downcase == 'd' %>

    @page { 
      size: A3 landscape; 
      margin:0; 
     }

    body { 
        font-family: Arial, sans-serif; 
        font-size: 5px; 
        margin-top: 0; 
        padding: 0; 
        background: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        } 
    
    .sticker {
      border: 1px solid #000;
      width: <%= type_d ? '180mm' : '280mm' %>;
      height: <%= type_d ? '13mm' : '25mm' %>; 
      padding: 1px; 
      box-sizing: border-box;
      position: relative;
      margin-top: 241mm;
      display: flex;
      flex-direction: row;
      align-items: center;
         }

    table {
      max-width:  <%= type_d ? '130mm' : '315mm' %>;
      height: <%= type_d ? '11mm' : '23mm' %>;
      border-collapse: collapse;
      table-layout: fixed;
    }

    th, td {
      border: 1.5px solid <%= @form_data[:frame_colour].to_s.split.first %>;
      padding: 0;
      font-size: <%= type_d ? '2.5px' : '9px' %>;
      text-align: center;
      vertical-align: middle;
      word-wrap: break-word;
    }

    td {
      height: <%= type_d ? '3mm' : '6mm' %>;
    }
    th {
      height: <%= type_d ? '6mm' : '12mm' %>;
    }

    th {
      font-weight: bold;
      background: #fff;
    }

    /* LEFT LOGO AREA */
    .left-logo {
      width: <%= type_d ? '35mm' : '60mm' %>;
      text-align: center;
      vertical-align: middle;
      border: none;
      position: relative;
    }

    /* RIGHT LOGO AREA */
    .right-logo {
      width: <%= type_d ? '25mm' : '40mm' %>;
      text-align: center;
      vertical-align: middle;
      border: none;
      position: relative;
    }

    /* LOGO & SIGNATURE IMAGE STYLES */
    .logo-container {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .logo-container img {
      margin: 0 2mm;
      max-width: <%= type_d ? '12mm' : '18mm' %>;
      max-height: <%= type_d ? '5mm' : '15mm' %>;
      object-fit: contain;
    }

    /* RIGHT SIDE LOGO BLOCK (EMC + Distribution + QR) */
    .right-logo-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1mm;
    }

    .right-logo-container img {
      max-width: <%= type_d ? '10mm' : '10mm' %>;
      max-height: <%= type_d ? '5mm' : '5mm' %>;
      object-fit: contain;
    }

    .footer {
      position: absolute;
      bottom: -10mm;    
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      font-weight: bold;
      font-size: <%= type_d ? '8px' : '25px' %>;
    }

  </style>
</head>
<body>




<div class="sticker">
            <div class="left-logo" rowspan="2">
              <div class="logo-container" style="display:flex; gap:3mm; justify-content:center; align-items:center;">
            
                <!-- Logo Block 1 -->
                <div style="text-align:center; display:flex; flex-direction:column; align-items:center;">
                  <!-- Top text (add your own) -->
                  <% if @client&.logo&.attached? %>
                  <div style="font-size:<%= type_d ? '4px' : '6px' %>; font-weight:bold; margin-top: 1mm; padding-bottom: 0;">
                  Hersteller / Manufacturers  
                  </div>
            
                  <!-- Logo -->
                  <% if @client&.logo&.attached? %>
                    <%= image_tag @client.logo, alt: "Company Logo"%>
                  <% end %>
            
                  <!-- Bottom text (add your own) -->
                  <div style="font-size:<%= type_d ? '4px' : '6px' %>; padding-top:1mm; font-weight: bold;">
                    <%= @client&.company_url if @client&.company_url.present? %>
                  </div>
                  <% end %>
                </div>
            
            
                <!-- Logo Block 2 -->
                <div style="text-align:center; display:flex; flex-direction:column; align-items:center; margin-right: <%= type_d ? '1mm' : '3mm' %>;">
                  <!-- Top text (add your own) -->
                  <div style=" <%= type_d ? 'font-size:4px;' : 'font-size:6px;' %> font-weight:bold; margin-top:0mm;">
                  Coach LED Tube  
                  </div>
            
                  <!-- Logo -->
          
                  <%= wicked_pdf_image_tag "sticker_data.png",
                      style: "#{ type_d ? 'height: 5mm;' : 'height: 10mm;' } width: auto; #{ type_d ? 'transform: scale(1.0);' : 'transform: scale(1.4);' } transform-origin: center;" %>
 
                  <!-- Bottom text (add your own) -->
                  <div style="font-size:<%= type_d ? '4px' : '6px' %>; margin-top:0mm; font-weight: bold;">
                 Made in India
                  </div>
                  <div style="font-size:<%= type_d ? '4px' : '6px' %>; margin-top:1mm; font-weight: bold;">
                  <% begin %>
                  <% if @form_data[:sticker_date].present? %>
                    <%= Date.parse(@form_data[:sticker_date]).strftime('%m/%Y') %>
                  <% end %>
                <% rescue %>
                <% end %>                
                  </div>
                </div>
            
              </div>
            </div>
              <div>
                <table style="width: 100%; height: 50%; border-collapse: collapse; table-layout: fixed;">
                    <tr>
                    <th>Type <br><%= params[:language] == "en" ? "" : t("pdf.type") %></th>
                    <th>Length <br><%= params[:language] == "en" ? "" : t("pdf.length") %></th>
                    <th>Power <br><%= params[:language] == "en" ? "" : t("pdf.power") %></th>
                    <th>Voltage <br><%= params[:language] == "en" ? "" : t("pdf.voltage") %></th>
                    <th>Current <br><%= params[:language] == "en" ? "" : t("pdf.current") %></th>
                    <th style="width:20%;">Operating temperature <br> <%= params[:language] == "en" ? "" : t("pdf.operating_temperature") %></th>
                    <th>Light color <br><%= params[:language] == "en" ? "" : t("pdf.light_color") %></th>
                    <th>Article No. <br><%= params[:language] == "en" ? "" : t("pdf.article_no") %></th>
                    <th>Serial No. <br><%= params[:language] == "en" ? "" : t("pdf.serial_no") %></th>
                    </tr>
                    <% order = OrderEntry.find_by(id: @form_data[:order_id]) %>
                    <% sku_id = order&.sku_number %>
                    <% item_master = ItemMaster.find_by(sku_id: sku_id) %>
                    <tr>
                    <td style="font-weight: bold;"><%= @form_data[:type] %><br>
                    <%= item_master&.shortcode %>
                    </td>
                    <td style="font-weight: bold;"><%= @form_data[:length] %></td>
                    <td style="font-weight: bold;"><%= @form_data[:wattage] %></td>
                    <td style="font-weight: bold;"><%= @form_data[:voltage] %></td>
                    <td style="font-weight: bold;">
                      <%= begin
                            watt = @form_data[:wattage].to_s.gsub(/[^\d.]/, '').to_f
                            volt = @form_data[:voltage].to_s.gsub(/[^\d.]/, '').to_f
                            volt.zero? ? "-" : "#{(watt / volt).round(2)} A"
                          rescue
                            "-"
                          end %>
                    </td>
                    <td style="font-weight: bold; width: 15%;">-40°C to +85°C (OT6)</td>
                    <td style="font-weight: bold;"><%= @form_data[:cct] %></td>
                    <td><%= @form_data[:custom_article_no].presence || @form_data[:article_no] %></td>
                    <td></td>
                  </tr>
                </table>
              </div>


              <div class="right-logo" rowspan="2" style="margin-left: 3mm;">
              <div class="logo-container" style="display:flex; gap:3mm; justify-content:center; align-items:center;">
            
                <!-- Right Logo Block 1 (QR Code Section) -->
                <div style="text-align:center; display:flex; flex-direction:column; align-items:center;">
                <% if @distributor&.qr_code&.attached? %>
                      <!-- Top Text -->
                      <div style="font-size:<%= type_d ? '4px' : '6px' %>; font-weight:bold; margin-top: <%= type_d ? '1mm' : '1mm' %>; padding-bottom: 0;">
                        Manual
                      </div>
                
                      <!-- QR Code Logo -->
                        <%= image_tag @distributor.qr_code, alt: "QR Code" %>
                
                      <!-- Bottom text -->
                      <div style="font-size:4px; padding-top:1mm;">
                        
                      </div>
                <% end %>
                </div>
            
                <!-- Right Logo Block 2 (Distribution Logo Section) -->
                <div style="text-align:center; display:flex; flex-direction:column; align-items:center; margin-left: 3mm;">
            
                  <!-- Top Text -->
                  <% if @distributor&.distribution_logo&.attached? %>
                    <div style="font-size:<%= type_d ? '4px' : '6px' %>; font-weight:bold; margin-bottom:1mm;">
                      Distribution
                    </div>
              
                    <!-- Distribution Logo -->
                      <%= image_tag @distributor.distribution_logo, alt: "Distribution Logo" %>

                    <!-- Bottom URL -->
                    <div style="font-size:<%= type_d ? '4px' : '6px' %>; margin-top:1mm; font-weight: bold;">
                      <%= @distributor&.distributor_url if @distributor&.distributor_url.present? %>
                    </div>
                  <% end %>
                </div>
            
              </div>
            </div>
            <div class="footer">
Quantity: <%= @form_data[:sticker_quantity] %> pcs
</div>
</div>






























</body>
</html>
