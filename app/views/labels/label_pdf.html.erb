<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<title>LED Product Sticker</title>

<style>
<% is_d = @form_data[:profile].to_s.downcase == 'd' %>
<% s = is_d ? 1 : 1 %>
<% lang_en = params[:language].to_s == "en" %>

<%
# =========================
# FIXED OUTER SIZE (DO NOT TOUCH)
# =========================

sticker_w = 386 * s  # mm
sticker_h = 30  * s # mm

# =========================
# 🔥 GLOBAL SCALE FIX (NEW)
# =========================
base_sticker_h = 38.0
scale_h = sticker_h / base_sticker_h

# =========================
# OUTER LAYOUT (TOTAL = 100)
# =========================
outer_left   = 16
outer_center = 60
outer_right  = 28

# =========================
# LEFT INNER CONTROL
# =========================
left_col_1 = 48
left_col_2 = 52

# =========================
# RIGHT INNER CONTROL
# =========================
right_col_1 = 41.5
right_col_2 = 21.5
right_col_3 = 35

# =========================
# CENTER TABLE CONTROL (TOTAL = 100)
# =========================
c_type    = 16
c_length  = 10
c_power   = 8
c_voltage = 10
c_current = 10
c_temp    = 22
c_color   = 10
c_article = 14

# =========================
# CENTER SPACING
# =========================
center_padding_top    = 1 * scale_h   # mm
center_padding_bottom = 1 * scale_h   # mm

# =========================
# LOGO SPACING CONTROL
# =========================
logo_gap_top = 0.8 * scale_h
logo_gap_bottom = 0.8 * scale_h
logo_scale = 0.85

# =========================
# TYPOGRAPHY
# =========================
font_main  = 14.4 * s * scale_h
font_small = 11 * s * scale_h
logo_h     = 25 * s * scale_h

center_header_h = 11 * s * scale_h
center_row_h    = 17 * s * scale_h

# =========================
# BORDER CONTROL
# =========================
border_w = 0.45 * s * scale_h
inner_border_w = 0.85 * s * scale_h

footer_fs = 18 * s * scale_h
%>

@page {
  size: 600mm 330mm;
  margin: 0;
}

html, body {
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
}

/* MAIN BOX */
.sticker {
  margin-top: 100.3mm;
  width: <%= sticker_w %>mm;
  height: <%= sticker_h %>mm;
  border: <%= border_w %>mm solid #000;
  border-collapse: collapse;
  table-layout: fixed;
}

/* INNER TABLE */
.inner {
  width: 100%;
  height: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

/* =========================
   INNER COLUMN PADDING FIX
   ========================= */
.left-section .inner td,
.right-section .inner td {
  padding-left: <%= 2 * scale_h %>mm;
  padding-right: <%= 2 * scale_h %>mm;
  box-sizing: border-box;
}

/* BLOCK */
.block {
  position: relative;
  height: 100%;
  width: 100%;
  overflow: hidden;
}

.block-top {
  position: absolute;
  top: 0;
  width: 100%;
  text-align: center;
  padding-top: <%= 0.5 * scale_h %>mm;
}

.block-bottom {
  position: absolute;
  bottom: 0;
  width: 100%;
  text-align: center;
  padding-bottom: <%= 0.8 * scale_h %>mm;
}

.block-middle {
  position: absolute;
  top: 28%;
  bottom: 20%;
  left: 0;
  right: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  padding-top: <%= logo_gap_top %>mm;
  padding-bottom: <%= logo_gap_bottom %>mm;

  box-sizing: border-box;
  overflow: hidden;
  text-align: center;
}

.top {
  font-size: <%= font_small %>px;
  font-weight: bold;
}

.bottom {
  font-size: <%= font_small %>px;
  font-weight: bold;
}

/* LOGO */
.logo {
  width: 90%;
  height: 90%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.logo img {
  display: inline-block;
  margin: auto;

  max-height: <%= logo_h %>mm;
  max-width: 100%;

  width: auto;
  height: auto;

  object-fit: contain;
}

.right-section .inner td:nth-child(2) .block-middle {
  bottom: 0;
  padding-bottom: 0;
}

.right-section .inner td:nth-child(2) .logo img {
  aspect-ratio: 1 / 1;
  max-height: <%= logo_h %>mm;
  max-width: <%= logo_h %>mm;
  width: auto;
  height: auto;
  object-fit: contain;
}

/* CENTER */
.center-wrapper {
  padding-top: <%= center_padding_top %>mm;
  padding-bottom: <%= center_padding_bottom %>mm;
  height: 100%;
  box-sizing: border-box;
}

.data {
  width: 100%;
  height: 100%;
  border-collapse: collapse;
  table-layout: auto;
}

.data th,
.data td {
  border: <%= inner_border_w %>mm solid <%= @form_data[:frame_colour].to_s.split.first %>;
  font-size: <%= font_main %>px;
  text-align: center;
  font-weight: bold;
  white-space: nowrap;
}

.data th {
  height: <%= center_header_h %>mm;
}

.data td {
  height: <%= center_row_h %>mm;
}

/* FOOTER */
.footer {
  text-align: center;
  font-size: <%= footer_fs %>px;
  font-weight: bold;
  margin-top: <%= 1.5 * s * scale_h %>mm;
}

/* OUTER COLUMN PADDING */
.left-section {
  padding-left: <%= 1 * scale_h %>mm;
  padding-right: <%= 1 * scale_h %>mm;
}

.right-section {
  padding-left: <%= 1 * scale_h %>mm;
  padding-right: <%= 0 * scale_h %>mm;
}

.right-section .bottom {
  white-space: nowrap;
}

</style>
</head>

<body>

<table class="sticker">

<colgroup>
  <col style="width:<%= outer_left %>%;">
  <col style="width:<%= outer_center %>%;">
  <col style="width:<%= outer_right %>%;">
</colgroup>

<tr>

<!-- LEFT -->
<td class="left-section">
  <table class="inner">
    <colgroup>
      <col style="width:<%= left_col_1 %>%;">
      <col style="width:<%= left_col_2 %>%;">
    </colgroup>
    <tr>

      <td>
        <div class="block">
          <div class="block-top"><div class="top">Hersteller / Manufacturers</div></div>

          <div class="block-middle">
            <div class="logo">
              <%= image_tag @client.logo if @client&.logo&.attached? %>
            </div>
          </div>

          <div class="block-bottom">
            <div class="bottom"><%= @client.company_url %></div>
          </div>
        </div>
      </td>

      <td>
        <div class="block">
          <div class="block-top"><div class="top">Coach LED Tube</div></div>

          <div class="block-middle">
            <div class="">
              <%= wicked_pdf_image_tag "sticker_data.png" %>
            </div>
          </div>

          <div class="block-bottom">
            <div class="bottom">Made in India</div>
          </div>
        </div>
      </td>

    </tr>
  </table>
</td>

<!-- CENTER -->
<td>
  <div class="center-wrapper">
    <table class="data">
      <colgroup>
        <col style="width:<%= c_type %>%;">
        <col style="width:<%= c_length %>%;">
        <col style="width:<%= c_power %>%;">
        <col style="width:<%= c_voltage %>%;">
        <col style="width:<%= c_current %>%;">
        <col style="width:<%= c_temp %>%;">
        <col style="width:<%= c_color %>%;">
        <col style="width:<%= c_article %>%;">
      </colgroup>

      <tr>
        <th>Type <%= lang_en ? "" : "<br>#{t('pdf.type')}".html_safe %></th>
        <th>Length <%= lang_en ? "" : "<br>#{t('pdf.length')}".html_safe %></th>
        <th>Power <%= lang_en ? "" : "<br>#{t('pdf.power')}".html_safe %></th>
        <th>Voltage <%= lang_en ? "" : "<br>#{t('pdf.voltage')}".html_safe %></th>
        <th>Current <%= lang_en ? "" : "<br>#{t('pdf.current')}".html_safe %></th>
        <th>Operating temperature <%= lang_en ? "" : "<br>#{t('pdf.operating_temperature')}".html_safe %></th>
        <th>Light color <%= lang_en ? "" : "<br>#{t('pdf.light_color')}".html_safe %></th>
        <th>Article No. <%= lang_en ? "" : "<br>#{t('pdf.article_no')}".html_safe %></th>
      </tr>

      <tr>
        <td>
          <% if @client&.brand_name.present? %>
          <%= @client.brand_name %>&nbsp;<% end %>
          <%= @form_data[:type] %><br>
          <%= @form_data[:profile] %>/<%= @form_data[:length].to_s.scan(/\d+/).first %>/<%= @form_data[:cct].to_s.scan(/\d+/).first %>/<%= @form_data[:cover] %>
        </td>
        <td><%= @form_data[:length] %></td>
        <td><%= @form_data[:wattage] %></td>
        <td><%= @form_data[:voltage] %></td>
        <td>
          <%= begin
                w = @form_data[:wattage].to_f
                v = @form_data[:voltage].to_f
                v.zero? ? "-" : "#{(w/v).round(2)} A"
              rescue "-"
              end %>
        </td>
        <td>-40°C to +85°C (OT6)</td>
        <td><%= @form_data[:cct] %></td>
        <td><%= @form_data[:article_no] %></td>
      </tr>
    </table>
  </div>
</td>

<!-- RIGHT -->
<td class="right-section">
  <table class="inner">
    <colgroup>
      <col style="width:<%= right_col_1 %>%;">
      <col style="width:<%= right_col_2 %>%;">
      <col style="width:<%= right_col_3 %>%;">
    </colgroup>

    <tr>

      <td><div class="block"><div class="block-top"><div class="top"><%= lang_en ? "Serial No." : "#{t('pdf.serial_no')} / Serial No." %></div></div></div></td>

      <td>
        <div class="block">
          <div class="block-top"><div class="top"><%= lang_en ? "Anleitung / Manual" : "#{t('pdf.manual')} / Manual" %></div></div>
          <div class="block-middle">
            <div class="logo">
              <%= image_tag @distributor.qr_code if @distributor&.qr_code&.attached? %>
            </div>
          </div>
        </div>
      </td>

      <td>
        <div class="block">
          <div class="block-top"><div class="top"><%= lang_en ? "Vertrieb / Distribution" : "#{t('pdf.distribution')} / Distribution " %></div></div>

          <div class="block-middle">
            <div class="logo">
              <%= image_tag @distributor.distribution_logo if @distributor&.distribution_logo&.attached? %>
            </div>
          </div>

          <div class="block-bottom">
            <div class="bottom"><%= @distributor.distributor_url %></div>
          </div>
        </div>
      </td>

    </tr>
  </table>
</td>

</tr>
</table>

<div class="footer">
  Quantity: <%= @form_data[:sticker_quantity] %> pcs
</div>

</body>
</html>
