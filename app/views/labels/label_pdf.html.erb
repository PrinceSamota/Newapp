<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>LED Product Sticker</title>
  <style>
    <% type_d = @form_data[:type].to_s.downcase == 'd' %>

    @page { 
      size: A3 landscape; 
      margin:0; 
     }

    body { 
        font-family: Arial, sans-serif; 
        font-size: 5px; 
        margin-top: 0; 
        padding: 0; 
        background: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        } 
    
    .sticker {
      border: 1px solid #000;
      width: <%= type_d ? '210mm' : '350mm' %>;
      height: <%= type_d ? '17mm' : '32.6mm' %>; 
      padding: 1px; 
      box-sizing: border-box;
      position: relative;
      margin-top: 241mm;
      display: flex;
      flex-direction: row;
      align-items: center;
         }

    table {
      min-width:  <%= type_d ? '110mm' : '180mm' %>;
      max-height: <%= type_d ? '14mm' : '26mm' %>;
      min-height: <%= type_d ? '14mm' : '26mm' %>;
      border-collapse: collapse;
      table-layout: fixed;
      margin-left:1mm;
    }

    th {
      border: 2px solid <%= @form_data[:frame_colour].to_s.split.first %>;
      padding: 1mm;
      font-size: <%= type_d ? '5px' : '9px' %>;
      text-align: center;
      vertical-align: middle;
      word-wrap: break-word;
    }
      
    td {
      border: 2px solid <%= @form_data[:frame_colour].to_s.split.first %>;
      padding: 1mm;
      font-size: <%= type_d ? '5px' : '9px' %>;
      text-align: center;
      vertical-align: middle;
      word-wrap: break-word;
    }

    td {
      height: <%= type_d ? '2mm' : '6mm' %>;
    }
    th {
      height: <%= type_d ? '2mm' : '6mm' %>;
    }

    th {
      font-weight: bold;
      background: #fff;
    }

    /* LEFT LOGO AREA */
    .left-logo {
      width: <%= type_d ? '35mm' : '75mm' %>;
      text-align: center;
      vertical-align: middle;
      border: none;
      position: relative;
      margin-left:2mm;
    }

    /* RIGHT LOGO AREA */
    .right-logo {
      width: <%= type_d ? '55mm' : '95mm' %>;
      text-align: center;
      vertical-align: middle;
      border: none;
      position: relative;
    }



    /* LOGO & SIGNATURE IMAGE STYLES */
    .logo-container {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .logo-container img {
      margin: 0 2mm;
      max-width: <%= type_d ? '12mm' : '18mm' %>;
      max-height: <%= type_d ? '5mm' : '15mm' %>;
      object-fit: contain;
    }

    /* RIGHT SIDE LOGO BLOCK (EMC + Distribution + QR) */
    .right-logo-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1mm;
    }

    .right-logo-container img {
      max-width: <%= type_d ? '10mm' : '10mm' %>;
      max-height: <%= type_d ? '5mm' : '5mm' %>;
      object-fit: contain;
    }

    .footer {
      position: absolute;
      bottom: -15mm;    
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      font-weight: bold;
      font-size: <%= type_d ? '13px' : '25px' %>;
    }

  </style>
</head>
<body>




<div class="sticker">
            <div class="left-logo" rowspan="2">
              <div class="logo-container" style="display:flex; gap:3mm; justify-content:center; align-items:center;">
            
                <!-- Logo Block 1 -->
                <div style="
                text-align:center;
                display:flex;
                flex-direction:column;
                align-items:center;
                justify-content:flex-start;
                min-height:<%= type_d ? '18mm' : '32.6mm' %>;
                min-width:<%= type_d ? '18mm' : '26mm' %>;
                padding: 0 2mm;
              ">
          
               <% if @client&.logo&.attached? %>
          
                  <div style="
                    font-size:<%= type_d ? '5px' : '9px' %>;
                    font-weight: bold;
                    min-height:<%= type_d ? '4mm' : '8mm' %>;
                    line-height:<%= type_d ? '4mm' : '7mm' %>;

                    white-space: nowrap;
                    overflow: visible;
                    width: auto;
                    min-width: max-content;
                  ">
                    Hersteller / Manufacturers
                  </div>
          
                  <!-- Image with proper gap -->
                  <div style="
                    height:<%= type_d ? '6mm' : '12mm' %>;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    margin-top:2mm;
                    margin-bottom:3mm;
                  ">
                    <%= image_tag @client.logo,
                        style: "max-height: #{type_d ? '10mm' : '16mm'}; max-width: #{type_d ? '16mm' : '28mm'}; width: auto; height: auto; object-fit: contain;" %>
                  </div>
          
                  <div style="
                    font-size:<%= type_d ? '5px' : '8px' %>;
                    font-weight:bold;
                    margin-top:<%= type_d ? '0' : '2mm' %>;
                  ">
                    <%= @client.company_url %>
                  </div>
          
                <% end %>
              </div>
                
              <div style="
              text-align:center;
              display:flex;
              flex-direction:column;
              align-items:center;
              justify-content:flex-start;
              min-height:<%= type_d ? '18mm' : '32.6mm' %>;
              min-width:<%= type_d ? '18mm' : '24mm' %>;
              padding: 0 2mm;
            ">
        
             <% if @client&.logo&.attached? %>
        
                <div style="
                  font-size:<%= type_d ? '5px' : '9px' %>;
                  font-weight: bold;
                  min-height:<%= type_d ? '4mm' : '8mm' %>;
                  line-height:<%= type_d ? '4mm' : '7mm' %>;

                  white-space: nowrap;
                  overflow: visible;
                  width: auto;
                  min-width: max-content;
                ">
                  Coach LED Tube
                </div>
        
                <!-- Image with proper gap -->
                <div style="
                  height:<%= type_d ? '6mm' : '12mm' %>;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  margin-top:2mm;
                  margin-bottom:3mm;
                ">
                <%= wicked_pdf_image_tag "sticker_data.png",
                      style: "max-height: #{type_d ? '10mm' : '18mm'}; max-width: #{type_d ? '16mm' : '32mm'}; width: auto; height: auto; object-fit: contain;" %>
                </div>
        
                <div style="
                  font-size:<%= type_d ? '5px' : '8px' %>;
                  font-weight:bold;
                  margin-top:<%= type_d ? '0' : '2mm' %>;
                ">
                Made in India
                </div>
        
              <% end %>
            </div>
                
              </div>
            </div>
              <div>
                <table style="border-collapse: collapse; table-layout: auto;">
                    <tr>
                    <th style="white-space: nowrap; max-width: 10%;">Type <br><%= params[:language] == "en" ? "" : t("pdf.type") %></th>
                    <th>Length <br><%= params[:language] == "en" ? "" : t("pdf.length") %></th>
                    <th>Power <br><%= params[:language] == "en" ? "" : t("pdf.power") %></th>
                    <th>Voltage <br><%= params[:language] == "en" ? "" : t("pdf.voltage") %></th>
                    <th>Current <br><%= params[:language] == "en" ? "" : t("pdf.current") %></th>
                    <th style="width:20%;">Operating temperature <br> <%= params[:language] == "en" ? "" : t("pdf.operating_temperature") %></th>
                    <th>Light color <br><%= params[:language] == "en" ? "" : t("pdf.light_color") %></th>
                    <th>Article No. <br><%= params[:language] == "en" ? "" : t("pdf.article_no") %></th>
                    </tr>
                    <% order = OrderEntry.find_by(id: @form_data[:order_id]) %>
                    <% sku_id = order&.sku_number %>
                    <% item_master = ItemMaster.find_by(sku_id: sku_id) %>
                    <tr>
                    <td style="font-weight: bold; white-space: nowrap;"><% if @client&.brand_name.present? %><%= @client&.brand_name %><% end %> <%= @form_data[:type] %><br>
                    <%= @form_data[:profile] %>/<%= @form_data[:length].to_s.scan(/\d+/).first %>/<%= @form_data[:cct].to_s.scan(/\d+/).first %>/<%= @form_data[:cover] %>
                    </td>
                    <td style="font-weight: bold;"><%= @form_data[:length] %></td>
                    <td style="font-weight: bold;"><%= @form_data[:wattage] %></td>
                    <td style="font-weight: bold;"><%= @form_data[:voltage] %></td>
                    <td style="font-weight: bold;">
                      <%= begin
                            watt = @form_data[:wattage].to_s.gsub(/[^\d.]/, '').to_f
                            volt = @form_data[:voltage].to_s.gsub(/[^\d.]/, '').to_f
                            volt.zero? ? "-" : "#{(watt / volt).round(2)} A"
                          rescue
                            "-"
                          end %>
                    </td>
                    <td style="font-weight: bold; width: 15%;">-40°C to +85°C (OT6)</td>
                    <td style="font-weight: bold;"><%= @form_data[:cct] %></td>
                    <td style="font-weight: bold;"><%= @form_data[:custom_article_no].presence || @form_data[:article_no] %></td>
                  </tr>
                </table>
              </div>


              <div class="right-logo" rowspan="3" style="margin-left: <%= type_d ? '1mm' : '0mm' %>;">
  <div class="logo-container" style="display:flex; gap:%= type_d ? '1mm' : '3mm' %>; justify-content:center; align-items:center; ">

    <!-- Logo Block 1 -->
    <div style="
      text-align:center;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:flex-start;
      min-height:<%= type_d ? '18mm' : '32.6mm' %>;
      min-width:<%= type_d ? '18mm' : '30mm' %>;
      padding: 0 2mm;
    ">

      <% if @distributor&.qr_code&.attached? %>

        <div style="
                    font-size:<%= type_d ? '5px' : '8px' %>;
                    font-weight: bold;
                    min-height:<%= type_d ? '4mm' : '8mm' %>;
                    line-height:<%= type_d ? '4mm' : '7mm' %>;

                    white-space: nowrap;
                    overflow: visible;
                    width: auto;
                    min-width: max-content;
                  ">
          <%= params[:language] == "en" ? "" : t("pdf.serial_no") %> / Serial No.
        </div>

        <!-- Image with proper gap -->
        <div style="
          height:<%= type_d ? '6mm' : '12mm' %>;
          display:flex;
          align-items:center;
          justify-content:center;
          margin-top:2mm;
          margin-bottom:3mm;
        ">
          <%#= image_tag @distributor.qr_code,
              style: "max-height: 18mm; max-width: 35mm; width: auto; height: auto; object-fit: contain;" %>
        </div>

        <div style="
          font-size:<%= type_d ? '4px' : '8px' %>;
          font-weight:bold;
          margin-top:1mm;
        ">
          
        </div>

        <div style="
          font-size:<%= type_d ? '4px' : '6px' %>;
          font-weight:bold;
          margin-top:1mm;
        ">
          
        </div>

      <% end %>
    </div>

    <!-- Logo Block 2 -->
    <div style="
      text-align:center;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:flex-start;
      min-height:<%= type_d ? '18mm' : '32.6mm' %>;
      min-width:<%= type_d ? '17mm' : '25mm' %>;
      padding: 0 2mm;
      margin-left:<%= type_d ? '0' : '3mm' %>;
    ">

      <% if @distributor&.qr_code&.attached? %>

        <div style="
          font-size:<%= type_d ? '5px' : '8px' %>;
          font-weight:bold;
          height:<%= type_d ? '4mm' : '8mm' %>;
          line-height:<%= type_d ? '4mm' : '7mm' %>;
        ">
          Anieitung / Manual
        </div>

        <!-- Image with proper gap -->
        <div style="
          height:<%= type_d ? '6mm' : '12mm' %>;
          display:flex;
          align-items:center;
          justify-content:center;
          margin-top:2mm;
          margin-bottom:3mm;
        ">
          <%= image_tag @distributor.qr_code,
              style: "max-height:#{type_d ? '10mm' : '18mm'}; max-width: #{type_d ? '16mm' : '35mm'} width: auto; height: auto; object-fit: contain;" %>
        </div>

      <% end %>
    </div>

    <!-- Logo Block 3 -->
    <div style="
      text-align:center;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:flex-start;
      min-height:<%= type_d ? '18mm' : '32.6mm' %>;
      min-width:<%= type_d ? '17mm' : '26mm' %>;
      padding: 0 2mm;
    ">

      <% if @distributor&.distribution_logo&.attached? %>

         <div style="
                    font-size:<%= type_d ? '5px' : '8px' %>;
                    font-weight: bold;
                    min-height:<%= type_d ? '4mm' : '8mm' %>;
                    line-height:<%= type_d ? '4mm' : '7mm' %>;

                    white-space: nowrap;
                    overflow: visible;
                    width: auto;
                    min-width: max-content;
                  ">
          Vertrieb / Distribution
        </div>

        <!-- Image with proper gap -->
        <div style="
          height:<%= type_d ? '6mm' : '12mm' %>;
          display:flex;
          align-items:center;
          justify-content:center;
          margin-top:2mm;
          margin-bottom:3mm;
        ">
          <%= image_tag @distributor.distribution_logo,
              style: "max-height: #{type_d ? '10mm' : '18mm'}; max-width: #{type_d ? '16mm' : '35mm'}; width: auto; height: auto; object-fit: contain;" %>
        </div>

        <div style="
          font-size:<%= type_d ? '5px' : '8px' %>;
          font-weight:bold;
          margin-top:<%= type_d ? '0' : '2mm' %>;
        ">
          <%= @distributor.distributor_url %>
        </div>

      <% end %>
    </div>

  </div>

            </div>
            <div class="footer">
Quantity: <%= @form_data[:sticker_quantity] %> pcs
</div>
</div>
</body>
</html>
