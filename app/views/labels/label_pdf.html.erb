<!doctype html>
<html>
<head>
  <meta charset="utf-8" />
  <title>LED Product Sticker</title>
  <style>
    @page { 
      size: 315mm 25mm; 
      margin: 0; 
    }

    body {
      font-family: Arial, sans-serif;
      font-size: 8px;
      margin: 0;
      padding: 0;
      background: #fff;
    }

    .sticker {
      border: 1px solid #000;
      width: 315mm;
      height: 25mm;
      padding: 2px;
      box-sizing: border-box;
      position: relative;
    }

    table {
      width: 100%;
      height: 100%;
      border-collapse: collapse;
      table-layout: fixed;
    }

    th, td {
      border: 1px solid #000;
      padding: 1px 2px;
      font-size: 7px;
      text-align: center;
      vertical-align: middle;
      word-wrap: break-word;
    }

    th {
      font-weight: bold;
      background: #fff;
    }

    .left-logo {
      width: 60mm;
      text-align: center;
      vertical-align: middle;
      border: none;
      font-size: 7px;
      position: relative;
    }

    .left-logo::before {
      content: "LOGO AREA";
      position: absolute;
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 8px;
      color: #aaa;
    }

    .right-logo {
      width: 40mm;
      text-align: center;
      vertical-align: middle;
      border: none;
      font-size: 7px;
      position: relative;
    }

    .right-logo::before {
      content: "LOGO / QR AREA";
      position: absolute;
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 8px;
      color: #aaa;
    }

    .footer {
      text-align: center;
      font-weight: bold;
      font-size: 12px;
      margin-top: 4px;
    }
  </style>
</head>
<body>
  <div class="sticker">
    <table>
      <tr>
        <th class="left-logo" rowspan="2"></th>
        <th>Type</th>
        <th>Länge<br>Length</th>
        <th>Leistung<br>Power</th>
        <th>Spannung<br>Voltage</th>
        <th>Stromstärke<br>Current</th>
        <th>Betriebstemperatur<br>Operating temperature</th>
        <th>Lichtfarbe<br>Light color</th>
        <th>Artikel Nr.<br>Article No.</th>
        <th>Serien Nr.<br>Serial No.</th>
        <th class="right-logo" rowspan="2"></th>
      </tr>
      <tr>
        <td><%= @form_data[:type] %></td>
        <td><%= @form_data[:length] %></td>
        <td><%= @form_data[:wattage] %></td>
        <td><%= @form_data[:voltage] %></td>
        <td>0.92 A</td>
        <td>-40°C to +85°C (OT6)</td>
        <td>3000 K</td>
        <td>00021-2332nf</td>
        <td></td>
      </tr>
    </table>
  </div>

  <div class="footer">
    Quantity: 50 pcs
  </div>
</body>
</html>
