<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<title>LED Product Sticker</title>

<style>
<% is_d = @form_data[:type].to_s.downcase == 'd' %>
<% s = is_d ? 0.66 : 1 %>
<% lang_en = params[:language].to_s == "en" %>

<%
# =========================
# FIXED OUTER SIZE (DO NOT TOUCH)
# =========================
sticker_w = 490   # mm
sticker_h = 28.6  # mm

# =========================
# OUTER LAYOUT (TOTAL = 100)
# =========================
outer_left   = 20
outer_center = 61
outer_right  = 24

# =========================
# LEFT INNER CONTROL
# =========================
left_col_1 = 50
left_col_2 = 50

# =========================
# RIGHT INNER CONTROL
# =========================
right_col_1 = 30
right_col_2 = 30
right_col_3 = 40

# =========================
# CENTER TABLE CONTROL (TOTAL = 100)
# =========================
c_type    = 18
c_length  = 10
c_power   = 10
c_voltage = 10
c_current = 10
c_temp    = 18
c_color   = 10
c_article = 14

# =========================
# CENTER SPACING
# =========================
center_padding_top    = 3   # mm
center_padding_bottom = 3   # mm

# =========================
# LOGO SPACING CONTROL (UPDATED)
# QR logo: 35.3mm × ~14.9mm
# Distribution logo: 47.0mm × ~14.9mm
# =========================
logo_gap_top = 0.8
logo_gap_bottom = 0.8
logo_scale = 0.85

# =========================
# TYPOGRAPHY
# =========================
font_main  = 15.4 * s
font_small = 13 * s
logo_h     = 18 * s

center_header_h = 11 * s
center_row_h    = 17 * s

border_w = 0.45 * s
footer_fs = 18 * s
%>

@page {
  size: A3 landscape;
  margin: 0;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
}

/* MAIN BOX */
.sticker {
  margin-top: 100.3mm;
  width: <%= sticker_w %>mm;
  height: <%= sticker_h %>mm;
  border: <%= border_w %>mm solid #000;
  border-collapse: collapse;
  table-layout: fixed;
}

/* INNER TABLE */
.inner {
  width: 100%;
  height: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.inner td {
  border: none !important;
  height: 100%;
}

/* BLOCK POSITIONING (FINAL FIX - NO OVERLAP) */
.block {
  position: relative;
  height: 100%;
  width: 100%;
}

/* TOP TEXT */
.block-top {
  position: absolute;
  top: 0;
  width: 100%;
  text-align: center;
  padding-top: 0.5mm;
}

/* BOTTOM TEXT */
.block-bottom {
  position: absolute;
  bottom: 0;
  width: 100%;
  text-align: center;
  padding-bottom: 0.8mm;
}

/* MIDDLE SAFE ZONE */
.block-middle {
  position: absolute;
  top: 28%;   /* ⬆ increased top spacing for ALL logos */
  bottom: 20%;
  left: 0;
  right: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  padding-top: <%= logo_gap_top %>mm;
  padding-bottom: <%= logo_gap_bottom %>mm;
  box-sizing: border-box;

  text-align: center;
}

/* TEXT */
.top {
  font-size: <%= font_small %>px;
  font-weight: bold;
}

.bottom {
  font-size: <%= font_small %>px;
  font-weight: bold;
}

/* LOGO (GLOBAL SAFE CENTERING) */
.logo {
  width: 100%;
  height: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.logo img {
  display: inline-block;
  margin: auto;

  max-height: <%= logo_h * logo_scale %>mm;
  max-width: 85%;
}

/* CENTER WRAPPER */
.center-wrapper {
  padding-top: <%= center_padding_top %>mm;
  padding-bottom: <%= center_padding_bottom %>mm;
  height: 100%;
  box-sizing: border-box;
}

/* CENTER TABLE */
.data {
  width: 100%;
  height: 100%;
  border-collapse: collapse;
  table-layout: auto;
}

/* FIX: prevent height increase */
.data th,
.data td {
  border: <%= border_w * 2.4 %>mm solid <%= @form_data[:frame_colour].to_s.split.first %>;
  font-size: <%= font_main %>px;
  text-align: center;
  font-weight: bold;

  white-space: nowrap;
}

/* HEADER */
.data th {
  height: <%= center_header_h %>mm;
}

/* ROW */
.data td {
  height: <%= center_row_h %>mm;
}

/* FOOTER */
.footer {
  text-align: center;
  font-size: <%= footer_fs %>px;
  font-weight: bold;
  margin-top: <%= 1.5 * s %>mm;
}

/* =========================
   RIGHT SIDE LOGO ENHANCEMENT (NEW)
   ========================= */

/* reduce internal padding space */
td:nth-child(3) .block-middle {
  top: 10% !important;
  bottom: 10% !important;
}

/* enlarge logo container usage */
td:nth-child(3) .logo {
  width: 100%;
  height: 100%;
}

/* increase actual logo size */
td:nth-child(3) .logo img {
  max-width: 95%;
  max-height: 95%;
}

</style>
</head>

<body>

<table class="sticker">

  <!-- OUTER WIDTH CONTROL -->
  <colgroup>
    <col style="width:<%= outer_left %>%;">
    <col style="width:<%= outer_center %>%;">
    <col style="width:<%= outer_right %>%;">
  </colgroup>

<tr>

<!-- LEFT -->
<td>
  <table class="inner">
    <colgroup>
      <col style="width:<%= left_col_1 %>%;">
      <col style="width:<%= left_col_2 %>%;">
    </colgroup>
    <tr>

      <!-- Manufacturer -->
      <td>
        <div class="block">
          <div class="block-top">
            <div class="top">Hersteller / Manufacturers</div>
          </div>

          <div class="block-middle">
            <div class="logo">
              <%= image_tag @client.logo if @client&.logo&.attached? %>
            </div>
          </div>

          <div class="block-bottom">
            <div class="bottom"><%= @client.company_url %></div>
          </div>
        </div>
      </td>

      <!-- Product -->
      <td>
        <div class="block">
          <div class="block-top">
            <div class="top">Coach LED Tube</div>
          </div>

          <div class="block-middle">
            <div class="logo">
              <%= wicked_pdf_image_tag "sticker_data.png" %>
            </div>
          </div>

          <div class="block-bottom">
            <div class="bottom">Made in India</div>
          </div>
        </div>
      </td>

    </tr>
  </table>
</td>

<!-- CENTER -->
<td>
  <div class="center-wrapper">
    <table class="data">

      <colgroup>
        <col style="width:<%= c_type %>%;">
        <col style="width:<%= c_length %>%;">
        <col style="width:<%= c_power %>%;">
        <col style="width:<%= c_voltage %>%;">
        <col style="width:<%= c_current %>%;">
        <col style="width:<%= c_temp %>%;">
        <col style="width:<%= c_color %>%;">
        <col style="width:<%= c_article %>%;">
      </colgroup>

      <tr>
        <th>Type <%= lang_en ? "" : "<br>#{t('pdf.type')}".html_safe %></th>
        <th>Length <%= lang_en ? "" : "<br>#{t('pdf.length')}".html_safe %></th>
        <th>Power <%= lang_en ? "" : "<br>#{t('pdf.power')}".html_safe %></th>
        <th>Voltage <%= lang_en ? "" : "<br>#{t('pdf.voltage')}".html_safe %></th>
        <th>Current <%= lang_en ? "" : "<br>#{t('pdf.current')}".html_safe %></th>
        <th>Operating temperature <%= lang_en ? "" : "<br>#{t('pdf.operating_temperature')}".html_safe %></th>
        <th>Light color <%= lang_en ? "" : "<br>#{t('pdf.light_color')}".html_safe %></th>
        <th>Article No. <%= lang_en ? "" : "<br>#{t('pdf.article_no')}".html_safe %></th>
      </tr>

      <tr>
        <td>
          <% if @client&.brand_name.present? %><%= @client.brand_name %><% end %><%= @form_data[:type] %><br>
          <%= @form_data[:profile] %>/<%= @form_data[:length].to_s.scan(/\d+/).first %>/<%= @form_data[:cct].to_s.scan(/\d+/).first %>/<%= @form_data[:cover] %>
        </td>
        <td><%= @form_data[:length] %></td>
        <td><%= @form_data[:wattage] %></td>
        <td><%= @form_data[:voltage] %></td>
        <td>
          <%= begin
                w = @form_data[:wattage].to_f
                v = @form_data[:voltage].to_f
                v.zero? ? "-" : "#{(w/v).round(2)} A"
              rescue "-"
              end %>
        </td>
        <td>-40°C to +85°C</td>
        <td><%= @form_data[:cct] %></td>
        <td><%= @form_data[:article_no] %></td>
      </tr>

    </table>
  </div>
</td>

<!-- RIGHT -->
<td>
  <table class="inner">
    <colgroup>
      <col style="width:<%= right_col_1 %>%;">
      <col style="width:<%= right_col_2 %>%;">
      <col style="width:<%= right_col_3 %>%;">
    </colgroup>

    <tr>

      <!-- Serial -->
      <td>
        <div class="block">
          <div class="block-top">
            <div class="top"><%= lang_en ? "Serial No." : "#{t('pdf.serial_no')} / Serial No." %></div>
          </div>
        </div>
      </td>

      <!-- Manual -->
      <td>
        <div class="block">
          <div class="block-top"><div class="top">Manual</div></div>

          <div class="block-middle">
            <div class="logo">
              <%= image_tag @distributor.qr_code if @distributor&.qr_code&.attached? %>
            </div>
          </div>
        </div>
      </td>

      <!-- Distribution -->
      <td>
        <div class="block">
          <div class="block-top">
            <div class="top">Distribution</div>
          </div>

          <div class="block-middle">
            <div class="logo">
              <%= image_tag @distributor.distribution_logo if @distributor&.distribution_logo&.attached? %>
            </div>
          </div>

          <div class="block-bottom">
            <div class="bottom"><%= @distributor.distributor_url %></div>
          </div>
        </div>
      </td>

    </tr>
  </table>
</td>

</tr>
</table>

<div class="footer">
  Quantity: <%= @form_data[:sticker_quantity] %> pcs
</div>

</body>
</html>