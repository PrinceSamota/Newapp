<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<title>LED Product Sticker</title>

<style>
<% is_d = @form_data[:type].to_s.downcase == 'd' %>
<% s = is_d ? 0.66 : 1 %>
<% lang_en = params[:language].to_s == "en" %>

<%
# =========================
# MASTER CONTROLS
# =========================

sticker_w = 400 * s
sticker_h = 32.6 * s

left_w    = 60 * s
right_w   = 75 * s

font_main  = 15.4 * s
font_small = 10 * s

logo_h = 18 * s

# CENTER TABLE (FINAL POLISH)
center_header_h = 11 * s
center_row_h    = 17 * s

# COLUMN WIDTHS
col_type    = 22
col_len     = 10
col_power   = 10
col_volt    = 10
col_curr    = 10
col_temp    = 25
col_color   = 10
col_article = 14

cell_pad = 0.3 * s
border_w = 0.45 * s

footer_fs = 18 * s
%>

@page {
  size: A3 landscape;
  margin: 0;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
}

/* MAIN */
.sticker {
  margin-top: 100.3mm;
  width: <%= sticker_w %>mm;
  height: <%= sticker_h %>mm;
  border: <%= border_w %>mm solid #000;
  border-collapse: collapse;
  table-layout: fixed;
}

td {
  padding: 0;
  vertical-align: middle;
}

/* WIDTHS */
.left   { width: <%= left_w %>mm; }
.right  { width: <%= right_w %>mm; }

/* INNER TABLE */
.inner {
  width: 100%;
  height: 100%;
  table-layout: fixed;
  border-collapse: collapse;
}

.inner td {
  vertical-align: middle;
  text-align: center;
  border: none !important;
}

/* TRUE CENTERING */
.center-box {
  display: table;
  width: 100%;
  height: 100%;
}

.center-box-inner {
  display: table-cell;
  vertical-align: middle;
  text-align: center;
}

/* TEXT */
.top {
  font-size: <%= font_small %>px;
  font-weight: bold;
  margin-bottom: 0.3mm;
}

.bottom {
  font-size: <%= font_small %>px;
  font-weight: bold;
  margin-top: 0.3mm;
}

/* LOGO */
.logo {
  height: <%= logo_h %>mm;
}

.logo img {
  max-height: 95%;
  max-width: 92%;
  display: block;
  margin: 0 auto;
  border: none !important;
  outline: none !important;
}

/* CENTER TABLE */
.data {
  padding: 30px;
  width: 100%;
  height: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}

.data th {
  border: <%= border_w * 2.4 %>mm solid <%= @form_data[:frame_colour].to_s.split.first %>;
  font-size: <%= font_main %>px;
  height: <%= center_header_h %>mm;
  padding: <%= cell_pad * 0.5 %>mm;
  text-align: center;
  font-weight: bold;
  line-height: 1.0;
}

.data td {
  border: <%= border_w * 2.4 %>mm solid <%= @form_data[:frame_colour].to_s.split.first %>;
  font-size: <%= font_main %>px;
  height: <%= center_row_h %>mm;
  padding: <%= cell_pad * 0.5 %>mm;
  text-align: center;
  vertical-align: middle;
  font-weight: bold;
  line-height: 1.1;
}

/* FOOTER */
.footer {
  text-align: center;
  font-size: <%= footer_fs %>px;
  font-weight: bold;
  margin-top: <%= 1.5 * s %>mm;
}

</style>
</head>

<body>

<table class="sticker">
<tr>

<!-- LEFT -->
<td class="left">
  <table class="inner">
    <tr>

      <td>
        <div class="center-box"><div class="center-box-inner">
          <div class="top">Hersteller / Manufacturers</div>
          <div class="logo">
            <%= image_tag @client.logo if @client&.logo&.attached? %>
          </div>
          <div class="bottom"><%= @client.company_url %></div>
        </div></div>
      </td>

      <td>
        <div class="center-box"><div class="center-box-inner">
          <div class="top">Coach LED Tube</div>
          <div class="logo">
            <%= wicked_pdf_image_tag "sticker_data.png" %>
          </div>
          <div class="bottom">Made in India</div>
          <div class="bottom">
            <% if @form_data[:sticker_date].present? %>
              <%= Date.parse(@form_data[:sticker_date]).strftime('%m/%Y') rescue "" %>
            <% end %>
          </div>
        </div></div>
      </td>

    </tr>
  </table>
</td>

<!-- CENTER -->
<td>

<table class="data">
<tr>
  <th style="width:<%= col_type %>%;">Type</th>
  <th style="width:<%= col_len %>%;">Length</th>
  <th style="width:<%= col_power %>%;">Power</th>
  <th style="width:<%= col_volt %>%;">Voltage <%= lang_en ? "" : "<br>#{t('pdf.voltage')}".html_safe %></th>
  <th style="width:<%= col_curr %>%;">Current</th>
  <th style="width:<%= col_temp %>%;">Operating temperature <%= lang_en ? "" : "<br>#{t('pdf.operating_temperature')}".html_safe%></th>
  <th style="width:<%= col_color %>%;">Light color</th>
  <th style="width:<%= col_article %>%;">Article No.</th>
</tr>

<tr>
  <td style="line-height:1.15;">
    <div><%= @client&.brand_name %><%= @form_data[:type] %></div>
    <div style="margin-top:1mm;">
      <%= @form_data[:profile] %> /
      <%= @form_data[:length].to_s.scan(/\d+/).first %> /
      <%= @form_data[:cct].to_s.scan(/\d+/).first %> /
      <%= @form_data[:cover] %>
    </div>
  </td>

  <td><%= @form_data[:length] %></td>
  <td><%= @form_data[:wattage] %></td>
  <td><%= @form_data[:voltage] %></td>

  <td>
    <%= begin
          watt = @form_data[:wattage].to_f
          volt = @form_data[:voltage].to_f
          volt.zero? ? "-" : "#{(watt / volt).round(2)} A"
        rescue "-"
        end %>
  </td>

  <td>-40°C to +85°C (OT6)</td>
  <td><%= @form_data[:cct] %></td>
  <td><%= @form_data[:custom_article_no].presence || @form_data[:article_no] %></td>
</tr>
</table>

</td>

<!-- RIGHT -->
<td class="right">
  <table class="inner">
    <colgroup>
      <col style="width:32%">
      <col style="width:30%">
      <col style="width:38%">
    </colgroup>
    <tr>

      <td>
        <div class="center-box"><div class="center-box-inner">
          <div class="top"><%= lang_en ? "Serial No." : "<br>#{t('pdf.serial_number')}".html_safe %></div>
          <div class="logo">
            <%= image_tag @distributor.qr_code if @distributor&.qr_code&.attached? %>
          </div>
          <%# <div class="bottom">10099686</div>
          <div class="bottom">04/2026</div> %>
        </div></div>
      </td>

      <td>
        <div class="center-box"><div class="center-box-inner">
          <div class="top">Anleitung / Manual</div>
          <div class="logo">
            <%= image_tag @distributor.qr_code if @distributor&.qr_code&.attached? %>
          </div>
        </div></div>
      </td>

      <td>
        <div class="center-box"><div class="center-box-inner">
          <div class="top">Vertrieb / Distribution</div>
          <div class="logo">
            <%= image_tag @distributor.distribution_logo if @distributor&.distribution_logo&.attached? %>
          </div>
          <div class="bottom"><%= @distributor.distributor_url %></div>
        </div></div>
      </td>

    </tr>
  </table>
</td>

</tr>
</table>

<div class="footer">
  Quantity: <%= @form_data[:sticker_quantity] %> pcs
</div>

</body>
</html>