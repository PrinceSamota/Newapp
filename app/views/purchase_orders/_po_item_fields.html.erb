<div class="po-item-row relative grid grid-cols-1 md:grid-cols-4 gap-6 bg-gray-50 p-4 border border-gray-200 rounded-lg">
  <% if local_assigns[:item] %>
    <input type="hidden" name="purchase_order[purchase_order_items_attributes][<%= index %>][id]" value="<%= item.id %>" />
  <% end %>
  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">SKU ID</label>
    <select name="purchase_order[purchase_order_items_attributes][<%= index %>][sku_id]" class="po-sku-select required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm <%= 'bg-gray-200 cursor-not-allowed' if @purchase_order&.closed? %>" <%= 'disabled' if @purchase_order&.closed? %>>
      <option value="">Select SKU</option>
      <% @item_masters.each do |im| %>
        <option value="<%= im.sku_id %>" <%= 'selected' if local_assigns[:item] && item.sku_id == im.sku_id %>><%= im.sku_id %></option>
      <% end %>
    </select>
  </div>

  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">Item Name</label>
    <select name="purchase_order[purchase_order_items_attributes][<%= index %>][item_name]" required="required" class="po-item-name required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm <%= 'bg-gray-200 cursor-not-allowed' if @purchase_order&.closed? %>" <%= 'disabled' if @purchase_order&.closed? %>>
      <option value="">Select Item Name</option>
      <% @item_masters.each do |im| %>
        <option value="<%= im.item_name %>" <%= 'selected' if local_assigns[:item] && item.item_name == im.item_name %>><%= im.item_name %></option>
      <% end %>
    </select>
  </div>

  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">Quantity</label>
    <input type="number" name="purchase_order[purchase_order_items_attributes][<%= index %>][quantity]" value="<%= item.quantity if local_assigns[:item] %>" required="required" min="1" class="required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm <%= 'bg-gray-200 cursor-not-allowed' if @purchase_order&.closed? %>" <%= 'readonly' if @purchase_order&.closed? %> />
  </div>

  <div>
    <label class="block text-sm font-semibold text-gray-700 mb-1">Purchase Price</label>
    <input type="number" step="0.00001" name="purchase_order[purchase_order_items_attributes][<%= index %>][purchase_price]" value="<%= item.purchase_price if local_assigns[:item] %>" required="required" class="po-item-price required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm <%= 'bg-gray-200 cursor-not-allowed' if @purchase_order&.closed? %>" <%= 'readonly' if @purchase_order&.closed? %> />
  </div>

  <input type="hidden" name="purchase_order[purchase_order_items_attributes][<%= index %>][_destroy]" value="0" class="po-item-destroy" />

  <% unless @purchase_order&.closed? %>
    <% if index.to_s != '0' || local_assigns[:item] %>
      <button type="button" class="remove-po-item absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer" title="Remove">✕</button>
    <% end %>
  <% end %>
</div>
