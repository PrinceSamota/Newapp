<div class="w-full mx-auto p-6 space-y-8">
  <%= link_to purchase_orders_path, class: "inline-flex items-center gap-2 text-gray-700 bg-white hover:bg-gray-100 font-bold px-4 py-2 rounded-lg border border-gray-300 shadow-sm transition text-sm" do %>
    <i class="fa-solid fa-arrow-left"></i>
    <span>Back</span>
  <% end %>

  <div>
    <h2 class="text-xl font-bold text-gray-800 mb-6 px-1 uppercase tracking-wider">Edit Purchase Order Document</h2>
    <%= render "form" %>
  </div>

  <!-- Item Details & Inward Receipts -->
  <div class="space-y-6">
    <h2 class="text-xl font-bold text-gray-800 px-1 uppercase tracking-wider">Inward Receipts (RMI)</h2>
    
    <div class="bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50 text-gray-500 uppercase font-semibold text-xs text-left">
          <tr>
            <th class="px-6 py-4">Item (SKU)</th>
            <th class="px-6 py-4 text-center">Ordered</th>
            <th class="px-6 py-4 text-center">Delivered</th>
            <th class="px-6 py-4 text-center">Remaining</th>
            <th class="px-6 py-4 text-center">Status</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @po_items.each do |po_item| %>
            <!-- Main Item Row -->
            <tr class="hover:bg-gray-50 transition-colors group">
              <td class="px-6 py-4">
                <div class="font-bold text-gray-800 text-base"><%= po_item.sku_id %></div>
                <div class="text-xs text-gray-500 mt-1"><%= po_item.item_name %></div>
              </td>
              <td class="px-6 py-4 text-center font-semibold text-gray-700"><%= po_item.quantity %></td>
              <td class="px-6 py-4 text-center font-bold text-green-600"><%= po_item.calculated_delivered_quantity %></td>
              <td class="px-6 py-4 text-center font-bold text-red-600"><%= po_item.remaining_quantity %></td>
              <td class="px-6 py-4 text-center">
                <span class="px-3 py-1 text-xs font-bold rounded-full <%= po_item.remaining_quantity > 0 ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= po_item.remaining_quantity > 0 ? 'Open' : 'Completed' %>
                </span>
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex flex-col items-end gap-2">
                  <!-- RMI Conversion Form Removed -->
                  <% if po_item.remaining_quantity == 0 %>
                     <span class="text-xs font-bold text-gray-500 flex items-center gap-1 bg-gray-100 px-3 py-1.5 rounded-md"><i class="fa-solid fa-check-circle text-green-500"></i> Fully Received</span>
                  <% end %>

                  <!-- Collapse Toggle for History -->
                  <button type="button" onclick="document.getElementById('history-<%= po_item.id %>').classList.toggle('hidden')" class="text-blue-600 hover:text-blue-800 text-xs font-semibold flex items-center gap-1 transition-colors mt-1 opacity-80 hover:opacity-100">
                    <i class="fa-solid fa-clock-rotate-left"></i> View Receipt History
                  </button>
                </div>
              </td>
            </tr>

            <!-- Collapsible History Row -->
            <% rmi_items = RawMaterialStockItem.joins(:raw_material_stock_batch).where(raw_material_stock_batches: { purchase_order_id: po_item.purchase_order_id }, sku_id: po_item.sku_id).order('raw_material_stock_batches.receiving_date DESC') %>
            <tr id="history-<%= po_item.id %>" class="hidden bg-gray-50 border-t-0 shadow-inner">
              <td colspan="6" class="p-0">
                <div class="px-8 py-5 border-l-4 border-blue-500">
                  <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-clock-rotate-left"></i> Receipt History for <%= po_item.sku_id %>
                  </h4>
                  <% if rmi_items.present? %>
                    <table class="w-full lg:w-4/5 divide-y divide-gray-200 text-sm border border-gray-200 bg-white rounded-lg overflow-hidden shadow-sm">
                      <thead class="bg-gray-100 text-gray-600 uppercase font-bold text-xs text-left">
                        <tr>
                          <th class="px-4 py-2 border-b">Receiving Date</th>
                          <th class="px-4 py-2 border-b text-right">Quantity Received</th>
                          <th class="px-4 py-2 border-b text-right">Purchase Price</th>
                          <th class="px-4 py-2 border-b text-center">Status</th>
                          <th class="px-4 py-2 border-b text-right">Action</th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-gray-100">
                        <% rmi_items.each do |rmi| %>
                          <tr class="hover:bg-gray-50">
                            <td class="px-4 py-2 text-gray-700 font-medium"><%= rmi.raw_material_stock_batch.receiving_date&.strftime("%d %b %Y") %></td>
                            <td class="px-4 py-2 font-bold text-gray-900 text-right"><%= rmi.receiving_quantity %></td>
                            <td class="px-4 py-2 text-gray-600 text-right"><%= number_to_currency(rmi.purchase_price, unit: "₹") %></td>
                            <td class="px-4 py-2 text-center">
                              <% if rmi.stock_updated? %>
                                <span class="px-2 py-1 text-xs font-bold rounded-full bg-green-100 text-green-800 border border-green-200">Stock Updated</span>
                              <% else %>
                                <span class="px-2 py-1 text-xs font-bold rounded-full bg-yellow-100 text-yellow-800 border border-yellow-200">Stock Pending</span>
                              <% end %>
                            </td>
                            <td class="px-4 py-2 text-right">
                              <%= link_to "View Batch", raw_material_stock_batch_path(rmi.raw_material_stock_batch_id), class: "text-blue-600 hover:underline text-xs font-semibold" %>
                            </td>
                          </tr>
                        <% end %>
                      </tbody>
                    </table>
                  <% else %>
                    <p class="text-gray-500 text-sm py-2">No inward receipts yet.</p>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    
    <div class="mt-4 flex justify-end">
      <%= link_to "Create RMI", new_raw_material_stock_batch_path(po_number: @purchase_order.po_number), class: "bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg shadow-md transition-colors cursor-pointer flex items-center gap-2" %>
    </div>
  </div>
</div>
