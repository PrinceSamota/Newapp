<div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-200">
  <%= form_with url: (@purchase_order.new_record? ? purchase_orders_path : purchase_order_path(@purchase_order)), method: (@purchase_order.new_record? ? :post : :patch), local: true, id: "po-multi-form" do |form| %>
    <% if @purchase_order.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded-lg mb-6 text-sm border border-red-200">
        <h3 class="font-bold mb-1">Please correct the following errors:</h3>
        <ul class="list-disc list-inside">
          <% @purchase_order.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Supplier Info Section -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
      <div>
        <%= form.label :po_number, "Purchase Order No", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= form.text_field :po_number, name: "purchase_order[po_number]", value: @purchase_order.po_number, required: true, readonly: (!@purchase_order.new_record? || @purchase_order.closed?), class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm #{(!@purchase_order.new_record? || @purchase_order.closed?) ? 'bg-gray-200 cursor-not-allowed' : 'bg-white'}" %>
      </div>
      <div>
        <%= form.label :po_date, "PO Date", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= form.date_field :po_date, name: "purchase_order[po_date]", value: @purchase_order.po_date, required: true, readonly: @purchase_order.closed?, class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm #{@purchase_order.closed? ? 'bg-gray-200 cursor-not-allowed' : ''}" %>
      </div>
      <div>
        <%= form.label :supplier_name, "Supplier Name", class: "block text-sm font-semibold text-gray-700 mb-1" %>
        <%= form.select :supplier_name, 
              options_for_select(@suppliers.pluck(:name).uniq, @purchase_order.supplier_name), 
              { include_blank: "Select or type a Supplier" }, 
              { name: "purchase_order[supplier_name]", id: "po-supplier-select-multi", disabled: @purchase_order.closed?, class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm #{@purchase_order.closed? ? 'bg-gray-200 cursor-not-allowed' : ''}" } %>
      </div>
    </div>

    <div class="border-t border-gray-300 mb-6"></div>

    <h3 class="text-lg font-semibold text-gray-800 mb-4">Items</h3>
    <div id="po-items-container" class="space-y-4">
      <% 
        if @purchase_order.purchase_order_items.empty?
          @purchase_order.purchase_order_items.build
        end
      %>
      <% @purchase_order.purchase_order_items.each_with_index do |item, idx| %>
        <%= render 'purchase_orders/po_item_fields', index: idx, item: (item.new_record? ? nil : item) %>
      <% end %>
    </div>

    <% unless @purchase_order.closed? %>
    <div class="pt-6 flex justify-between items-center">
      <button type="button" id="add-po-item" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-4 rounded-md cursor-pointer text-sm">
        + Add Item
      </button>
      <%= form.submit (@purchase_order.new_record? ? "Create PO" : "Update PO"), class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-8 rounded-lg shadow-md transition text-sm cursor-pointer" %>
    </div>
    <% end %>
  <% end %>
</div>

<div id="po-item-template" style="display: none;">
  <%= render 'purchase_orders/po_item_fields', index: 'INDEX' %>
</div>

<!-- Items Data for JS -->
<%= content_tag :script, raw(@item_masters.to_json), id: "po_item_masters_json", type: "application/json" %>

<script>
  window.attachPoItemEvents = function(row) {
    const skuSelect = row.querySelector(".po-sku-select");
    const nameSelect = row.querySelector(".po-item-name");
    const priceInput = row.querySelector(".po-item-price");

    let tsSku = null;
    let tsName = null;

    if (skuSelect && !skuSelect.tomselect) {
      tsSku = new TomSelect(skuSelect, {
        create: false,
        placeholder: "Search SKU ID...",
        allowEmptyOption: true
      });
    } else if (skuSelect) {
      tsSku = skuSelect.tomselect;
    }

    if (nameSelect && !nameSelect.tomselect && nameSelect.tagName === 'SELECT') {
      tsName = new TomSelect(nameSelect, {
        create: false,
        placeholder: "Search Item Name...",
        allowEmptyOption: true
      });
    } else if (nameSelect) {
      tsName = nameSelect.tomselect;
    }

    if (tsSku) {
      tsSku.on('change', function(value) {
        if (!value) return;
        const match = window.poItemsData.find(i => String(i.sku_id) === String(value));
        if (match) {
          if (tsName && tsName.getValue() !== match.item_name) {
            tsName.setValue(match.item_name, true); // true = silent to prevent infinite loop
          }
          if (priceInput) priceInput.value = match.purchase_price || "";
        }
      });
    }

    if (tsName) {
      tsName.on('change', function(value) {
        if (!value) return;
        const match = window.poItemsData.find(i => String(i.item_name) === String(value));
        if (match) {
          if (tsSku && tsSku.getValue() !== match.sku_id) {
            tsSku.setValue(match.sku_id, true);
          }
          if (priceInput) priceInput.value = match.purchase_price || "";
        }
      });
    }
  };

  document.addEventListener("turbo:load", function() {
    const supplierSelect = document.getElementById("po-supplier-select-multi");
    if (supplierSelect && !supplierSelect.tomselect) {
      new TomSelect(supplierSelect, {
        create: true,
        placeholder: "Select or type supplier...",
        allowEmptyOption: true
      });
    }

    const itemsDataEl = document.getElementById("po_item_masters_json");
    window.poItemsData = itemsDataEl ? JSON.parse(itemsDataEl.textContent) : [];

    const container = document.getElementById("po-items-container");
    if (container) {
      container.querySelectorAll(".po-item-row").forEach(window.attachPoItemEvents);
    }
  });

  if (!window.poMultiFormDelegationAdded) {
    window.poMultiFormDelegationAdded = true;
    document.addEventListener("click", function(e) {
      if (e.target.closest("#add-po-item")) {
        const container = document.getElementById("po-items-container");
        const templateDiv = document.getElementById("po-item-template");
        
        if (container && templateDiv) {
          const templateHTML = templateDiv.innerHTML;
          let indexCounter = container.querySelectorAll(".po-item-row").length;
          const newRowHtml = templateHTML.replace(/INDEX/g, indexCounter);
          
          container.insertAdjacentHTML("beforeend", newRowHtml);
          
          const newRow = container.lastElementChild;
          window.attachPoItemEvents(newRow);
        }
      }
      
      if (e.target.closest(".remove-po-item")) {
        const row = e.target.closest(".po-item-row");
        if (row) {
          const destroyInput = row.querySelector(".po-item-destroy");
          if (destroyInput) {
            destroyInput.value = "1";
            row.style.display = "none";
          } else {
            row.remove();
          }
        }
      }
    });
  }
</script>
