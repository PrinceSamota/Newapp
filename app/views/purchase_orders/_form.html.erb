<div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-200">
  <%= form_with model: @purchase_order, url: @purchase_order.new_record? ? purchase_orders_path : purchase_order_path(@purchase_order), local: true, id: "po-form" do |form| %>
    <% if @purchase_order.errors.any? %>
      <div class="bg-red-50 text-red-800 p-4 rounded-lg mb-6 text-sm border border-red-200">
        <h3 class="font-bold mb-1">Please correct the following errors:</h3>
        <ul class="list-disc list-inside">
          <% @purchase_order.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Form Grid Layout -->
    <div class="space-y-6">
      <!-- Row 1: PO Number, PO Date, Supplier Name -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <%= form.label :po_number, "Purchase Order No", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :po_number, required: true, class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm" %>
        </div>

        <div>
          <%= form.label :po_date, "PO Date", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.date_field :po_date, required: true, class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm" %>
        </div>

        <div>
          <%= form.label :supplier_name, "Supplier Name", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.select :supplier_name, 
                options_for_select(@suppliers.pluck(:name).uniq, @purchase_order.supplier_name), 
                { include_blank: "Select or type a Supplier" }, 
                { id: "po-supplier-select", class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm" } %>
        </div>
      </div>

      <!-- Row 2: SKU ID, Item Name, Quantity, Purchase Price -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div>
          <%= form.label :sku_id, "SKU ID", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <select name="purchase_order[sku_id]" id="po-sku-select" class="required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm">
            <option value="">Select SKU</option>
            <% @item_masters.each do |item| %>
              <option value="<%= item.sku_id %>" 
                      data-item-name="<%= item.item_name %>" 
                      data-purchase-price="<%= item.purchase_price %>"
                      <%= 'selected' if @purchase_order.sku_id == item.sku_id %>>
                <%= item.sku_id %> (<%= item.item_name %>)
              </option>
            <% end %>
          </select>
        </div>

        <div>
          <%= form.label :item_name, "Item Name", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :item_name, id: "purchase_order_item_name", required: true, class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm bg-gray-50" %>
        </div>

        <div>
          <%= form.label :quantity, "Quantity", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.number_field :quantity, required: true, min: 1, class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm" %>
        </div>

        <div>
          <%= form.label :purchase_price, "Purchase Price", class: "block text-sm font-semibold text-gray-700 mb-1" %>
          <%= form.text_field :purchase_price, id: "purchase_order_purchase_price", required: true, class: "required-field w-full rounded-lg border border-gray-300 focus:ring-2 focus:ring-blue-500 py-2 px-4 shadow-sm text-sm" %>
        </div>
      </div>

      <!-- Action Button -->
      <div class="flex justify-end pt-4">
        <%= form.submit @purchase_order.new_record? ? "Create PO" : "Update PO", 
              class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-8 rounded-lg shadow-md transition text-sm cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener("turbo:load", initializePoForm);
  document.addEventListener("turbo:frame-load", initializePoForm);

  function initializePoForm() {
    const supplierSelect = document.getElementById("po-supplier-select");
    const skuSelect = document.getElementById("po-sku-select");

    // Initialize Supplier TomSelect (allows searching and adding custom new names)
    if (supplierSelect && !supplierSelect.tomselect) {
      new TomSelect(supplierSelect, {
        create: true,
        placeholder: "Select or type supplier...",
        allowEmptyOption: true
      });
    }

    // Initialize SKU TomSelect & set up autofill change handler
    if (skuSelect && !skuSelect.tomselect) {
      const tsSku = new TomSelect(skuSelect, {
        create: false,
        placeholder: "Search SKU ID...",
        allowEmptyOption: true
      });

      tsSku.on('change', function(value) {
        const option = skuSelect.querySelector(`option[value="${value}"]`);
        if (option) {
          const itemName = option.getAttribute("data-item-name");
          const purchasePrice = option.getAttribute("data-purchase-price");

          const nameInput = document.getElementById("purchase_order_item_name");
          const priceInput = document.getElementById("purchase_order_purchase_price");

          if (nameInput) nameInput.value = itemName || "";
          if (priceInput) priceInput.value = purchasePrice || "";
        }
      });
    }
  }

  // Fallback trigger if page loads directly
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializePoForm);
  } else {
    initializePoForm();
  }
</script>
