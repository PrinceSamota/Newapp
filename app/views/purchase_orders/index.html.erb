<% content_for(:title, "Purchase Orders") %>

<div class="max-w-8xl mx-auto p-6 space-y-8">
  <!-- Header & Search Section -->
  <div class="bg-white p-6 rounded-2xl shadow-md border border-gray-200">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-2 font-bold text-2xl text-gray-800">
        <i class="fa-solid fa-file-invoice-dollar text-blue-600"></i>
        <span>Purchase Order Management</span>
      </div>

      <!-- Ransack Search Form -->
      <div class="w-full md:w-auto">
        <%= search_form_for @q, url: purchase_orders_path, method: :get, class: "flex items-center gap-2 w-full md:max-w-md" do |f| %>
          <div class="relative w-full md:w-80">
            <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
              <i class="fa-solid fa-magnifying-glass"></i>
            </div>
            <%= f.search_field :po_number_or_supplier_name_or_sku_id_or_item_name_cont,
                  class: "w-full pl-10 pr-4 py-2 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm",
                  placeholder: "Search PO, SKU, Supplier, Item..." %>
          </div>
          <%= f.submit "Search", class: "px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition text-sm font-semibold cursor-pointer shadow" %>
          <%= link_to "Clear", purchase_orders_path, class: "px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition text-sm font-semibold border border-gray-300" %>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Create Purchase Order Section -->
  <div>
    <h3 class="text-lg font-bold text-gray-700 mb-3 px-1 uppercase tracking-wider">Create New Purchase Order</h3>
    <%= render "form" %>
  </div>

  <!-- All Purchase Orders Table -->
  <div class="bg-white rounded-2xl shadow-md border border-gray-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
      <h2 class="text-lg font-bold text-gray-800">All Purchase Orders</h2>
      <span class="px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-full">
        Total: <%= @purchase_orders.respond_to?(:total_entries) ? @purchase_orders.total_entries : @purchase_orders.count %>
      </span>
    </div>

    <% if @purchase_orders.present? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm divide-y divide-gray-200">
          <thead class="bg-gray-100 text-gray-600 uppercase text-xs font-semibold">
            <tr>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">PO No.</th>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">PO Date</th>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">Supplier Name</th>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">SKU ID</th>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">Item Name</th>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">Qty Ordered</th>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">Qty Delivered</th>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">Qty Remaining</th>
              <th class="px-6 py-3.5 text-center border-r border-gray-200">Status</th>
              <th class="px-6 py-3.5 text-center">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-100">
            <% @purchase_orders.each_with_index do |po, index| %>
              <tr class="hover:bg-gray-50 <%= index.even? ? '' : 'bg-gray-50/30' %> transition-colors">
                <td class="px-6 py-4 text-center border-r border-gray-100 font-semibold text-gray-800"><%= po.po_number %></td>
                <td class="px-6 py-4 text-center border-r border-gray-100 text-gray-600"><%= po.po_date&.strftime("%d %b %Y") %></td>
                <td class="px-6 py-4 text-center border-r border-gray-100 font-medium text-gray-700"><%= po.supplier_name %></td>
                <td class="px-6 py-4 text-center border-r border-gray-100 text-blue-600"><%= po.sku_id %></td>
                <td class="px-6 py-4 text-center border-r border-gray-100 text-gray-600"><%= po.item_name %></td>
                <td class="px-6 py-4 text-center border-r border-gray-100 font-medium text-gray-800"><%= po.quantity %></td>
                <td class="px-6 py-4 text-center border-r border-gray-100 text-green-700 font-medium"><%= po.delivered_quantity %></td>
                <td class="px-6 py-4 text-center border-r border-gray-100 text-gray-800 font-semibold"><%= po.remaining_quantity %></td>
                <td class="px-6 py-4 text-center border-r border-gray-100">
                  <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-bold rounded-full <%= po.status == 'Open' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                    <%= po.status %>
                  </span>
                </td>
                <td class="px-6 py-4 text-center">
                  <%= link_to edit_purchase_order_path(po), class: "inline-flex items-center gap-1.5 text-blue-600 hover:text-blue-900 font-bold hover:underline" do %>
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Edit / Convert</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12 text-gray-500">
        <i class="fa-solid fa-folder-open text-4xl mb-3 text-gray-300 block"></i>
        No purchase orders found matching your search.
      </div>
    <% end %>
  </div>
</div>
