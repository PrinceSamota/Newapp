<div class="relative">
  <%= label_tag field_id, label_text, class: "text-xs font-medium text-gray-700 block mb-1" %>

  <div class="relative">
    <input type="text"
           id="<%= field_id %>_search"
           placeholder="Search <%= label_text %>..."
           <%= "readonly" if local_assigns[:readonly] %>
           onkeyup="<%= local_assigns[:readonly] ? '' : "filterDropdown('#{field_id}')" %>"
           onclick="<%= local_assigns[:readonly] ? '' : "toggleDropdown('#{field_id}')" %>"
           autocomplete="off"
           value="<%= selected_value %>"
           class="required-field w-full px-3 py-2 pr-10 border border-gray-300 rounded-md text-sm <%= local_assigns[:readonly] ? 'bg-gray-200 cursor-not-allowed' : 'bg-white' %>" />

    <button type="button"
            id="<%= field_id %>_clear"
            onclick="clearDropdownSelection('<%= field_id %>')"
            class="hidden absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-400 hover:text-red-600 text-sm"
            title="Clear selection">
      ✕
    </button>
  </div>

  <input type="hidden"
         name="<%= field_name %>"
         id="<%= field_id %>_hidden"
         value="<%= selected_value %>" />

  <div id="<%= field_id %>_list"
       class="absolute z-10 bg-white border border-gray-300 rounded-lg mt-1 max-h-60 overflow-auto w-full hidden shadow-lg">
    <% items.each do |item| %>
      <div class="px-4 py-2 cursor-pointer hover:bg-gray-100 text-sm"
           onclick="selectLinkedDropdown('<%= field_id %>', this)"
           data-sku="<%= item.sku_id %>"
           data-item-name="<%= j item.item_name %>">
        <%= item.send(value_method) %>
      </div>
    <% end %>
  </div>
</div>
