<header class="relative z-10 bg-white shadow-lg">
<div class="mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex justify-between h-16 items-center w-full">
    <div class="flex-shrink-0 text-xl font-bold ">
    <% if user_signed_in? %>
    <%= link_to "Home", root_path, class: "px-4 py-2 cursor-pointer transition font-bold", form: { class: "inline" } %>
  <% else %>
  <% end %>
    </div>
    <div class="space-x-4">
      <% if user_signed_in? %>
        <span class="text-gray-400">Hi, <%= current_user.email %></span>
        <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "px-4 py-2  cursor-pointer transition font-bold", form: { class: "inline" } %>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "px-4 py-2  cursor-pointer transition font-bold" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "px-4 py-2  cursor-pointer transition font-bold" %>
      <% end %>
    </div>
  </div>
</div>
</header>
<h1 class="text-2xl font-bold mb-6 text-gray-800 mt-4">Enter Availability</h1>

<%= form_with url: availabilities_path, method: :post, local: true do %>
  <% @variables_by_category.each do |category, variables| %>
    <div class="mb-8 p-4 bg-gray-100 rounded-lg shadow-sm">
      <h2 class="text-lg font-semibold text-gray-700 mb-4 border-b pb-2"><%= category %></h2>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% variables.each do |var| %>
          <div>
            <label for="availability_<%= category.parameterize %>_<%= var.parameterize %>" class="block text-sm font-medium text-gray-600 mb-1">
              <%= var %>
            </label>
            <%= number_field_tag "availability[#{category}][#{var}]", nil,
              min: 0,
              id: "availability_#{category.parameterize}_#{var.parameterize}",
              class: "w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-blue-500 focus:outline-none" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-6">
    <%= submit_tag "Save Stock", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-6 rounded shadow" %>
  </div>
<% end %>
