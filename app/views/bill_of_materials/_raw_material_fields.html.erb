<div class="raw-material-row relative grid grid-cols-4 gap-4 items-end bg-white border border-gray-200 rounded-lg px-4 py-3 shadow-sm">

  <!-- SKU ID -->
  <div>
    <%= f.label :sku_id, "SKU ID", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.select :sku_id,
      options_for_select(item_masters.map { |item| [item.sku_id, item.sku_id] }, f.object.sku_id),
      { include_blank: "Choose SKU" },
      id: f.object.object_id.to_s + "_sku_id",
      class: "sku-id-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
    %>
  </div>

  <!-- Item Name -->
  <div>
    <%= f.label :item_name, "Item Name", class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.select :item_name,
      options_for_select(item_masters.map { |item| [item.item_name, item.item_name] }, f.object.item_name),
      { include_blank: "Choose Item" },
      id: f.object.object_id.to_s + "_item_name",
      class: "item-name-select w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
    %>
  </div>

  <!-- Quantity -->
  <div>
    <%= f.label :quantity, class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.number_field :quantity,
      value: f.object.quantity || 1,
      class: "quantity-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
    %>
  </div>

  <!-- Unit -->
  <div>
    <%= f.label :unit, class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.text_field :unit,
      value: f.object.unit,
      class: "unit-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
    %>
  </div>
</div>
<script>
document.addEventListener("turbo:load", () => {
  const itemMap = {
    <% @item_masters.each do |item| %>
      "<%= item.sku_id %>": "<%= j item.item_name %>",
    <% end %>
  };

  const reverseMap = {
    <% @item_masters.each do |item| %>
      "<%= j item.item_name %>": "<%= item.sku_id %>",
    <% end %>
  };

  function setupRawMaterialAutofill(row) {
    const skuSelect = row.querySelector(".sku-id-field");
    const itemSelect = row.querySelector(".item-name-select");

    if (!skuSelect || !itemSelect) return;

    skuSelect.addEventListener("change", function () {
      const selectedSku = this.value;
      if (itemMap[selectedSku]) {
        itemSelect.value = itemMap[selectedSku];
      }
    });

    itemSelect.addEventListener("change", function () {
      const selectedItem = this.value;
      if (reverseMap[selectedItem]) {
        skuSelect.value = reverseMap[selectedItem];
      }
    });
  }

  // Setup autofill for existing rows
  document.querySelectorAll(".raw-material-row").forEach(setupRawMaterialAutofill);

  // Also attach to dynamically added rows
  const addButton = document.getElementById("add-raw-material");
  if (addButton) {
    addButton.addEventListener("click", () => {
      setTimeout(() => {
        const newRows = document.querySelectorAll(".raw-material-row");
        const lastRow = newRows[newRows.length - 1];
        setupRawMaterialAutofill(lastRow);
      }, 100); // slight delay to let Turbo render
    });
  }
});

</script>