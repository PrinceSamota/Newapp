<div class="raw-material-row relative grid grid-cols-4 gap-4 items-end bg-white border border-gray-200 rounded-lg px-4 py-3 shadow-sm">

  <!-- SKU ID -->
  <div>
  <%= render 'searchable_dropdown',
  field_id: "sku_#{f.index || SecureRandom.hex(4)}",  # Unique ID per row
  label_text: 'SKU ID',
  field_name: f.object_name + '[sku_id]',
  items: item_masters,
  value_method: :sku_id,
  selected_value: f.object.sku_id,
  input_class: "sku-id-field" %>
  </div>

  <!-- Item Name -->
  <div>
  <%= render 'searchable_dropdown',
  field_id: "item_#{f.index || SecureRandom.hex(4)}",
  label_text: 'Item Name',
  field_name: f.object_name + '[item_name]',
  items: item_masters,
  value_method: :item_name,
  selected_value: f.object.item_name,
  input_class: "item-name-select" %>
  </div>

  <!-- Unit -->
  <div>
    <%= f.label :unit, class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.text_field :unit,
      id:"unitField",
      class: "required-field unit-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
    %>
  </div>


<%= f.hidden_field :item_master_id, class: "item-master-id-field" %>
  <!-- Quantity -->
  <div>
    <%= f.label :quantity, class: "text-xs font-medium text-gray-700 block mb-1" %>
    <%= f.number_field :quantity,
      value: f.object.quantity ,
      min: 1, 
      class: "required-field quantity-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm"
    %>
  </div>

  <%= f.hidden_field :_destroy %>

  <!-- Cross ✕ Button -->
  <button type="button"
    class="remove-raw-material absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer">
    ✕
  </button>
</div>

<script>
document.addEventListener("turbo:load", () => {
  const skuToItem = {
    <% item_masters.each do |item| %>
      "<%= j item.sku_id %>": "<%= j item.item_name %>",
    <% end %>
  };

  const itemToSku = {
    <% item_masters.each do |item| %>
      "<%= j item.item_name %>": "<%= j item.sku_id %>",
    <% end %>
  };

  const skuToUnit = {
    <% item_masters.each do |item| %>
      "<%= j item.sku_id %>": "<%= j item.measurement&.name || '' %>",
    <% end %>
  };

  const itemToUnit = {
    <% item_masters.each do |item| %>
      "<%= j item.item_name %>": "<%= j item.measurement&.name || '' %>",
    <% end %>
  };
  const itemToId = {
    <% item_masters.each do |item| %>
      "<%= j item.item_name %>": "<%= j item.id|| '' %>",
    <% end %>
  };
  const skuToId = {
    <% item_masters.each do |item| %>
      "<%= j item.sku_id %>": "<%= j item.id|| '' %>",
    <% end %>
  };

  const skuToStock = {
  <% item_masters.each do |item| %>
    "<%= j item.sku_id %>": <%= item.opening_stock.to_f %>,
  <% end %>
};
function setupRawMaterialAutofill(row) {
  const skuSelect = row.querySelector(".sku-id-field");
  const itemSelect = row.querySelector(".item-name-select");
  const unitInput = row.querySelector(".unit-field");
  const quantityInput = row.querySelector(".quantity-field_comment");
   const itemMasterIdField = row.querySelector(".item-master-id-field");
  if (!skuSelect || !itemSelect || !unitInput || !quantityInput || !itemMasterIdField) return;

  function validateStock() {
    const sku = skuSelect.value;
    const availableStock = skuToStock[sku] || 0;
    const enteredQty = parseFloat(quantityInput.value);

    if (isNaN(enteredQty) || enteredQty <= 0) {
      quantityInput.classList.add("border-red-500");
      quantityInput.setCustomValidity("Quantity must be greater than 0");
      quantityInput.reportValidity();
      return false;
    } else if (enteredQty > availableStock) {
      quantityInput.classList.add("border-red-500");
      quantityInput.setCustomValidity(`Only ${availableStock} in stock`);
      quantityInput.reportValidity();
      return false;
    } else {
      quantityInput.classList.remove("border-red-500");
      quantityInput.setCustomValidity("");
      return true;
    }
  }

  quantityInput.addEventListener("input", validateStock);

  skuSelect.addEventListener("change", () => {
    const sku = skuSelect.value;
    if (skuToItem[sku]) itemSelect.value = skuToItem[sku];
    if (skuToUnit[sku]) unitInput.value = skuToUnit[sku];
    if (skuToId[sku]) itemMasterIdField.value = skuToId[sku];

    validateStock();
  });

  itemSelect.addEventListener("change", () => {
    const item = itemSelect.value;
    if (itemToSku[item]) skuSelect.value = itemToSku[item];
    if (itemToUnit[item]) unitInput.value = itemToUnit[item];
      if (itemToId[item]) itemMasterIdField.value = itemToId[item];
    validateStock();
  });
}


  // Setup for existing rows
  document.querySelectorAll(".raw-material-row").forEach(setupRawMaterialAutofill);

  // Watch for new rows added dynamically
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      mutation.addedNodes.forEach((node) => {
        if (node.nodeType !== 1) return;

        if (node.classList.contains("raw-material-row")) {
          setupRawMaterialAutofill(node);
        }

        const nestedRows = node.querySelectorAll?.(".raw-material-row") || [];
        nestedRows.forEach(setupRawMaterialAutofill);
      });
    });
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true,
  });
});


  function filterDropdown(fieldId) {
    const input = document.getElementById(`${fieldId}_search`);
    const filter = input.value.toLowerCase();
    const dropdown = document.getElementById(`${fieldId}_list`);
    const items = dropdown.querySelectorAll("div");

    dropdown.classList.remove("hidden");

    items.forEach(item => {
      const text = item.textContent.toLowerCase();
      item.style.display = text.includes(filter) ? "block" : "none";
    });
  }
function selectFromDropdown(fieldId, element) {
  const selectedValue = element.textContent.trim();
  const input = document.getElementById(`${fieldId}_search`);
  const hiddenInput = document.getElementById(`${fieldId}_hidden`);
  const dropdown = document.getElementById(`${fieldId}_list`);

  input.value = selectedValue;
  hiddenInput.value = fieldId.includes('sku') ? element.dataset.sku : element.dataset.itemName;
  dropdown.classList.add("hidden");

  const fieldSuffix = fieldId.split("_")[1]; // get the unique ID suffix
  const pairFieldId = fieldId.includes('sku') ? `item_${fieldSuffix}` : `sku_${fieldSuffix}`;
  const pairFieldInput = document.getElementById(`${pairFieldId}_search`);
  const pairFieldHidden = document.getElementById(`${pairFieldId}_hidden`);

  if (pairFieldInput && pairFieldHidden) {
    pairFieldInput.value = fieldId.includes('sku') ? element.dataset.itemName : element.dataset.sku;
    pairFieldHidden.value = fieldId.includes('sku') ? element.dataset.itemName : element.dataset.sku;
  }

  const row = input.closest(".raw-material-row"); // ✅ get the row element here
  if (row) {
    const unitField = row.querySelector(".unit-field");
    if (unitField) {
      unitField.value = element.dataset.unit || "";
    }

    const itemMasterIdField = row.querySelector(".item-master-id-field");
    if (itemMasterIdField) {
      itemMasterIdField.value = element.dataset.itemMasterId || "";
    }
  }
     input.readOnly = true;
  if (pairInput) pairInput.readOnly = true;
}

  

  document.addEventListener("click", function (e) {
    if (!e.target.closest(".relative")) {
      document.querySelectorAll("[id$='_list']").forEach(d => d.classList.add("hidden"));
    }
  });

  document.addEventListener("turbo:load", function () {
    document.querySelectorAll(".quantity-field").forEach(field => {
      field.addEventListener("input", function () {
        if (parseInt(this.value) <= 0) {
          this.value = "";
        }
      });
    });
  });
  
document.addEventListener("submit", function(e) {
  const rows = document.querySelectorAll(".raw-material-row");
  let allValid = true;

  rows.forEach(row => {
    const skuField = row.querySelector(".sku-id-field");
    const quantityField = row.querySelector(".quantity-field");

    const sku = skuField?.value?.trim();
    const qty = parseFloat(quantityField?.value?.trim() || "0");
    const availableStock = skuToStock[sku] || 0;

    if (!sku || isNaN(qty) || qty <= 0 || qty > availableStock) {
      quantityField.classList.add("border-red-500");

      if (qty > availableStock) {
        quantityField.setCustomValidity(`Only ${availableStock} in stock`);
      } else {
        quantityField.setCustomValidity("Quantity must be valid and > 0");
      }

      quantityField.reportValidity();
      allValid = false;
    } else {
      quantityField.setCustomValidity("");
      quantityField.classList.remove("border-red-500");
    }
  });

  if (!allValid) {
    e.preventDefault();
    alert("Please fix quantity errors before submitting.");
  }
});


</script>
