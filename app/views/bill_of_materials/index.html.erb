<div class="flex justify-between items-center mb-4 ">
  <!-- Back Button -->


  <!-- Add BOM Button (styled like Add Item) -->

</div>

<!-- BOM Table -->
<div class="pl-6 pr-6">
<div class="overflow-x-auto bg-white shadow-md rounded-lg border border-gray-200">
<div class="flex items-center justify-between px-6 pt-4 pb-4">
<h1 class="text-2xl font-bold">Bill of Material</h1>
<!-- Search Input -->
<div data-controller="bom-search" class="relative ">
  <span class="absolute top-1/2 left-0 pl-3 transform -translate-y-1/2 text-gray-500">
    <i class="fa-solid fa-magnifying-glass"></i>
  </span>
  <input
    type="text"
    id="bomSearchInput"
    placeholder="BOM Number or Name"
    class="border border-gray-300 rounded-md px-3 py-2 text-sm w-full pl-10 focus:ring-blue-500 focus:border-blue-500"
  />
</div>

<%= link_to new_bill_of_material_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300" do %>
  <i class="fa-solid fa-plus"></i>
  <span class="font-semibold">Add BOM</span>
<% end %>
</div>
  <% if @bill_of_materials.any? %>
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
        <tr>
          <% ["BOM Number", "BOM Name", "Finished Good", "Action"].each_with_index do |header, index| %>
            <th class="px-6 py-3 text-left whitespace-nowrap border-r border-gray-300 <%= 'last:border-r-0' if index == 3 %>">
              <%= header %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200" id="bomTableBody">
        <% @bill_of_materials.each do |bom| %>
          <tr class="hover:bg-gray-50" data-bom-number="<%= bom.bom_number.downcase %>" data-bom-name="<%= bom.name.downcase %>">
            <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= bom.bom_number %></td>
            <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= bom.name %></td>

            <!-- Finished Good Info -->
              <td class="px-4 py-3 border-r border-gray-200 w-[30%] max-w-xs whitespace-normal break-words">
                <% if bom.finished_good.present? %>
                  <div class="flex flex-wrap gap-x-4 gap-y-1">
                    <div><strong>SKU:</strong> <%= bom.finished_good.sku_id %></div>
                    <div><strong>Item:</strong> <%= bom.finished_good.item_name %></div>
                    <div><strong>Qty:</strong> <%= bom.finished_good.quantity %></div>
                    <div><strong>Unit:</strong> <%= bom.finished_good.unit %></div>
                  </div>
                <% else %>
                  <span class="text-gray-500 italic">N/A</span>
                <% end %>
              </td>

            <!-- Action Buttons -->
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex flex-col gap-2">
                <%= link_to edit_bill_of_material_path(bom), class: "flex items-center gap-1 cursor-pointer text-sm" do %>
                  <i class="fa fa-pen-to-square"></i>
                  <span>Edit</span>
                <% end %>

                <%= link_to clone_bill_of_material_path(bom), class: "flex items-center gap-1 cursor-pointer text-sm", title: "Clone" do %>
                  <i class="fa-solid fa-clone"></i>
                  <span>Clone</span>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-gray-500 italic px-6 py-4">No BOMs found.</p>
  <% end %>
</div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("bomSearchInput");
    const tableRows = document.querySelectorAll("#bomTableBody tr");

    searchInput.addEventListener("input", function () {
      const query = this.value.toLowerCase();

      tableRows.forEach(row => {
        const bomNumber = row.dataset.bomNumber || "";
        const bomName = row.dataset.bomName || "";
        const isMatch = bomNumber.includes(query) || bomName.includes(query);

        row.style.display = isMatch ? "" : "none";
      });
    });
  });
</script>