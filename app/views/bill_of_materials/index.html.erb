<div class="flex justify-between items-center mb-4 ">
  <!-- Back Button -->


  <!-- Add BOM Button (styled like Add Item) -->

</div>

<!-- BOM Table -->
<div class="pl-6 pr-6">
<div class="overflow-x-auto bg-white shadow-md rounded-lg border border-gray-200">
<div class="flex items-center justify-between px-6 pt-2 pb-2">
<h1 class="text-2xl font-bold">Bill of Material</h1>
<!-- Search Input -->
<div data-controller="bom-search" class="relative ">
  <div class="flex items-center gap-2 pt-4 mb-4">
              <div class="relative mb:w-1/3">
                
              <%= search_form_for @q, html: { class: "flex items-center gap-2 w-full max-w-xl mx-auto" } do |f| %>
                <div class="relative w-full">
                  <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2"
                         viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path stroke-linecap="round" stroke-linejoin="round"
                            d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 103 10.5a7.5 7.5 0 0013.15 6.15z"/>
                    </svg>
                  </div>
                  <%= f.search_field :bom_number_or_finished_good_sku_id_or_name_cont,
                    class: "w-full pl-10 pr-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 ",
                    placeholder: "Search by BOM Name, BOM Number, SKU ID..." %>
                </div>
              
                <%= f.submit "Search",
                  class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition duration-150 ease-in-out cursor-pointer" %>
              <% end %>
              

              </div>
            </div>
</div>

<%= link_to new_bill_of_material_path, class: "flex items-center gap-2 transition-colors duration-200 text-black hover:bg-gray-200 rounded-md px-3 py-2 cursor-pointer border border-gray-300" do %>
  <i class="fa-solid fa-plus"></i>
  <span class="font-semibold">Add BOM</span>
<% end %>
</div>
  <% if @bill_of_materials.any? %>
    <div class="max-h-[80vh] overflow-y-auto border border-gray-300 rounded-lg">
  <table class="min-w-full divide-y divide-gray-200 text-sm">
    <thead class="bg-gray-100 text-gray-600 uppercase text-xs sticky top-0 z-10">
      <tr>
        <% ["BOM Number", "BOM Name", "Finished Good", "Action"].each_with_index do |header, index| %>
          <th class="px-6 py-3 text-left whitespace-nowrap border-r border-gray-300 <%= 'last:border-r-0' if index == 3 %>">
            <%= header %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200" id="bomTableBody">
      <% @bill_of_materials.each do |bom| %>
        <tr class="hover:bg-gray-50" data-bom-number="<%= bom.bom_number.downcase %>" data-bom-name="<%= bom.name.downcase %>">
          <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200 text-blue-600 underline">
            <%= link_to bom.bom_number, bill_of_material_path(bom) %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap border-r border-gray-200"><%= bom.name %></td>
          <td class="px-4 py-3 border-r border-gray-200 w-[30%] max-w-xs whitespace-normal break-words">
            <% if bom.finished_good.present? %>
              <div class="flex flex-wrap gap-x-4 gap-y-1">
                <div><strong>SKU:</strong> <%= bom.finished_good.sku_id %></div>
              </div>
            <% else %>
              <span class="text-gray-500 italic">N/A</span>
            <% end %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="flex flex-col gap-2">
              <%= link_to clone_bill_of_material_path(bom), class: "flex items-center gap-1 cursor-pointer text-sm", title: "Clone" do %>
                <i class="fa-solid fa-clone"></i>
                <span>Clone</span>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

     <div class="flex items-center justify-between px-4 py-4 border-t border-gray-200 bg-gray-50 text-sm text-gray-600">
  <div>
    Showing 
    <%= @bill_of_materials.offset_value + 1 %> -
    <%= [@bill_of_materials.offset_value + @bill_of_materials.length, @bill_of_materials.total_entries].min %>
    of <%= @bill_of_materials.total_entries %> results
  </div>

  <div class="flex items-center space-x-1">
  <%= will_paginate @bill_of_materials,
    renderer: PaginationRenderer,
    previous_label: "&laquo;".html_safe,
    next_label: "&raquo;".html_safe,
    container: false %>
</div>
</div>

  <% else %>
    <p class="text-gray-500 italic px-6 py-4">No BOMs found.</p>
  <% end %>
</div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("bomSearchInput");
    const tableRows = document.querySelectorAll("#bomTableBody tr");

    searchInput.addEventListener("input", function () {
      const query = this.value.toLowerCase();

      tableRows.forEach(row => {
        const bomNumber = row.dataset.bomNumber || "";
        const bomName = row.dataset.bomName || "";
        const isMatch = bomNumber.includes(query) || bomName.includes(query);

        row.style.display = isMatch ? "" : "none";
      });
    });
  });
</script>