<%= link_to bill_of_materials_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 border border-gray-300" do %>
    <i class="fa-solid fa-arrow-left"></i>
    <span class="font-bold">Back</span>
  <% end %>
<%= form_with model: @bill_of_material, url: update_bom_all_items_path(@bill_of_material), method: :patch, local: true do |f| %>
    <div class="pt-6">
      <div class="bg-white p-6 rounded-lg shadow border border-gray-200">
        <h2 class="text-xl font-bold text-gray-800 mb-6"> <%= @bill_of_material.name %></h2>
  
        <!-- BOM Info -->
        <div class="grid grid-cols-1 md:grid-cols-1 gap-6 mb-6">
  <div>
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Finished Good</h3>
    <% if @bill_of_material.finished_good.present? %>
      <div class="border border-gray-200  shadow-sm rounded-md p-3 bg-gray-50">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          
          <!-- SKU -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">SKU</label>
            <%= f.fields_for :finished_good do |fg_fields| %>
              <%= fg_fields.text_field :sku_id,
                readonly: true,
                class: "w-full border border-gray-300 rounded-md p-2 bg-gray-100 text-gray-800 cursor-not-allowed" %>
            <% end %>
          </div>
          
          <!-- Item Name -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Item Name</label>
            <%= f.fields_for :finished_good do |fg_fields| %>
              <%= fg_fields.text_field :item_name,
                readonly: true,
                class: "w-full border border-gray-300 rounded-md p-2 bg-gray-100 text-gray-800 cursor-not-allowed" %>
            <% end %>
          </div>
          
          <!-- Quantity -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Quantity</label>
            <%= f.fields_for :finished_good do |fg_fields| %>
              <%= fg_fields.number_field :quantity,
                step: 0.01,
                class: "w-full border border-gray-300 rounded-md p-2 focus:ring focus:ring-blue-200" %>
            <% end %>
          </div>
          
          <!-- Unit -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Unit</label>
            <%= f.fields_for :finished_good do |fg_fields| %>
              <%= fg_fields.text_field :unit,
                class: "w-full border border-gray-300 rounded-md p-2 focus:ring focus:ring-blue-200" %>
            <% end %>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>

        <!-- Raw Material Section -->
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Raw Materials</h3>
        <% if @bill_of_material.bom_raw_material_items.any? %>
          <div class="overflow-x-auto rounded-lg shadow-sm border border-gray-300 mb-4">
            <table class="min-w-full text-sm">
              <thead class="bg-gray-50 text-gray-700 text-xs font-semibold uppercase">
                <tr>
                  <th class="px-4 py-2 text-left">SKU</th>
                  <th class="px-4 py-2 text-left">Item Name</th>
                  <th class="px-4 py-2 text-left">Quantity</th>
                  <th class="px-4 py-2 text-left">Unit</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-100">
              <%= f.fields_for :bom_raw_material_items do |rm_fields| %>
                <tr class="item-row">
                  <td class="px-4 py-2">
                    <%= rm_fields.text_field :sku_id,
                      readonly: true,
                      class: "w-full border-gray-300 p-2 rounded-md border bg-gray-100 cursor-not-allowed text-gray-800" %>
                  </td>
                  <td class="px-4 py-2">
                    <%= rm_fields.text_field :item_name,
                      readonly: true,
                      class: "w-full border-gray-300 p-2 rounded-md border bg-gray-100 cursor-not-allowed text-gray-800" %>
                  </td>
                  <td class="px-4 py-2">
                    <%= rm_fields.number_field :quantity, step: 0.01,
                      class: "w-full border-gray-300 p-2 rounded-md border" %>
                  </td>
                  <td class="px-4 py-2">
                    <%= rm_fields.text_field :unit,
                      class: "w-full border-gray-300 p-2 rounded-md border" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
            </table>
          </div>
        <% else %>
          <p class="italic text-gray-500">No raw materials found.</p>
        <% end %>
  
        <!-- Submit Button -->
        <div class="mt-6 text-right">
          <%= f.submit "Save Changes", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-md shadow cursor-pointer" %>
        </div>
      </div>
    </div>
  <% end %>
  