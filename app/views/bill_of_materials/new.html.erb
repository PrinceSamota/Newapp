<%= link_to bill_of_materials_path, class: "flex items-center gap-2 text-black hover:bg-gray-200 rounded-md p-2 w-22 border border-gray-300" do %>
    <i class="fa-solid fa-arrow-left"></i>
    <span class="font-bold">Back</span>
  <% end %>


  <%= form_with model: @bill_of_material, id: "bom-form", local: true do |f| %>
    <div class="max-w-8xl mx-auto bg-white p-8 rounded-2xl shadow-xl space-y-8 mt-10">
      
      <!-- Header -->
      <h2 class="text-2xl font-semibold text-gray-800">Bill of Material</h2>
  
      <!-- BOM Name -->
      
      <div>
        <label class="block text-sm font-medium text-gray-700">Bill of Material Name</label>
        <%= f.text_field :name, placeholder: "Enter BOM Name", id: "bom-name", class: "required-field mt-1 w-full border border-gray-300 rounded-md px-4 py-2 focus:ring-blue-500 focus:border-blue-500" %>
      </div>
  
      <!-- Finished Good Section (Styled to Match Raw Material UI) -->
      <div class="bg-blue-50 p-6 rounded-2xl shadow-md border border-gray-200 mt-8">
      <h3 class="text-lg font-semibold text-gray-800 mb-4">Finished Good</h3>
      
      <%= f.fields_for :finished_good do |fg| %>
        <div class="grid grid-cols-4 gap-6 items-center bg-white border border-blue-200 rounded-lg px-4 py-3 shadow-sm">
          
          <div>
            <%= fg.label :sku_id, "SKU ID", class: "text-xs font-medium text-gray-700 block mb-1" %>
            <%= fg.select :sku_id, options_for_select(@item_masters.map { |item| [item.sku_id, item.sku_id] }, fg.object.sku_id), { include_blank: "Choose SKU" }, id: "finished-good-sku-id", class: "required-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
          </div>
    
          <div>
            <%= fg.label :item_name, "Item Name", class: "text-xs font-medium text-gray-700 block mb-1" %>
            <%= fg.select :item_name, options_for_select(@item_masters.map { |item| [item.item_name, item.item_name] }, fg.object.item_name), { include_blank: "Choose Item" }, id: "finished-good-item-name", class: "required-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
          </div>
    
          <div>
            <%= fg.label :quantity, class: "text-xs font-medium text-gray-700 block mb-1" %>
            <%= fg.number_field :quantity, value: 1, class: "required-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
          </div>
    
          <div>
            <%= fg.label :unit, class: "text-xs font-medium text-gray-700 block mb-1" %>
            <%= fg.text_field :unit, class: "required-field unit-field w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>
          </div>
          
        </div>
      <% end %>
    </div>
      <!-- Raw Materials Section -->
      <div class="bg-green-50 p-6 rounded-xl shadow-sm">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Raw Materials</h3>
  
        <div id="bom-raw-materials" class="space-y-4">
          <%= f.fields_for :bom_raw_material_items do |rm| %>
            <%= render 'raw_material_fields', f: rm, item_masters: @item_masters_false %>
          <% end %>
        </div>
  
        <button type="button" id="add-raw-material" class="mt-4 bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-md cursor-pointer">
          + Add Raw Material
        </button>
      </div>
  
      <!-- Template for new raw material row -->
      <div id="raw-material-template" class="hidden">
        <% new_object = BomRawMaterialItem.new %>
        <% index = "NEW_INDEX" %>
        <%= f.fields_for :bom_raw_material_items, new_object, child_index: index do |rm_form| %>
          <%= render 'raw_material_fields', f: rm_form, item_masters: @item_masters_false %>
        <% end %>
      </div>
  
      <!-- Submit Button -->
      <div class="text-right">
        <%= f.submit "Save BOM", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-xl text-lg cursor-pointer" %>
      </div>
    </div>
  <% end %>
  
  
  <!-- JavaScript to handle adding new raw material rows -->
  <script>
  document.addEventListener("turbo:load", () => {
    if (window.bomRawMaterialFormInitialized) return;
    window.bomRawMaterialFormInitialized = true;

    const container = document.getElementById("bom-raw-materials");
    const template = document.getElementById("raw-material-template")?.innerHTML;
    const addButton = document.getElementById("add-raw-material");
    const form = document.querySelector("form");

    let index = container.querySelectorAll(".raw-material-row").length;

    // Mappings for SKU ↔ Item and Unit
    const skuToItem = {
      <% @item_masters.each do |item| %>
        "<%= item.sku_id %>": "<%= j item.item_name %>",
      <% end %>
    };
    const itemToSku = {
      <% @item_masters.each do |item| %>
        "<%= j item.item_name %>": "<%= item.sku_id %>",
      <% end %>
    };



    const skuToUnit = {
      <% @item_masters.each do |item| %>
        "<%= item.sku_id %>": "<%= j item.measurement&.name || '' %>",
      <% end %>
    };
    const itemToUnit = {
      <% @item_masters.each do |item| %>
        "<%= j item.item_name %>": "<%= item.measurement&.name || '' %>",
      <% end %>
    };
    
    function addRow() {
      if (!template) return;
      const html = template.replace(/NEW_INDEX/g, index);
      container.insertAdjacentHTML("beforeend", html);
      const newRow = container.querySelectorAll(".raw-material-row")[index];
      attachAutoFillEvents(newRow);
      index++;
    }

    function removeRow(event) {
      if (event.target.classList.contains("remove-raw-material")) {
        const row = event.target.closest(".raw-material-row");
        row?.remove();
      }
    }

    function normalizeFieldNames() {
      const rows = container.querySelectorAll(".raw-material-row");
      rows.forEach((row, i) => {
        const inputs = row.querySelectorAll("input, select, textarea");
        inputs.forEach((input) => {
          input.name = input.name.replace(/\[bom_raw_material_items_attributes\]\[[^\]]+\]/, `[bom_raw_material_items_attributes][${i}]`);
        });
      });
    }

    function removeTemplatePlaceholders() {
      container.querySelectorAll('[name*="NEW_INDEX"], [name*="temp_"]').forEach((el) => {
        const row = el.closest(".raw-material-row");
        row?.remove();
      });
    }

    function attachAutoFillEvents(row) {
      const skuSelect = row.querySelector(".sku-id-field");
      const itemSelect = row.querySelector(".item-name-select");
      const unitField = row.querySelector(".unit-field");

      if (skuSelect) {
        skuSelect.addEventListener("change", () => {
          const sku = skuSelect.value;
          if (skuToItem[sku]) itemSelect.value = skuToItem[sku];
          if (skuToUnit[sku]) unitField.value = skuToUnit[sku];
        });
      }

      if (itemSelect) {
        itemSelect.addEventListener("change", () => {
          const itemName = itemSelect.value;
          if (itemToSku[itemName]) skuSelect.value = itemToSku[itemName];
          if (itemToUnit[itemName]) unitField.value = itemToUnit[itemName];
        });
      }
    }

    addButton?.addEventListener("click", addRow);
    container?.addEventListener("click", removeRow);
    form?.addEventListener("submit", () => {
      removeTemplatePlaceholders();
      normalizeFieldNames();
    });

    // Initial rows
    container?.querySelectorAll(".raw-material-row").forEach(row => attachAutoFillEvents(row));

    // Finished Good - auto-fill
    const fgSku = document.getElementById("finished-good-sku-id");
    const fgItem = document.getElementById("finished-good-item-name");
    const fgUnit = document.querySelector(".unit-field");

    if (fgSku && fgItem) {
      fgSku.addEventListener("change", () => {
        const sku = fgSku.value;
        if (skuToItem[sku]) fgItem.value = skuToItem[sku];
        if (skuToUnit[sku] && fgUnit) fgUnit.value = skuToUnit[sku];
        fgItem.dispatchEvent(new Event('change'));
      });

      fgItem.addEventListener("change", () => {
        const item = fgItem.value;
        if (itemToSku[item]) fgSku.value = itemToSku[item];
        if (itemToUnit[item] && fgUnit) fgUnit.value = itemToUnit[item];
      });
    }

    // Auto-fill BOM Name from FG Item Name
    const bomNameField = document.getElementById("bom-name");
    if (fgItem && bomNameField) {
      fgItem.addEventListener("change", () => {
        const value = fgItem.value;
        if (value) bomNameField.value = value;
      });
    }
  });
  document.addEventListener("turbo:load", () => {
    const form = document.getElementById("bom-form");
    if (!form) return;
  
    form.addEventListener("submit", (e) => {
      let isValid = true;
  
      // Remove previous errors
      form.querySelectorAll(".required-field").forEach((field) => {
        field.classList.remove("border-red-500");
        const next = field.nextElementSibling;
        if (next && next.classList.contains("text-red-500")) {
          next.remove();
        }
      });
  
      // Validate fields
      form.querySelectorAll(".required-field").forEach((field) => {
  if (field.offsetParent !== null && !field.value.trim()) {
    isValid = false;
    field.classList.add("border-red-500");

    const error = document.createElement("p");
    error.textContent = "This field is required";
    error.className = "text-red-500 text-xs mt-1";
    field.insertAdjacentElement("afterend", error);
  }
});
  
      // Only prevent if validation fails
      if (!isValid) {
        e.preventDefault();
      }
    });
  });
  
</script>
