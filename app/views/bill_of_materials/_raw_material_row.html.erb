<div class="border border-gray-200 shadow-sm rounded-md p-3 bg-gray-50 raw-material-row relative grid grid-cols-4 gap-4 items-end">

  <!-- SKU ID (Searchable) -->
  <div>
    <%= render 'searchable_dropdown',
      field_id: "sku_#{f.index || SecureRandom.hex(4)}",
      label_text: 'SKU ID',
      field_name: f.object_name + '[sku_id]',
      items: item_masters,
      value_method: :sku_id,
      selected_value: f.object.sku_id,
      input_class: "sku-id-field",
      readonly: f.object.persisted? %>
  </div>

  <!-- Item Name (Searchable) -->
  <div>
    <%= render 'searchable_dropdown',
      field_id: "item_#{f.index || SecureRandom.hex(4)}",
      label_text: 'Item Name',
      field_name: f.object_name + '[item_name]',
      items: item_masters,
      value_method: :item_name,
      selected_value: f.object.item_name,
      input_class: "item-name-select",
      readonly: f.object.persisted? %>
  </div>
  <!-- Unit -->
  <div>
    <%= f.label :unit, "Unit", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :unit,
        class: "required-field unit-field w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
  </div>

  <!-- Quantity -->
  <div>
    <%= f.label :quantity, "Quantity", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :quantity, min: 0.0001, step: :any,
        class: "required-field quantity-field w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
  </div>



  <!-- Hidden Fields -->
  <%= f.hidden_field :item_master_id, class: "item-master-id-field" %>
  <%= f.hidden_field :_destroy, class: "destroy-flag" %>

  <!-- Delete Button -->
  <button type="button"
          class="delete-raw-material absolute -top-3 -right-3 bg-white border border-red-300 text-red-600 px-2 py-1 text-xs rounded-full shadow hover:bg-red-100 hover:text-red-700 transition cursor-pointer">
    ✕
  </button>
</div> 
<script>
  function filterDropdown(fieldId) {
    const input = document.getElementById(`${fieldId}_search`);
    const filter = input.value.toLowerCase();
    const dropdown = document.getElementById(`${fieldId}_list`);
    const items = dropdown?.querySelectorAll("div");

    if (!dropdown || !items) return;

    dropdown.classList.remove("hidden");

    items.forEach(item => {
      const text = item.textContent.toLowerCase();
      item.style.display = text.includes(filter) ? "block" : "none";
    });
  }

  function selectFromDropdown(fieldId, element) {
    const selectedValue = element.textContent.trim();
    const input = document.getElementById(`${fieldId}_search`);
    const hiddenInput = document.getElementById(`${fieldId}_hidden`);
    const dropdown = document.getElementById(`${fieldId}_list`);
  
    input.value = selectedValue;
    hiddenInput.value = fieldId.includes('sku') ? element.dataset.sku : element.dataset.itemName;
    dropdown.classList.add("hidden");
  
    const suffix = fieldId.split("_")[1];
    const pairFieldId = fieldId.includes('sku') ? `item_${suffix}` : `sku_${suffix}`;
    const pairInput = document.getElementById(`${pairFieldId}_search`);
    const pairHidden = document.getElementById(`${pairFieldId}_hidden`);
  
    if (pairInput && pairHidden) {
      pairInput.value = fieldId.includes('sku') ? element.dataset.itemName : element.dataset.sku;
      pairHidden.value = fieldId.includes('sku') ? element.dataset.itemName : element.dataset.sku;
    }
  
    const row = input.closest(".raw-material-row");
    if (row) {
      const unitField = row.querySelector(".unit-field");
      if (unitField) unitField.value = element.dataset.unit || "";
  
      const itemMasterIdField = row.querySelector(".item-master-id-field");
      if (itemMasterIdField) itemMasterIdField.value = element.dataset.itemMasterId || "";
    }
  
    input.readOnly = true;
    if (pairInput) pairInput.readOnly = true;
  
    addClearButton(input, row);
    if (pairInput) addClearButton(pairInput, row);
  }
  
  function addClearButton(input, row) {
    if (input.parentElement.querySelector(".clear-selection")) return;
  
    input.parentElement.style.position = "relative";
  
    const clearBtn = document.createElement("span");
    clearBtn.innerHTML = "x";
    clearBtn.className =
      "clear-selection absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-red-600 cursor-pointer text-sm";
  
    input.parentElement.appendChild(clearBtn);
  
    clearBtn.addEventListener("click", () => {
      input.value = "";
      const hiddenInput = document.getElementById(input.id.replace("_search", "_hidden"));
      if (hiddenInput) hiddenInput.value = "";
  
      const skuInput = row.querySelector(".sku-id-field");
      const itemInput = row.querySelector(".item-name-select");
      const unitField = row.querySelector(".unit-field");
      const itemMasterIdField = row.querySelector(".item-master-id-field");
  
      if (skuInput) skuInput.value = "";
      if (itemInput) itemInput.value = "";
      if (unitField) unitField.value = "";
      if (itemMasterIdField) itemMasterIdField.value = "";
  
      if (skuInput) skuInput.readOnly = false;
      if (itemInput) itemInput.readOnly = false;
  
      row.querySelectorAll(".clear-selection").forEach(btn => btn.remove());
    });
  }
  
  
</script>
