<% is_existing = f.object.persisted? %>

<div class="border border-gray-200 shadow-sm rounded-md p-3 bg-gray-50">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    
    <!-- SKU ID -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">SKU ID</label>
      <%= f.select :sku_id,
        options_from_collection_for_select(item_masters, :sku_id, :sku_id, f.object.sku_id),
        { include_blank: "Select SKU" },
        class: "sku-id-field w-full border border-gray-300 rounded-md px-3 py-2 text-sm #{'bg-gray-100 cursor-not-allowed text-gray-800 appearance-none custom-disabled-select' if is_existing}",
        disabled: is_existing %>
    </div>

    <!-- Item Name -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Item Name</label>
      <%= f.select :item_name,
        options_from_collection_for_select(item_masters, :item_name, :item_name, f.object.item_name),
        { include_blank: "Select Item" },
        class: "item-name-select w-full border border-gray-300 rounded-md px-3 py-2 text-sm #{'bg-gray-100 cursor-not-allowed text-gray-800 appearance-none custom-disabled-select' if is_existing}",
        disabled: is_existing %>
    </div>

    <!-- Quantity -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Quantity</label>
      <%= f.number_field :quantity, step: 0.01, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
    </div>

    <!-- Unit -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Unit</label>
      <%= f.text_field :unit, class: "w-full border border-gray-300 rounded-md px-3 py-2 text-sm" %>
    </div>
  </div>
  <div class="flex items-center justify-between gap-2">
  <!-- existing fields like sku_id, item_name, quantity etc. -->
  <%= f.hidden_field :_destroy, class: "destroy-flag" %>
  <button type="button" class="delete-raw-material bg-red-500 text-white px-2 py-1 rounded">
    Delete
  </button>
</div>
</div>
