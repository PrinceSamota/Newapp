# === Temporary & Development Files ===
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
!/tmp/storage/
!/tmp/storage/.keep

/test
/spec
/coverage
/docs

.byebug_history
*.swp
.DS_Store

# === Environment Files ===
/.env*
!/.env*.erb

# === Editor & CI Tools ===
.bundle
node_modules/
package-lock.json
yarn-error.log

# === Git & CI ===
.git
.gitignore
.github/
.circleci/
.travis.yml

# === Public and Precompiled Assets ===
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# === Vendor (Optional) ===
vendor/assets/

# === Binary Tools (Optional if you don’t use bin/ on runtime) ===
/bin/

# === Other ===
README.md
README.markdown
*.md

# === Sensitive Info ===
/config/master.key
